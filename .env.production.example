# ============================================================
# DOQ Production Environment Template
# Copy to .env.production and fill in your values
# ============================================================

# Application
NODE_ENV=production
PORT=3000
APP_PORT=3000
DOQ_DOMAIN=doq.example.com
PUBLIC_URL=https://doq.example.com
TRUST_PROXY=1

# Database
DB_HOST=db
DB_PORT=3306
DB_USER=doq_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
DB_NAME=DOQ
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_BIND_PORT=3306

# JWT & Security
JWT_SECRET=GENERATE_64_CHAR_RANDOM_STRING_HERE
RUN_MIGRATIONS=true
WAIT_FOR_DB=true

# Cron Jobs
CRON_ENABLED=true
CRON_INTERVAL_SECONDS=3600
DAILY_REPORT_ENABLED=true
PURGE_REPORTED_COMPLETED_ORDERS=true

# Commission (7% for both)
COMMISSION_APPROVED=false
CHEF_COMMISSION_PERCENT=7
DELIVERY_COMMISSION_PERCENT=7
DELIVERY_COMMISSION_BASIS=order_total
SETTLEMENT_CADENCE=daily
PAYOUT_LINK=https://your-payout-link.com

# Email (configure for production)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM="DOQ <noreply@doq.example.com>"

# Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@doq.example.com
ADMIN_BOOTSTRAP_PASSWORD=GENERATE_SECURE_PASSWORD
ADMIN_BOOTSTRAP_FIRST_NAME=DOQ
ADMIN_BOOTSTRAP_LAST_NAME=Admin
ADMIN_BOOTSTRAP_PHONE=01012345678
ADMIN_BOOTSTRAP_TOTP_SECRET=GENERATE_BASE32_SECRET

# Payment (Paymob)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com/api

# Backup
BACKUP_ENABLED=true
BACKUP_DIR=/app/backups
MYSQLDUMP_BIN=mysqldump

# Docker Registry (if using private registry)
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=