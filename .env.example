# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=doq_user
DB_PASSWORD=
DB_NAME=DOQ
MYSQL_ROOT_PASSWORD=
MYSQL_BIND_PORT=3306

# At least 32 random characters. The app warns on startup when it is shorter.
JWT_SECRET=

# Public address of the site, used in password reset links. Required in production.
PUBLIC_URL=http://localhost:3000
PORT=3000
APP_PORT=3000
NODE_ENV=development

# Container startup and recurring jobs
RUN_MIGRATIONS=true
WAIT_FOR_DB=true
CRON_ENABLED=false
CRON_INTERVAL_SECONDS=3600
DAILY_REPORT_ENABLED=true
PURGE_REPORTED_COMPLETED_ORDERS=true
COMMISSION_APPROVED=true
CHEF_COMMISSION_PERCENT=7
DELIVERY_COMMISSION_PERCENT=7
DELIVERY_COMMISSION_BASIS=order_total
SETTLEMENT_CADENCE=daily
PAYOUT_LINK=https://ipn.eg/S/mahmoudmustafamm/instapay/0qc4FA
PAYMENTS_ENABLED=false

# Email for password reset links. With Gmail use an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional one-time admin bootstrap. Set only during a controlled first setup, then remove values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=
ADMIN_BOOTSTRAP_LAST_NAME=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_TOTP_SECRET=

# Paymob
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com/api

# Daily backup from tasks/cron.js
BACKUP_ENABLED=false
BACKUP_DIR=
MYSQLDUMP_BIN=mysqldump
