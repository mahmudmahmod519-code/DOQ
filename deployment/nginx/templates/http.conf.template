# Phase 1 (no certificate yet): serve ACME challenges and proxy the app over HTTP.
# DOQ_* variables are filled by the nginx image (envsubst) at container start.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    include /etc/nginx/snippets/acme.conf;
    location / { return 444; }
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOQ_SERVER_NAMES};

    include /etc/nginx/snippets/acme.conf;
    include /etc/nginx/snippets/app-locations.conf;
}
