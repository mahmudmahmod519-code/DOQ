# ============================================================
# DOQ production environment  (template: deploy.sh copies it to .env.production)
#  - deploy.sh NEVER overwrites an existing .env.production.
#  - Values left empty / as CHANGE_ME are generated (secrets) or derived (URLs) on first deploy.
#  - Do not use the "$" character in values (docker compose would interpolate it).
#  - chmod 600; never commit this file.
# ============================================================

# ---------- REQUIRED: you must set these two ----------
# Your domain (an A/AAAA record must point to this VPS before SSL is issued)
DOQ_DOMAIN=CHANGE_ME.example.com
# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=CHANGE_ME@example.com

# ---------- Domain / SSL options ----------
# Also serve www.<domain> (needs its own DNS record)
INCLUDE_WWW=false
# true = domain is proxied by Cloudflare (orange cloud). Nginx will trust Cloudflare's client IP header.
CLOUDFLARE_PROXY=false
# true = use Let's Encrypt staging (test certificates, no rate limits). Use false for real certificates.
LETSENCRYPT_STAGING=false
# Derived automatically (https://DOQ_DOMAIN) when empty
PUBLIC_URL=
# Derived automatically from DOQ_DOMAIN + INCLUDE_WWW when empty
DOQ_SERVER_NAMES=

# ---------- Secrets: generated on first deploy when empty ----------
DB_NAME=DOQ
DB_USER=doq_user
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# At least 32 random characters
JWT_SECRET=

# ---------- Application ----------
NODE_ENV=production
TRUST_PROXY=1
PAYMENTS_ENABLED=false

# Recurring jobs (tasks/cron.js, "cron" container)
CRON_ENABLED=true
CRON_INTERVAL_SECONDS=3600
DAILY_REPORT_ENABLED=true
PURGE_REPORTED_COMPLETED_ORDERS=true
COMMISSION_APPROVED=false
CHEF_COMMISSION_PERCENT=7
DELIVERY_COMMISSION_PERCENT=7
DELIVERY_COMMISSION_BASIS=order_total
SETTLEMENT_CADENCE=daily
PAYOUT_LINK=https://ipn.eg/S/mahmoudmustafamm/instapay/0qc4FA

# Email (password reset links, daily report). Optional but recommended.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional one-time admin bootstrap (run: sudo ./deployment/scripts/bootstrap-admin.sh, then clear these)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=
ADMIN_BOOTSTRAP_LAST_NAME=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_TOTP_SECRET=

# Paymob (only when PAYMENTS_ENABLED=true)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com/api

# ---------- Infrastructure ----------
# MySQL 8.0 reached end of life in April 2026; 8.4 is the current LTS.
# If you migrate an EXISTING 8.0 data volume, keep mysql:8.0 until you have a backup (upgrade is one-way).
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:1.27-alpine
CERTBOT_IMAGE=certbot/certbot:v2.11.0
MYSQL_MEMORY_LIMIT=2g
APP_MEMORY_LIMIT=1g
CRON_MEMORY_LIMIT=512m

# ---------- Backups (host side, deployment/backup/backup.sh) ----------
BACKUP_DIR=/var/backups/doq
BACKUP_RETENTION_DAYS=14
# Always keep at least this many newest backups, whatever their age
BACKUP_MIN_KEEP=3
# Optional encrypted off-server copy: passphrase for gpg (AES256) + an rclone remote (e.g. "b2:doq-backups")
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_RCLONE_REMOTE=

# Install fail2ban for SSH brute-force protection (temporary bans, does not change SSH settings)
INSTALL_FAIL2BAN=true
