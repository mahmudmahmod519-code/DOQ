# DOQ MySQL settings (sized for an 8 GB VPS shared with the app)
[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
default-time-zone    = '+00:00'
innodb_buffer_pool_size = 1G
max_connections         = 150
skip-name-resolve
# Never listen beyond the docker network (no ports are published in docker-compose.prod.yml)
bind-address = 0.0.0.0
slow_query_log = 1
long_query_time = 2

[client]
default-character-set = utf8mb4
