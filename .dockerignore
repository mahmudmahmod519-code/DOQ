tests
docs
mobile
mobile_flutter
deployment
*.md
fresh_start.sh
unrun.sh
run.sh
deploy.sh
update.sh
fly.toml
Caddyfile
Caddyfile.staging
docker-compose*.yml
to_delete

# Runtime state (lives in volumes / host directories)
backups
verification
tmp
public/upload
database/.cron.lock
database/Untitled.pdf
