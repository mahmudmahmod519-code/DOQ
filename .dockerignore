# Dependencies and logs (installed inside the image)
node_modules
npm-debug.log*

# Secrets are injected at runtime by docker compose (env_file), never baked into the image
.env
.env.*

# Version control and CI
.git
.gitignore
.github

# Not needed to run the server
tests
mobile_flutter
deployment
*.md
*.sh
!docker-entrypoint.sh
Caddyfile
docker-compose*.yml

# Runtime state (lives in volumes / host directories)
backups
verification
tmp
public/upload
database/.cron.lock
