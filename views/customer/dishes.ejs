<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<script src="/app-client.js"></script>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport">
    <title>دوق - منيو الأطباق</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface": "#fff8f6",
                        "surface-dim": "#eed4d1",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#fff0ee",
                        "surface-container": "#ffe9e6",
                        "surface-container-high": "#fce2de",
                        "on-surface": "#261816",
                        "on-surface-variant": "#59413d",
                        "outline": "#8d706c",
                        "outline-variant": "#e1bfb9",
                        "primary": "#9e2016",
                        "on-primary": "#ffffff",
                        "primary-container": "#c0392b",
                        "secondary": "#a23f00",
                        "secondary-container": "#fc7127",
                        "on-secondary-container": "#5c2000",
                        "background": "#fff8f6",
                        "on-background": "#261816",
                    },
                    borderRadius: {
                        "sm": "0.25rem",
                        "DEFAULT": "0.5rem",
                        "md": "0.75rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "2xl": "2rem",
                        "full": "9999px"
                    },
                    fontFamily: {
                        "cairo": ["Cairo", "sans-serif"],
                    },
                    boxShadow: {
                        "menu": "0 1px 3px rgba(38, 24, 22, 0.04), 0 4px 12px rgba(38, 24, 22, 0.08), 0 8px 24px rgba(38, 24, 22, 0.04)",
                        "menu-hover": "0 4px 8px rgba(38, 24, 22, 0.06), 0 12px 24px rgba(38, 24, 22, 0.12), 0 16px 32px rgba(38, 24, 22, 0.08)",
                        "glow": "0px 4px 24px rgba(158, 32, 22, 0.15)"
                    }
                }
            }
        }
    </script>
    
    <style>
        body { 
            font-family: 'Cairo', sans-serif; 
            background-color: #fff8f6; 
            color: #261816; 
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
        }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        
        .dish-card { 
            transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.4s ease; 
            background-color: #ffffff;
            border: 1px solid rgba(225, 191, 185, 0.4);
        }
        .dish-card:hover { 
            transform: translateY(-4px) rotate(0.5deg); 
            box-shadow: 0 12px 32px rgba(158, 32, 22, 0.12); 
            border-color: rgba(158, 32, 22, 0.2);
        }

        .menu-item-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            position: relative;
        }
        .menu-item-header::after {
            content: '';
            flex: 1;
            border-bottom: 2px dotted #e1bfb9;
            margin: 0 12px;
            position: relative;
            top: -4px;
            opacity: 0.8;
        }

        .slider-container { position: relative; height: 40px; width: 100%; display: flex; align-items: center; }
        .slider-track-bg { position: absolute; width: 100%; height: 6px; background-color: #f7ddd9; border-radius: 999px; }
        .slider-track-active { position: absolute; height: 6px; background: linear-gradient(90deg, #9e2016 0%, #fc7127 100%); border-radius: 999px; }
        
        .slider-threshold-mark { position: absolute; top: 50%; transform: translate(-50%, -50%); width: 2px; height: 14px; background-color: #8d706c; opacity: 0.5; border-radius: 2px; }
        .slider-threshold-label { position: absolute; top: -18px; transform: translateX(-50%); font-size: 10px; font-weight: 700; color: #8d706c; white-space: nowrap; }
        
        .slider-thumb {
            position: absolute; width: 26px; height: 26px; background-color: #ffffff; border-radius: 50%; cursor: grab; z-index: 10;
            display: flex; align-items: center; justify-content: center; transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s;
            user-select: none; touch-action: none;
        }
        .slider-thumb:active { cursor: grabbing; transform: scale(1.2); }
        .slider-thumb.min { border: 3px solid #9e2016; box-shadow: 0px 4px 12px rgba(158, 32, 22, 0.3); }
        .slider-thumb.max { border: 3px solid #fc7127; box-shadow: 0px 4px 12px rgba(252, 113, 39, 0.3); }
        .slider-thumb::after { content: ''; width: 8px; height: 8px; border-radius: 50%; }
        .slider-thumb.min::after { background-color: #9e2016; }
        .slider-thumb.max::after { background-color: #fc7127; }

        .preset-btn {
            padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 600; background-color: #fff0ee; color: #59413d;
            border: 1px solid #e1bfb9; cursor: pointer; transition: all 0.2s ease; white-space: nowrap;
        }
        .preset-btn:hover { background-color: #fce2de; border-color: #9e2016; color: #9e2016; transform: translateY(-1px); }
        .preset-btn.active { background-color: #9e2016; color: white; border-color: #9e2016; box-shadow: 0 4px 12px rgba(158, 32, 22, 0.25); }

        .page-btn { min-width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; cursor: pointer; transition: all 0.2s ease; border: 1px solid #e1bfb9; color: #59413d; background: #fff; }
        .page-btn:hover:not(.disabled) { background: #fce2de; border-color: #9e2016; color: #9e2016; }
        .page-btn.active { background: #9e2016; color: white; border-color: #9e2016; box-shadow: 0 4px 12px rgba(158, 32, 22, 0.3); }
        .page-btn.disabled { opacity: 0.4; pointer-events: none; cursor: not-allowed; }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e1bfb9; border-radius: 10px; }
    </style>
</head>
<body class="bg-background text-on-background antialiased flex flex-col min-h-screen">

    <%- include('../partials/header') %>

    <main class="flex-grow pt-20 md:pt-24">
        <!-- Hero Section -->
        <section class="relative px-4 py-12 md:py-20 bg-gradient-to-b from-surface-container to-background mb-8 overflow-hidden">
            <div class="max-w-5xl mx-auto text-center relative z-10">
                <div class="inline-flex items-center gap-2 bg-secondary-container/20 text-on-secondary-container px-4 py-1.5 rounded-full text-sm font-bold mb-6 border border-secondary-container/30">
                    <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">restaurant_menu</span>
                    منيو دوق
                </div>
                <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-primary mb-6 leading-tight drop-shadow-sm">
                    اختار وجبتك،<br class="md:hidden"> وسيب الباقي علينا
                </h1>
                <p class="text-lg md:text-xl text-on-surface-variant mb-10 max-w-2xl mx-auto leading-relaxed">
                    كل أطباقنا محضرة يومياً بمكونات طازجة، لتعطيك طعم البيت الأصيل في كل لقمة.
                </p>
                
                <!-- لوحة الفلاتر المتقدمة -->
                <div class="bg-surface-container-lowest rounded-3xl p-6 md:p-8 shadow-menu border border-outline-variant/30 max-w-4xl mx-auto relative">
                    <div class="absolute top-4 left-4 w-8 h-8 border-t-2 border-l-2 border-outline-variant/30 rounded-tl-lg"></div>
                    <div class="absolute bottom-4 right-4 w-8 h-8 border-b-2 border-r-2 border-outline-variant/30 rounded-br-lg"></div>

                    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
                        <!-- البحث والتصنيف -->
                        <div class="md:col-span-7 space-y-5">
                            <div>
                                <label class="block text-sm font-bold text-on-surface-variant mb-2">ابحث في المنيو</label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline text-2xl">search</span>
                                    <input class="w-full pl-4 pr-12 py-3.5 rounded-xl border border-outline-variant/40 bg-surface focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-base outline-none font-medium" 
                                           placeholder="مثال: كشري، طواجن، مشويات..." type="text" id="searchInput">
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-on-surface-variant mb-2">القسم</label>
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline text-2xl">category</span>
                                    <select class="w-full pl-4 pr-12 py-3.5 rounded-xl border border-outline-variant/40 bg-surface focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-base outline-none font-medium appearance-none" id="categoryFilter">
                                        <option value="">كل الأقسام</option>
                                    </select>
                                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
                                </div>
