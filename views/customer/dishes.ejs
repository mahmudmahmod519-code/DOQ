                        </div>

                        <!-- شريط السعر الذكي -->
                        <div class="md:col-span-5 flex flex-col justify-center h-full">
                            <label class="block text-sm font-bold text-on-surface-variant mb-4 w-full text-center">نطاق السعر (ج.م)</label>
                            
                            <div class="px-3">
                                <div class="slider-container" id="priceSliderContainer">
                                    <div class="slider-track-bg"></div>
                                    <div id="activeTrack" class="slider-track-active"></div>
                                    <div class="slider-threshold-mark" id="thresholdMark" style="left: 70%;">
                                        <span class="slider-threshold-label">500</span>
                                    </div>
                                    <div id="thumbMin" class="slider-thumb min" data-type="min"></div>
                                    <div id="thumbMax" class="slider-thumb max" data-type="max"></div>
                                </div>

                                <div class="flex justify-between items-center mt-8 bg-surface-container px-4 py-3 rounded-2xl border border-outline-variant/30">
                                    <div class="text-center flex-1">
                                        <span class="text-xs text-on-surface-variant block mb-1 font-medium">من</span>
                                        <span class="text-xl font-extrabold text-primary" id="displayMin">0</span>
                                    </div>
                                    <span class="material-symbols-outlined text-outline-variant mx-2 text-sm">remove</span>
                                    <div class="text-center flex-1">
                                        <span class="text-xs text-on-surface-variant block mb-1 font-medium">إلى</span>
                                        <span class="text-xl font-extrabold text-secondary" id="displayMax">10,000</span>
                                    </div>
                                </div>

                                <div class="flex flex-wrap gap-2 mt-4 justify-center">
                                    <button class="preset-btn" data-min="0" data-max="100">أقل من 100</button>
                                    <button class="preset-btn" data-min="100" data-max="300">100 - 300</button>
                                    <button class="preset-btn" data-min="300" data-max="500">300 - 500</button>
                                    <button class="preset-btn" data-min="500" data-max="10000">500 +</button>
                                    <button class="preset-btn" data-min="0" data-max="10000">الكل</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="absolute top-0 left-0 w-64 h-64 bg-secondary-fixed/30 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
            <div class="absolute bottom-0 right-0 w-80 h-80 bg-primary-fixed/30 rounded-full blur-3xl translate-x-1/3 translate-y-1/3 pointer-events-none"></div>
        </section>

        <!-- ========================================== -->
        <!-- شريط تنبيه فلتر المطبخ (يظهر فقط عند الحاجة) -->
        <!-- ========================================== -->
        <div id="kitchenFilterBanner" class="hidden max-w-7xl mx-auto px-4 md:px-6 lg:px-8 mb-6">
            <div class="bg-primary/10 border border-primary/20 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm backdrop-blur-sm">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings: 'FILL' 1;">storefront</span>
                    <div class="text-right">
                        <h3 class="font-bold text-primary text-lg">أنت تتصفح حالياً أطباق مطبخ محدد</h3>
                        <p class="text-sm text-on-surface-variant">يتم عرض الأطباق المتاحة من هذا المطبخ فقط بناءً على اختيارك السابق.</p>
                    </div>
                </div>
                <button id="clearKitchenFilterBtn" class="px-6 py-2.5 bg-primary text-white rounded-xl font-bold hover:bg-primary-container transition-all flex items-center gap-2 shadow-glow whitespace-nowrap active:scale-95">
                    <span class="material-symbols-outlined text-xl">clear_all</span>
                    عرض كل الأطباق
                </button>
            </div>
        </div>
        <!-- ========================================== -->

        <!-- شبكة الأطباق -->
        <section class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8 mb-16">
            <div class="flex justify-between items-center mb-8 pb-4 border-b border-dashed border-outline-variant">
                <span class="text-on-surface-variant font-bold text-lg flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">menu_book</span>
                    <span id="resultsCount">جاري التحميل...</span>
                </span>
                <span class="text-on-surface-variant text-sm bg-surface-container px-3 py-1 rounded-full" id="pageInfo">الصفحة 1</span>
            </div>

            <div id="loadingState" class="flex justify-center items-center py-20 hidden">
                <div class="flex flex-col items-center gap-4">
                    <div class="w-12 h-12 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                    <span class="text-on-surface-variant font-bold">جاري تجهيز المنيو...</span>
                </div>
            </div>

            <div id="dishesGridSection">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" id="dishesGrid"></div>
            </div>

            <div class="mt-16 flex justify-center items-center gap-2 flex-wrap" id="paginationArea">
                <button class="page-btn" id="prevPageBtn">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
                <div class="flex items-center gap-2 flex-wrap" id="pageNumbers"></div>
                <button class="page-btn" id="nextPageBtn">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>

    <script>
        // ==========================================
        // 1. شريط السعر الذكي غير الخطي
        // ==========================================
        class SmartPriceSlider {
            constructor() {
                this.minVal = 0;
                this.maxVal = 10000;
                this.currentMin = 0;
                this.currentMax = 10000;
                this.thresholdValue = 500;
                this.thresholdPercent = 70;
                
                this.container = document.getElementById('priceSliderContainer');
                this.activeTrack = document.getElementById('activeTrack');
                this.thumbMin = document.getElementById('thumbMin');
                this.thumbMax = document.getElementById('thumbMax');
                this.displayMin = document.getElementById('displayMin');
                this.displayMax = document.getElementById('displayMax');
                this.isDragging = null;

                this.initEvents();
                this.updateVisuals();
            }

            valueToPercent(val) {
                if (val <= this.thresholdValue) return (val / this.thresholdValue) * this.thresholdPercent;
                return this.thresholdPercent + ((val - this.thresholdValue) / (this.maxVal - this.thresholdValue)) * (100 - this.thresholdPercent);
            }

            percentToValue(percent) {
                let val;
                if (percent <= this.thresholdPercent) val = (percent / this.thresholdPercent) * this.thresholdValue;
                else val = this.thresholdValue + ((percent - this.thresholdPercent) / (100 - this.thresholdPercent)) * (this.maxVal - this.thresholdValue);
                
                return val <= this.thresholdValue ? Math.round(val / 10) * 10 : Math.round(val / 100) * 100;
            }

            updateVisuals() {
                const minPercent = this.valueToPercent(this.currentMin);
                const maxPercent = this.valueToPercent(this.currentMax);
                
                this.thumbMin.style.left = `calc(${minPercent}% - 13px)`;
                this.thumbMax.style.left = `calc(${maxPercent}% - 13px)`;
                this.activeTrack.style.left = `${minPercent}%`;
                this.activeTrack.style.width = `${maxPercent - minPercent}%`;
                
                this.displayMin.textContent = this.currentMin.toLocaleString('ar-EG');
                this.displayMax.textContent = this.currentMax.toLocaleString('ar-EG');
                this.updatePresetButtons();
            }

            updatePresetButtons() {
                document.querySelectorAll('.preset-btn').forEach(btn => {
                    if (this.currentMin === parseInt(btn.dataset.min) && this.currentMax === parseInt(btn.dataset.max)) {
                        btn.classList.add('active');
                    } else {
                        btn.classList.remove('active');
                    }
                });
            }

            handleMove(clientX) {
                const rect = this.container.getBoundingClientRect();
                let percent = Math.max(0, Math.min(100, ((clientX - rect.left) / rect.width) * 100));
                let newValue = this.percentToValue(percent);

                if (this.isDragging === 'min') {
                    const step = newValue <= this.thresholdValue ? 10 : 100;
                    if (newValue >= this.currentMax - step) newValue = this.currentMax - step;
                    this.currentMin = Math.max(0, newValue);
                } else if (this.isDragging === 'max') {
                    const step = newValue <= this.thresholdValue ? 10 : 100;
                    if (newValue <= this.currentMin + step) newValue = this.currentMin + step;
                    this.currentMax = Math.min(this.maxVal, newValue);
                }
                this.updateVisuals();
            }

            setValues(min, max) {
                this.currentMin = min;
                this.currentMax = max;
                this.updateVisuals();
                applyFilters();
            }

            initEvents() {
                const startDrag = (e, type) => { e.preventDefault(); this.isDragging = type; document.body.style.cursor = 'grabbing'; };
                const onMove = (e) => {
                    if (!this.isDragging) return;
                    e.preventDefault();
                    this.handleMove(e.touches ? e.touches[0].clientX : e.clientX);
                };
                const endDrag = () => {
                    if (this.isDragging) { this.isDragging = null; document.body.style.cursor = 'default'; applyFilters(); }
                };

                this.thumbMin.addEventListener('mousedown', (e) => startDrag(e, 'min'));
                this.thumbMax.addEventListener('mousedown', (e) => startDrag(e, 'max'));
                this.thumbMin.addEventListener('touchstart', (e) => startDrag(e, 'min'), {passive: false});
                this.thumbMax.addEventListener('touchstart', (e) => startDrag(e, 'max'), {passive: false});

                window.addEventListener('mousemove', onMove);
                window.addEventListener('touchmove', onMove, {passive: false});
                window.addEventListener('mouseup', endDrag);
                window.addEventListener('touchend', endDrag);

                document.querySelectorAll('.preset-btn').forEach(btn => {
                    btn.addEventListener('click', () => this.setValues(parseInt(btn.dataset.min), parseInt(btn.dataset.max)));
                });
            }
        }

        const priceSlider = new SmartPriceSlider();

        // ==========================================
        // 2. منطق جلب البيانات وعرضها
        // ==========================================
        let currentPage = 1, totalPages = 1, totalItems = 0, isLoading = false;
        let currentFilters = { q: '', category: '', min_price: '0', max_price: '10000', sort_by: 'created_at', sort_order: 'DESC' };

        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const grid = document.getElementById('dishesGrid');
        const loadingState = document.getElementById('loadingState');
        const resultsCount = document.getElementById('resultsCount');
        const pageInfo = document.getElementById('pageInfo');
        const pageNumbers = document.getElementById('pageNumbers');
        const prevPageBtn = document.getElementById('prevPageBtn');
        const nextPageBtn = document.getElementById('nextPageBtn');
        
        // عناصر فلتر المطبخ الجديدة
        const kitchenFilterBanner = document.getElementById('kitchenFilterBanner');
        const clearKitchenFilterBtn = document.getElementById('clearKitchenFilterBtn');

        // دالة للتحقق من وجود kitchen_id وإظهار/إخفاء الشريط
        function checkKitchenFilter() {
            const kitchenId = sessionStorage.getItem('kitchen_id');
            if (kitchenId) {
                kitchenFilterBanner.classList.remove('hidden');
            } else {
                kitchenFilterBanner.classList.add('hidden');
            }
        }

        // دالة لمسح فلتر المطبخ وإعادة تعيين كل شيء
        function clearKitchenFilter() {
            // 1. مسح المعرف من الذاكرة
            sessionStorage.removeItem('kitchen_id');
            
            // 2. إعادة تعيين حقول الإدخال
            searchInput.value = '';
            categoryFilter.value = '';
            
            // 3. إعادة تعيين شريط السعر (سيقوم هذا تلقائياً باستدعاء applyFilters)
            priceSlider.setValues(0, 10000);
            
            // 4. إخفاء شريط التنبيه
            kitchenFilterBanner.classList.add('hidden');
            
            // ملاحظة: priceSlider.setValues يستدعي applyFilters() داخلياً، 
            // و applyFilters() تقرأ القيم الجديدة الفارغة وتستدعي fetchDishes(1)
        }

        // ربط الزر بحدث النقر
        clearKitchenFilterBtn.addEventListener('click', clearKitchenFilter);

        async function fetchCategories() {
            try {
                const res = await fetch('/categories/api/v1/all');
                const data = await res.json();
                if (data.status === 'success' && data.data.length) {
                    const html = ['<option value="">كل الأقسام</option>'];
                    data.data.forEach(cat => {
                        if (cat.dishes_count > 0) html.push(`<option value="${DOQ.escape(encodeURIComponent(cat.name || ''))}">${DOQ.escape(cat.name || '')} (${Number(cat.dishes_count) || 0})</option>`);
                    });
                    categoryFilter.innerHTML = html.join('');
                }
            } catch (e) { console.error('Error fetching categories:', e); }
        }

        async function fetchDishes(page = 1) {
            if (isLoading) return;
            isLoading = true;
            loadingState.classList.remove('hidden');
            grid.innerHTML = '';

            let params = new URLSearchParams();
            params.append('page', page);
            params.append('limit', 9);
            if (currentFilters.q) params.append('q', currentFilters.q);
            if (currentFilters.category) params.append('category', decodeURIComponent(currentFilters.category));
            params.append('min_price', currentFilters.min_price);
            params.append('max_price', currentFilters.max_price);
            params.append('sort_by', currentFilters.sort_by);
            params.append('sort_order', currentFilters.sort_order);

            // التحقق من kitchen_id لتحديد مسار الـ API
            let url = sessionStorage.getItem('kitchen_id') ? `/dishes/v1/api/kitchen/${parseInt(sessionStorage.getItem('kitchen_id'))}` : '/dishes/v1/api';

            try {
                const res = await fetch(url + '?' + params.toString());
                const data = await res.json();
                if (data.status === 'success') {
                    const dishes = data.data || [];
                    const pagination = data.pagination || { page: 1, limit: 9, total: 0, total_pages: 1 };
                    
                    currentPage = pagination.page;
                    totalPages = pagination.total_pages;
                    totalItems = pagination.total;

                    updateUI(dishes);
                    renderPagination();

                    setTimeout(() => {
                        const targetElement = document.getElementById('dishesGridSection');
                        if (targetElement && page > 1) { 
                            targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    }, 100);

                } else {
                    showError(data.message || 'حدث خطأ أثناء التحميل');
                }
            } catch (err) {
                showError('حدث خطأ في الاتصال بالخادم');
            } finally {
                loadingState.classList.add('hidden');
                isLoading = false;
            }
        }

        function updateUI(dishes) {
            resultsCount.textContent = `${totalItems} صنف متاح`;
            pageInfo.textContent = `صفحة ${currentPage} من ${totalPages}`;

            if (dishes.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full flex flex-col items-center justify-center py-16 text-center bg-surface-container-low/30 rounded-3xl border border-dashed border-outline-variant">
                        <span class="material-symbols-outlined text-6xl text-outline-variant mb-4">search_off</span>
                        <h3 class="text-xl font-bold text-on-surface mb-2">لا توجد أصناف مطابقة</h3>
                        <p class="text-on-surface-variant max-w-md">جرب تغيير كلمات البحث، أو وسع نطاق السعر.</p>
                    </div>`;
                return;
            }

            let html = '';
            dishes.forEach((dish, index) => {
                // تم تصحيح الخطأ الصياغي هنا لضمان عمل الكود بشكل سليم
                const imageUrl = DOQ.safeImage(dish.image_url || '/assests/dish_avatar.jpeg');
                const price = dish.price || 0;
                const categoryName = dish.category_name || 'أطباق متنوعة';
                const kitchenTitle = dish.kitchen_title || 'مطبخ دوق';
                const isFeatured = index === 0; 
                
                html += `
                    <article class="dish-card rounded-2xl overflow-hidden group flex flex-col h-full relative">
                        ${isFeatured ? '<div class="absolute top-4 right-4 z-10 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg flex items-center gap-1"><span class="material-symbols-outlined text-sm" style="font-variation-settings: \'FILL\' 1;">star</span>الأكثر طلباً</div>' : ''}
                        
                        <div class="relative w-full overflow-hidden" style="height: 200px;">
                            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="${imageUrl}" alt="${DOQ.escape(dish.name || '')}" loading="lazy">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                        </div>
                        
                        <div class="p-5 flex flex-col flex-grow bg-white relative">
                            <div class="menu-item-header mb-3">
                                <h3 class="font-bold text-lg text-on-surface leading-tight line-clamp-1">${DOQ.escape(dish.name || '')}</h3>
                                <span class="font-extrabold text-secondary text-lg whitespace-nowrap">${price} <span class="text-xs font-normal text-on-surface-variant">ج.م</span></span>
                            </div>
                            
                            <div class="flex items-center gap-2 text-on-surface-variant mb-4 text-sm">
                                <span class="material-symbols-outlined text-base text-outline">storefront</span>
                                <span class="font-medium">${DOQ.escape(kitchenTitle)}</span>
                                <span class="mx-1">•</span>
                                <span class="bg-surface-container px-2 py-0.5 rounded text-xs">${DOQ.escape(categoryName)}</span>
                            </div>
                            
                            <a href="/dishes/${dish.id}" class="mt-auto w-full py-3 bg-surface text-primary border border-primary/20 rounded-xl font-bold text-base hover:bg-primary hover:text-white transition-all flex items-center justify-center gap-2 group/btn">
                                عرض التفاصيل والطلب
                                <span class="material-symbols-outlined text-lg group-hover/btn:-translate-x-1 transition-transform">arrow_back</span>
                            </a>
                        </div>
                    </article>
                `;
            });
            grid.innerHTML = html;
        }

        function renderPagination() {
            prevPageBtn.classList.toggle('disabled', currentPage <= 1);
            nextPageBtn.classList.toggle('disabled', currentPage >= totalPages);

            let html = '';
            const range = window.innerWidth < 640 ? 1 : 2;
            const start = Math.max(1, currentPage - range);
            const end = Math.min(totalPages, currentPage + range);

            if (start > 1) {
                html += `<span class="page-btn" data-page="1">1</span>`;
                if (start > 2) html += `<span class="text-on-surface-variant px-1 hidden sm:inline">...</span>`;
            }

            for (let i = start; i <= end; i++) {
                html += `<span class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</span>`;
            }

            if (end < totalPages) {
                if (end < totalPages - 1) html += `<span class="text-on-surface-variant px-1 hidden sm:inline">...</span>`;
                html += `<span class="page-btn" data-page="${totalPages}">${totalPages}</span>`;
            }

            pageNumbers.innerHTML = html;
            document.querySelectorAll('#pageNumbers .page-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const page = parseInt(this.dataset.page);
                    if (page && page !== currentPage) fetchDishes(page);
                });
            });
        }

        function showError(msg) {
            grid.innerHTML = `
                <div class="col-span-full flex flex-col items-center justify-center py-16 text-center bg-error-container/20 rounded-3xl border border-error/20">
                    <span class="material-symbols-outlined text-6xl text-error mb-4">error</span>
                    <h3 class="text-xl font-bold text-on-surface mb-2">حصل خطأ مفاجئ</h3>
                    <p class="text-on-surface-variant max-w-md mb-6">${msg}</p>
                    <button onclick="fetchDishes(1)" class="px-6 py-3 bg-primary text-on-primary rounded-xl font-bold hover:bg-primary-container transition-colors">إعادة المحاولة</button>
                </div>`;
        }

        function applyFilters() {
            currentFilters.q = searchInput.value.trim();
            currentFilters.category = categoryFilter.value;
            currentFilters.min_price = priceSlider.currentMin;
            currentFilters.max_price = priceSlider.currentMax;
            fetchDishes(1);
        }

        let searchTimeout;
        searchInput.addEventListener('input', () => { clearTimeout(searchTimeout); searchTimeout = setTimeout(applyFilters, 600); });
        categoryFilter.addEventListener('change', applyFilters);

        prevPageBtn.addEventListener('click', () => { if (currentPage > 1) fetchDishes(currentPage - 1); });
        nextPageBtn.addEventListener('click', () => { if (currentPage < totalPages) fetchDishes(currentPage + 1); });

        window.addEventListener('resize', () => {
            clearTimeout(window.resizeTimer);
            window.resizeTimer = setTimeout(renderPagination, 200);
        });

        document.addEventListener('DOMContentLoaded', () => {
            checkKitchenFilter(); // التحقق من فلتر المطبخ عند التحميل
            fetchCategories();
            fetchDishes(1);
        });
    </script>
</body>
</html>
