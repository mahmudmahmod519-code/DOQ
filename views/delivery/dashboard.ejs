<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>طلبات التوصيل | دوق</title>
<script src="/app-client.js"></script><script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#fff8f6] text-[#261816]">
<%- include('../partials/role_bar', { links: [{ href: '/delivery', label: 'طلبات التوصيل', active: true }] }) %>
<main class="mx-auto max-w-6xl p-4 md:p-8">
<section class="rounded-3xl bg-[#261816] p-6 text-white shadow-xl"><p class="text-sm text-white/70">حساب شركة الدليفري</p><h1 class="mt-2 text-2xl font-bold md:text-3xl">الطلبات المفتوحة قدام كل الشركات</h1><p class="mt-2 text-white/75">الطلب يفضل معلق لحد ما شركة تقبله. مفيش رفض. أول قبول بيحجز الطلب للشركة دي</p><div class="mt-4 flex flex-wrap gap-2 text-sm"><span class="rounded-full bg-white/10 px-3 py-1">مفتوحة: <b id="count-open">0</b></span><span class="rounded-full bg-white/10 px-3 py-1">معاك: <b id="count-active">0</b></span><span class="rounded-full bg-white/10 px-3 py-1">اتسلمت: <b id="count-done">0</b></span></div></section>
<section class="mt-6 rounded-2xl border border-[#e1bfb9] bg-white p-5 shadow-sm"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="font-bold">العربيات</h2><p class="text-sm text-[#59413d]">اختار العربية وقت قبول الطلب عشان التقرير يحسب كل عربية لوحدها</p></div><form id="vehicle-form" class="flex flex-wrap gap-2"><input id="vehicle-label" required maxlength="80" class="rounded-xl border border-[#e1bfb9] px-3 py-2" placeholder="رقم أو اسم العربية"><button class="rounded-xl bg-[#9e2016] px-4 py-2 font-bold text-white">إضافة عربية</button></form></div><div id="vehicles" class="mt-3 flex flex-wrap gap-2"></div></section>
<div id="notice" class="mt-5 hidden rounded-xl p-4" role="status"></div><section id="orders" class="mt-6 grid gap-4 md:grid-cols-2"></section>
</main>
<script>
const esc=v=>DOQ.escape(v);let vehicles=[];
function notice(t,ok=true){const e=document.getElementById('notice');e.textContent=t;e.className='mt-5 rounded-xl p-4 '+(ok?'bg-green-100 text-green-900':'bg-red-100 text-red-900');}
function money(v){return Number(v||0).toFixed(2)+' جنيه';}
function tel(v){return v?'<a dir="ltr" class="text-[#9e2016] underline" href="tel:'+esc(v)+'">'+esc(v)+'</a>':'مش متاح';}
function row(l,v){return '<div class="flex justify-between gap-3 border-b border-[#e1bfb9]/40 py-2"><span class="text-[#59413d]">'+l+'</span><span class="text-left">'+v+'</span></div>';}
function chip(s){const m={pending:['مفتوح','bg-amber-100 text-amber-900'],accepted:['معاك','bg-blue-100 text-blue-900'],completed:['اتسلم','bg-green-100 text-green-900'],cancelled:['اتلغى','bg-red-100 text-red-900']};const x=m[s]||[s,'bg-gray-100 text-gray-800'];return '<span class="rounded-full px-3 py-1 text-xs font-bold '+x[1]+'">'+x[0]+'</span>';}
function vehicleOptions(){return vehicles.length?'<select data-vehicle class="w-full rounded-xl border border-[#e1bfb9] px-3 py-3">'+vehicles.map(v=>'<option value="'+v.id+'">'+esc(v.label)+'</option>').join('')+'</select>':'<p class="text-sm text-amber-800">ضيف عربية قبل قبول الطلب</p>';}
function card(o){const open=o.status==='pending'&&!o.delivery_id,mine=o.status==='accepted'&&Number(o.delivery_id)>0;return '<article class="rounded-2xl border border-[#e1bfb9] bg-white p-5 shadow-sm"><div class="flex items-start justify-between gap-3"><div><p class="text-sm text-[#59413d]">كود الطلب</p><p dir="ltr" class="text-right text-xl font-extrabold tracking-wider">'+esc(o.order_code)+'</p></div>'+chip(o.status)+'</div><p class="mt-3 text-lg font-bold">'+esc(o.dish_name)+' × '+o.quantity+'</p><div class="mt-3 rounded-xl bg-[#fff8f6] p-3 text-sm">'+row('اسم الطلب',esc(o.order_name||'بدون اسم'))+row('الإجمالي','<b>'+money(o.total_price)+'</b>')+'</div><h3 class="mt-4 font-bold">الاستلام من المطبخ</h3><div class="text-sm">'+row('المطبخ',esc(o.kitchen_name))+row('العنوان',esc(o.kitchen_address||'مش متاح'))+row('التليفون',tel(o.kitchen_phone))+'</div>'+(mine?'<h3 class="mt-4 font-bold">بيانات العميل بعد القبول</h3><div class="text-sm">'+row('الاسم',esc(o.customer_name||'مش متاح'))+row('التليفون',tel(o.customer_phone))+row('العنوان',esc(o.customer_address||'اسأل العميل على التليفون'))+'</div>':'<p class="mt-4 rounded-xl bg-amber-50 p-3 text-sm text-amber-900">بيانات العميل هتظهر لأول شركة تقبل الطلب</p>')+(open?'<div class="mt-5 space-y-2">'+vehicleOptions()+'<button class="w-full rounded-xl bg-green-700 px-4 py-3 font-bold text-white" data-action="accept" data-id="'+esc(o.public_id)+'">قبول الطلب</button></div>':mine?'<button class="mt-5 w-full rounded-xl bg-[#9e2016] px-4 py-3 font-bold text-white" data-action="complete" data-id="'+esc(o.public_id)+'">تأكيد إن الطلب وصل</button>':'<p class="mt-4 text-sm text-[#59413d]">الطلب اتسلم قبل كده</p>')+'</article>';}
async function loadVehicles(){vehicles=(await DOQ.api('/orders/api/v1/delivery/vehicles')).data||[];document.getElementById('vehicles').innerHTML=vehicles.length?vehicles.map(v=>'<span class="rounded-full bg-[#fff0ee] px-3 py-1 text-sm">'+esc(v.label)+'</span>').join(''):'<span class="text-sm text-[#59413d]">لسه مفيش عربيات مضافة</span>';}
async function load(){try{const rows=(await DOQ.api('/orders/api/v1/delivery')).data||[];document.getElementById('count-open').textContent=rows.filter(o=>o.status==='pending'&&!o.delivery_id).length;document.getElementById('count-active').textContent=rows.filter(o=>o.status==='accepted'&&Number(o.delivery_id)>0).length;document.getElementById('count-done').textContent=rows.filter(o=>o.status==='completed').length;document.getElementById('orders').innerHTML=rows.length?rows.map(card).join(''):'<div class="rounded-2xl border border-dashed border-[#e1bfb9] bg-white p-8 text-center md:col-span-2">مفيش طلبات مفتوحة دلوقتي</div>';}catch(e){notice(e.message,false);}}
document.getElementById('vehicle-form').addEventListener('submit',async e=>{e.preventDefault();try{await DOQ.api('/orders/api/v1/delivery/vehicles','POST',{label:document.getElementById('vehicle-label').value});document.getElementById('vehicle-label').value='';await loadVehicles();notice('تمت إضافة العربية');load();}catch(err){notice(err.message,false);}});
document.getElementById('orders').addEventListener('click',async e=>{const b=e.target.closest('button[data-action]');if(!b)return;b.disabled=true;try{if(b.dataset.action==='accept'){const c=b.closest('article'),s=c.querySelector('[data-vehicle]');if(!s)throw new Error('ضيف عربية قبل قبول الطلب');await DOQ.api('/orders/api/v1/delivery/'+encodeURIComponent(b.dataset.id)+'/accept','PATCH',{vehicle_id:Number(s.value)});}else await DOQ.api('/orders/api/v1/'+encodeURIComponent(b.dataset.id)+'/status','PATCH',{status:'completed'});notice('تم تحديث الطلب');load();}catch(err){notice(err.message,false);b.disabled=false;}});
loadVehicles().then(load).catch(e=>notice(e.message,false));
</script>
</body>
</html>
