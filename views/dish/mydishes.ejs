<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>دوق - إدارة أطباقي</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#9e2016",
                        "primary-container": "#c0392b",
                        "on-primary": "#ffffff",
                        "secondary": "#a23f00",
                        "secondary-container": "#fc7127",
                        "on-secondary-container": "#5c2000",
                        "background": "#fff8f6",
                        "surface": "#fff8f6",
                        "surface-variant": "#f7ddd9",
                        "surface-container": "#ffe9e6",
                        "on-surface": "#261816",
                        "on-surface-variant": "#59413d",
                        "outline": "#8d706c",
                        "outline-variant": "#e1bfb9",
                        "error": "#ba1a1a",
                    },
                    fontFamily: {
                        "body": ["Cairo", "sans-serif"],
                    }
                },
            },
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; background-color: #fff8f6; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .meal-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .meal-card:hover { transform: translateY(-4px); box-shadow: 0px 12px 40px rgba(192, 57, 43, 0.12); }
        /* Loader Animation */
        .loader { border: 3px solid #f7ddd9; border-top-color: #9e2016; border-radius: 50%; width: 24px; height: 24px; animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen flex flex-col justify-between">

    <!-- معلومات المستخدم المحقونة من الـ Render -->
    <script>
        const currentUser = <%- JSON.stringify(currentUser || null) %>;
    </script>

    <!-- Top AppBar Header -->
    <header class="sticky top-0 z-40 backdrop-blur-md bg-surface/90 shadow-sm border-b border-surface-variant">
        <div class="flex flex-row justify-between items-center w-full px-4 md:px-8 max-w-7xl mx-auto py-4">
            <div class="flex items-center gap-3">
                <a href="/dashboard" class="w-10 h-10 rounded-full flex items-center justify-center bg-surface-container hover:bg-surface-variant transition-colors">
                    <span class="material-symbols-outlined">arrow_forward</span>
                </a>
                <div class="flex flex-col">
                    <h1 class="text-xl font-bold text-on-surface" id="header-kitchen-name">مطبخي...</h1>
                    <span class="text-sm text-on-surface-variant flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">person</span>
                        <%= currentUser ? currentUser.first_name + ' ' + currentUser.last_name : 'شيف' %>
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button onclick="openCreateModal()" class="flex items-center gap-2 bg-primary text-white px-4 py-2 rounded-xl font-bold transition-all hover:bg-primary-container shadow-sm">
                    <span class="material-symbols-outlined">add</span>
                    <span class="hidden md:inline">إضافة طبق جديد</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 md:px-8 pt-6 pb-20 w-full flex-grow">

        <!-- Search Bar Section -->
        <section class="mb-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                <h2 class="text-2xl font-bold text-primary">قائمة الأطباق</h2>
                <span id="meal-counter" class="bg-secondary-container text-on-secondary-container px-4 py-1.5 rounded-full font-bold text-sm w-fit">
                    جاري التحميل...
                </span>
            </div>

            <!-- Search Input -->
            <div class="relative">
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                <input type="text" id="search-input" placeholder="ابحث عن طبق في قائمتك..." 
                       class="w-full bg-surface-container border border-outline-variant rounded-xl py-3 pr-12 pl-10 text-on-surface focus:outline-none focus:border-primary transition-colors">
                <button id="clear-search-btn" onclick="clearSearch()" class="hidden absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-primary">
                    <span class="material-symbols-outlined">cancel</span>
                </button>
            </div>
        </section>

        <!-- Dynamic Error Alert Box -->
        <div id="error-alert" class="hidden fixed top-5 left-1/2 -translate-x-1/2 z-[9999] w-[90%] max-w-md p-4 bg-red-100 border border-red-400 text-red-700 text-center rounded-xl shadow-2xl flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-xl">error</span>
            <p id="error-message-text" class="text-base font-semibold">حدث خطأ</p>
        </div>

        <!-- Dishes Grid Container -->
        <section id="dishes-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Loading State -->
            <div class="col-span-full flex flex-col items-center justify-center py-20 gap-4">
                <div class="loader"></div>
                <p class="text-on-surface-variant font-bold">جاري تحميل الأطباق...</p>
            </div>
        </section>

        <!-- Pagination Section -->
        <section id="pagination-container" class="mt-10 flex justify-center items-center gap-2">
            <!-- Dynamic Pagination Buttons -->
        </section>

    </main>

    <!-- Create / Edit Dish Modal -->
    <div id="dish-modal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-surface rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-surface-variant my-8 max-h-[90vh] overflow-y-auto">
            
            <div class="flex items-center justify-between border-b border-outline-variant pb-4 mb-6">
                <h3 id="modal-title" class="text-xl font-bold text-primary">إضافة طبق جديد</h3>
                <button onclick="closeModal()" class="text-on-surface-variant hover:text-primary transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Dish Form -->
            <form id="dish-form" onsubmit="handleFormSubmit(event)" class="space-y-4">
                
                <!-- Kitchen Selection -->
                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">المطبخ التابع له *</label>
                    <select id="dish-kitchen-id" required class="w-full bg-surface-container border border-outline-variant rounded-xl p-3 text-on-surface focus:outline-none focus:border-primary">
                        <option value="">جاري تحميل المطابخ...</option>
                    </select>
                </div>

                <!-- Dish Name -->
                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">اسم الطبق *</label>
                    <input type="text" id="dish-name" required placeholder="مثال: طاجن لحم بالبرقوق" 
                           class="w-full bg-surface-container border border-outline-variant rounded-xl p-3 text-on-surface focus:outline-none focus:border-primary">
                </div>

                <!-- Price & Category -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-bold text-on-surface mb-1">السعر (ج.م) *</label>
                        <input type="number" step="0.01" min="0" id="dish-price" required placeholder="مثال: 150" 
                               class="w-full bg-surface-container border border-outline-variant rounded-xl p-3 text-on-surface focus:outline-none focus:border-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-on-surface mb-1">التصنيف *</label>
                        <select id="dish-category" required class="w-full bg-surface-container border border-outline-variant rounded-xl p-3 text-on-surface focus:outline-none focus:border-primary">
                            <option value="">جاري تحميل التصنيفات...</option>
                        </select>
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">وصف الطبق</label>
                    <textarea id="dish-description" rows="3" placeholder="اكتب وصفاً شهياً للطبق..." 
                              class="w-full bg-surface-container border border-outline-variant rounded-xl p-3 text-on-surface focus:outline-none focus:border-primary"></textarea>
                </div>

                <!-- Ingredients Tag Management -->
                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">المكونات</label>
                    <div class="flex gap-2 mb-2">
                        <input type="text" id="ingredient-input" placeholder="أضف مكوناً واضغط إضافة أو Enter" 
                               class="flex-grow bg-surface-container border border-outline-variant rounded-xl p-3 text-on-surface focus:outline-none focus:border-primary">
                        <button type="button" onclick="addIngredientFromInput()" class="bg-secondary-container hover:bg-secondary text-white font-bold px-4 py-2 rounded-xl transition-all">
                            إضافة
                        </button>
                    </div>
                    <!-- Ingredients Pills Container -->
                    <div id="ingredients-pills-container" class="flex flex-wrap gap-2 pt-1"></div>
                </div>

                <!-- Image Upload & Preview -->
                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">صورة الطبق (اختياري)</label>
                    <input type="file" id="dish-image-file" accept="image/*" onchange="previewImage(event)" 
                           class="w-full bg-surface-container border border-outline-variant rounded-xl p-2 text-on-surface text-sm">
                    <div id="image-preview-box" class="mt-3 hidden">
                        <img id="image-preview" src="" alt="معاينة الصورة" class="w-full h-40 object-cover rounded-xl border border-outline-variant">
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center justify-between gap-3 pt-4 border-t border-outline-variant mt-6">
                    <button type="button" id="delete-dish-btn" onclick="deleteCurrentDish()" class="hidden bg-error text-white font-bold px-4 py-2.5 rounded-xl hover:bg-red-700 transition-all flex items-center gap-1">
                        <span class="material-symbols-outlined">delete</span>
                        <span>حذف</span>
                    </button>
                    
                    <div class="flex items-center gap-2 mr-auto">
                        <button type="button" onclick="closeModal()" class="px-5 py-2.5 rounded-xl border border-outline text-on-surface hover:bg-surface-container transition-all">
                            إلغاء
                        </button>
                        <button type="submit" id="save-dish-btn" class="bg-primary hover:bg-primary-container text-white font-bold px-6 py-2.5 rounded-xl transition-all flex items-center gap-2">
                            <span>حفظ الطبق</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Client-side Logic Script -->
    <script>
        // State Management
        let currentPage = 1;
        let searchQuery = '';
        let currentDishId = null;
        let ingredientsList = [];
        
        // عند تحميل الصفحة
        document.addEventListener('DOMContentLoaded', async () => {
            // جلب البيانات الأساسية بالتوازي
            await Promise.all([
                loadKitchens(),
                loadCategories()
            ]);
            // جلب الأطباق
            await fetchDishes(1, '');

            // إعداد البحث (Debounce)
            let searchTimeout = null;
            document.getElementById('search-input').addEventListener('input', (e) => {
                const query = e.target.value.trim();
                document.getElementById('clear-search-btn').classList.toggle('hidden', query === '');
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    searchQuery = query;
                    fetchDishes(1, searchQuery);
                }, 400);
            });

            // منع إرسال الفورم عند الضغط على Enter في حقل المكونات
            document.getElementById('ingredient-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addIngredientFromInput();
                }
            });
        });

        // ==========================================
        // UI Helpers
        // ==========================================
        function showError(msg) {
            const errorBox = document.getElementById('error-alert');
            document.getElementById('error-message-text').textContent = msg || 'حدث خطأ غير متوقع';
            errorBox.classList.remove('hidden');
        }

        function hideError() {
            document.getElementById('error-alert').classList.add('hidden');
        }

        function toggleLoading(btnId, isLoading, text = 'حفظ الطبق') {
            const btn = document.getElementById(btnId);
            if (!btn) return;
            if (isLoading) {
                btn.disabled = true;
                btn.innerHTML = `<div class="loader w-4 h-4 border-2"></div> <span>جاري العمل...</span>`;
                btn.classList.add('opacity-70', 'cursor-not-allowed');
            } else {
                btn.disabled = false;
                btn.innerHTML = text;
                btn.classList.remove('opacity-70', 'cursor-not-allowed');
            }
        }

        // ==========================================
        // API Fetchers (Dependencies)
        // ==========================================
        
        // 1. جلب المطابخ الخاصة بالشيف
        async function loadKitchens() {
            try {
                const response = await fetch('/kitchens/api/v1/my'); 
                const data = await response.json();
                const select = document.getElementById('dish-kitchen-id');
                select.innerHTML = '';

                if (response.ok && data.status === 'success' && data.data) {
                    let kitchens = Array.isArray(data.data) ? data.data : [data.data];
                    
                    if (kitchens.length > 0) {
                        kitchens.forEach(k => {
                            select.innerHTML += `<option value="${k.id}">${k.title || k.name}</option>`;
                        });
                        document.getElementById('header-kitchen-name').textContent = kitchens[0].title || kitchens[0].name || 'مطبخي';
                    } else {
                        select.innerHTML = '<option value="">لا توجد مطابخ متاحة (يجب إنشاء مطبخ أولاً)</option>';
                        document.getElementById('header-kitchen-name').textContent = 'لا يوجد مطبخ';
                    }
                } else {
                    select.innerHTML = '<option value="">لا توجد مطابخ متاحة</option>';
                    document.getElementById('header-kitchen-name').textContent = 'لا يوجد مطبخ';
                }
            } catch (err) {
                console.error("خطأ في تحميل المطابخ:", err);
                document.getElementById('dish-kitchen-id').innerHTML = '<option value="">فشل تحميل المطابخ</option>';
            }
        }

        // 2. جلب التصنيفات
        async function loadCategories() {
            try {
                const response = await fetch('/categories/all');
                const data = await response.json();
                const select = document.getElementById('dish-category');
                select.innerHTML = '<option value="">اختر التصنيف...</option>';
                
                if (response.ok && data.status === 'success' && data.data) {
                    const categories = Array.isArray(data.data) ? data.data : [data.data];
                    categories.forEach(cat => {
                        select.innerHTML += `<option value="${cat.id}">${cat.name}</option>`;
                    });
                }
            } catch (err) {
                console.error("خطأ في تحميل التصنيفات:", err);
            }
        }

        // ==========================================
        // Dishes Core Logic
        // ==========================================

        async function fetchDishes(page = 1, q = '') {
            hideError();
            currentPage = page;
            const container = document.getElementById('dishes-container');
            
            container.innerHTML = `
                <div class="col-span-full flex flex-col items-center justify-center py-20 gap-4">
                    <div class="loader"></div>
                    <p class="text-on-surface-variant font-bold">جاري تحميل بيانات الأطباق...</p>
                </div>`;

            try {
                const url = `/dishes/v1/api/my?page=${page}&limit=12&q=${encodeURIComponent(q)}`;
                const response = await fetch(url);
                const result = await response.json();

                if (!response.ok || result.status === 'error') {
                    throw new Error(result.message || 'حدث خطأ أثناء جلب الأطباق');
                }

                const dishes = Array.isArray(result.data) ? result.data : (result.data ? [result.data] : []);
                const pagination = result.pagination || { page: 1, limit: 12, total: dishes.length, total_pages: 1 };

                document.getElementById('meal-counter').textContent = `${pagination.total || dishes.length} أطباق متاحة`;

                renderDishesGrid(dishes);
                renderPagination(pagination);

            } catch (error) {
                container.innerHTML = '';
                document.getElementById('pagination-container').innerHTML = '';
                showError(error.message);
            }
        }

        function renderDishesGrid(dishes) {
            const container = document.getElementById('dishes-container');
            
            if (!dishes || dishes.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full text-center py-16 bg-surface-container/50 rounded-2xl border border-dashed border-outline-variant">
                        <span class="material-symbols-outlined text-5xl text-outline mb-2">restaurant_menu</span>
                        <p class="text-xl font-bold text-on-surface mb-2">لا توجد أطباق هنا!</p>
                        <p class="text-sm text-on-surface-variant mb-6">قم بإضافة أول طبق لك ليبدأ العملاء في الطلب.</p>
                        <button onclick="openCreateModal()" class="bg-primary text-white font-bold px-6 py-2.5 rounded-xl shadow-sm hover:bg-primary-container transition-all">
                            إضافة طبق جديد
                        </button>
                    </div>
                `;
                return;
            }

            container.innerHTML = dishes.map(dish => {
                const imageSrc = dish.image_url ? dish.image_url : 'https://placehold.co/600x400/ffe9e6/9e2016?text=بدون+صورة';
                const dishJson = JSON.stringify(dish).replace(/"/g, '&quot;');
                
                return `
                    <div class="meal-card bg-surface rounded-2xl overflow-hidden shadow-sm flex flex-col border border-surface-variant">
                        <div class="relative h-56 bg-surface-container group">
                            <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="${imageSrc}" alt="${dish.name}">
                            <div class="absolute top-3 left-3 bg-primary text-white px-3 py-1 rounded-xl font-bold text-sm shadow-md">
                                ${dish.price} ج.م
                            </div>
                        </div>
                        <div class="p-5 flex flex-col flex-grow">
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="text-lg font-bold text-on-surface">${dish.name}</h3>
                                ${dish.category_name ? `<span class="text-xs bg-surface-container text-primary font-bold px-2.5 py-1 rounded-lg">${dish.category_name}</span>` : ''}
                            </div>
                            <p class="text-on-surface-variant text-sm mb-4 flex-grow line-clamp-2 leading-relaxed">
                                ${dish.description || 'لا يوجد وصف محدد.'}
                            </p>
                            <button onclick="openEditModal(${dishJson})" 
                                    class="w-full bg-secondary-container hover:bg-secondary text-white py-2.5 rounded-xl font-bold transition-all flex items-center justify-center gap-1">
                                <span>تعديل التفاصيل</span>
                                <span class="material-symbols-outlined text-[18px]">edit</span>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderPagination(pagination) {
            const container = document.getElementById('pagination-container');
            const { page, total_pages } = pagination;

            if (!total_pages || total_pages <= 1) {
                container.innerHTML = '';
                return;
            }

            let html = `
                <button onclick="fetchDishes(${page - 1}, searchQuery)" ${page <= 1 ? 'disabled class="opacity-50 cursor-not-allowed px-3 py-2 border border-outline-variant rounded-xl text-sm"' : 'class="px-3 py-2 border border-outline-variant hover:bg-surface-container rounded-xl text-sm font-bold transition-colors"'}>
                    السابق
                </button>
            `;

            for (let i = 1; i <= total_pages; i++) {
                if (i === page) {
                    html += `<button class="px-4 py-2 bg-primary text-white font-bold rounded-xl text-sm shadow-sm">${i}</button>`;
                } else {
                    html += `<button onclick="fetchDishes(${i}, searchQuery)" class="px-4 py-2 border border-outline-variant hover:bg-surface-container rounded-xl text-sm transition-colors">${i}</button>`;
                }
            }

            html += `
                <button onclick="fetchDishes(${page + 1}, searchQuery)" ${page >= total_pages ? 'disabled class="opacity-50 cursor-not-allowed px-3 py-2 border border-outline-variant rounded-xl text-sm"' : 'class="px-3 py-2 border border-outline-variant hover:bg-surface-container rounded-xl text-sm font-bold transition-colors"'}>
                    التالي
                </button>
            `;

            container.innerHTML = html;
        }

        // ==========================================
        // Modal & Form Handling
        // ==========================================

        function clearSearch() {
            document.getElementById('search-input').value = '';
            document.getElementById('clear-search-btn').classList.add('hidden');
            searchQuery = '';
            fetchDishes(1, '');
        }

        // --- المكونات (Ingredients) ---
        function addIngredientFromInput() {
            const input = document.getElementById('ingredient-input');
            const val = input.value.trim();
            if (val && !ingredientsList.includes(val)) {
                ingredientsList.push(val);
                renderIngredientsPills();
                input.value = '';
            }
        }

        function removeIngredient(index) {
            ingredientsList.splice(index, 1);
            renderIngredientsPills();
        }

        function renderIngredientsPills() {
            const container = document.getElementById('ingredients-pills-container');
            container.innerHTML = ingredientsList.map((ing, idx) => `
                <span class="inline-flex items-center gap-1 bg-surface-container border border-outline-variant text-on-surface px-3 py-1 rounded-full text-sm font-bold">
                    ${ing}
                    <button type="button" onclick="removeIngredient(${idx})" class="hover:text-error mt-0.5">
                        <span class="material-symbols-outlined text-[16px]">close</span>
                    </button>
                </span>
            `).join('');
        }

        // --- الصور ---
        function previewImage(e) {
            const file = e.target.files[0];
            const box = document.getElementById('image-preview-box');
            const img = document.getElementById('image-preview');
            if (file) {
                const reader = new FileReader();
                reader.onload = (event) => {
                    img.src = event.target.result;
                    box.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            } else {
                box.classList.add('hidden');
            }
        }

        // --- فتح وإغلاق النافذة (Modal) ---
        function openCreateModal() {
            currentDishId = null;
            document.getElementById('modal-title').textContent = 'إضافة طبق جديد';
            document.getElementById('dish-form').reset();
            document.getElementById('delete-dish-btn').classList.add('hidden');
            document.getElementById('image-preview-box').classList.add('hidden');
            
            ingredientsList = [];
            renderIngredientsPills();
            
            document.getElementById('dish-modal').classList.remove('hidden');
        }

        function openEditModal(dish) {
            currentDishId = dish.id;
            document.getElementById('modal-title').textContent = 'تعديل بيانات الطبق';
            
            document.getElementById('dish-name').value = dish.name || '';
            document.getElementById('dish-price').value = dish.price || '';
            document.getElementById('dish-category').value = dish.category_id || '';
            document.getElementById('dish-description').value = dish.description || '';
            document.getElementById('dish-image-file').value = '';
            
            if (dish.kitchen_id) {
                document.getElementById('dish-kitchen-id').value = dish.kitchen_id;
            }

            if (dish.ingredients) {
                ingredientsList = Array.isArray(dish.ingredients) 
                    ? dish.ingredients 
                    : dish.ingredients.split(',').map(s => s.trim()).filter(Boolean);
            } else {
                ingredientsList = [];
            }
            renderIngredientsPills();

            const previewBox = document.getElementById('image-preview-box');
            const previewImg = document.getElementById('image-preview');
            if (dish.image_url) {
                previewImg.src = dish.image_url;
                previewBox.classList.remove('hidden');
            } else {
                previewBox.classList.add('hidden');
            }

            document.getElementById('delete-dish-btn').classList.remove('hidden');
            document.getElementById('dish-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('dish-modal').classList.add('hidden');
            hideError();
        }

        // ==========================================
        // Submit Logic (Create / Update / Upload)
        // ==========================================

        async function handleFormSubmit(e) {
            e.preventDefault();
            hideError();
            toggleLoading('save-dish-btn', true);

            const name = document.getElementById('dish-name').value.trim();
            const price = parseFloat(document.getElementById('dish-price').value);
            const category_id = parseInt(document.getElementById('dish-category').value);
            const description = document.getElementById('dish-description').value.trim();
            const kitchen_id = parseInt(document.getElementById('dish-kitchen-id').value);
            const ingredients = ingredientsList.join(',');

            const payload = { name, price, category_id, description, kitchen_id, ingredients };

            try {
                let dishId = currentDishId;

                if (currentDishId) {
                    const res = await fetch(`/dishes/v1/api/${currentDishId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (!res.ok || data.status === 'error') throw new Error(data.message || 'فشل في تحديث بيانات الطبق');
                } else {
                    const res = await fetch('/dishes/v1/api/', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (!res.ok || data.status === 'error') throw new Error(data.message || 'فشل في إضافة الطبق');
                    dishId = data.data.id;
                }

                const imageFileInput = document.getElementById('dish-image-file');
                if (imageFileInput.files.length > 0 && dishId) {
                    const formData = new FormData();
                    formData.append('image', imageFileInput.files[0]);

                    const imgRes = await fetch(`/dishes/v1/api/${dishId}/upload_image`, {
                        method: 'POST',
                        body: formData
                    });
                    const imgData = await imgRes.json();
                    if (!imgRes.ok || imgData.status === 'error') throw new Error(imgData.message || 'تم حفظ البيانات لكن فشل رفع الصورة');
                }

                closeModal();
                await fetchDishes(currentPage, searchQuery);

            } catch (err) {
                showError(err.message);
            } finally {
                toggleLoading('save-dish-btn', false, '<span>حفظ الطبق</span>');
            }
        }

        // ==========================================
        // Delete Logic
        // ==========================================
        async function deleteCurrentDish() {
            if (!currentDishId) return;
            if (!confirm('هل أنت متأكد من رغبتك في حذف هذا الطبق نهائياً؟')) return;

            hideError();
            toggleLoading('delete-dish-btn', true, 'جاري الحذف');

            try {
                const res = await fetch(`/dishes/v1/api/my/${currentDishId}`, {
                    method: 'DELETE'
                });
                const data = await res.json();

                if (!res.ok || data.status === 'error') {
                    throw new Error(data.message || 'فشل في حذف الطبق');
                }

                closeModal();
                await fetchDishes(1, searchQuery);

            } catch (err) {
                showError(err.message);
            } finally {
                toggleLoading('delete-dish-btn', false, `<span class="material-symbols-outlined">delete</span><span>حذف</span>`);
            }
        }
    </script>
</body>
</html>