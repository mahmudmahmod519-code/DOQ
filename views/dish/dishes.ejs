<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>دوق - جميع الأطباق</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-secondary-container": "#5c2000",
                        "on-tertiary": "#ffffff",
                        "tertiary-fixed": "#c0e8ff",
                        "on-surface-variant": "#59413d",
                        "primary-container": "#c0392b",
                        "surface-container-low": "#fff0ee",
                        "outline-variant": "#e1bfb9",
                        "background": "#fff8f6",
                        "primary": "#9e2016",
                        "on-background": "#261816",
                        "inverse-primary": "#ffb4a9",
                        "error": "#ba1a1a",
                        "on-secondary-fixed-variant": "#7c2e00",
                        "secondary-fixed": "#ffdbcd",
                        "on-secondary-fixed": "#351000",
                        "tertiary": "#005875",
                        "inverse-surface": "#3c2d2a",
                        "surface-container-lowest": "#ffffff",
                        "on-error": "#ffffff",
                        "surface-dim": "#eed4d1",
                        "on-primary-fixed-variant": "#8e130c",
                        "surface": "#fff8f6",
                        "secondary-fixed-dim": "#ffb595",
                        "error-container": "#ffdad6",
                        "surface-container-high": "#fce2de",
                        "outline": "#8d706c",
                        "surface-variant": "#f7ddd9",
                        "on-error-container": "#93000a",
                        "on-secondary": "#ffffff",
                        "surface-bright": "#fff8f6",
                        "tertiary-fixed-dim": "#80d0f8",
                        "on-tertiary-container": "#d3eeff",
                        "primary-fixed-dim": "#ffb4a9",
                        "surface-container-highest": "#f7ddd9",
                        "on-primary-container": "#ffe5e1",
                        "inverse-on-surface": "#ffedea",
                        "primary-fixed": "#ffdad5",
                        "on-tertiary-fixed": "#001e2b",
                        "surface-container": "#ffe9e6",
                        "surface-tint": "#b02d21",
                        "secondary-container": "#fc7127",
                        "on-primary": "#ffffff",
                        "on-primary-fixed": "#410000",
                        "on-surface": "#261816",
                        "tertiary-container": "#007296",
                        "on-tertiary-fixed-variant": "#004d66",
                        "secondary": "#a23f00"
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    spacing: {
                        "container-max": "1280px",
                        "xl": "80px",
                        "xs": "4px",
                        "md": "24px",
                        "gutter": "24px",
                        "sm": "12px",
                        "lg": "48px",
                        "base": "8px"
                    },
                    fontFamily: {
                        "body-md": ["Tajawal", "sans-serif"],
                        "display-lg": ["Tajawal", "sans-serif"],
                        "body-lg": ["Tajawal", "sans-serif"],
                        "display-lg-mobile": ["Tajawal", "sans-serif"],
                        "headline-md": ["Tajawal", "sans-serif"],
                        "label-sm": ["Tajawal", "sans-serif"]
                    },
                    fontSize: {
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "display-lg": ["48px", { lineHeight: "60px", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
                        "display-lg-mobile": ["32px", { lineHeight: "40px", fontWeight: "700" }],
                        "headline-md": ["24px", { lineHeight: "32px", fontWeight: "600" }],
                        "label-sm": ["14px", { lineHeight: "20px", letterSpacing: "0.01em", fontWeight: "500" }]
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Tajawal', sans-serif;
            background-color: #fff8f6;
            overflow-x: hidden;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }
        .hover-lift {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .hover-lift:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(158, 32, 22, 0.1);
        }
        .shimmer {
            background: linear-gradient(90deg, #f7ddd9 25%, #ffe9e6 50%, #f7ddd9 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
        }
        @keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .pagination-disabled {
            opacity: 0.5;
            pointer-events: none;
            cursor: not-allowed;
        }
        .pagination-active {
            background: #9e2016 !important;
            color: white !important;
        }
        .page-btn {
            min-width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            border: 1px solid #e1bfb9;
            color: #59413d;
            padding: 0 10px;
        }
        .page-btn:hover:not(.pagination-disabled) {
            background: #f7ddd9;
        }
        .page-btn.pagination-active {
            background: #9e2016 !important;
            color: white !important;
            border-color: #9e2016 !important;
        }
        .page-btn.pagination-disabled {
            opacity: 0.4;
            pointer-events: none;
            cursor: not-allowed;
        }
        .dish-card {
            width: 100%;
        }
        .dish-card .dish-image {
            height: 180px;
        }
        @media (min-width: 640px) {
            .dish-card .dish-image {
                height: 200px;
            }
        }
        @media (min-width: 768px) {
            .dish-card .dish-image {
                height: 220px;
            }
        }
    </style>
</head>
<body class="bg-background text-on-background antialiased flex flex-col min-h-screen overflow-x-hidden">

    <!-- TopNavBar -->
    <header class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-md border-b border-outline-variant/20 shadow-sm transition-all duration-300" id="main-header">
        <div class="flex flex-row-reverse justify-between items-center px-4 md:px-6 lg:px-8 py-3 md:py-4 max-w-7xl mx-auto">
            <a class="text-xl md:text-2xl font-bold text-primary hover:scale-105 transition-transform duration-300 active:scale-95" href="/">دوق</a>
            <nav class="hidden md:flex gap-4 lg:gap-6 items-center text-base font-medium">
                <a class="text-on-surface-variant hover:text-primary transition-colors hover:scale-105 transition-transform duration-300" href="/">الرئيسية</a>
                <a class="text-primary border-b-2 border-primary pb-1 hover:scale-105 transition-transform duration-300" href="/dishes">تصفح الأطباق</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors hover:scale-105 transition-transform duration-300" href="/auth">انضم كطباخ</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors hover:scale-105 transition-transform duration-300" href="/about">من نحن</a>
            </nav>
            <div class="flex items-center gap-2 md:gap-3">
                <% if (currentUser) { %>
                    <a href="/logout" class="px-3 md:px-4 py-1.5 md:py-2 bg-error/10 text-error rounded-full text-sm font-medium hover:bg-error/20 transition-all">تسجيل خروج</a>
                <% } else { %>
                    <a class="px-4 md:px-5 py-1.5 md:py-2 bg-primary text-white rounded-full text-sm font-medium hover:bg-primary/90 hover:scale-105 transition-all duration-300 shadow-md active:scale-95" href="/auth">تسجيل الدخول</a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow pt-20 md:pt-24">

        <!-- Hero & Search Section -->
        <section class="relative px-4 py-10 md:py-16 lg:py-20 bg-gradient-to-b from-surface-container to-background mb-8 md:mb-12 overflow-hidden">
            <div class="max-w-6xl mx-auto text-center relative z-10">
                <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-primary mb-4 md:mb-6 drop-shadow-sm leading-tight">🍔 ألذ أكلات الشارع والوجبات البيتي</h1>
                <p class="text-base md:text-lg text-on-surface-variant mb-8 md:mb-10 max-w-2xl mx-auto px-2">ذوق أصل الأكل البيتي وحلاوة أكل الشارع.. لقمة هنية تنسيك الدنيا!</p>
                
                <!-- Search & Filters Bar (بدون Sorting) -->
                <div class="glass-panel p-4 md:p-6 rounded-2xl max-w-4xl mx-auto shadow-lg shadow-primary/5">
                    <div class="flex flex-col md:flex-row gap-4 items-end md:items-center">
                        <div class="w-full md:w-1/3 text-right">
                            <label class="block text-sm md:text-label-sm text-on-surface-variant mb-1.5">بحث</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">search</span>
                                <input class="w-full pl-4 pr-10 py-2.5 rounded-lg border border-outline-variant/40 bg-surface focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-base outline-none" 
                                       placeholder="ابحث عن طبق..." type="text" id="searchInput">
                            </div>
                        </div>
                        <div class="w-full md:w-1/4 text-right">
                            <label class="block text-sm md:text-label-sm text-on-surface-variant mb-1.5">التصنيف</label>
                            <select class="w-full px-4 py-2.5 rounded-lg border border-outline-variant/40 bg-surface focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-base appearance-none outline-none" 
                                    id="categoryFilter">
                                <option value="">الكل</option>
                            </select>
                        </div>
                        <div class="w-full md:w-1/4 flex gap-3 text-right">
                            <div class="w-1/2">
                                <label class="block text-sm md:text-label-sm text-on-surface-variant mb-1.5">من (ج.م)</label>
                                <input class="w-full px-3 py-2.5 rounded-lg border border-outline-variant/40 bg-surface focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-base outline-none" 
                                       placeholder="الحد الأدنى" type="number" id="minPriceInput">
                            </div>
                            <div class="w-1/2">
                                <label class="block text-sm md:text-label-sm text-on-surface-variant mb-1.5">إلى (ج.م)</label>
                                <input class="w-full px-3 py-2.5 rounded-lg border border-outline-variant/40 bg-surface focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-base outline-none" 
                                       placeholder="الحد الأقصى" type="number" id="maxPriceInput">
                            </div>
                        </div>
                    </div>
                    <!-- ✅ تم إزالة Sorting Controls بالكامل -->
                </div>
            </div>
            <!-- Decorations -->
            <div class="absolute top-0 left-0 w-32 md:w-64 h-32 md:h-64 bg-secondary-fixed/20 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
            <div class="absolute bottom-0 right-0 w-40 md:w-80 h-40 md:h-80 bg-primary-fixed/20 rounded-full blur-3xl translate-x-1/3 translate-y-1/3 pointer-events-none"></div>
        </section>

        <!-- Dishes Grid -->
        <section class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8 mb-16 md:mb-20">
            
            <!-- Results Count & Page Info -->
            <div class="flex justify-between items-center mb-6">
                <span class="text-on-surface-variant text-base font-medium" id="resultsCount">0 طبق</span>
                <span class="text-on-surface-variant text-sm" id="pageInfo">الصفحة 1</span>
            </div>

            <!-- Loading -->
            <div id="loadingState" class="flex justify-center items-center py-16 md:py-20 hidden">
                <div class="flex flex-col items-center gap-3">
                    <div class="w-10 h-10 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                    <span class="text-on-surface-variant font-medium">جاري تحميل الأطباق...</span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" id="dishesGrid"></div>

            <!-- Pagination -->
            <div class="mt-12 md:mt-16 flex justify-center items-center gap-2 flex-wrap" id="paginationArea">
                <button class="page-btn" id="prevPageBtn">
                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                </button>
                <div class="flex items-center gap-1 md:gap-2 flex-wrap" id="pageNumbers"></div>
                <button class="page-btn" id="nextPageBtn">
                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                </button>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="w-full mt-8 md:mt-12 bg-surface-container-lowest border-t border-outline-variant">
        <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8 py-8 md:py-12 flex flex-col md:flex-row-reverse justify-between items-center gap-6 text-sm md:text-base">
            <div class="text-xl md:text-2xl font-bold text-primary">دوق</div>
            <div class="text-on-surface-variant text-center md:text-right">© 2026 دوق. جميع الحقوق محفوظة. فن التذوق في كل لقمة.</div>
            <nav class="flex flex-wrap justify-center md:justify-start gap-4 md:gap-6">
                <a class="text-on-surface-variant hover:text-secondary hover:underline transition-all" href="#">الشروط والأحكام</a>
                <a class="text-on-surface-variant hover:text-secondary hover:underline transition-all" href="#">سياسة الخصوصية</a>
                <a class="text-on-surface-variant hover:text-secondary hover:underline transition-all" href="/contact">اتصل بنا</a>
                <a class="text-on-surface-variant hover:text-secondary hover:underline transition-all" href="/faqs">الأسئلة الشائعة</a>
            </nav>
        </div>
    </footer>

    <script>
        // ============================================
        // State
        // ============================================
        let currentPage = 1;
        let totalPages = 1;
        let totalItems = 0;
        let isLoading = false;
        let currentFilters = {
            q: '',
            category: '',
            min_price: '',
            max_price: '',
            sort_by: 'created_at',   // ✅ ثابت
            sort_order: 'DESC'       // ✅ ثابت
        };

        // ============================================
        // DOM References
        // ============================================
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const minPriceInput = document.getElementById('minPriceInput');
        const maxPriceInput = document.getElementById('maxPriceInput');
        const grid = document.getElementById('dishesGrid');
        const loadingState = document.getElementById('loadingState');
        const resultsCount = document.getElementById('resultsCount');
        const pageInfo = document.getElementById('pageInfo');
        const pageNumbers = document.getElementById('pageNumbers');
        const prevPageBtn = document.getElementById('prevPageBtn');
        const nextPageBtn = document.getElementById('nextPageBtn');

        // ============================================
        // جلب التصنيفات
        // ============================================
        async function fetchCategories() {
            try {
                const res = await fetch('/categories/all');
                const data = await res.json();
                if (data.status === 'success' && data.data.length) {
                    const html = ['<option value="">الكل</option>'];
                    data.data.forEach(cat => {
                        if (cat.dishes_count > 0) {
                            html.push(`<option value="${encodeURIComponent(cat.name)}">${cat.name}</option>`);
                        }
                    });
                    categoryFilter.innerHTML = html.join('');
                }
            } catch (e) {
                console.error('Error fetching categories:', e);
            }
        }

        // ============================================
        // جلب الأطباق
        // ============================================
        async function fetchDishes(page = 1) {
            if (isLoading) return;
            isLoading = true;
            loadingState.classList.remove('hidden');
            grid.innerHTML = '';

            // Build query params
            let params = new URLSearchParams();
            params.append('page', page);
            params.append('limit', 10);
            
            // Filters
            if (currentFilters.q) params.append('q', currentFilters.q);
            if (currentFilters.category) params.append('category', currentFilters.category);
            if (currentFilters.min_price !== '') params.append('min_price', currentFilters.min_price);
            if (currentFilters.max_price !== '') params.append('max_price', currentFilters.max_price);
            // ✅ sort_by و sort_order ثابتين
            params.append('sort_by', currentFilters.sort_by);
            params.append('sort_order', currentFilters.sort_order);

            try {
                const res = await fetch('/dishes/v1/api?' + params.toString());
                const data = await res.json();
                if (data.status === 'success') {
                    const dishes = data.data || [];
                    const pagination = data.pagination || { page: 1, limit: 10, total: 0, total_pages: 1 };
                    
                    currentPage = pagination.page;
                    totalPages = pagination.total_pages;
                    totalItems = pagination.total;

                    updateUI(dishes);
                    renderPagination();
                } else {
                    showError(data.message || 'حدث خطأ أثناء التحميل');
                }
            } catch (err) {
                showError('حدث خطأ في الاتصال بالخادم');
                console.error(err);
            } finally {
                loadingState.classList.add('hidden');
                isLoading = false;
            }
        }

        // ============================================
        // تحديث الواجهة
        // ============================================
        function updateUI(dishes) {
            resultsCount.textContent = `${totalItems} طبق`;
            pageInfo.textContent = `الصفحة ${currentPage}`;

            if (dishes.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full flex flex-col items-center justify-center py-12 md:py-20 text-center">
                        <span class="material-symbols-outlined text-5xl md:text-6xl text-outline-variant mb-4">inbox</span>
                        <h3 class="text-xl md:text-headline-md font-bold text-on-background mb-2">لا توجد أطباق</h3>
                        <p class="text-on-surface-variant text-sm md:font-body-md max-w-md px-4">عذراً، لم نتمكن من العثور على أطباق تطابق بحثك. جرب تغيير كلمات البحث أو الفلاتر.</p>
                    </div>
                `;
                return;
            }

            let html = '';
            dishes.forEach(dish => {
                const imageUrl = dish.image_url || 'https://images.unsplash.com/photo-1547928576-a4a33237eceb?auto=format&fit=crop&w=600&q=80';
                const price = dish.price || 0;
                const categoryName = dish.category_name || 'غير مصنف';
                const kitchenTitle = dish.kitchen_title || 'مطبخ';
                html += `
                    <article class="dish-card bg-surface-container-lowest rounded-xl overflow-hidden hover-lift border border-outline-variant/30 group shadow-sm hover:shadow-md transition-shadow">
                        <div class="relative w-full overflow-hidden dish-image">
                            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="${imageUrl}" alt="${dish.name}">
                            <div class="absolute top-3 left-3 bg-surface-container-lowest/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-primary border border-primary/20 shadow-sm">${categoryName}</div>
                        </div>
                        <div class="p-4 md:p-5 flex flex-col gap-3">
                            <div class="flex justify-between items-start gap-2">
                                <h3 class="font-bold text-lg md:text-[20px] text-on-background line-clamp-1">${dish.name}</h3>
                                <span class="font-bold text-secondary text-base md:text-lg whitespace-nowrap">${price} ج.م</span>
                            </div>
                            <div class="flex items-center gap-2 text-on-surface-variant mb-3 md:mb-4">
                                <span class="material-symbols-outlined text-[16px] md:text-[18px]">restaurant</span>
                                <span class="text-sm md:font-label-sm">${kitchenTitle}</span>
                            </div>
                            <a href="/dishes/${dish.id}" class="mt-auto w-full py-2.5 md:py-3 bg-primary text-on-primary rounded-lg text-sm md:font-label-sm hover:bg-primary/90 transition-colors flex items-center justify-center gap-2 group/btn">
                                عرض التفاصيل
                                <span class="material-symbols-outlined text-[16px] md:text-[18px] group-hover/btn:-translate-x-1 transition-transform">arrow_back</span>
                            </a>
                        </div>
                    </article>
                `;
            });
            grid.innerHTML = html;
        }

        // ============================================
        // عرض أزرار الصفحات
        // ============================================
        function renderPagination() {
            prevPageBtn.classList.toggle('pagination-disabled', currentPage <= 1);
            nextPageBtn.classList.toggle('pagination-disabled', currentPage >= totalPages);

            let html = '';
            const isMobile = window.innerWidth < 640;
            const range = isMobile ? 1 : 2;
            
            const start = Math.max(1, currentPage - range);
            const end = Math.min(totalPages, currentPage + range);

            if (start > 1) {
                html += `<span class="page-btn" data-page="1">1</span>`;
                if (start > 2) html += `<span class="text-on-surface-variant px-1 hidden sm:inline">...</span>`;
            }

            for (let i = start; i <= end; i++) {
                const active = i === currentPage ? 'pagination-active' : '';
                html += `<span class="page-btn ${active}" data-page="${i}">${i}</span>`;
            }

            if (end < totalPages) {
                if (end < totalPages - 1) html += `<span class="text-on-surface-variant px-1 hidden sm:inline">...</span>`;
                html += `<span class="page-btn" data-page="${totalPages}">${totalPages}</span>`;
            }

            pageNumbers.innerHTML = html;

            document.querySelectorAll('#pageNumbers .page-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const page = parseInt(this.dataset.page);
                    if (page && page !== currentPage) fetchDishes(page);
                });
            });
        }

        // ============================================
        // عرض خطأ
        // ============================================
        function showError(msg) {
            grid.innerHTML = `
                <div class="col-span-full flex flex-col items-center justify-center py-12 text-center">
                    <span class="material-symbols-outlined text-5xl md:text-6xl text-error mb-4">error</span>
                    <h3 class="text-xl md:text-headline-md font-bold text-on-background mb-2">حدث خطأ</h3>
                    <p class="text-on-surface-variant text-sm md:font-body-md max-w-md px-4">${msg}</p>
                    <button onclick="fetchDishes(1)" class="mt-4 md:mt-6 px-6 py-2 text-primary border border-primary rounded-lg hover:bg-primary-container hover:text-on-primary-container transition-colors">
                        إعادة المحاولة
                    </button>
                </div>
            `;
        }

        // ============================================
        // تطبيق الفلاتر والبحث
        // ============================================
        function applyFilters() {
            currentFilters.q = searchInput.value.trim();
            currentFilters.category = categoryFilter.value;
            currentFilters.min_price = minPriceInput.value.trim();
            currentFilters.max_price = maxPriceInput.value.trim();
            // ✅ sort_by و sort_order ثابتين، لا حاجة لتحديثهما
            fetchDishes(1);
        }

        // ============================================
        // أحداث البحث والفلاتر
        // ============================================
        searchInput.addEventListener('keypress', e => { if (e.key === 'Enter') applyFilters(); });
        categoryFilter.addEventListener('change', applyFilters);

        let searchTimeout;
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(applyFilters, 500);
        });
        minPriceInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(applyFilters, 500);
        });
        maxPriceInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(applyFilters, 500);
        });

        prevPageBtn.addEventListener('click', function() {
            if (currentPage > 1) fetchDishes(currentPage - 1);
        });
        nextPageBtn.addEventListener('click', function() {
            if (currentPage < totalPages) fetchDishes(currentPage + 1);
        });

        window.addEventListener('resize', () => {
            clearTimeout(window.resizeTimer);
            window.resizeTimer = setTimeout(renderPagination, 200);
        });

        // ============================================
        // تحميل أولي
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            fetchCategories();
            fetchDishes(1);
        });

        window.addEventListener('scroll', function() {
            const header = document.getElementById('main-header');
            if (window.scrollY > 10) {
                header.classList.add('shadow-md');
                header.classList.remove('shadow-sm');
            } else {
                header.classList.remove('shadow-md');
                header.classList.add('shadow-sm');
            }
        });
    </script>

</body>
</html>