<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<script src="/app-client.js"></script>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>إدارة الأطباق | دوق DOQ</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    fontFamily: { sans: ["Cairo", "sans-serif"] },
                    colors: {
                        "primary": "#9e2016",
                        "primary-container": "#c0392b",
                        "on-primary": "#ffffff",
                        "secondary": "#a23f00",
                        "secondary-container": "#fc7127",
                        "on-secondary": "#ffffff",
                        "background": "#fff8f6",
                        "surface": "#fff8f6",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#fff0ee",
                        "surface-container": "#ffe9e6",
                        "surface-container-high": "#fce2de",
                        "on-surface": "#261816",
                        "on-surface-variant": "#59413d",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "outline-variant": "#e1bfb9",
                        "tertiary": "#005875",
                        "tertiary-container": "#007296"
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e1bfb9; border-radius: 10px; }
        .pagination-disabled { opacity: 0.5; pointer-events: none; cursor: not-allowed; }
        .pagination-active { background: #9e2016 !important; color: white !important; border-color: #9e2016 !important; }
        .slide-in-right { animation: slideInRight 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
        @keyframes slideInRight { from { opacity: 0; transform: translateX(100%); } to { opacity: 1; transform: translateX(0); } }
        @keyframes countPulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.08); }
            100% { transform: scale(1); }
        }
        #totalCount > div {
            animation: countPulse 0.4s ease-out;
        }
    </style>
</head>
<body class="bg-background text-on-surface antialiased">

    <%- include('../partials/admin_sidebar', { activePage: 'dishes' }) %>
    <!-- Header -->
    <header class="fixed top-0 right-0 lg:right-72 left-0 h-16 bg-surface/80 backdrop-blur-xl shadow-sm z-40 flex items-center justify-between px-4 md:px-8">
        <div class="flex items-center gap-3 flex-1">
            <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-on-surface text-[24px]">menu</span>
            </button>
            <div class="flex items-center gap-2 text-sm text-on-surface-variant">
                <span class="material-symbols-outlined text-[18px] hidden sm:inline">home</span>
                <span class="hidden sm:inline">/</span>
                <span class="text-on-surface font-semibold">إدارة الأطباق</span>
            </div>
            
            <div class="hidden md:flex items-center gap-2 bg-surface-container-low px-3 py-1.5 rounded-full mr-2">
                <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
                <span class="text-xs text-on-surface-variant">المنصة تعمل بنشاط</span>
            </div>
        </div>
        
        <div class="flex items-center gap-4">
            <div class="w-9 h-9 rounded-full bg-primary flex items-center justify-center text-white font-bold">
                <%= currentUser ? currentUser.first_name.charAt(0).toUpperCase() : 'أ' %>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="pt-20 pb-16 px-4 md:px-8 lg:pr-72 min-h-screen bg-surface transition-all duration-300">
        
        <!-- Page Header -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6 text-center">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-surface-container-high flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[22px]" style="font-variation-settings: 'FILL' 1;">flatware</span>
        </div>
        <div class="text-center">
            <h1 class="text-xl md:text-2xl font-bold text-on-surface">إدارة الأطباق</h1>
            <p class="text-sm text-on-surface-variant" id="totalCount">جاري التحميل...</p>
        </div>
    </div>
</div>

        <!-- Filter & Search Bar -->
        <div class="bg-surface-container-lowest rounded-xl p-4 md:p-5 shadow-sm border border-outline-variant/30 mb-6">
            <div class="flex flex-col md:flex-row gap-4 items-stretch md:items-end">
                <div class="flex-1 w-full">
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">بحث</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline-variant text-[20px]">search</span>
                        <input id="searchInput" type="text" placeholder="ابحث عن اسم الطبق..." 
                               class="w-full pr-10 pl-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium">
                    </div>
                </div>
                <div class="w-full md:w-48">
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">التصنيف</label>
                    <select id="categoryFilter" class="w-full py-2.5 px-4 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium appearance-none">
                        <option value="">الكل</option>
                    </select>
                </div>
                <div class="w-full md:w-48">
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">المطبخ</label>
                    <select id="kitchenFilter" class="w-full py-2.5 px-4 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium appearance-none">
                        <option value="">كل المطابخ</option>
                    </select>
                </div>
                <button id="searchBtn" class="w-full md:w-auto px-6 py-2.5 bg-secondary-container text-on-secondary rounded-xl font-bold hover:bg-secondary hover:text-white transition-all active:scale-95 flex items-center justify-center gap-2 shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">search</span>بحث
                </button>
            </div>
        </div>

        <!-- Loading State -->
        <div id="loadingState" class="flex justify-center items-center py-20 hidden">
            <div class="flex flex-col items-center gap-4">
                <div class="w-10 h-10 border-3 border-primary border-t-transparent rounded-full animate-spin"></div>
                <span class="text-on-surface-variant font-medium">جاري تحميل الأطباق...</span>
            </div>
        </div>

        <!-- Data Table Section -->
        <div id="tableContainer" class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm min-w-[800px]">
                    <thead>
                        <tr class="border-b border-surface-container text-on-surface-variant text-right bg-surface-container-low/50">
                            <th class="p-4 font-bold text-xs whitespace-nowrap text-center">#</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap">الطبق</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap hidden sm:table-cell">المطبخ</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap hidden md:table-cell">التصنيف</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap">السعر</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap hidden lg:table-cell">تاريخ الإضافة</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="dishesTableBody" class="divide-y divide-outline-variant/30">
                        <!-- سيتم تعبئتها بواسطة JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div id="paginationArea" class="px-4 md:px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-outline-variant/30 hidden">
                <span class="text-xs text-on-surface-variant" id="paginationInfo"></span>
                <nav class="flex items-center gap-1 md:gap-2 flex-wrap justify-center" id="paginationNav"></nav>
            </div>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden bg-surface-container-lowest rounded-xl shadow-sm border border-dashed border-outline-variant p-12 flex flex-col items-center justify-center text-center">
            <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-4xl text-outline-variant">search_off</span>
            </div>
            <h3 class="text-lg font-bold text-on-surface mb-2">لا توجد أطباق مطابقة</h3>
            <p class="text-sm text-on-surface-variant max-w-md mb-6">لم نتمكن من العثور على أي أطباق تطابق معايير البحث الحالية.</p>
            <button id="clearFiltersBtn" class="px-6 py-2.5 bg-surface-container text-on-surface rounded-xl font-bold hover:bg-surface-container-high transition-all text-sm">
                مسح المرشحات
            </button>
        </div>

    </main>

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed top-24 left-4 md:left-8 z-[100] flex flex-col gap-3 pointer-events-none"></div>


    <script>
        // ============================================
        // Sidebar Toggle
        // ============================================
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            if (sidebar.classList.contains('translate-x-full')) {
                sidebar.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                sidebar.classList.add('translate-x-full');
                overlay.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        // ============================================
        // State
        // ============================================
        let currentPage = 1;
        let totalPages = 1;
        let totalItems = 0;
        let isLoading = false;
        let dishesData = [];
        let currentFilters = { q: '', category: '', kitchen: '' };
        let categoriesMap = {};
        let kitchensMap = {};

        // ============================================
        // DOM References
        // ============================================
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const kitchenFilter = document.getElementById('kitchenFilter');
        const searchBtn = document.getElementById('searchBtn');
        const tableBody = document.getElementById('dishesTableBody');
        const loadingState = document.getElementById('loadingState');
        const emptyState = document.getElementById('emptyState');
        const tableContainer = document.getElementById('tableContainer');
        const paginationArea = document.getElementById('paginationArea');
        const paginationNav = document.getElementById('paginationNav');
        const totalCount = document.getElementById('totalCount');
        const paginationInfo = document.getElementById('paginationInfo');
        const clearFiltersBtn = document.getElementById('clearFiltersBtn');

        // ============================================
        // Fetch Filters
        // ============================================
        async function loadFilters() {
            try {
                // Categories
                const catRes = await fetch('/categories/api/v1/all'); // تأكد من صحة المسار
                const catData = await catRes.json();
                if (catData.status === 'success' && Array.isArray(catData.data)) {
                    catData.data.forEach(cat => { categoriesMap[cat.id] = cat.name; });
                }
                let catHtml = '<option value="">الكل</option>';
                Object.keys(categoriesMap).forEach(id => { catHtml += `<option value="${id}">${categoriesMap[id]}</option>`; });
                categoryFilter.innerHTML = catHtml;

                // Kitchens
                const kitRes = await fetch('/kitchens/api/v1'); // تأكد من صحة المسار
                const kitData = await kitRes.json();
                if (kitData.status === 'success' && Array.isArray(kitData.data)) {
                    kitData.data.forEach(kit => { kitchensMap[kit.id] = kit.title; });
                }
                let kitHtml = '<option value="">كل المطابخ</option>';
                Object.keys(kitchensMap).forEach(id => { kitHtml += `<option value="${id}">${kitchensMap[id]}</option>`; });
                kitchenFilter.innerHTML = kitHtml;
            } catch (e) {
                console.error('Error loading filters:', e);
            }
        }

        function getCategoryName(id) { return categoriesMap[id] || 'غير مصنف'; }
        function getKitchenTitle(id) { return kitchensMap[id] || 'مطبخ'; }

        // ============================================
        // Fetch Dishes
        // ============================================
        async function fetchDishes(page = 1) {
            if (isLoading) return;
            isLoading = true;
            loadingState.classList.remove('hidden');
            tableContainer.classList.add('hidden');
            emptyState.classList.add('hidden');
            paginationArea.classList.add('hidden');

            const q = currentFilters.q;
            const categoryId = currentFilters.category;
            const kitchenId = currentFilters.kitchen;

            let baseUrl = '/dishes/v1/api/dashboard';
            if (categoryId) baseUrl = `/dishes/v1/api/category/${categoryId}`;
            else if (kitchenId) baseUrl = `/dishes/v1/api/kitchen/${kitchenId}`;

            const params = new URLSearchParams({ page, limit: 10 });
            if (q) params.append('q', q);

            try {
                const res = await fetch(baseUrl + '?' + params.toString());
                const data = await res.json();

                if (data.status === 'success') {
                    let dishes = Array.isArray(data.data) ? data.data : (data.data ? [data.data] : []);
                    const pagination = data.pagination || { page: 1, limit: 10, total: 0, total_pages: 1 };
                    
        // عرض العداد بتصميم احترافي
        const count = pagination.total || 0;

        totalCount.innerHTML = `
            <div class="flex items-center gap-2 flex-wrap">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full 
                            bg-gradient-to-l from-primary to-primary-container 
                            text-white shadow-md shadow-primary/20">
                    <span class="material-symbols-outlined text-[18px]" 
                          style="font-variation-settings: 'FILL' 1;">flatware</span>
                    <span class="text-sm font-extrabold tracking-wide">
                        ${count.toLocaleString('ar-EG')}
                    </span>
                </div>
                <span class="text-xs md:text-sm text-on-surface-variant font-medium">
                    ${count === 1 ? 'طبق متاح في القائمة' : 'أطباق متاحة في القائمة'}
                </span>
            </div>
        `;
                    currentPage = pagination.page;
                    totalPages = pagination.total_pages;
                    totalItems = pagination.total;
                    dishesData = dishes;

                    if (dishes.length === 0) {
                        emptyState.classList.remove('hidden');
                    } else {
                        tableContainer.classList.remove('hidden');
                        renderTable(dishes);
                        renderPagination(pagination);
                    }
                } else {
                    showToast(data.message || 'حدث خطأ أثناء التحميل', 'error');
                }
            } catch (err) {
                showToast('حدث خطأ في الاتصال بالخادم', 'error');
                console.error(err);
            } finally {
                loadingState.classList.add('hidden');
                isLoading = false;
            }
        }

        // ============================================
        // Render Table
        // ============================================
        function renderTable(dishes) {
            let html = '';
            const startIndex = (currentPage - 1) * 10;
            
            dishes.forEach((dish, index) => {
                const num = startIndex + index + 1;
                const imageUrl = DOQ.safeImage(dish.image_url || '/assests/dish_avatar.jpeg');
                const categoryName = dish.category_name || getCategoryName(dish.category_id);
                const kitchenTitle = dish.kitchen_title || getKitchenTitle(dish.kitchen_id);
                const date = dish.created_at ? new Date(dish.created_at).toLocaleDateString('ar-EG') : '';

                html += `
                    <tr class="border-b border-surface-container hover:bg-surface-container-low/60 transition-colors group">
                        <td class="p-4 text-on-surface-variant font-medium text-center">${num}</td>
                        <td class="p-4">
                            <div class="flex items-center gap-3">
                                <img src="${imageUrl}" alt="${DOQ.escape(dish.name || '')}" class="w-12 h-12 rounded-lg object-cover border border-outline-variant/30 group-hover:scale-105 transition-transform">
                                <div>
                                    <div class="font-bold text-on-surface text-sm md:text-base">${DOQ.escape(dish.name || '')}</div>
                                    <div class="text-xs text-on-surface-variant sm:hidden mt-0.5">${DOQ.escape(categoryName)}</div>
                                </div>
                            </div>
                        </td>
                        <td class="p-4 text-on-surface-variant text-sm hidden sm:table-cell">${DOQ.escape(kitchenTitle)}</td>
                        <td class="p-4 hidden md:table-cell">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-tertiary-container/10 text-tertiary">${DOQ.escape(categoryName)}</span>
                        </td>
                        <td class="p-4 font-bold text-primary text-sm">${Number(dish.price || 0).toLocaleString()} ج.م</td>
                        <td class="p-4 text-on-surface-variant text-xs hidden lg:table-cell whitespace-nowrap">${date}</td>
                        <td class="p-4 text-center">
                            <div class="flex items-center justify-center gap-1">
                                <a href="/dishes/${dish.id}" class="w-8 h-8 rounded-lg flex items-center justify-center text-secondary hover:bg-secondary/10 transition-colors" title="عرض">
                                    <span class="material-symbols-outlined text-[20px]">visibility</span>
                                </a>
                                <button onclick="deleteDish(${dish.id})" class="w-8 h-8 rounded-lg flex items-center justify-center text-error hover:bg-error/10 transition-colors" title="حذف">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });
            tableBody.innerHTML = html;
        }

        // ============================================
        // Pagination
        // ============================================
        function renderPagination(pagination) {
            if (pagination.total_pages <= 1) {
                paginationArea.classList.add('hidden');
                return;
            }
            paginationArea.classList.remove('hidden');
            
            const start = ((pagination.page - 1) * pagination.limit) + 1;
            const end = Math.min(pagination.page * pagination.limit, pagination.total);
            paginationInfo.textContent = `عرض ${start} إلى ${end} من أصل ${pagination.total} طبق`;

            let html = '';
            if (pagination.page > 1) {
                html += `<button onclick="goToPage(${pagination.page - 1})" class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant text-xs font-bold hover:bg-white transition-all">السابق</button>`;
            }
            
            for (let i = 1; i <= pagination.total_pages; i++) {
                if (i === pagination.page) {
                    html += `<span class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary text-white text-xs font-bold">${i}</span>`;
                } else if (i === 1 || i === pagination.total_pages || (i >= pagination.page - 1 && i <= pagination.page + 1)) {
                    html += `<button onclick="goToPage(${i})" class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant text-xs font-bold hover:bg-white transition-all">${i}</button>`;
                } else if (i === pagination.page - 2 || i === pagination.page + 2) {
                    html += `<span class="text-xs text-on-surface-variant px-1">...</span>`;
                }
            }

            if (pagination.page < pagination.total_pages) {
                html += `<button onclick="goToPage(${pagination.page + 1})" class="w-8 h-8 flex items-center justify-center rounded-lg border border-outline-variant text-xs font-bold hover:bg-white transition-all">التالي</button>`;
            }
            paginationNav.innerHTML = html;
        }

        function goToPage(page) {
            if (page < 1 || page > totalPages || page === currentPage) return;
            fetchDishes(page);
        }

        // ============================================
        // Delete Dish
        // ============================================
        async function deleteDish(id) {
            if (!confirm('هل أنت متأكد من حذف هذا الطبق؟ لا يمكن التراجع عن هذا الإجراء.')) return;

            try {
                const res = await fetch(`/dishes/v1/api/${id}`, { method: 'DELETE' });
                const data = await res.json();

                if (data.status === 'success') {
                    showToast('✅ تم حذف الطبق بنجاح', 'success');
                    fetchDishes(currentPage);
                } else {
                    showToast('❌ ' + (data.message || 'حدث خطأ أثناء الحذف'), 'error');
                }
            } catch (err) {
                showToast('❌ حدث خطأ في الاتصال بالخادم', 'error');
                console.error(err);
            }
        }

        // ============================================
        // Toast Notification
        // ============================================
        function showToast(message, type) {
            type = type || 'success';
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            const theme = type === 'success' 
                ? 'bg-surface-container-lowest border-r-4 border-[#15803d] text-on-surface' 
                : 'bg-surface-container-lowest border-r-4 border-error text-on-surface';
            const iconColor = type === 'success' ? 'text-[#15803d]' : 'text-error';
            const icon = type === 'success' ? 'check_circle' : 'error';

            toast.className = theme + ' px-4 py-3 rounded-xl shadow-lg flex items-center gap-3 slide-in-right border border-outline-variant/30 pointer-events-auto';
            toast.innerHTML = `
                <span class="material-symbols-outlined text-xl ${iconColor}" style="font-variation-settings: 'FILL' 1;">${icon}</span>
                <span class="font-bold text-sm">${message}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                toast.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
                setTimeout(() => { if(toast.parentElement) toast.remove(); }, 400);
            }, 4000);
        }

        // ============================================
        // Event Listeners
        // ============================================
        function applyFilters() {
            currentFilters.q = searchInput.value.trim();
            currentFilters.category = categoryFilter.value;
            currentFilters.kitchen = kitchenFilter.value;
            fetchDishes(1);
        }

        searchBtn.addEventListener('click', applyFilters);
        searchInput.addEventListener('keypress', e => { if (e.key === 'Enter') applyFilters(); });
        categoryFilter.addEventListener('change', applyFilters);
        kitchenFilter.addEventListener('change', applyFilters);

        clearFiltersBtn.addEventListener('click', function() {
            searchInput.value = '';
            categoryFilter.value = '';
            kitchenFilter.value = '';
            applyFilters();
        });

        // ============================================
        // Initialization
        // ============================================
        document.addEventListener('DOMContentLoaded', async function() {
            await loadFilters();
            fetchDishes(1);
        });
    </script>
</body>
</html>
