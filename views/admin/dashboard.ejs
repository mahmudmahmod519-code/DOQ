<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<script src="/app-client.js"></script>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>لوحة التحكم | دوق DOQ</title>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#9e2016",
            "primary-container": "#c0392b",
            "on-primary": "#ffffff",
            "on-primary-container": "#ffe5e1",
            "secondary": "#a23f00",
            "secondary-container": "#fc7127",
            "on-secondary": "#ffffff",
            "background": "#fff8f6",
            "surface": "#fff8f6",
            "surface-container-lowest": "#ffffff",
            "surface-container-low": "#fff0ee",
            "surface-container": "#ffe9e6",
            "surface-container-high": "#fce2de",
            "on-surface": "#261816",
            "on-surface-variant": "#59413d",
            "error": "#ba1a1a",
            "error-container": "#ffdad6",
            "on-error-container": "#93000a",
            "tertiary": "#005875",
            "tertiary-container": "#007296",
          },
          fontFamily: {
            sans: ["Cairo", "sans-serif"],
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Cairo', sans-serif; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-thumb { background: #e1bfb9; border-radius: 10px; }
    .slide-in-left { animation: slideInLeft 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
    @keyframes slideInLeft { from { transform: translateX(100%); } to { transform: translateX(0); } }
  </style>
</head>
<body class="bg-background text-on-surface antialiased">

    <%- include('../partials/admin_sidebar', { activePage: 'admin' }) %>

  <!-- Main Content Wrapper -->
  <div class="transition-all duration-300">
    <!-- Header (Responsive) -->
    <header class="fixed top-0 right-0 lg:right-72 left-0 h-16 bg-surface/80 backdrop-blur-xl shadow-sm z-40 flex items-center justify-between px-4 md:px-8">
      <div class="flex items-center gap-3 flex-1">
        <!-- زر Hamburger للموبايل -->
        <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-surface-container transition-colors">
          <span class="material-symbols-outlined text-on-surface text-[24px]">menu</span>
        </button>
        <div class="flex items-center gap-2 text-sm text-on-surface-variant">
          <span class="material-symbols-outlined text-[18px] hidden sm:inline">home</span>
          <span class="hidden sm:inline">/</span>
          <span class="text-on-surface font-semibold">لوحة التحكم الرئيسية</span>
        </div>
        <div class="hidden md:flex items-center gap-2 bg-surface-container-low px-3 py-1.5 rounded-full mr-2">
          <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
          <span class="text-xs text-on-surface-variant">المنصة تعمل بنشاط</span>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <div class="w-9 h-9 rounded-full bg-primary flex items-center justify-center">
          <span class="material-symbols-outlined text-white text-[18px]">person</span>
        </div>
      </div>
    </header>

    <main class="w-full pt-20 px-4 md:px-8 lg:pr-72 pb-16 bg-surface min-h-screen">
      <div class="flex flex-col w-full space-y-6 md:space-y-8">

        <!-- Welcome Banner -->
        <section class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-5 md:p-8 shadow-sm border border-outline-variant/30">
          <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div class="flex flex-col space-y-2">
              <div class="flex items-center gap-2 text-secondary text-sm font-medium">
                <span class="inline-block w-2 h-2 rounded-full bg-secondary-container animate-ping"></span>
                <span>لوحة العمليات الحية • عربيات الشارع المصري</span>
              </div>
              <h1 class="text-2xl md:text-4xl font-bold text-primary tracking-tight">
                أهلاً بك يا أدمن 🍲
              </h1>
              <p class="text-on-surface-variant max-w-2xl text-sm md:text-base">
                نظرة عامة ومباشرة على نشاط المطابخ ونبض مجتمع دوق
              </p>
            </div>
          </div>
        </section>

        <!-- Primary Stats (4 Cards) -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5" id="stats-grid">
          <div class="rounded-xl bg-surface-container-lowest p-5 shadow-sm border border-outline-variant/30 animate-pulse h-36"></div>
          <div class="rounded-xl bg-surface-container-lowest p-5 shadow-sm border border-outline-variant/30 animate-pulse h-36"></div>
          <div class="rounded-xl bg-surface-container-lowest p-5 shadow-sm border border-outline-variant/30 animate-pulse h-36"></div>
          <div class="rounded-xl bg-surface-container-lowest p-5 shadow-sm border border-outline-variant/30 animate-pulse h-36"></div>
        </section>

        <!-- Main Grid: Tables + Sidebar widgets -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

          <!-- Left: Tables (8 cols) -->
          <div class="lg:col-span-8 flex flex-col space-y-6">

            <!-- Latest Carts Table -->
            <section class="rounded-xl bg-surface-container-lowest p-5 md:p-6 shadow-sm border border-outline-variant/30">
              <div class="flex items-center justify-between mb-6">
                <div>
                  <h2 class="text-lg md:text-xl font-semibold text-on-surface">أحدث المطابخ المسجلة</h2>
                  <p class="text-xs md:text-sm text-on-surface-variant">آخر المطابخ المنضمة للمنصة</p>
                </div>
                <a href="/kitchens" class="text-sm text-primary font-medium hover:underline whitespace-nowrap">عرض الكل ←</a>
              </div>
              <div class="overflow-x-auto -mx-5 md:-mx-6 px-5 md:px-6">
                <table class="w-full text-sm min-w-[600px]">
                  <thead>
                    <tr class="border-b border-surface-container text-on-surface-variant text-right">
                      <th class="p-3 font-medium whitespace-nowrap">المطبخ</th>
                      <th class="p-3 font-medium whitespace-nowrap">الشيف</th>
                      <th class="p-3 font-medium whitespace-nowrap">المدينة</th>
                      <th class="p-3 font-medium whitespace-nowrap">التقييم</th>
                      <th class="p-3 font-medium whitespace-nowrap">الأطباق</th>
                      <th class="p-3 font-medium whitespace-nowrap">التاريخ</th>
                    </tr>
                  </thead>
                  <tbody id="latest-carts-body">
                    <tr><td colspan="6" class="p-8 text-center text-on-surface-variant">جاري التحميل...</td></tr>
                  </tbody>
                </table>
              </div>
            </section>

            <!-- Latest Reviews Feed -->
            <section class="rounded-xl bg-surface-container-lowest p-5 md:p-6 shadow-sm border border-outline-variant/30">
              <div class="flex items-center justify-between mb-6">
                <div>
                  <h2 class="text-lg md:text-xl font-semibold text-on-surface">أحدث التقييمات</h2>
                  <p class="text-xs md:text-sm text-on-surface-variant">آراء حقيقية من المتذوقين</p>
                </div>
                <a href="/reviews" class="text-sm text-primary font-medium hover:underline whitespace-nowrap">عرض الكل ←</a>
              </div>
              <div class="space-y-4" id="latest-reviews">
                <div class="p-4 rounded-xl bg-surface-container-low animate-pulse h-20"></div>
                <div class="p-4 rounded-xl bg-surface-container-low animate-pulse h-20"></div>
              </div>
            </section>
          </div>

          <!-- Right: Top Carts + Alerts (4 cols) -->
          <div class="lg:col-span-4 flex flex-col space-y-6">

            <!-- Top 5 by Fair Score -->
            <section class="rounded-xl bg-surface-container-lowest p-5 md:p-6 shadow-sm border border-outline-variant/30">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h2 class="text-lg font-semibold text-on-surface">أفضل 5 مطابخ</h2>
                  <p class="text-xs text-on-surface-variant">وفقاً لمؤشر Fair Score</p>
                </div>
                <span class="material-symbols-outlined text-[24px] text-secondary" style="font-variation-settings: 'FILL' 1;">military_tech</span>
              </div>
              <div class="space-y-3" id="top-carts">
                <div class="p-3 rounded-xl bg-surface-container-low animate-pulse h-14"></div>
                <div class="p-3 rounded-xl bg-surface-container-low animate-pulse h-14"></div>
              </div>
            </section>

            <!-- Rating Distribution -->
            <section class="rounded-xl bg-surface-container-lowest p-5 md:p-6 shadow-sm border border-outline-variant/30">
              <h3 class="text-lg font-semibold text-on-surface mb-4">توزيع التقييمات</h3>
              <div class="space-y-2" id="rating-distribution">
                <!-- filled by JS -->
              </div>
            </section>

          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    // ============================================
    // Sidebar Toggle (للموبايل)
    // ============================================
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        
        if (sidebar.classList.contains('translate-x-full')) {
            sidebar.classList.remove('translate-x-full');
            overlay.classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // منع التمرير
        } else {
            sidebar.classList.add('translate-x-full');
            overlay.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }

    // ============================================
    // Dashboard Logic
    // ============================================
    async function loadDashboard() {
      try {
        const res = await fetch('/admin/api/v1/dashboard');
        const json = await res.json();

        if (json.status !== 'success') {
          console.error('Dashboard error:', json.message);
          return;
        }

        const { stats, latestCarts, latestReviews, topCartsByFairScore } = json.data;

        renderStats(stats);
        renderLatestCarts(latestCarts);
        renderLatestReviews(latestReviews);
        renderTopCarts(topCartsByFairScore);
        renderRatingDistribution(stats.ratingDistribution);

      } catch (err) {
        console.error('Failed to load dashboard:', err);
      }
    }

    // ---------- Stats Cards ----------
    function renderStats(stats) {
      const grid = document.getElementById('stats-grid');
      grid.innerHTML = `
        <div class="rounded-xl bg-surface-container-lowest p-5 shadow-sm border border-outline-variant/30 hover:shadow-md transition-all">
          <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-on-surface-variant">إجمالي المستخدمين</span>
            <div class="w-11 h-11 rounded-xl bg-red-50 flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[24px]">group</span>
            </div>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-2xl md:text-3xl font-bold text-on-surface">${formatNumber(stats.totalUsers)}</span>
            <div class="flex items-center gap-1 bg-surface-container-low text-tertiary text-xs px-2.5 py-1 rounded-full whitespace-nowrap">
              <span class="material-symbols-outlined text-[16px]">trending_up</span>
              <span>+${stats.newUsersThisMonth}</span>
            </div>
          </div>
          <p class="mt-2 text-xs text-on-surface-variant/80">${stats.totalCustomers} عميل • ${stats.totalChefs} شيف</p>
        </div>

        <div class="rounded-xl bg-surface-container-lowest p-5 shadow-sm border border-outline-variant/30 hover:shadow-md transition-all">
          <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-on-surface-variant">إجمالي المطابخ</span>
            <div class="w-11 h-11 rounded-xl bg-orange-50 flex items-center justify-center text-secondary">
              <span class="material-symbols-outlined text-[24px]">storefront</span>
            </div>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-2xl md:text-3xl font-bold text-on-surface">${formatNumber(stats.totalCarts)}</span>
            <div class="flex items-center gap-1 bg-orange-50 text-secondary text-xs px-2.5 py-1 rounded-full whitespace-nowrap">
              <span class="material-symbols-outlined text-[16px]">add</span>
              <span>+${stats.newCartsThisWeek}</span>
            </div>
          </div>
          <p class="mt-2 text-xs text-on-surface-variant/80">${stats.newCartsThisMonth} جديد هذا الشهر</p>
        </div>

        <div class="rounded-xl bg-surface-container-lowest p-5 shadow-sm border border-outline-variant/30 hover:shadow-md transition-all">
          <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-on-surface-variant">إجمالي الأطباق</span>
            <div class="w-11 h-11 rounded-xl bg-surface-container-high flex items-center justify-center text-primary-container">
              <span class="material-symbols-outlined text-[24px]">soup_kitchen</span>
            </div>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-2xl md:text-3xl font-bold text-on-surface">${formatNumber(stats.totalDishes)}</span>
            <div class="flex items-center gap-1 bg-surface-container-high text-primary text-xs px-2.5 py-1 rounded-full whitespace-nowrap">
              <span class="material-symbols-outlined text-[16px]">restaurant</span>
              <span>+${stats.newDishesThisMonth}</span>
            </div>
          </div>
          <p class="mt-2 text-xs text-on-surface-variant/80">كشري، كبدة، حواوشي وحلويات</p>
        </div>

        <div class="rounded-xl bg-surface-container-lowest p-5 shadow-sm border border-outline-variant/30 hover:shadow-md transition-all">
          <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-on-surface-variant">إجمالي التقييمات</span>
            <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center text-tertiary">
              <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' 1;">stars</span>
            </div>
          </div>
          <div class="flex items-baseline justify-between">
            <span class="text-2xl md:text-3xl font-bold text-on-surface">${formatNumber(stats.totalReviews)}</span>
            <div class="flex items-center gap-1 bg-surface-container-low text-secondary text-xs px-2.5 py-1 rounded-full whitespace-nowrap">
              <span class="material-symbols-outlined text-[16px]">grade</span>
              <span>متوسط ${stats.averageRating || 0}</span>
            </div>
          </div>
          <p class="mt-2 text-xs text-on-surface-variant/80">موثقة بنظام Fair Score</p>
        </div>
      `;
    }

    // ---------- Latest Carts Table ----------
    function renderLatestCarts(carts) {
      const tbody = document.getElementById('latest-carts-body');
      if (!carts || carts.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-on-surface-variant">لا توجد مطابخ بعد</td></tr>`;
        return;
      }

      tbody.innerHTML = carts.map(cart => `
        <tr class="border-b border-surface-container-low hover:bg-surface-container-low/60 transition-colors">
          <td class="p-3.5">
            <div class="font-semibold text-on-surface whitespace-nowrap">${escapeHtml(cart.title)}</div>
          </td>
          <td class="p-3.5 text-on-surface whitespace-nowrap">${escapeHtml(cart.chef_name || '—')}</td>
          <td class="p-3.5 text-on-surface-variant whitespace-nowrap">${escapeHtml(cart.city || '—')}</td>
          <td class="p-3.5">
            <span class="inline-flex items-center gap-1 font-semibold text-secondary bg-surface-container px-2 py-0.5 rounded-md text-sm whitespace-nowrap">
              ${cart.fair_score || cart.avg_rating || '—'} ★
            </span>
          </td>
          <td class="p-3.5 text-on-surface-variant whitespace-nowrap">${cart.dishes_count || 0}</td>
          <td class="p-3.5 text-on-surface-variant text-xs whitespace-nowrap">${formatDate(cart.created_at)}</td>
        </tr>
      `).join('');
    }

    // ---------- Latest Reviews ----------
    function renderLatestReviews(reviews) {
      const container = document.getElementById('latest-reviews');
      if (!reviews || reviews.length === 0) {
        container.innerHTML = `<p class="text-center text-on-surface-variant py-6">لا توجد تقييمات بعد</p>`;
        return;
      }

      container.innerHTML = reviews.map(r => {
        const initials = getInitials(r.user_name);
        const stars = renderStars(r.rating);
        return `
          <div class="p-4 rounded-xl bg-surface-container-low flex flex-col md:flex-row md:items-center justify-between gap-4 border border-outline-variant/20">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-semibold text-sm shrink-0">
                ${initials}
              </div>
              <div class="flex flex-col min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-semibold text-on-surface text-sm truncate">${escapeHtml(r.user_name)}</span>
                  <span class="text-xs text-on-surface-variant truncate">• ${escapeHtml(r.kitchen_name)} — ${escapeHtml(r.dish_name)}</span>
                </div>
                <div class="flex items-center gap-1 text-secondary my-1">
                  ${stars}
                </div>
                <p class="text-sm text-on-surface-variant line-clamp-2">${escapeHtml(r.comment || '')}</p>
              </div>
            </div>
            <div class="text-xs text-on-surface-variant/80 shrink-0 whitespace-nowrap">
              ${formatDate(r.created_at)}
            </div>
          </div>
        `;
      }).join('');
    }

    // ---------- Top Carts by Fair Score ----------
    function renderTopCarts(carts) {
      const container = document.getElementById('top-carts');
      if (!carts || carts.length === 0) {
        container.innerHTML = `<p class="text-center text-on-surface-variant py-4 text-sm">لا توجد بيانات كافية</p>`;
        return;
      }

      container.innerHTML = carts.map((cart, i) => `
        <div class="flex items-center justify-between p-3 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors border border-outline-variant/20">
          <div class="flex items-center gap-3 min-w-0">
            <span class="w-6 h-6 rounded-full ${i === 0 ? 'bg-secondary-container text-white' : 'bg-surface-container-high text-primary'} font-semibold text-xs flex items-center justify-center shrink-0">
              ${i + 1}
            </span>
            <div class="min-w-0">
              <div class="font-semibold text-on-surface text-sm truncate">${escapeHtml(cart.title)}</div>
              <div class="text-xs text-on-surface-variant truncate">${escapeHtml(cart.city || '')} • ${escapeHtml(cart.chef_name || '')}</div>
            </div>
          </div>
          <div class="text-left shrink-0">
            <span class="font-semibold text-sm text-secondary bg-white px-2.5 py-1 rounded-lg shadow-sm whitespace-nowrap">
              ${cart.fair_score || '—'} ★
            </span>
          </div>
        </div>
      `).join('');
    }

    // ---------- Rating Distribution ----------
    function renderRatingDistribution(dist) {
      const container = document.getElementById('rating-distribution');
      if (!container) return;

      if (!dist) {
        container.innerHTML = '<p class="text-center text-on-surface-variant text-sm py-4">لا توجد بيانات كافية</p>';
        return;
      }

      let ratingsData = {};
      let total = 0;

      if (Array.isArray(dist)) {
        dist.forEach(item => {
          const r = item.rating || item.stars || item.star; 
          const c = Number(item.count || item.total || 0);
          if (r !== undefined) {
            ratingsData[r] = c;
            total += c;
          }
        });
      } else if (typeof dist === 'object') {
        ratingsData = dist;
        total = Object.values(ratingsData).reduce((a, b) => a + Number(b), 0) || 1;
      }

      if (total === 0 || Object.keys(ratingsData).length === 0) {
        container.innerHTML = '<p class="text-center text-on-surface-variant text-sm py-4">لا توجد تقييمات بعد</p>';
        return;
      }

      const stars = [5, 4, 3, 2, 1];

      container.innerHTML = stars.map(s => {
        const count = Number(ratingsData[s] || ratingsData[String(s)] || 0);
        const pct = total > 0 ? Math.round((count / total) * 100) : 0;
        
        return `
          <div class="flex items-center gap-3">
            <span class="text-xs text-on-surface-variant w-8 flex-shrink-0 font-medium">${s} ★</span>
            <div class="flex-1 h-2.5 bg-surface-container rounded-full overflow-hidden">
              <div class="h-full bg-secondary-container rounded-full transition-all duration-500 ease-out" style="width: ${pct}%"></div>
            </div>
            <span class="text-xs text-on-surface-variant w-10 text-left flex-shrink-0 font-bold">${count}</span>
          </div>
        `;
      }).join('');
    }

    // ---------- Helpers ----------
    function formatNumber(n) {
      return Number(n || 0).toLocaleString('ar-EG');
    }

    function formatDate(dateStr) {
      if (!dateStr) return '—';
      const d = new Date(dateStr);
      const now = new Date();
      const diffMs = now - d;
      const diffMins = Math.floor(diffMs / 60000);
      const diffHours = Math.floor(diffMs / 3600000);
      const diffDays = Math.floor(diffMs / 86400000);

      if (diffMins < 60) return `منذ ${diffMins} دقيقة`;
      if (diffHours < 24) return `منذ ${diffHours} ساعة`;
      if (diffDays < 7) return `منذ ${diffDays} يوم`;
      return d.toLocaleDateString('ar-EG');
    }

    function getInitials(name) {
      if (!name) return '؟';
      const parts = name.trim().split(' ');
      if (parts.length >= 2) return parts[0][0] + parts[1][0];
      return parts[0][0] || '؟';
    }

    function renderStars(rating) {
      let html = '';
      for (let i = 1; i <= 5; i++) {
        const filled = i <= rating ? "style=\"font-variation-settings: 'FILL' 1;\"" : '';
        html += `<span class="material-symbols-outlined text-[16px]" ${filled}>star</span>`;
      }
      return html;
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // Start
    loadDashboard();
  </script>
</body>
</html>