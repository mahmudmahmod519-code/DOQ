<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<script src="/app-client.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المستخدمين | دوق DOQ</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#9e2016", "primary-container": "#c0392b", "on-primary": "#ffffff",
                        "secondary": "#a23f00", "secondary-container": "#fc7127", "on-secondary": "#ffffff",
                        "background": "#fff8f6", "surface": "#fff8f6", "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#fff0ee", "surface-container": "#ffe9e6",
                        "on-surface": "#261816", "on-surface-variant": "#59413d",
                        "error": "#ba1a1a", "error-container": "#ffdad6", "outline-variant": "#e1bfb9"
                    },
                    fontFamily: { sans: ["Cairo", "sans-serif"] }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; }
        .fade-out { animation: fadeOut 0.4s ease-in-out forwards; }
        @keyframes fadeOut { 0% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(0.95); height: 0; padding: 0; margin: 0; overflow: hidden; } }
        .zoom-in { animation: zoomIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
        @keyframes zoomIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
        .slide-in-left { animation: slideInLeft 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
        @keyframes slideInLeft { from { transform: translateX(100%); } to { transform: translateX(0); } }
    </style>
</head>
<body class="bg-background text-on-surface antialiased">

    <%- include('../partials/admin_sidebar', { activePage: 'users' }) %>

    <!-- Header (Responsive) -->
    <header class="fixed top-0 right-0 lg:right-72 left-0 h-16 bg-surface/80 backdrop-blur-xl shadow-sm z-40 flex items-center justify-between px-4 md:px-8">
        <div class="flex items-center gap-3 flex-1">
            <!-- زر Hamburger للموبايل -->
            <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-on-surface text-[24px]">menu</span>
            </button>
            <div class="flex items-center gap-2 text-sm text-on-surface-variant">
                <span class="material-symbols-outlined text-[18px] hidden sm:inline">home</span>
                <span class="hidden sm:inline">/</span>
                <span class="text-on-surface font-semibold">إدارة المستخدمين</span>
            </div>
            <div class="hidden md:flex items-center gap-2 bg-surface-container-low px-3 py-1.5 rounded-full mr-2">
                <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
                <span class="text-xs text-on-surface-variant">المنصة تعمل بنشاط</span>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-white text-[18px]">person</span>
            </div>
        </div>
    </header>

    <!-- Main Content (Responsive) -->
    <main class="pt-20 pb-16 px-4 md:px-8 lg:pr-72 min-h-screen bg-surface transition-all duration-300">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Table Section -->
            <div class="lg:col-span-8 flex flex-col space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-primary mb-1 flex items-center gap-3">
                            <span class="material-symbols-outlined text-3xl md:text-4xl">group</span>إدارة المستخدمين
                        </h1>
                        <p class="text-on-surface-variant flex items-center gap-2 text-sm">
                            <span class="material-symbols-outlined text-secondary text-[16px]">counter_1</span>
                            <span id="totalUsersCount" class="font-bold">0</span>
                            <span>مستخدم مسجل في المنصة</span>
                        </p>
                    </div>
                    <!-- ✅ زرار إضافة مدير جديد -->
                    <button onclick="openAddModal()" class="px-5 py-2.5 bg-secondary text-white rounded-xl font-bold hover:bg-secondary-container transition-all active:scale-95 flex items-center justify-center gap-2 shadow-sm">
                        <span class="material-symbols-outlined text-[20px]">person_add</span>
                        إضافة مدير جديد
                    </button>
                </div>

                <!-- Filters Form (Responsive) -->
                <form id="filterForm" class="rounded-xl bg-surface-container-lowest p-4 md:p-5 shadow-sm border border-outline-variant/30" onsubmit="event.preventDefault(); applyFilters(1);">
                    <div class="flex flex-col gap-3">
                        <div class="w-full">
                            <label class="block text-xs font-bold text-on-surface-variant mb-1.5">البحث السريع</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline-variant text-[20px]">search</span>
                                <input type="text" id="searchInput" placeholder="ابحث بالاسم، البريد، الهاتف..." 
                                       class="w-full pr-10 pl-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium">
                            </div>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-3">
                            <div class="flex-1">
                                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">نوع الدور</label>
                                <select id="roleFilter" class="w-full py-2.5 px-4 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium">
                                    <option value="all">الكل</option>
                                    <option value="customer">عميل</option>
                                    <option value="chef">شيف</option>
                                    <option value="admin">مدير</option>
                                </select>
                            </div>
                            <button type="submit" class="sm:mt-6 px-6 py-2.5 bg-primary text-white rounded-xl font-bold hover:bg-primary-container transition-all active:scale-95 flex items-center justify-center gap-2 shadow-sm">
                                <span class="material-symbols-outlined text-[18px]">search</span>بحث
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Table (Responsive) -->
                <div class="rounded-xl bg-surface-container-lowest shadow-sm border border-outline-variant/30 overflow-hidden">
                    <div class="overflow-x-auto min-h-[300px]">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-surface-container text-on-surface-variant text-right bg-surface-container-low/50">
                                    <th class="p-3 md:p-4 font-bold text-xs">#</th>
                                    <th class="p-3 md:p-4 font-bold text-xs">الاسم</th>
                                    <th class="p-3 md:p-4 font-bold text-xs hidden md:table-cell">البريد الإلكتروني</th>
                                    <th class="p-3 md:p-4 font-bold text-xs hidden sm:table-cell">الهاتف</th>
                                    <th class="p-3 md:p-4 font-bold text-xs">الدور</th>
                                    <th class="p-3 md:p-4 font-bold text-xs hidden lg:table-cell">التاريخ</th>
                                    <th class="p-3 md:p-4 font-bold text-xs text-center">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody id="userTableBody">
                                <tr>
                                    <td colspan="7" class="p-12 text-center text-on-surface-variant">
                                        <div class="flex flex-col items-center gap-3">
                                            <div class="w-8 h-8 border-3 border-primary border-t-transparent rounded-full animate-spin"></div>
                                            <p class="font-bold">جاري تحميل البيانات...</p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div id="paginationContainer" class="hidden px-4 md:px-6 py-3 md:py-4 flex flex-col sm:flex-row justify-between items-center gap-3 bg-surface-container-low/50 border-t border-outline-variant/30">
                        <span id="pageInfoText" class="text-xs text-on-surface-variant"></span>
                        <div id="paginationButtons" class="flex items-center gap-1 md:gap-2 flex-wrap justify-center"></div>
                    </div>
                </div>
            </div>

            <!-- Edit Form Section (Responsive - يظهر تحت الجدول على الموبايل) -->
            <div id="formSection" class="lg:col-span-4">
                <div class="rounded-xl bg-surface-container-lowest shadow-sm border border-outline-variant/30 lg:sticky lg:top-24 overflow-hidden">
                    <div class="bg-surface-container-low p-6 text-center relative border-b border-outline-variant/30">
                        <div id="formLoading" class="hidden absolute inset-0 bg-white/60 backdrop-blur-sm z-20 flex items-center justify-center">
                            <div class="w-8 h-8 border-3 border-primary border-t-transparent rounded-full animate-spin"></div>
                        </div>
                        <div id="userAvatar" class="w-20 h-20 rounded-full bg-primary text-white text-3xl font-bold flex items-center justify-center mx-auto mb-3 shadow-md ring-4 ring-surface-container-lowest">?</div>
                        <h2 class="text-lg font-bold text-on-surface" id="formUserNameHeader">اختر مستخدم للتعديل</h2>
                        <p class="text-xs text-on-surface-variant mt-1" id="formRegistrationDate">انضم في: --</p>
                    </div>

                    <form id="editUserForm" class="p-5 md:p-6 space-y-4 md:space-y-5">
                        <input type="hidden" id="editUserId" value="">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">الاسم الأول</label>
                                <input type="text" id="firstName" class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">اسم العائلة</label>
                                <input type="text" id="lastName" class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-on-surface-variant mb-1.5">رقم الهاتف</label>
                            <input type="tel" id="phone" class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium text-left" dir="ltr">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-on-surface-variant mb-1.5">الدور</label>
                            <select id="userRole" class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium">
                                <option value="customer">عميل</option>
                                <option value="chef">شيف</option>
                                <option value="admin">مدير</option>
                            </select>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-outline-variant/30">
                            <div>
                                <label class="block text-xs font-bold text-on-surface-variant/60 mb-1.5">البريد (للقراءة)</label>
                                <input type="email" id="email" disabled class="w-full px-3 py-2.5 bg-surface-container border border-transparent rounded-xl text-on-surface-variant/70 outline-none text-sm font-medium cursor-not-allowed">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-on-surface-variant/60 mb-1.5">رمز التحقق</label>
                                <input type="text" id="verifyCode" disabled value="غير متاح" class="w-full px-3 py-2.5 bg-surface-container border border-transparent rounded-xl text-on-surface-variant/70 outline-none text-sm font-medium text-center cursor-not-allowed">
                            </div>
                        </div>
                        <div class="pt-2 flex flex-col gap-3">
                            <button type="submit" id="saveBtn" class="w-full py-3 bg-primary text-white rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-primary-container transition-all shadow-sm active:scale-[0.98]">
                                <span class="material-symbols-outlined text-[20px]">save</span>حفظ التغييرات
                            </button>
                            <button type="button" id="resetBtn" class="w-full py-2.5 text-on-surface-variant font-medium hover:bg-surface-container rounded-xl transition-all text-sm">إلغاء التعديلات</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <!-- Confirm Delete Modal -->
    <div id="confirmModal" class="fixed inset-0 z-[110] bg-black/40 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-surface-container-lowest rounded-2xl w-full max-w-sm p-6 text-center shadow-2xl zoom-in border border-outline-variant/30">
            <div class="w-16 h-16 rounded-full bg-error-container flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-4xl text-error">warning</span>
            </div>
            <h3 class="text-xl font-bold text-on-surface mb-2">هل أنت متأكد؟</h3>
            <p class="text-sm text-on-surface-variant mb-6">هذا الإجراء سيقوم بحذف هذا المستخدم وجميع بياناته المرتبطة نهائياً من النظام.</p>
            <div class="flex flex-col gap-3">
                <button id="confirmDeleteBtn" class="w-full py-3 bg-error text-white rounded-xl font-bold hover:bg-red-700 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">delete</span>نعم، حذف المستخدم
                </button>
                <button onclick="closeModal()" class="w-full py-3 bg-surface-container text-on-surface rounded-xl font-bold hover:bg-surface-container-high transition-all">تراجع</button>
            </div>
        </div>
    </div>

    <!-- ✅ Add Admin Modal -->
    <div id="addAdminModal" class="fixed inset-0 z-[110] bg-black/40 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg p-6 shadow-2xl zoom-in border border-outline-variant/30 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-outline-variant/30">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-2xl text-on-secondary">person_add</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-on-surface">إضافة مدير جديد</h3>
                        <p class="text-xs text-on-surface-variant mt-0.5">أضف مدير جديد للمنصة</p>
                    </div>
                </div>
                <button onclick="closeAddModal()" class="w-8 h-8 rounded-lg hover:bg-surface-container flex items-center justify-center transition-all">
                    <span class="material-symbols-outlined text-on-surface-variant">close</span>
                </button>
            </div>

            <form id="addAdminForm" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-on-surface-variant mb-1.5">الاسم الأول *</label>
                        <input type="text" id="addFirstName" required class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-secondary/20 focus:border-secondary text-on-surface outline-none text-sm font-medium">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-on-surface-variant mb-1.5">اسم العائلة *</label>
                        <input type="text" id="addLastName" required class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-secondary/20 focus:border-secondary text-on-surface outline-none text-sm font-medium">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">البريد الإلكتروني *</label>
                    <input type="email" id="addEmail" required class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-secondary/20 focus:border-secondary text-on-surface outline-none text-sm font-medium text-left" dir="ltr">
                </div>

                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">رقم الهاتف *</label>
                    <input type="tel" id="addPhone" required pattern="^(010|011|012|015)[0-9]{8}$" class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-secondary/20 focus:border-secondary text-on-surface outline-none text-sm font-medium text-left" dir="ltr" placeholder="01xxxxxxxxx">
                </div>

                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">كلمة المرور *</label>
                    <input type="password" id="addPassword" required minlength="8" class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-secondary/20 focus:border-secondary text-on-surface outline-none text-sm font-medium text-left" dir="ltr">
                    <p class="text-xs text-on-surface-variant mt-1">يجب أن تحتوي على حرف كبير، حرف صغير، رقم، ورمز خاص</p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">تأكيد كلمة المرور *</label>
                    <input type="password" id="addPasswordConfirm" required minlength="8" class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-secondary/20 focus:border-secondary text-on-surface outline-none text-sm font-medium text-left" dir="ltr">
                </div>

                <div class="pt-4 border-t border-outline-variant/30 flex flex-col sm:flex-row gap-3">
                    <button type="submit" id="addAdminBtn" class="flex-1 py-3 bg-secondary text-white rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-secondary-container transition-all shadow-sm active:scale-[0.98]">
                        <span class="material-symbols-outlined text-[20px]">person_add</span>
                        إضافة المدير
                    </button>
                    <button type="button" onclick="closeAddModal()" class="sm:flex-none px-6 py-3 bg-surface-container text-on-surface rounded-xl font-bold hover:bg-surface-container-high transition-all">
                        إلغاء
                    </button>
                </div>
            </form>
        </div>
    </div>
    
    <script>
        let currentEditingId = null;
        let idToDelete = null;
        let currentPage = 1;
        let currentQ = '';
        let currentRole = 'all';

        // ============================================
        // Sidebar Toggle (للموبايل)
        // ============================================
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            
            if (sidebar.classList.contains('translate-x-full')) {
                sidebar.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                sidebar.classList.add('translate-x-full');
                overlay.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        // ============================================
        // ✅ Add Admin Modal Functions
        // ============================================
        function openAddModal() {
            document.getElementById('addAdminModal').classList.remove('hidden');
            document.getElementById('addAdminModal').classList.add('flex');
            document.getElementById('addAdminForm').reset();
        }

        function closeAddModal() {
            document.getElementById('addAdminModal').classList.add('hidden');
            document.getElementById('addAdminModal').classList.remove('flex');
        }

        // Handle Add Admin Form Submit
        document.getElementById('addAdminForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const btn = document.getElementById('addAdminBtn');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div> جاري الإضافة...';

            const firstname = document.getElementById('addFirstName').value.trim();
            const lastname = document.getElementById('addLastName').value.trim();
            const email = document.getElementById('addEmail').value.trim();
            const phone_number = document.getElementById('addPhone').value.trim();
            const password = document.getElementById('addPassword').value;
            const password_confirmation = document.getElementById('addPasswordConfirm').value;

            if (password !== password_confirmation) {
                alert('❌ كلمة المرور غير متطابقة');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                return;
            }


            try {
                const response = await fetch('/users/api/v1', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        firstname,
                        lastname,
                        email,
                        phone_number,
                        password,
                        roles: 'admin'
                    })
                });

                const data = await response.json();

                if (response.ok && data.status === 'success') {
                    alert('✅ ' + (data.message || 'تم إضافة المدير بنجاح'));
                    closeAddModal();
                    loadUsers(1); // Reload table
                } else {
                    alert('❌ ' + (data.message || 'حدث خطأ أثناء الإضافة'));
                }
            } catch (error) {
                alert('❌ خطأ في الاتصال بالخادم');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });

        // ============================================
        // 1. جلب وعرض المستخدمين
        // ============================================
        async function loadUsers(page = 1) {
            currentPage = page;
            const tbody = document.getElementById('userTableBody');
            const paginationContainer = document.getElementById('paginationContainer');
            
            tbody.innerHTML = `
                <tr><td colspan="7" class="p-12 text-center text-on-surface-variant">
                    <div class="flex flex-col items-center gap-3">
                        <div class="w-8 h-8 border-3 border-primary border-t-transparent rounded-full animate-spin"></div>
                        <p class="font-bold">جاري تحميل البيانات...</p>
                    </div>
                </td></tr>`;
            paginationContainer.classList.add('hidden');

            try {
                const params = new URLSearchParams({ page, limit: 10 });
                if (currentQ) params.append('q', currentQ);
                if (currentRole !== 'all') params.append('role', currentRole);

                const res = await fetch(`/admin/api/v1/users?${params.toString()}`);
                const json = await res.json();

                if (json.status === 'success') {
                    renderTable(json.data, json.pagination);
                } else {
                    throw new Error(json.message || 'فشل جلب البيانات');
                }
            } catch (error) {
                tbody.innerHTML = `
                    <tr><td colspan="7" class="p-12 text-center text-error">
                        <div class="flex flex-col items-center gap-3">
                            <span class="material-symbols-outlined text-5xl">error</span>
                            <p class="font-bold">${DOQ.escape(error.message || 'حدث خطأ غير متوقع')}</p>
                        </div>
                    </td></tr>`;
            }
        }

        function renderTable(users, pagination) {
            const tbody = document.getElementById('userTableBody');
            const paginationContainer = document.getElementById('paginationContainer');
            const pageInfoText = document.getElementById('pageInfoText');
            const paginationButtons = document.getElementById('paginationButtons');

            document.getElementById('totalUsersCount').textContent = pagination.total;

            if (users.length === 0) {
                tbody.innerHTML = `
                    <tr><td colspan="7" class="p-12 text-center text-on-surface-variant">
                        <div class="flex flex-col items-center gap-3">
                            <span class="material-symbols-outlined text-5xl text-outline-variant">group_off</span>
                            <p class="font-bold">لا يوجد مستخدمين يطابقون بحثك</p>
                        </div>
                    </td></tr>`;
                paginationContainer.classList.add('hidden');
                return;
            }

            let html = '';
            users.forEach((user, index) => {
                const roleClass = user.roles === 'admin' ? 'bg-primary/10 text-primary' : 
                                  user.roles === 'chef' ? 'bg-secondary-container text-on-secondary-container' : 'bg-surface-container text-on-surface-variant';
                const roleName = user.roles === 'admin' ? 'مدير' : user.roles === 'chef' ? 'شيف' : 'عميل';
                const rowNumber = (pagination.page - 1) * pagination.limit + index + 1;

                html += `
                    <tr class="border-b border-surface-container hover:bg-surface-container-low/60 transition-colors cursor-pointer user-row group" 
                        data-user-id="${user.id}" onclick="loadUserDetails(${user.id})">
                        <td class="p-3 md:p-4 text-on-surface-variant font-medium">${rowNumber}</td>
                        <td class="p-3 md:p-4">
                            <div class="font-bold text-on-surface text-sm">${DOQ.escape(user.first_name)} ${DOQ.escape(user.last_name)}</div>
                            <div class="text-xs text-on-surface-variant md:hidden mt-0.5">${DOQ.escape(user.email)}</div>
                        </td>
                        <td class="p-3 md:p-4 text-on-surface-variant text-sm hidden md:table-cell">${DOQ.escape(user.email)}</td>
                        <td class="p-3 md:p-4 text-on-surface-variant font-mono text-xs hidden sm:table-cell">${DOQ.escape(user.phone_number)}</td>
                        <td class="p-3 md:p-4"><span class="inline-flex items-center gap-1 font-semibold text-xs px-2 py-0.5 md:px-2.5 md:py-1 rounded-lg ${roleClass}">${roleName}</span></td>
                        <td class="p-3 md:p-4 text-on-surface-variant text-xs hidden lg:table-cell">${new Date(user.created_at).toLocaleDateString('ar-EG')}</td>
                        <td class="p-3 md:p-4 text-center">
                            <button onclick="confirmDelete(event, ${user.id})" class="delete-btn w-8 h-8 rounded-lg flex items-center justify-center text-error hover:bg-error-container transition-all mx-auto">
                                <span class="material-symbols-outlined text-[18px]">delete</span>
                            </button>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;

            // Render Pagination
            if (pagination.total_pages > 1) {
                paginationContainer.classList.remove('hidden');
                pageInfoText.textContent = `صفحة ${pagination.page} من ${pagination.total_pages}`;
                
                let btnsHtml = '';
                if (pagination.page > 1) {
                    btnsHtml += `<button onclick="loadUsers(${pagination.page - 1})" class="px-3 py-1.5 md:px-4 md:py-2 rounded-lg border border-outline-variant text-xs font-bold hover:bg-white transition-all">السابق</button>`;
                }
                
                for (let i = 1; i <= pagination.total_pages; i++) {
                    if (i === pagination.page) {
                        btnsHtml += `<span class="w-7 h-7 md:w-8 md:h-8 flex items-center justify-center rounded-lg bg-primary text-white text-xs font-bold">${i}</span>`;
                    } else if (i === 1 || i === pagination.total_pages || (i >= pagination.page - 1 && i <= pagination.page + 1)) {
                        btnsHtml += `<button onclick="loadUsers(${i})" class="w-7 h-7 md:w-8 md:h-8 flex items-center justify-center rounded-lg border border-outline-variant text-xs font-bold hover:bg-white transition-all">${i}</button>`;
                    } else if (i === pagination.page - 2 || i === pagination.page + 2) {
                        btnsHtml += `<span class="text-xs text-on-surface-variant px-1">...</span>`;
                    }
                }

                if (pagination.page < pagination.total_pages) {
                    btnsHtml += `<button onclick="loadUsers(${pagination.page + 1})" class="px-3 py-1.5 md:px-4 md:py-2 rounded-lg border border-outline-variant text-xs font-bold hover:bg-white transition-all">التالي</button>`;
                }
                paginationButtons.innerHTML = btnsHtml;
            } else {
                paginationContainer.classList.add('hidden');
            }
        }

        function applyFilters(page = 1) {
            currentQ = document.getElementById('searchInput').value.trim();
            currentRole = document.getElementById('roleFilter').value;
            loadUsers(page);
        }

        // ============================================
        // 2. جلب تفاصيل مستخدم محدد للتعديل
        // ============================================
        async function loadUserDetails(id) {
            const loader = document.getElementById('formLoading');
            loader.classList.remove('hidden');
            
            document.querySelectorAll('.user-row').forEach(row => row.classList.remove('bg-primary/5', 'border-r-4', 'border-primary'));
            const selectedRow = document.querySelector(`.user-row[data-user-id="${id}"]`);
            if (selectedRow) selectedRow.classList.add('bg-primary/5', 'border-r-4', 'border-primary');
            
            try {
                const res = await fetch(`/admin/api/v1/users/${id}`);
                const json = await res.json();

                if (json.status === 'success') {
                    const user = json.data;
                    currentEditingId = id;
                    document.getElementById('editUserId').value = id;
                    document.getElementById('formUserNameHeader').textContent = user.first_name + ' ' + user.last_name;
                    document.getElementById('formRegistrationDate').textContent = 'انضم في: ' + new Date(user.created_at).toLocaleDateString('ar-EG');
                    document.getElementById('firstName').value = user.first_name;
                    document.getElementById('lastName').value = user.last_name;
                    document.getElementById('phone').value = user.phone_number;
                    document.getElementById('userRole').value = user.roles;
                    document.getElementById('email').value = user.email;
                    document.getElementById('verifyCode').value = user.code || 'غير متاح';
                    document.getElementById('userAvatar').textContent = user.first_name.charAt(0);

                    if (window.innerWidth < 1024) {
                        setTimeout(() => {
                            document.getElementById('formSection').scrollIntoView({ 
                                behavior: 'smooth', 
                                block: 'start' 
                            });
                        }, 100);
                    }
                } else {
                    alert('❌ ' + json.message);
                }
            } catch (error) {
                alert('❌ خطأ في جلب بيانات المستخدم');
            } finally {
                loader.classList.add('hidden');
            }
        }

        // ============================================
        // 3. حذف مستخدم
        // ============================================
        function confirmDelete(e, id) {
            e.stopPropagation();
            idToDelete = id;
            document.getElementById('confirmModal').classList.remove('hidden');
            document.getElementById('confirmModal').classList.add('flex');
        }

        function closeModal() {
            document.getElementById('confirmModal').classList.add('hidden');
            document.getElementById('confirmModal').classList.remove('flex');
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
            const btn = this;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div> جاري الحذف...';
            btn.disabled = true;
            
            try {
                const response = await fetch(`/admin/api/v1/users/${idToDelete}`, { method: 'DELETE' });
                const data = await response.json();

                if (response.ok && (data.status === 'success' || data.status === 'successful')) {
                    const row = document.querySelector(`.user-row[data-user-id="${idToDelete}"]`);
                    if (row) {
                        row.classList.add('fade-out');
                        setTimeout(() => {
                            loadUsers(currentPage);
                            if (currentEditingId == idToDelete) {
                                document.getElementById('formUserNameHeader').textContent = 'اختر مستخدم للتعديل';
                                document.getElementById('editUserForm').reset();
                                currentEditingId = null;
                            }
                        }, 400);
                    }
                } else {
                    alert('❌ ' + (data.message || 'حدث خطأ أثناء الحذف'));
                }
            } catch (error) {
                alert('❌ خطأ في الاتصال بالخادم');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
                closeModal();
            }
        });

        // ============================================
        // 4. تعديل مستخدم
        // ============================================
        document.getElementById('editUserForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const btn = document.getElementById('saveBtn');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div> جاري الحفظ...';

            const id = document.getElementById('editUserId').value;
            const firstName = document.getElementById('firstName').value.trim();
            const lastName = document.getElementById('lastName').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const role = document.getElementById('userRole').value;

            if (!id) {
                alert('⚠️ يرجى اختيار مستخدم أولاً');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                return;
            }

            try {
                const response = await fetch(`/admin/api/v1/users/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ first_name: firstName, last_name: lastName, phone_number: phone, roles: role })
                });

                const data = await response.json();

                if (response.ok && data.status === 'success') {
                    alert('✅ ' + (data.message || 'تم تحديث البيانات بنجاح'));
                    loadUsers(currentPage);
                    loadUserDetails(id);
                } else {
                    alert('❌ ' + (data.message || 'حدث خطأ أثناء التحديث'));
                }
            } catch (error) {
                alert('❌ خطأ في الاتصال بالخادم');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });

        document.getElementById('resetBtn').addEventListener('click', function() {
            if (currentEditingId) loadUserDetails(currentEditingId);
        });

        // ============================================
        // 5. التهيئة الأولية
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            loadUsers(1);
        });
    </script>
</body>
</html>
