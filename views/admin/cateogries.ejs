<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<script src="/app-client.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة التصنيفات | دوق DOQ</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#9e2016",
                        "primary-container": "#c0392b",
                        "on-primary": "#ffffff",
                        "secondary": "#a23f00",
                        "secondary-container": "#fc7127",
                        "on-secondary": "#ffffff",
                        "background": "#fff8f6",
                        "surface": "#fff8f6",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#fff0ee",
                        "surface-container": "#ffe9e6",
                        "surface-container-high": "#fce2de",
                        "on-surface": "#261816",
                        "on-surface-variant": "#59413d",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "outline-variant": "#e1bfb9"
                    },
                    fontFamily: {
                        sans: ["Cairo", "sans-serif"],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #e1bfb9; border-radius: 10px; }
        
        .slide-in-right { animation: slideInRight 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
        @keyframes slideInRight { from { opacity: 0; transform: translateX(100%); } to { opacity: 1; transform: translateX(0); } }
        
        .zoom-in { animation: zoomIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
        @keyframes zoomIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
    </style>
</head>
<body class="bg-background text-on-surface antialiased">

    <!-- استدعاء الشريط الجانبي -->
    <%- include('../partials/admin_sidebar', { activePage: 'categories' }) %>

    <!-- Header -->
    <header class="fixed top-0 right-0 lg:right-72 left-0 h-16 bg-surface/80 backdrop-blur-xl shadow-sm z-40 flex items-center justify-between px-4 md:px-8">
        <div class="flex items-center gap-3 flex-1">
            <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-on-surface text-[24px]">menu</span>
            </button>
            <div class="flex items-center gap-2 text-sm text-on-surface-variant">
                <span class="material-symbols-outlined text-[18px] hidden sm:inline">home</span>
                <span class="hidden sm:inline">/</span>
                <span class="text-on-surface font-semibold">إدارة التصنيفات</span>
            </div>
            <div class="hidden md:flex items-center gap-2 bg-surface-container-low px-3 py-1.5 rounded-full mr-2">
                <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
                <span class="text-xs text-on-surface-variant">المنصة تعمل بنشاط</span>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <div class="w-9 h-9 rounded-full bg-primary flex items-center justify-center text-white font-bold">
                <%= currentUser && currentUser.first_name ? currentUser.first_name.charAt(0).toUpperCase() : 'أ' %>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="pt-20 pb-16 px-4 md:px-8 lg:pr-72 min-h-screen bg-surface transition-all duration-300">
        
        <!-- Page Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 md:mb-8">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-primary mb-1 flex items-center gap-3">
                    <span class="material-symbols-outlined text-3xl md:text-4xl" style="font-variation-settings: 'FILL' 1;">category</span>
                    إدارة التصنيفات
                </h1>
                <p class="text-on-surface-variant text-sm md:text-base">إدارة وتنظيم تصنيفات الأطباق في المنصة</p>
            </div>
            <button onclick="openAddModal()" class="w-full sm:w-auto px-6 py-2.5 bg-primary text-white rounded-xl font-bold hover:bg-primary-container transition-all active:scale-95 flex items-center justify-center gap-2 shadow-sm">
                <span class="material-symbols-outlined text-[20px]">add</span>
                إضافة تصنيف جديد
            </button>
        </div>

        <!-- Table Container -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm min-w-[700px]">
                    <thead>
                        <tr class="border-b border-surface-container text-on-surface-variant text-right bg-surface-container-low/50">
                            <th class="p-4 font-bold text-xs whitespace-nowrap">#</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap">اسم التصنيف</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap hidden md:table-cell">الوصف</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap text-center">عدد الأطباق</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap hidden lg:table-cell">تاريخ الإنشاء</th>
                            <th class="p-4 font-bold text-xs whitespace-nowrap text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="categoriesTableBody">
                        <!-- سيتم تعبئة هذا الجزء بواسطة JavaScript -->
                        <tr>
                            <td colspan="6" class="p-12 text-center text-on-surface-variant">
                                <div class="flex flex-col items-center gap-3">
                                    <div class="w-8 h-8 border-[3px] border-primary border-t-transparent rounded-full animate-spin"></div>
                                    <p class="font-bold">جاري تحميل التصنيفات...</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- ============================================ -->
    <!-- Modal: إضافة تصنيف جديد -->
    <!-- ============================================ -->
    <div id="addModal" class="fixed inset-0 z-[60] bg-black/40 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 shadow-2xl zoom-in border border-outline-variant/30">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">add_circle</span>
                    إضافة تصنيف جديد
                </h2>
                <button onclick="closeModal('addModal')" class="p-2 rounded-lg hover:bg-surface-container transition-colors">
                    <span class="material-symbols-outlined text-on-surface-variant">close</span>
                </button>
            </div>
            
            <form id="addForm" onsubmit="submitAddForm(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">اسم التصنيف *</label>
                    <input id="addName" type="text" placeholder="مثال: أكلات مصرية" 
                           class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium" required>
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">الوصف</label>
                    <textarea id="addDescription" rows="3" placeholder="وصف مختصر للتصنيف..." 
                              class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium resize-none"></textarea>
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="submit" class="flex-1 bg-primary text-white py-2.5 rounded-xl font-bold hover:bg-primary-container transition-all active:scale-[0.98]">
                        إضافة التصنيف
                    </button>
                    <button type="button" onclick="closeModal('addModal')" class="flex-1 bg-surface-container-low text-on-surface-variant py-2.5 rounded-xl font-bold hover:bg-surface-container-high transition-all">
                        إلغاء
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- Modal: تعديل تصنيف -->
    <!-- ============================================ -->
    <div id="editModal" class="fixed inset-0 z-[60] bg-black/40 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 shadow-2xl zoom-in border border-outline-variant/30">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">edit</span>
                    تعديل التصنيف
                </h2>
                <button onclick="closeModal('editModal')" class="p-2 rounded-lg hover:bg-surface-container transition-colors">
                    <span class="material-symbols-outlined text-on-surface-variant">close</span>
                </button>
            </div>
            
            <form id="editForm" onsubmit="submitEditForm(event)" class="space-y-4">
                <input type="hidden" id="editId">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">اسم التصنيف *</label>
                    <input id="editName" type="text" placeholder="مثال: أكلات مصرية" 
                           class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium" required>
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">الوصف</label>
                    <textarea id="editDescription" rows="3" placeholder="وصف مختصر للتصنيف..." 
                              class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary text-on-surface outline-none text-sm font-medium resize-none"></textarea>
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="submit" class="flex-1 bg-primary text-white py-2.5 rounded-xl font-bold hover:bg-primary-container transition-all active:scale-[0.98]">
                        حفظ التغييرات
                    </button>
                    <button type="button" onclick="closeModal('editModal')" class="flex-1 bg-surface-container-low text-on-surface-variant py-2.5 rounded-xl font-bold hover:bg-surface-container-high transition-all">
                        إلغاء
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed top-24 left-4 md:left-8 z-[100] flex flex-col gap-3 pointer-events-none"></div>

    <script>
        // ============================================
        // Sidebar Toggle (من الـ Partial)
        // ============================================
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            if (sidebar.classList.contains('translate-x-full')) {
                sidebar.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                sidebar.classList.add('translate-x-full');
                overlay.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        // ============================================
        // Modal Management
        // ============================================
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
            document.getElementById(id).classList.add('flex');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            document.getElementById(id).classList.remove('flex');
        }

        function openAddModal() {
            document.getElementById('addForm').reset();
            openModal('addModal');
        }

        // ============================================
        // Fetch & Render Categories
        // ============================================
        async function loadCategories() {
            const tbody = document.getElementById('categoriesTableBody');
            try {
                // استخدام الـ Route الجديد الخاص بالأدمن
                const res = await fetch('/admin/api/v1/categories');
                const data = await res.json();

                if (data.status === 'success' && Array.isArray(data.data)) {
                    renderCategoriesTable(data.data);
                } else {
                    tbody.innerHTML = `
                        <tr><td colspan="6" class="p-12 text-center text-error">
                            <div class="flex flex-col items-center gap-3">
                                <span class="material-symbols-outlined text-4xl">error</span>
                                <p class="font-bold">فشل في تحميل البيانات</p>
                            </div>
                        </td></tr>`;
                }
            } catch (err) {
                console.error('Error:', err);
                tbody.innerHTML = `
                    <tr><td colspan="6" class="p-12 text-center text-error">
                        <div class="flex flex-col items-center gap-3">
                            <span class="material-symbols-outlined text-4xl">wifi_off</span>
                            <p class="font-bold">حدث خطأ في الاتصال بالخادم</p>
                        </div>
                    </td></tr>`;
            }
        }

        function renderCategoriesTable(categories) {
            const tbody = document.getElementById('categoriesTableBody');
            
            if (!categories || categories.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="p-12 text-center text-on-surface-variant">
                            <div class="flex flex-col items-center gap-3">
                                <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center">
                                    <span class="material-symbols-outlined text-4xl text-outline-variant">category</span>
                                </div>
                                <p class="font-bold text-on-surface">لا توجد تصنيفات حالياً</p>
                                <p class="text-sm">ابدأ بإضافة تصنيف جديد لتنظيم الأطباق</p>
                            </div>
                        </td>
                    </tr>`;
                return;
            }

            tbody.innerHTML = categories.map((cat, index) => `
                <tr class="border-b border-surface-container hover:bg-surface-container-low/60 transition-colors group">
                    <td class="p-4 text-on-surface-variant font-medium">${index + 1}</td>
                    <td class="p-4">
                        <div class="font-bold text-on-surface">${escapeHtml(cat.name)}</div>
                        <div class="text-xs text-on-surface-variant md:hidden mt-1 line-clamp-1">${escapeHtml(cat.description) || 'لا يوجد وصف'}</div>
                    </td>
                    <td class="p-4 text-on-surface-variant hidden md:table-cell max-w-xs truncate">${escapeHtml(cat.description) || '—'}</td>
                    <td class="p-4 text-center">
                        <span class="inline-flex items-center gap-1 font-semibold text-xs px-2.5 py-1 rounded-lg bg-primary/10 text-primary">
                            ${cat.dishes_count || 0}
                        </span>
                    </td>
                    <td class="p-4 text-on-surface-variant text-xs hidden lg:table-cell whitespace-nowrap">
                        ${new Date(cat.created_at).toLocaleDateString('ar-EG')}
                    </td>
                    <td class="p-4 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <button onclick="openEditModal(${cat.id})" class="w-8 h-8 rounded-lg flex items-center justify-center text-primary hover:bg-primary/10 transition-all" title="تعديل">
                                <span class="material-symbols-outlined text-[20px]">edit</span>
                            </button>
                            <button onclick="deleteCategory(${cat.id})" class="w-8 h-8 rounded-lg flex items-center justify-center text-error hover:bg-error/10 transition-all" title="حذف">
                                <span class="material-symbols-outlined text-[20px]">delete</span>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        // ============================================
        // Open Edit Modal & Fetch Single Category
        // ============================================
        function openEditModal(id) {
            // ملاحظة: تأكد من وجود هذا الـ Route في الـ Backend الخاص بك
            fetch('/categories/api/v1/' + id, {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'success') {
                    document.getElementById('editId').value = data.data.id;
                    document.getElementById('editName').value = data.data.name;
                    document.getElementById('editDescription').value = data.data.description || '';
                    openModal('editModal');
                } else {
                    showToast(data.message || 'حدث خطأ', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('حدث خطأ في الاتصال بالخادم', 'error');
            });
        }

        // ============================================
        // Form Submissions (بدون إعادة تحميل الصفحة)
        // ============================================
        function submitAddForm(e) {
            e.preventDefault();
            const name = document.getElementById('addName').value.trim();
            const description = document.getElementById('addDescription').value.trim();
            
            if (!name) {
                showToast('يرجى إدخال اسم التصنيف', 'error');
                return;
            }
            
            fetch('/categories/api/v1', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, description })
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'success') {
                    showToast('✅ ' + data.message, 'success');
                    closeModal('addModal');
                    loadCategories(); // تحديث الجدول فوراً بدون Reload
                } else {
                    showToast('❌ ' + data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('حدث خطأ في الاتصال بالخادم', 'error');
            });
        }

        function submitEditForm(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const name = document.getElementById('editName').value.trim();
            const description = document.getElementById('editDescription').value.trim();
            
            if (!name) {
                showToast('يرجى إدخال اسم التصنيف', 'error');
                return;
            }
            
            fetch('/categories/api/v1/' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, description })
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'success') {
                    showToast('✅ ' + data.message, 'success');
                    closeModal('editModal');
                    loadCategories(); // تحديث الجدول فوراً بدون Reload
                } else {
                    showToast('❌ ' + data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('حدث خطأ في الاتصال بالخادم', 'error');
            });
        }

        // ============================================
        // Delete Category
        // ============================================
        function deleteCategory(id) {
            Swal.fire({
                title: 'هل أنت متأكد؟',
                text: 'سيتم حذف هذا التصنيف نهائياً. لا يمكن التراجع عن هذا الإجراء.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ba1a1a',
                cancelButtonColor: '#59413d',
                confirmButtonText: 'نعم، حذف',
                cancelButtonText: 'إلغاء',
                customClass: { popup: 'rounded-2xl font-["Cairo"]' }
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/categories/api/v1/' + id, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'success') {
                            showToast('✅ ' + data.message, 'success');
                            loadCategories(); // تحديث الجدول فوراً بدون Reload
                        } else {
                            showToast('❌ ' + data.message, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showToast('حدث خطأ في الاتصال بالخادم', 'error');
                    });
                }
            });
        }

        // ============================================
        // Toast Notification
        // ============================================
        function showToast(message, type) {
            type = type || 'success';
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            const theme = type === 'success' 
                ? 'bg-surface-container-lowest border-r-4 border-[#15803d] text-on-surface' 
                : 'bg-surface-container-lowest border-r-4 border-error text-on-surface';
            const iconColor = type === 'success' ? 'text-[#15803d]' : 'text-error';
            const icon = type === 'success' ? 'check_circle' : 'error';

            toast.className = theme + ' px-4 py-3 rounded-xl shadow-lg flex items-center gap-3 slide-in-right border border-outline-variant/30 pointer-events-auto';
            toast.innerHTML = `
                <span class="material-symbols-outlined text-xl ${iconColor}" style="font-variation-settings: 'FILL' 1;">${icon}</span>
                <span class="font-bold text-sm">${message}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                toast.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
                setTimeout(() => { if(toast.parentElement) toast.remove(); }, 400);
            }, 4000);
        }

        // ============================================
        // Helper: Escape HTML to prevent XSS
        // ============================================
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // ============================================
        // Initialization
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            loadCategories();
        });
    </script>
</body>
</html>