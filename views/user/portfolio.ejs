        function renderStars(rating) {
            let html = '';
            for (let i = 1; i <= 5; i++) {
                html += `<span class="material-symbols-outlined text-[16px] ${i <= rating ? 'star-filled' : 'star-empty'}" style="font-variation-settings: 'FILL' ${i <= rating ? '1' : '0'};">star</span>`;
            }
            return html;
        }

        // ==========================================
        // دوال تعديل وحذف التقييم (تم تحديثها)
        // ==========================================
        
        function openEditModal(reviewId) {
            const review = currentReviewsData.find(r => r.id === reviewId);
            if (!review) return;

            document.getElementById('editReviewId').value = review.id;
            document.getElementById('editRating').value = review.rating;
            document.getElementById('editComment').value = review.comment || '';
            
            renderEditStars(review.rating);
            document.getElementById('editReviewModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeEditModal() {
            document.getElementById('editReviewModal').classList.add('hidden');
            document.body.style.overflow = '';
        }

        function renderEditStars(currentRating) {
            const container = document.getElementById('editStarContainer');
            container.innerHTML = '';
            for (let i = 5; i >= 1; i--) {
                const star = document.createElement('span');
                star.className = `material-symbols-outlined text-[32px] cursor-pointer transition-colors ${i <= currentRating ? 'text-secondary' : 'text-outline-variant'}`;
                star.style.fontVariationSettings = `'FILL' ${i <= currentRating ? 1 : 0}`;
                star.textContent = 'star';
                star.onclick = () => {
                    document.getElementById('editRating').value = i;
                    renderEditStars(i); // إعادة رسم النجوم لتحديث الشكل
                };
                container.appendChild(star);
            }
        }

        // إرسال طلب التعديل للـ Backend
        document.getElementById('editReviewForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const reviewId = document.getElementById('editReviewId').value;
            const rating = parseInt(document.getElementById('editRating').value);
            const comment = document.getElementById('editComment').value;

            if (!rating) {
                alert('يرجى اختيار تقييم');
                return;
            }

            try {
                const res = await fetch(`/reviews/v1/api/${reviewId}`, {
                    method: 'PATCH', // استخدام PATCH للتحديث الجزئي كما هو معرف في الـ Controller
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rating, comment })
                });
                
                const data = await res.json();
                if (data.status === 'success') {
                    alert('تم تحديث التقييم بنجاح');
                    closeEditModal();
                    renderContent(); // إعادة تحميل المحتوى لعرض التعديلات
                } else {
                    alert('حدث خطأ: ' + (data.message || 'فشل في تحديث التقييم'));
                }
            } catch (err) {
                alert('حدث خطأ في الاتصال');
            }
        });

        async function deleteReview(id) {
            if (!confirm('هل أنت متأكد من حذف هذا التقييم؟')) return;
            try {
                const res = await fetch(`/reviews/v1/api/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.status === 'success') {
                    alert('تم الحذف بنجاح');
                    renderContent();
                } else {
                    alert('حدث خطأ: ' + (data.message || ''));
                }
            } catch (err) { alert('حدث خطأ في الاتصال'); }
        }

