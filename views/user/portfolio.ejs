                                            <div class="w-16 h-16 rounded-xl bg-surface overflow-hidden flex-shrink-0">
                                                ${r.dish_image ? `<img src="${DOQ.safeImage(r.dish_image)}" class="w-full h-full object-cover">` : 
                                                `<div class="w-full h-full flex items-center justify-center"><span class="material-symbols-outlined text-outline-variant text-[32px]" style="font-variation-settings: 'FILL' 0;">restaurant</span></div>`}
                                            </div>
                                            <div class="flex-1">
                                                <div class="flex items-start justify-between mb-2 flex-wrap gap-2">
                                                    <div>
                                                        <h4 class="font-cairo font-bold text-lg text-on-surface">${DOQ.escape(r.dish_name || 'طبق')}</h4>
                                                        <p class="text-sm text-secondary font-medium">${DOQ.escape(r.kitchen_name || '')}</p>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <div class="flex gap-0.5">${renderStars(r.rating)}</div>
                                                        <span class="text-sm font-bold text-primary">${r.rating}/5</span>
                                                    </div>
                                                </div>
                                                ${r.comment ? `<p class="text-on-surface-variant bg-surface p-3 rounded-xl mb-2 leading-relaxed">"${DOQ.escape(r.comment)}"</p>` : ''}
                                                <div class="flex items-center justify-between">
                                                    <span class="text-xs text-outline">${new Date(r.created_at).toLocaleDateString('ar-EG', {year: 'numeric', month: 'long', day: 'numeric'})}</span>
                                                    <div class="flex gap-2">
                                                        <button onclick="openEditModal(${r.id})" class="text-xs bg-primary/10 text-primary px-3 py-1.5 rounded-lg font-bold hover:bg-primary/20 transition-all flex items-center gap-1">
                                                            <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 0;">edit</span>
                                                            تعديل
                                                        </button>
                                                        <button onclick="deleteReview(${r.id})" class="text-xs bg-error/10 text-error px-3 py-1.5 rounded-lg font-bold hover:bg-error/20 transition-all flex items-center gap-1">
                                                            <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 0;">delete</span>
                                                            حذف
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                            ${pagination.total_pages > 1 ? `
                                <div class="flex justify-center gap-2 mt-6">
                                    ${Array.from({length: pagination.total_pages}, (_, i) => i + 1).map(p => `
                                        <button onclick="loadReviewsPage(${p})" class="w-10 h-10 rounded-lg ${p === pagination.page ? 'bg-primary text-white' : 'bg-surface-container-low text-on-surface-variant hover:bg-surface-container'} font-bold transition-all">${p}</button>
                                    `).join('')}
                                </div>
                            ` : ''}
                        </div>
                    `;
                }
            } catch (err) {
                container.innerHTML = '<div class="text-center py-12 text-error">حدث خطأ في تحميل التقييمات</div>';
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderTabs();
            renderContent();
        });
    </script>
</body>
</html>
