<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<script src="/app-client.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ملفي الشخصي - دوق DOQ</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#9e2016", "primary-container": "#c0392b", "on-primary": "#ffffff",
                        "secondary": "#a23f00", "secondary-container": "#fc7127",
                        "background": "#fff8f6", "surface": "#fff8f6",
                        "surface-container": "#ffe9e6", "surface-container-low": "#fff0ee",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#261816", "on-surface-variant": "#59413d",
                        "outline": "#8d706c", "outline-variant": "#e1bfb9",
                        "tertiary": "#005875", "tertiary-container": "#007296", "on-tertiary": "#ffffff",
                        "error": "#ba1a1a", "error-container": "#ffdad6"
                    },
                    fontFamily: { "cairo": ["Cairo", "sans-serif"], "tajawal": ["Tajawal", "sans-serif"] }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #fff8f6; }
        .cairo-font { font-family: 'Cairo', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        .material-symbols-filled { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        .fade-in { animation: fadeIn 0.5s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .tab-active { background: linear-gradient(135deg, #9e2016 0%, #c0392b 100%); color: white; box-shadow: 0 4px 12px rgba(158, 32, 22, 0.25); }
        .tab-inactive { background: white; color: #59413d; border: 1px solid #e1bfb9; }
        .tab-inactive:hover { background: #fff0ee; color: #9e2016; }
        .glass-card { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(225, 191, 185, 0.3); }
        .gradient-cover { background: linear-gradient(135deg, #9e2016 0%, #c0392b 50%, #fc7127 100%); }
        .star-filled { color: #fc7127; font-variation-settings: 'FILL' 1; }
        .star-empty { color: #e1bfb9; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen">

    <%- include('../partials/header.ejs') %>

    <main class="pb-16">
        <% const userRole = currentUser?.roles || 'customer'; %>
        
        <!-- HERO SECTION -->
        <div class="relative h-56 md:h-72 w-full gradient-cover overflow-hidden">
            <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 50%, white 1px, transparent 1px); background-size: 30px 30px;"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
        </div>

        <!-- PROFILE HEADER -->
        <div class="max-w-6xl mx-auto px-4 -mt-20 relative z-10">
            <div class="glass-card rounded-3xl p-6 md:p-8 shadow-xl fade-in">
                <div class="flex flex-col md:flex-row items-center md:items-end gap-6">
                    <div class="relative -mt-16 md:-mt-20">
                        <div class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-white p-1 shadow-2xl">
                            <img  
                                class="w-full h-full rounded-full object-cover"
                                src="<%= currentUser.portfolio_url || '/assests/avatar.jpeg' %>" 
                                alt="<%= currentUser?.first_name ? currentUser.first_name.charAt(0).toUpperCase() : '?' %>">
                        </div>
                        <div class="absolute -bottom-1 -right-1 w-12 h-12 rounded-full bg-white shadow-lg flex items-center justify-center border-4 border-background">
                            <% if (userRole === 'admin') { %>
                                <span class="material-symbols-outlined text-[24px] text-error" style="font-variation-settings: 'FILL' 1;">admin_panel_settings</span>
                            <% } else if (userRole === 'chef') { %>
                                <span class="material-symbols-outlined text-[24px] text-secondary-container" style="font-variation-settings: 'FILL' 1;">restaurant</span>
                            <% } else { %>
                                <span class="material-symbols-outlined text-[24px] text-tertiary" style="font-variation-settings: 'FILL' 1;">person</span>
                            <% } %>
                        </div>
                    </div>

                    <div class="flex-1 text-center md:text-right md:pb-2">
                        <h1 class="text-2xl md:text-4xl font-cairo font-bold text-on-surface mb-2">
                            <%= currentUser?.first_name || '' %> <%= currentUser?.last_name || '' %>
                        </h1>
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-bold mb-3 <%= 
                            userRole === 'admin' ? 'bg-red-100 text-red-700' : 
                            (userRole === 'chef' ? 'bg-orange-100 text-orange-700' : 'bg-blue-100 text-blue-700') 
                        %>">
                            <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                            <%= userRole === 'admin' ? 'مسؤول النظام' : (userRole === 'chef' ? 'طباخ محترف' : 'عميل مميز') %>
                        </div>
                        <div class="flex flex-wrap justify-center md:justify-start gap-4 text-on-surface-variant text-sm">
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[18px] text-primary" style="font-variation-settings: 'FILL' 0;">mail</span>
                                <span><%= currentUser?.email || '' %></span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[18px] text-primary" style="font-variation-settings: 'FILL' 0;">call</span>
                                <span><%= currentUser?.phone_number || 'غير محدد' %></span>
                            </div>
                            <% if (currentUser?.city) { %>
                            <div class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[18px] text-primary" style="font-variation-settings: 'FILL' 0;">location_on</span>
                                <span><%= currentUser.city %></span>
                            </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="flex flex-col gap-2">
                        <a href="/users/settings" class="flex items-center justify-center gap-2 bg-primary text-white px-6 py-3 rounded-xl font-bold hover:bg-primary-container transition-all shadow-lg">
                            <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 0;">settings</span>
                            <span class="text-sm">الإعدادات</span>
                        </a>
                        <div class="bg-surface-container-low px-6 py-3 rounded-xl border border-outline-variant/30 text-center">
                            <div class="text-2xl font-cairo font-bold text-primary" id="mainStat">-</div>
                            <div class="text-xs text-on-surface-variant">
                                <%= userRole === 'chef' ? 'إجمالي الأطباق' : 'التقييمات' %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABS -->
        <div class="max-w-6xl mx-auto px-4 mt-8">
            <div class="flex gap-3 overflow-x-auto hide-scrollbar pb-2" id="tabsContainer"></div>
        </div>

        <!-- TAB CONTENT -->
        <div class="max-w-6xl mx-auto px-4 mt-6" id="tabContent">
            <div class="text-center py-12"><div class="w-10 h-10 border-4 border-primary border-t-transparent rounded-full animate-spin mx-auto"></div></div>
        </div>
    </main>

    <!-- ========================================== -->
    <!-- Edit Review Modal (تمت إضافته) -->
    <!-- ========================================== -->
    <div id="editReviewModal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 shadow-2xl border border-outline-variant/30 fade-in">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-xl font-cairo font-bold text-on-surface">تعديل التقييم</h3>
                <button onclick="closeEditModal()" class="p-2 hover:bg-surface-container rounded-full transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <form id="editReviewForm">
                <input type="hidden" id="editReviewId">
                
                <!-- Star Rating Selector -->
                <div class="mb-4">
                    <label class="block text-sm font-bold text-on-surface-variant mb-2">التقييم</label>
                    <div class="flex gap-1 flex-row-reverse justify-end" id="editStarContainer">
                        <!-- Stars will be generated by JS -->
                    </div>
                    <input type="hidden" id="editRating" required>
                </div>

                <!-- Comment -->
                <div class="mb-6">
                    <label class="block text-sm font-bold text-on-surface-variant mb-2">التعليق</label>
                    <textarea id="editComment" rows="3" class="w-full bg-surface-container-low border border-outline-variant rounded-xl p-3 focus:border-primary focus:ring-1 focus:ring-primary resize-none" placeholder="اكتب تعليقك الجديد هنا..."></textarea>
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="flex-1 bg-primary text-white py-3 rounded-xl font-bold hover:bg-primary-container transition-all">حفظ التعديلات</button>
                    <button type="button" onclick="closeEditModal()" class="flex-1 bg-surface-container text-on-surface-variant py-3 rounded-xl font-bold hover:bg-surface-container-high transition-colors">إلغاء</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>

    <script>
        const currentUser = <%- JSON.stringify(currentUser || null) %>;
        const userRole = currentUser?.roles || 'customer';
        let currentTab = 'overview';
        let currentReviewsData = []; // متغير عالمي لحفظ بيانات التقييمات الحالية لاستخدامها في التعديل

        const tabsConfig = {
            customer: [
                { id: 'overview', label: 'نظرة عامة', icon: 'dashboard' },
                { id: 'reviews', label: 'تقييماتي', icon: 'rate_review' },
                { id: 'activity', label: 'النشاط', icon: 'history' }
            ],
            chef: [
                { id: 'overview', label: 'نظرة عامة', icon: 'dashboard' },
                { id: 'kitchen', label: 'مطبخي', icon: 'storefront' },
                { id: 'dishes', label: 'أطباقي', icon: 'flatware' }
            ],
            admin: [
                { id: 'overview', label: 'نظرة عامة', icon: 'dashboard' },
                { id: 'stats', label: 'الإحصائيات', icon: 'analytics' }
            ]
        };

        function renderTabs() {
            const container = document.getElementById('tabsContainer');
            const tabs = tabsConfig[userRole] || tabsConfig.customer;
            container.innerHTML = tabs.map(tab => `
                <button onclick="switchTab('${tab.id}')" id="tab-${tab.id}"
                        class="tab-${tab.id === currentTab ? 'active' : 'inactive'} 
                               flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all">
                    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' ${tab.id === currentTab ? '1' : '0'};">${tab.icon}</span>
                    ${tab.label}
                </button>
            `).join('');
        }

        function switchTab(tabId) {
            currentTab = tabId;
            renderTabs();
            renderContent();
        }

        async function renderContent() {
            const container = document.getElementById('tabContent');
            container.innerHTML = '<div class="text-center py-12"><div class="w-10 h-10 border-4 border-primary border-t-transparent rounded-full animate-spin mx-auto"></div></div>';

            if (currentTab === 'overview') await renderOverview(container);
            else if (currentTab === 'reviews') await renderCustomerReviews(container);
            else if (currentTab === 'kitchen') await renderChefKitchen(container);
            else if (currentTab === 'dishes') await renderChefDishes(container);
            else if (currentTab === 'activity') await renderCustomerActivity(container);
            else if (currentTab === 'stats') await renderAdminStats(container);
        }

        async function renderOverview(container) {
            if (userRole === 'customer') {
                try {
                    const res = await fetch('/reviews/v1/api/my?page=1&limit=5');
                    const data = await res.json();
                    if (data.status === 'success') {
                        const reviews = data.data || [];
                        const total = data.pagination?.total || 0;
                        document.getElementById('mainStat').textContent = total;
                        const avgRating = reviews.length > 0 ? (reviews.reduce((a, r) => a + r.rating, 0) / reviews.length).toFixed(1) : '0.0';

                        container.innerHTML = `
                            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 fade-in">
                                <div class="lg:col-span-2 glass-card rounded-3xl p-6 md:p-8 border border-outline-variant/30">
                                    <h2 class="font-cairo font-bold text-2xl text-on-surface mb-4 flex items-center gap-2">
                                        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 0;">waving_hand</span>
                                        أهلاً بك، ${DOQ.escape(currentUser.first_name || '')}! 👋
                                    </h2>
                                    <p class="text-on-surface-variant mb-6 leading-relaxed">
                                        هنا يمكنك متابعة جميع تقييماتك للأطباق، واكتشاف أطباق جديدة، والتواصل مع أفضل المطابخ في دوق.
                                    </p>
                                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                        <a href="/dishes" class="bg-primary/10 hover:bg-primary/20 text-primary p-4 rounded-2xl transition-all flex flex-col items-center gap-2">
                                            <span class="material-symbols-outlined text-[32px]" style="font-variation-settings: 'FILL' 0;">restaurant</span>
                                            <span class="text-sm font-bold">تصفح الأطباق</span>
                                        </a>
                                        <a href="/kitchens" class="bg-secondary-container/10 hover:bg-secondary-container/20 text-secondary p-4 rounded-2xl transition-all flex flex-col items-center gap-2">
                                            <span class="material-symbols-outlined text-[32px]" style="font-variation-settings: 'FILL' 0;">storefront</span>
                                            <span class="text-sm font-bold">استكشف المطابخ</span>
                                        </a>
                                        <a href="/reviews/my-reviews" class="bg-tertiary/10 hover:bg-tertiary/20 text-tertiary p-4 rounded-2xl transition-all flex flex-col items-center gap-2">
                                            <span class="material-symbols-outlined text-[32px]" style="font-variation-settings: 'FILL' 0;">rate_review</span>
                                            <span class="text-sm font-bold">كل تقييماتي</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="glass-card rounded-3xl p-6 border border-outline-variant/30">
                                    <h3 class="font-cairo font-bold text-lg text-on-surface mb-4 flex items-center gap-2">
                                        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 0;">insights</span>
                                        إحصائياتي
                                    </h3>
                                    <div class="space-y-3">
                                        <div class="bg-surface-container-low p-4 rounded-2xl">
                                            <div class="flex items-center justify-between">
                                                <span class="text-on-surface-variant text-sm">التقييمات</span>
                                                <span class="font-cairo font-bold text-2xl text-primary">${total}</span>
                                            </div>
                                        </div>
                                        <div class="bg-surface-container-low p-4 rounded-2xl">
                                            <div class="flex items-center justify-between">
                                                <span class="text-on-surface-variant text-sm">متوسط التقييم</span>
                                                <span class="font-cairo font-bold text-2xl text-secondary">${avgRating}</span>
                                            </div>
                                        </div>
                                        <div class="bg-surface-container-low p-4 rounded-2xl">
                                            <div class="flex items-center justify-between">
                                                <span class="text-on-surface-variant text-sm">تاريخ الانضمام</span>
                                                <span class="font-cairo font-bold text-sm text-tertiary">${new Date(currentUser.created_at).toLocaleDateString('ar-EG', {year: 'numeric', month: 'short'})}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-6 glass-card rounded-3xl p-6 md:p-8 border border-outline-variant/30 fade-in">
                                <div class="flex items-center justify-between mb-6">
                                    <h3 class="font-cairo font-bold text-xl text-on-surface flex items-center gap-2">
                                        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 0;">rate_review</span>
                                        آخر تقييماتي
                                    </h3>
                                    ${reviews.length > 0 ? `<a href="/reviews/my-reviews" class="text-primary text-sm font-bold hover:underline">عرض الكل ←</a>` : ''}
                                </div>
                                ${reviews.length === 0 ? `
                                    <div class="text-center py-12">
                                        <span class="material-symbols-outlined text-6xl text-outline-variant mb-3" style="font-variation-settings: 'FILL' 0;">rate_review</span>
                                        <p class="text-on-surface-variant mb-4">لم تقم بتقييم أي طبق بعد</p>
                                        <a href="/dishes" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-xl font-bold hover:bg-primary-container transition-all">
                                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">restaurant</span>
                                            ابدأ التقييم الآن
                                        </a>
                                    </div>
                                ` : `
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        ${reviews.map(r => `
                                            <div class="bg-surface-container-low p-4 rounded-2xl border border-outline-variant/20 hover:border-primary/30 transition-all">
                                                <div class="flex items-start gap-3">
                                                    <div class="w-12 h-12 rounded-xl bg-surface overflow-hidden flex-shrink-0">
                                                        ${r.dish_image ? `<img src="${DOQ.safeImage(r.dish_image)}" class="w-full h-full object-cover">` : 
                                                        `<div class="w-full h-full flex items-center justify-center"><span class="material-symbols-outlined text-outline-variant" style="font-variation-settings: 'FILL' 0;">restaurant</span></div>`}
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <div class="flex items-center justify-between mb-1">
                                                            <h4 class="font-bold text-on-surface truncate">${DOQ.escape(r.dish_name || 'طبق')}</h4>
                                                            <div class="flex gap-0.5">${renderStars(r.rating)}</div>
                                                        </div>
                                                        <p class="text-xs text-secondary font-medium mb-1">${DOQ.escape(r.kitchen_name || '')}</p>
                                                        <p class="text-sm text-on-surface-variant line-clamp-2">"${DOQ.escape(r.comment || 'لا يوجد تعليق')}"</p>
                                                        <p class="text-xs text-outline mt-2">${new Date(r.created_at).toLocaleDateString('ar-EG')}</p>
                                                    </div>
                                                </div>
                                            </div>
                                        `).join('')}
                                    </div>
                                `}
                            </div>
                        `;
                    }
                } catch (err) {
                    container.innerHTML = '<div class="text-center py-12 text-error">حدث خطأ في تحميل البيانات</div>';
                }
            } else if (userRole === 'chef') {
                try {
                    const [kRes, dRes] = await Promise.all([
                        fetch('/kitchens/api/v1/my'),
                        fetch('/dishes/v1/api/my?limit=1')
                    ]);
                    const kData = await kRes.json();
                    const dData = await dRes.json();
                    const kitchen = kData.data?.[0] || kData.data;
                    const dishesCount = dData.pagination?.total || 0;
                    document.getElementById('mainStat').textContent = dishesCount;

                    container.innerHTML = `
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 fade-in">
                            <div class="lg:col-span-2 glass-card rounded-3xl p-6 md:p-8 border border-outline-variant/30">
                                <h2 class="font-cairo font-bold text-2xl text-on-surface mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-secondary-container" style="font-variation-settings: 'FILL' 0;">storefront</span>
                                    ${DOQ.escape(kitchen?.title || 'مطبخي')}
                                </h2>
                                <p class="text-on-surface-variant mb-6">${DOQ.escape(kitchen?.description || 'لا يوجد وصف')}</p>
                                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
                                    <div class="bg-surface-container-low p-3 rounded-xl text-center">
                                        <div class="text-2xl font-cairo font-bold text-primary">${dishesCount}</div>
                                        <div class="text-xs text-on-surface-variant">طبق</div>
                                    </div>
                                    <div class="bg-surface-container-low p-3 rounded-xl text-center">
                                        <div class="text-2xl font-cairo font-bold text-secondary">-</div>
                                        <div class="text-xs text-on-surface-variant">تقييم</div>
                                    </div>
                                    <div class="bg-surface-container-low p-3 rounded-xl text-center">
                                        <div class="text-2xl font-cairo font-bold text-tertiary">${DOQ.escape(kitchen?.city || '-')}</div>
                                        <div class="text-xs text-on-surface-variant">المدينة</div>
                                    </div>
                                    <div class="bg-surface-container-low p-3 rounded-xl text-center">
                                        <div class="text-2xl font-cairo font-bold text-primary">نشط</div>
                                        <div class="text-xs text-on-surface-variant">الحالة</div>
                                    </div>
                                </div>
                                <div class="flex flex-wrap gap-3">
                                    <a href="/kitchens/my" class="bg-primary text-white px-5 py-2.5 rounded-xl font-bold hover:bg-primary-container transition-all flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 0;">edit</span>
                                        تعديل المطبخ
                                    </a>
                                    <a href="/dishes" class="bg-surface-container text-on-surface px-5 py-2.5 rounded-xl font-bold hover:bg-surface-container-high transition-all flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 0;">flatware</span>
                                        إدارة الأطباق
                                    </a>
                                    <a href="/users/dashboard" class="bg-surface-container text-on-surface px-5 py-2.5 rounded-xl font-bold hover:bg-surface-container-high transition-all flex items-center gap-2">
                                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 0;">dashboard</span>
                                        لوحة التحكم
                                    </a>
                                </div>
                            </div>
                            <div class="glass-card rounded-3xl p-6 border border-outline-variant/30">
                                <h3 class="font-cairo font-bold text-lg text-on-surface mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 0;">bolt</span>
                                    إجراءات سريعة
                                </h3>
                                <div class="space-y-2">
