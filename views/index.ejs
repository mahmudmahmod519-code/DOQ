<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>دوق | Dhouq - فن التذوق المنزلي</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&amp;family=Be+Vietnam+Pro:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "surface-tint": "#b02d21",
                    "surface-container-low": "#fff0ee",
                    "on-primary-container": "#ffe5e1",
                    "secondary-container": "#fc7127",
                    "primary-fixed": "#ffdad5",
                    "on-primary-fixed": "#410000",
                    "inverse-primary": "#ffb4a9",
                    "outline-variant": "#e1bfb9",
                    "inverse-on-surface": "#ffedea",
                    "primary-container": "#c0392b",
                    "on-background": "#261816",
                    "on-secondary-fixed-variant": "#7c2e00",
                    "on-primary": "#ffffff",
                    "surface-container-highest": "#f7ddd9",
                    "surface-container-high": "#fce2de",
                    "on-tertiary": "#ffffff",
                    "on-error-container": "#93000a",
                    "surface": "#fff8f6",
                    "on-error": "#ffffff",
                    "tertiary-fixed-dim": "#80d0f8",
                    "on-surface-variant": "#59413d",
                    "error": "#ba1a1a",
                    "on-secondary-container": "#5c2000",
                    "surface-container-lowest": "#ffffff",
                    "inverse-surface": "#3c2d2a",
                    "primary": "#9e2016",
                    "tertiary-fixed": "#c0e8ff",
                    "surface-container": "#ffe9e6",
                    "secondary-fixed": "#ffdbcd",
                    "error-container": "#ffdad6",
                    "on-primary-fixed-variant": "#8e130c",
                    "on-secondary": "#ffffff",
                    "tertiary-container": "#007296",
                    "surface-variant": "#f7ddd9",
                    "tertiary": "#005875",
                    "surface-bright": "#fff8f6",
                    "outline": "#8d706c",
                    "on-secondary-fixed": "#351000",
                    "secondary": "#a23f00",
                    "primary-fixed-dim": "#ffb4a9",
                    "on-tertiary-fixed-variant": "#004d66",
                    "on-tertiary-fixed": "#001e2b",
                    "on-surface": "#261816",
                    "surface-dim": "#eed4d1",
                    "on-tertiary-container": "#d3eeff",
                    "background": "#fff8f6",
                    "secondary-fixed-dim": "#ffb595"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "2xl": "1rem",
                    "full": "9999px"
            },
            "spacing": {
                    "md": "24px",
                    "lg": "48px",
                    "container-max": "1280px",
                    "base": "8px",
                    "xs": "4px",
                    "xl": "80px",
                    "sm": "12px",
                    "gutter": "24px"
            },
            "fontFamily": {
                    "cairo": ["Cairo", "sans-serif"],
                    "beVietnamPro": ["beVietnamPro", "sans-serif"],
                    "label-sm": ["beVietnamPro"],
                    "headline-md": ["beVietnamPro"],
                    "body-md": ["beVietnamPro"],
                    "display-lg": ["beVietnamPro"],
                    "body-lg": ["beVietnamPro"]
            }
          }
        }
      }
    </script>
<style>
        body { font-family: 'Cairo', sans-serif; background-color: #fff8f6; }
        .font-beVietnamPro { font-family: 'beVietnamPro', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .glass-effect { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
        .culinary-shadow { box-shadow: 0px 4px 20px rgba(192, 57, 43, 0.08); }
        .hero-overlay { background: linear-gradient(to bottom, rgba(38, 24, 22, 0.4), rgba(38, 24, 22, 0.7)); }
        .tasting-bar-active { border: 2px solid #fc7127; box-shadow: 0 0 10px rgba(252, 113, 39, 0.3); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="text-on-surface selection:bg-primary selection:text-white">

<!-- Top Navigation Bar -->
<header class="fixed top-0 w-full z-50 bg-surface/80 dark:bg-surface-container-lowest/80 backdrop-blur-md border-b border-outline-variant/20 shadow-sm">
<nav class="flex flex-row-reverse justify-between items-center px-lg py-md max-w-container-max mx-auto h-20">
    <!-- Brand Logo -->
    <div class="flex items-center gap-sm">
        <span class="text-headline-md font-bold text-primary">دوق</span>
    </div>
    
    <!-- Navigation Links -->
    <div class="hidden md:flex items-center gap-lg">
        <a class="text-primary border-b-2 border-primary pb-1 font-semibold" href="/">الرئيسية</a>
        <a class="text-on-surface-variant hover:text-primary transition-colors" href="/all-portfolios">تصفح المطابخ</a>
        <a class="text-on-surface-variant hover:text-primary transition-colors" href="/auth">انضم كطباخ</a>
        <a class="text-on-surface-variant hover:text-primary transition-colors" href="/about">من نحن</a>
        <a class="text-on-surface-variant hover:text-primary transition-colors" href="/faqs">الأسئلة الشائعة</a>
    </div>
    
    <!-- Trailing Actions -->
    <div class="flex items-center gap-md">
        <% if (locals.currentUser) { %>
            <a href="/vendor-dashboard" class="bg-primary text-on-primary px-lg py-2 rounded-full font-bold hover:scale-105 active:scale-95 transition-all duration-300">
                لوحة التحكم
            </a>
        <% } else { %>
            <a href="/auth" class="bg-primary text-on-primary px-lg py-2 rounded-full font-bold hover:scale-105 active:scale-95 transition-all duration-300">
                تسجيل الدخول
            </a>
        <% } %>
    </div>
</nav>
</header>

<main class="pt-20">

<!-- Hero Section -->
<section class="relative h-[85vh] min-h-[600px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <div class="w-full h-full bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1547928576-a4a33237eceb?auto=format&fit=crop&w=1920&q=80');"></div>
        <div class="absolute inset-0 hero-overlay"></div>
    </div>
    <div class="relative z-10 w-full max-w-4xl px-md text-center">
        <h1 class="text-white text-display-lg md:text-display-lg font-extrabold mb-md tracking-tight leading-tight">
            دوق أطيب الأكلات المنزلية <br>
            <span class="text-secondary-container">من أشهر الطهاة في منطقتك</span>
        </h1>
        <p class="text-on-primary-container text-body-lg mb-lg opacity-90">
            اكتشف مطابخ منزلية موثوقة، واستمتع بوجبات طازجة بطعم البيوت
        </p>
        
        <!-- Search & Filter Bar -->
        <form class="bg-white/95 backdrop-blur-sm p-sm rounded-2xl md:rounded-full shadow-2xl flex flex-col md:flex-row items-center gap-xs culinary-shadow border border-white/20" action="/all-portfolios" method="GET">
            <div class="flex-1 w-full flex items-center px-md border-b md:border-b-0 md:border-l border-outline-variant/30 py-2">
                <span class="material-symbols-outlined text-primary ml-2">search</span>
                <input class="w-full bg-transparent border-none focus:ring-0 text-on-surface text-body-md placeholder:text-outline" placeholder="ابحث عن مطبخ أو أكلة..." type="text" name="q">
            </div>
            <div class="flex flex-col md:flex-row w-full md:w-auto items-center gap-xs">
                <div class="w-full md:w-48 px-md py-2 border-b md:border-b-0 md:border-l border-outline-variant/30 flex items-center justify-between">
                    <select class="bg-transparent border-none focus:ring-0 text-on-surface text-body-md w-full cursor-pointer" name="city">
                        <option value="">اختر منطقتك</option>
                        <option value="القاهرة">القاهرة</option>
                        <option value="الجيزة">الجيزة</option>
                        <option value="الإسكندرية">الإسكندرية</option>
                        <option value="بورسعيد">بورسعيد</option>
                        <option value="السويس">السويس</option>
                        <option value="العاصمة الإدارية">العاصمة الإدارية</option>
                        <option value="حلوان">حلوان</option>
                        <option value="6 أكتوبر">6 أكتوبر</option>
                        <option value="المنصورة">المنصورة</option>
                        <option value="طنطا">طنطا</option>
                        <option value="الزقازيق">الزقازيق</option>
                        <option value="دمنهور">دمنهور</option>
                        <option value="كفر الشيخ">كفر الشيخ</option>
                        <option value="بنها">بنها</option>
                        <option value="شبين الكوم">شبين الكوم</option>
                        <option value="المنيا">المنيا</option>
                        <option value="أسيوط">أسيوط</option>
                        <option value="سوهاج">سوهاج</option>
                        <option value="قنا">قنا</option>
                        <option value="الأقصر">الأقصر</option>
                        <option value="أسوان">أسوان</option>
                        <option value="الغردقة">الغردقة</option>
                        <option value="مرسى مطروح">مرسى مطروح</option>
                        <option value="العريش">العريش</option>
                        <option value="الخارجة">الخارجة</option>
                        <option value="الطور">الطور</option>
                        <option value="شرم الشيخ">شرم الشيخ</option>
                        <option value="دمياط">دمياط</option>
                        <option value="بلطيم">بلطيم</option>
                    </select>
                </div>
                <div class="w-full md:w-48 px-md py-2 flex items-center justify-between">
                    <select class="bg-transparent border-none focus:ring-0 text-on-surface text-body-md w-full cursor-pointer" name="category">
                        <option value="">نوع الأكلة</option>
                        <option value="أكلات مصرية">أكلات مصرية</option>
                        <option value="حلويات">حلويات</option>
                        <option value="مشويات">مشويات</option>
                        <option value="مأكولات بحرية">مأكولات بحرية</option>
                        <option value="محاشي">محاشي</option>
                    </select>
                </div>
                <button type="submit" class="w-full md:w-auto bg-primary text-white p-4 md:rounded-full rounded-xl flex items-center justify-center hover:scale-105 transition-transform">
                    <span class="material-symbols-outlined">search</span>
                    <span class="md:hidden mr-2">بحث</span>
                </button>
            </div>
        </form>
    </div>
</section>

<!-- Tasting Bar (Categories) -->
<section class="bg-surface-container-lowest py-lg border-b border-outline-variant/10">
    <div class="max-w-container-max mx-auto px-md">
        <div class="flex items-center gap-lg overflow-x-auto pb-4 no-scrollbar scroll-smooth">
            <!-- All Category -->
            <a href="/all-portfolios" class="flex flex-col items-center gap-xs min-w-[80px] cursor-pointer group">
                <div class="w-16 h-16 rounded-full border-2 border-outline-variant p-1 tasting-bar-active transition-all group-hover:scale-110 overflow-hidden">
                    <div class="w-full h-full rounded-full bg-cover" style="background-image: url('https://images.unsplash.com/photo-1547928576-a4a33237eceb?auto=format&fit=crop&w=200&q=80');"></div>
                </div>
                <span class="text-label-sm font-bold text-secondary">الكل</span>
            </a>
            
            <!-- Category: مشويات -->
            <a href="/all-portfolios?category=%D9%85%D8%B4%D9%88%D9%8A%D8%A7%D8%AA" class="flex flex-col items-center gap-xs min-w-[80px] cursor-pointer group">
                <div class="w-16 h-16 rounded-full border-2 border-outline-variant p-1 transition-all group-hover:border-secondary group-hover:scale-110 overflow-hidden">
                    <div class="w-full h-full rounded-full bg-cover" style="background-image: url('https://images.unsplash.com/photo-1558030006-450675393462?auto=format&fit=crop&w=200&q=80');"></div>
                </div>
                <span class="text-label-sm font-medium text-on-surface-variant">مشويات</span>
            </a>
            
            <!-- Category: محاشي -->
            <a href="/all-portfolios?category=%D9%85%D8%AD%D8%A7%D8%B4%D9%8A" class="flex flex-col items-center gap-xs min-w-[80px] cursor-pointer group">
                <div class="w-16 h-16 rounded-full border-2 border-outline-variant p-1 transition-all group-hover:border-secondary group-hover:scale-110 overflow-hidden">
                    <div class="w-full h-full rounded-full bg-cover" style="background-image: url('https://images.unsplash.com/photo-1574482620811-d1d0b8caf096?auto=format&fit=crop&w=200&q=80');"></div>
                </div>
                <span class="text-label-sm font-medium text-on-surface-variant">محاشي</span>
            </a>
            
            <!-- Category: حلويات -->
            <a href="/all-portfolios?category=%D8%AD%D9%84%D9%88%D9%8A%D8%A7%D8%AA" class="flex flex-col items-center gap-xs min-w-[80px] cursor-pointer group">
                <div class="w-16 h-16 rounded-full border-2 border-outline-variant p-1 transition-all group-hover:border-secondary group-hover:scale-110 overflow-hidden">
                    <div class="w-full h-full rounded-full bg-cover" style="background-image: url('https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=200&q=80');"></div>
                </div>
                <span class="text-label-sm font-medium text-on-surface-variant">حلويات</span>
            </a>
            
            <!-- Category: أسماك -->
            <a href="/all-portfolios?category=%D8%A3%D8%B3%D9%85%D8%A7%D9%83" class="flex flex-col items-center gap-xs min-w-[80px] cursor-pointer group">
                <div class="w-16 h-16 rounded-full border-2 border-outline-variant p-1 transition-all group-hover:border-secondary group-hover:scale-110 overflow-hidden">
                    <div class="w-full h-full rounded-full bg-cover" style="background-image: url('https://images.unsplash.com/photo-1535399838253-e129d1c1cc18?auto=format&fit=crop&w=200&q=80');"></div>
                </div>
                <span class="text-label-sm font-medium text-on-surface-variant">أسماك</span>
            </a>
            
            <!-- Category: أكلات مصرية -->
            <a href="/all-portfolios?category=%D8%A3%D9%83%D9%84%D8%A7%D8%AA%20%D9%85%D8%B5%D8%B1%D9%8A%D8%A9" class="flex flex-col items-center gap-xs min-w-[80px] cursor-pointer group">
                <div class="w-16 h-16 rounded-full border-2 border-outline-variant p-1 transition-all group-hover:border-secondary group-hover:scale-110 overflow-hidden">
                    <div class="w-full h-full rounded-full bg-cover" style="background-image: url('https://images.unsplash.com/photo-1547592166-23ac45744acd?auto=format&fit=crop&w=200&q=80');"></div>
                </div>
                <span class="text-label-sm font-medium text-on-surface-variant">أكلات مصرية</span>
            </a>
        </div>
    </div>
</section>

<!-- Kitchens Grid -->
<section class="py-xl max-w-container-max mx-auto px-md">
    <div class="flex justify-between items-end mb-lg">
        <div>
            <h2 class="text-headline-md font-bold text-on-surface">أشهر المطابخ المنزلية حولك</h2>
            <p class="text-on-surface-variant mt-xs">طهاة محليون مبدعون في انتظارك</p>
        </div>
        <a class="text-primary font-bold hover:underline flex items-center gap-xs transition-all" href="/all-portfolios">
            عرض الكل
            <span class="material-symbols-outlined text-sm">arrow_back_ios</span>
        </a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md">
        <% if (locals.kitchens && kitchens.length > 0) { %>
            <% kitchens.forEach(kitchen => { %>
                <article class="bg-white rounded-2xl overflow-hidden culinary-shadow group transition-all duration-300 hover:-translate-y-2 duration-700 opacity-100 translate-y-0">
                    <div class="h-56 relative overflow-hidden">
                        <div class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-110" 
                             style="background-image: url(&quot;<%= kitchen.image || 'https://images.unsplash.com/photo-1547928576-a4a33237eceb?auto=format&fit=crop&w=600&q=80' %>&quot;);">
                        </div>
                        <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-label-sm font-bold text-primary flex items-center gap-xs">
                            <span class="material-symbols-outlined text-[16px]">star</span>
                            <%= kitchen.rating || '4.8' %>
                        </div>
                    </div>
                    <div class="p-md">
                        <div class="flex justify-between items-start mb-sm">
                            <div>
                                <h3 class="text-headline-md font-bold text-on-surface group-hover:text-primary transition-colors"><%= kitchen.name || 'مطبخ منزلي' %></h3>
                                <p class="text-secondary font-medium text-label-sm">الشيف <%= kitchen.chefName || 'غير معروف' %></p>
                            </div>
                            <span class="text-on-surface-variant flex items-center gap-xs text-label-sm bg-surface-container px-2 py-1 rounded-lg">
                                <span class="material-symbols-outlined text-[18px]">location_on</span>
                                <%= kitchen.location || 'القاهرة' %>
                            </span>
                        </div>
                        <p class="text-on-surface-variant text-body-md line-clamp-2 mb-md"><%= kitchen.bio || 'أشهى المأكولات المنزلية الطازجة' %></p>
                        <a href="/portfolio/<%= kitchen.slug || kitchen.id %>" 
                           class="block w-full bg-primary text-on-primary py-3 rounded-xl font-bold hover:bg-surface-tint transition-all active:scale-95 text-center">
                            تصفح المنيو
                        </a>
                    </div>
                </article>
            <% }) %>
        <% } else { %>
            <!-- Default Cards when no data -->
            <!-- Card 1 -->
            <article class="bg-white rounded-2xl overflow-hidden culinary-shadow group transition-all duration-300 hover:-translate-y-2 duration-700 opacity-100 translate-y-0">
                <div class="h-56 relative overflow-hidden">
                    <div class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-110" 
                         style="background-image: url('https://images.unsplash.com/photo-1547928576-a4a33237eceb?auto=format&fit=crop&w=600&q=80');">
                    </div>
                    <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-label-sm font-bold text-primary flex items-center gap-xs">
                        <span class="material-symbols-outlined text-[16px]">star</span>
                        4.9
                    </div>
                </div>
                <div class="p-md">
                    <div class="flex justify-between items-start mb-sm">
                        <div>
                            <h3 class="text-headline-md font-bold text-on-surface group-hover:text-primary transition-colors">مطبخ أم علي</h3>
                            <p class="text-secondary font-medium text-label-sm">الشيف منى</p>
                        </div>
                        <span class="text-on-surface-variant flex items-center gap-xs text-label-sm bg-surface-container px-2 py-1 rounded-lg">
                            <span class="material-symbols-outlined text-[18px]">location_on</span>
                            مدينة نصر
                        </span>
                    </div>
                    <p class="text-on-surface-variant text-body-md line-clamp-2 mb-md">أشهى المأكولات المصرية التقليدية بطعم الأصالة. نستخدم أجود المكونات الطازجة يومياً.</p>
                    <a href="/portfolio/1" class="block w-full bg-primary text-on-primary py-3 rounded-xl font-bold hover:bg-surface-tint transition-all active:scale-95 text-center">تصفح المنيو</a>
                </div>
            </article>
            
            <!-- Card 2 -->
            <article class="bg-white rounded-2xl overflow-hidden culinary-shadow group transition-all duration-300 hover:-translate-y-2 duration-700 opacity-100 translate-y-0">
                <div class="h-56 relative overflow-hidden">
                    <div class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-110" 
                         style="background-image: url('https://images.unsplash.com/photo-1558030006-450675393462?auto=format&fit=crop&w=600&q=80');">
                    </div>
                    <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-label-sm font-bold text-primary flex items-center gap-xs">
                        <span class="material-symbols-outlined text-[16px]">star</span>
                        4.8
                    </div>
                </div>
                <div class="p-md">
                    <div class="flex justify-between items-start mb-sm">
                        <div>
                            <h3 class="text-headline-md font-bold text-on-surface group-hover:text-primary transition-colors">مطبخ الست غالية</h3>
                            <p class="text-secondary font-medium text-label-sm">الشيف سلوى</p>
                        </div>
                        <span class="text-on-surface-variant flex items-center gap-xs text-label-sm bg-surface-container px-2 py-1 rounded-lg">
                            <span class="material-symbols-outlined text-[18px]">location_on</span>
                            التجمع الخامس
                        </span>
                    </div>
                    <p class="text-on-surface-variant text-body-md line-clamp-2 mb-md">وصفات عائلية متوارثة، من المحاشي إلى الطواجن بالفرن البلدي.</p>
                    <a href="/portfolio/2" class="block w-full bg-primary text-on-primary py-3 rounded-xl font-bold hover:bg-surface-tint transition-all active:scale-95 text-center">تصفح المنيو</a>
                </div>
            </article>
            
            <!-- Card 3 -->
            <article class="bg-white rounded-2xl overflow-hidden culinary-shadow group transition-all duration-300 hover:-translate-y-2 duration-700 opacity-100 translate-y-0">
                <div class="h-56 relative overflow-hidden">
                    <div class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-110" 
                         style="background-image: url('https://images.unsplash.com/photo-1574482620811-d1d0b8caf096?auto=format&fit=crop&w=600&q=80');">
                    </div>
                    <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-label-sm font-bold text-primary flex items-center gap-xs">
                        <span class="material-symbols-outlined text-[16px]">star</span>
                        5.0
                    </div>
                </div>
                <div class="p-md">
                    <div class="flex justify-between items-start mb-sm">
                        <div>
                            <h3 class="text-headline-md font-bold text-on-surface group-hover:text-primary transition-colors">مطبخ الأصالة</h3>
                            <p class="text-secondary font-medium text-label-sm">الشيف أحمد</p>
                        </div>
                        <span class="text-on-surface-variant flex items-center gap-xs text-label-sm bg-surface-container px-2 py-1 rounded-lg">
