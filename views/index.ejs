<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#9e2016">
  <title>دوق | اطلب أكلك من مطبخك المفضل</title>
  <script src="/app-client.js"></script>
  <link rel="manifest" href="/manifest.webmanifest">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            surface: '#fff8f6',
            'on-surface': '#261816',
            'on-surface-variant': '#59413d',
            'surface-container-low': '#fff0ee',
            'outline-variant': '#e1bfb9',
            'on-primary': '#ffffff',
            error: '#ba1a1a',
            'surface-low': '#fff0ee',
            'surface-high': '#fce2de',
            ink: '#261816',
            muted: '#59413d',
            primary: '#9e2016',
            'primary-deep': '#74160f',
            secondary: '#fc7127',
            line: '#e1bfb9'
          },
          fontFamily: { cairo: ['Cairo', 'sans-serif'] },
          boxShadow: {
            card: '0 12px 30px rgba(38, 24, 22, .08)',
            soft: '0 5px 20px rgba(158, 32, 22, .12)'
          }
        }
      }
    }
  </script>
  <style>
    :root { color-scheme: light; }
    body { font-family: Cairo, sans-serif; background: #fff8f6; color: #261816; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .hero-pattern { background: radial-gradient(circle at 12% 15%, rgba(252,113,39,.18), transparent 30%), radial-gradient(circle at 88% 75%, rgba(158,32,22,.28), transparent 34%); }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  </style>
</head>
<body class="min-h-screen bg-surface text-ink antialiased">
  <%- include('./partials/header.ejs') %>

  <%
    const role = (typeof currentUser !== 'undefined' && currentUser) ? currentUser.roles : 'guest';
    const name = (typeof currentUser !== 'undefined' && currentUser && currentUser.first_name) ? currentUser.first_name : 'ضيفنا';
    const dashboards = {
      admin: { href: '/admin', label: 'لوحة الإدارة', icon: 'admin_panel_settings' },
      chef: { href: '/users/dashboard', label: 'لوحة المطبخ', icon: 'restaurant' },
      delivery: { href: '/delivery', label: 'لوحة التوصيل', icon: 'local_shipping' },
      customer: { href: '/my-orders', label: 'طلباتي', icon: 'receipt_long' }
    };
    const dashboard = dashboards[role];
  %>

  <main class="pt-16 sm:pt-20">
    <section class="relative overflow-hidden bg-ink text-white">
      <div class="hero-pattern absolute inset-0"></div>
      <div class="absolute inset-y-0 left-0 hidden w-1/2 bg-cover bg-center opacity-35 lg:block" style="background-image:url('/assests/hero.jpeg')"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 sm:px-6 md:py-20 lg:grid-cols-[1.1fr_.9fr] lg:px-8 lg:py-24">
        <div class="max-w-2xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-secondary/40 bg-secondary/10 px-4 py-2 text-sm font-bold text-orange-100">
            <span class="material-symbols-outlined text-secondary">restaurant_menu</span>
            أكل بيتي بطعم تحبه
          </span>
          <h1 class="mt-6 text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">اطلب طبقك من المطبخ اللي يناسبك</h1>
          <p class="mt-5 max-w-xl text-base leading-8 text-white/75 sm:text-lg">شوف الأطباق والمطابخ المتاحة واختار طلبك بوضوح. كل مطبخ له منيوه وتفاصيله وتقييماته.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/kitchens" class="inline-flex items-center justify-center gap-2 rounded-xl bg-secondary px-6 py-3.5 font-extrabold text-white shadow-soft transition hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-white">
              <span class="material-symbols-outlined">search</span>
              استكشف المطابخ
            </a>
            <% if (dashboard) { %>
              <a href="<%= dashboard.href %>" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/25 bg-white/10 px-6 py-3.5 font-bold text-white transition hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white">
                <span class="material-symbols-outlined"><%= dashboard.icon %></span>
                <%= dashboard.label %>
              </a>
            <% } else { %>
              <a href="/auth" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/25 bg-white/10 px-6 py-3.5 font-bold text-white transition hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white">
                <span class="material-symbols-outlined">person_add</span>
                اعمل حساب
              </a>
            <% } %>
          </div>
          <p class="mt-5 text-sm text-white/55"><%= role === 'guest' ? 'تقدر تتصفح المنيو كضيف وتسجل وقت ما تكون جاهز' : 'أهلاً يا ' + name + '، تقدر تتابع طلباتك من زر لوحتك' %></p>
        </div>
        <div class="relative hidden lg:block">
          <div class="absolute -inset-4 rounded-[2rem] border border-secondary/25"></div>
          <img src="/assests/high_end_collage_of_delicious_homemade_middle_eastern_meals_warm_lighting_cozy.png" alt="أطباق متنوعة من مطابخ دوق" class="relative h-[390px] w-full rounded-[2rem] object-cover shadow-2xl" loading="eager">
          <div class="absolute -bottom-5 right-6 rounded-2xl bg-white px-5 py-4 text-ink shadow-card">
            <p class="text-xs font-bold text-muted">ابدأ من هنا</p>
            <p class="mt-1 font-extrabold text-primary">اختار مطبخك ثم طبقك</p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-line/60 bg-white">
      <div class="mx-auto flex max-w-7xl items-center gap-4 overflow-x-auto px-4 py-6 sm:px-6 lg:px-8">
        <div class="shrink-0 pl-2 text-sm font-extrabold text-muted">اتفرج على التصنيفات</div>
        <% if (categories && categories.length) { %>
          <% categories.slice(0, 8).forEach(category => { %>
            <a href="/kitchens?category=<%= encodeURIComponent(category.name) %>" class="group flex shrink-0 items-center gap-2 rounded-full border border-line/70 bg-surface px-3 py-2 transition hover:border-secondary hover:bg-surface-low">
              <img src="<%= category.image || '/assests/category.jpeg' %>" alt="<%= category.name %>" class="h-9 w-9 rounded-full object-cover" loading="lazy">
              <span class="text-sm font-bold text-ink group-hover:text-primary"><%= category.name %></span>
            </a>
          <% }) %>
        <% } else { %>
          <span class="text-sm text-muted">التصنيفات هتظهر هنا أول ما تتوفر</span>
        <% } %>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-sm font-extrabold text-secondary">اختيارات قريبة منك</p>
          <h2 class="mt-2 text-3xl font-black text-primary sm:text-4xl">مطابخ تقدر تبدأ منها</h2>
          <p class="mt-2 text-sm text-muted">افتح صفحة المطبخ وشوف المنيو والتقييمات والعنوان قبل ما تطلب</p>
        </div>
        <a href="/kitchens" class="inline-flex items-center gap-1 font-bold text-primary hover:text-secondary">كل المطابخ <span class="material-symbols-outlined text-lg">arrow_back</span></a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <% if (kitchens && kitchens.length) { %>
          <% kitchens.slice(0, 6).forEach(kitchen => { %>
            <article class="group overflow-hidden rounded-2xl border border-line/50 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-card">
              <a href="/kitchens/<%= kitchen.id %>" class="block">
                <div class="relative h-52 overflow-hidden bg-surface-high">
                  <img src="<%= kitchen.image || kitchen.portfolio_url || '/assests/profile_kitchen.jpeg' %>" alt="<%= kitchen.title %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" onerror="this.src='/assests/profile_kitchen.jpeg'">
                  <span class="absolute right-4 top-4 inline-flex items-center gap-1 rounded-full bg-white/95 px-3 py-1 text-xs font-extrabold text-ink shadow-sm"><span class="material-symbols-outlined text-sm text-amber-500">star</span><%= kitchen.avg_rating || kitchen.rating || 'جديد' %></span>
                </div>
                <div class="p-5">
                  <h3 class="text-xl font-extrabold text-ink group-hover:text-primary"><%= kitchen.title %></h3>
                  <p class="mt-2 text-sm text-muted"><span class="material-symbols-outlined ml-1 text-base text-secondary">person</span><%= kitchen.chef_name || 'مطبخ دوق' %></p>
                  <div class="mt-5 flex items-center justify-between border-t border-line/50 pt-4 text-sm font-bold text-muted">
                    <span class="inline-flex items-center gap-1"><span class="material-symbols-outlined text-base text-secondary">location_on</span><%= kitchen.city || 'مصر' %></span>
                    <span class="text-primary">شوف المنيو <span class="material-symbols-outlined align-middle text-base">arrow_back</span></span>
                  </div>
                </div>
              </a>
            </article>
          <% }) %>
        <% } else { %>
          <div class="rounded-2xl border border-dashed border-line bg-white p-10 text-center md:col-span-2 lg:col-span-3">
            <span class="material-symbols-outlined text-5xl text-line">storefront</span>
            <p class="mt-3 font-bold text-muted">لسه مفيش مطابخ متاحة للعرض</p>
          </div>
        <% } %>
      </div>
    </section>

    <section class="bg-surface-low">
      <div class="mx-auto grid max-w-7xl gap-5 px-4 py-14 sm:px-6 md:grid-cols-3 lg:px-8">
        <div class="md:col-span-3">
          <p class="text-sm font-extrabold text-secondary">الطريقة بسيطة</p>
          <h2 class="mt-2 text-3xl font-black text-primary">من أول التصفح لحد تأكيد الطلب</h2>
        </div>
        <% const steps = [
          { icon: 'storefront', title: 'اختار المطبخ', text: 'قارن المطابخ حسب المدينة والتقييم والمنيو' },
          { icon: 'restaurant_menu', title: 'اختار الطبق', text: 'افتح تفاصيل الطبق وحدد الكمية واسم الطلب' },
          { icon: 'local_shipping', title: 'تابع الطلب', text: 'المطبخ والتوصيل يحدثوا الحالة لحد ما يكتمل الطلب' }
        ]; %>
        <% steps.forEach((step, index) => { %>
          <article class="rounded-2xl border border-line/50 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3"><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-surface-high text-primary"><span class="material-symbols-outlined"><%= step.icon %></span></span><span class="text-sm font-black text-secondary">0<%= index + 1 %></span></div>
            <h3 class="mt-5 text-xl font-extrabold text-ink"><%= step.title %></h3>
            <p class="mt-2 text-sm leading-7 text-muted"><%= step.text %></p>
          </article>
        <% }) %>
      </div>
    </section>

    <% if (role === 'guest' || role === 'customer') { %>
      <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-3xl bg-primary px-6 py-10 text-white shadow-card sm:px-10 lg:flex lg:items-center lg:justify-between">
          <div class="relative max-w-2xl">
            <span class="text-sm font-bold text-orange-200">عندك أكل بتحبه وعايز تعرضه؟</span>
            <h2 class="mt-3 text-3xl font-black sm:text-4xl">خلّي مطبخك يوصل لناس أكتر</h2>
            <p class="mt-3 max-w-xl leading-8 text-white/75">سجل كطاهٍ. بعد التسجيل الحساب بيتراجع من الإدارة قبل ما يبدأ استقبال الطلبات</p>
            <a href="/auth" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-secondary px-6 py-3 font-extrabold text-white transition hover:bg-orange-500"><span class="material-symbols-outlined">restaurant</span>سجل كمطبخ</a>
          </div>
          <img src="/assests/chef_landing.jpeg" alt="طاهٍ يجهز الطعام" class="relative mt-8 hidden h-44 w-44 rounded-full border-4 border-white/20 object-cover lg:mt-0 lg:block" loading="lazy">
        </div>
      </section>
    <% } %>
  </main>

  <%- include('./partials/footer.ejs') %>
</body>
</html>
