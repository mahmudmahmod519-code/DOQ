<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دوق | الأسئلة الشائعة - Dhouq</title>
    
    <!-- Google Fonts -->
