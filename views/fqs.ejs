    <style>
        .accordion-item .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out, opacity 0.3s ease;
            opacity: 0;
        }
        .accordion-item.active .accordion-content {
            max-height: 500px;
            opacity: 1;
        }
        .accordion-item .chevron {
            transition: transform 0.3s ease;
        }
        .accordion-item.active .chevron {
            transform: rotate(180deg);
        }
        .active-tab {
            box-shadow: 0 8px 25px rgba(158, 32, 22, 0.25);
        }
    </style>
</head>
<body class="bg-background text-on-background">
    
    <%- include('./partials/header.ejs') %>


<!-- Hero Section -->
<section class="pt-32 pb-xl px-md relative overflow-hidden">
    <div class="max-w-container-max mx-auto text-center relative z-10">
        <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary mb-sm">الأسئلة الشائعة</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
            كل اللي محتاج تعرفه عن منصة دوق، سواء بتدور على أحلى عربيات أكل الشارع أو عايز تعرض عربيتك على المنصة.
        </p>
    </div>
    <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
</section>

<!-- Main Content -->
<main class="max-w-4xl mx-auto px-md mb-xl">

    <!-- Tab Selection -->
    <div class="flex justify-center mb-lg gap-sm">
        <button onclick="switchTab('customers')" id="tab-customers" class="flex items-center gap-sm px-lg py-sm rounded-xl transition-all duration-300 bg-primary text-white shadow-xl active-tab">
            <span class="material-symbols-outlined">person</span>
            <span class="font-headline-md text-[18px]">العملاء</span>
        </button>
        <button onclick="switchTab('chefs')" id="tab-chefs" class="flex items-center gap-sm px-lg py-sm rounded-xl transition-all duration-300 bg-white text-on-surface-variant hover:bg-surface-container-high active:scale-95 border border-outline-variant/30">
            <span class="material-symbols-outlined">restaurant_menu</span>
            <span class="font-headline-md text-[18px]">الشيفات</span>
        </button>
    </div>

    <!-- Customer Section -->
    <div id="section-customers" class="space-y-sm">
        <div class="bg-white rounded-2xl p-md shadow-[0px_4px_20px_rgba(192,57,43,0.06)] border border-outline-variant/20">
            
            <!-- FAQ 1: ما هي منصة دوق وكيف يمكنني الطلب؟ -->
            <div class="accordion-item">
                <button class="w-full flex items-center justify-between py-md text-right focus:outline-none transition-colors duration-300 group" onclick="toggleAccordion(this)">
                    <div class="flex items-center gap-md">
                        <span class="material-symbols-outlined text-secondary-container">shopping_cart</span>
                        <span class="font-headline-md text-[20px] question-header">ما هي منصة دوق وكيف أستخدمها؟</span>
                    </div>
                    <span class="material-symbols-outlined chevron">expand_more</span>
                </button>
                <div class="accordion-content">
                    <p class="font-body-md text-on-surface-variant leading-relaxed">
                        دوق منصة بتجمع عربيات أكل الشارع المصرية في مكان واحد. تقدر تتصفح العربيات، تشوف الأطباق والأسعار والصور، وتقرأ التقييمات الحقيقية. حالياً المنصة للعرض والاكتشاف، والاتفاق والدفع بيتم مباشرة مع صاحب العربية.
                    </p>
                </div>
            </div>

            <!-- FAQ 2: كيف تضمنون نظافة وجودة الأكل المنزلي؟ -->
            <div class="accordion-item">
                <button class="w-full flex items-center justify-between py-md text-right focus:outline-none transition-colors duration-300 group" onclick="toggleAccordion(this)">
                    <div class="flex items-center gap-md">
                        <span class="material-symbols-outlined text-secondary-container">verified_user</span>
                        <span class="font-headline-md text-[20px] question-header">إزاي أعرف إن التقييمات حقيقية؟</span>
                    </div>
                    <span class="material-symbols-outlined chevron">expand_more</span>
                </button>
                <div class="accordion-content">
                    <p class="font-body-md text-on-surface-variant leading-relaxed">
                        بنستخدم نظام اسمه Fair Score بيحسب التقييم بطريقة عادلة، عشان العربيات الجديدة متتظلمش بسبب قلة التقييمات. كمان كل عميل بيقدر يقيّم الطبق مرة واحدة بس، وبنراجع التقييمات عشان نقلل التلاعب.
                    </p>
                </div>
            </div>

            <!-- FAQ 3: كم يستغرق وقت تحضير وتوصيل الطلب؟ -->
            <div class="accordion-item">
                <button class="w-full flex items-center justify-between py-md text-right focus:outline-none transition-colors duration-300 group" onclick="toggleAccordion(this)">
                    <div class="flex items-center gap-md">
                        <span class="material-symbols-outlined text-secondary-container">schedule</span>
                        <span class="font-headline-md text-[20px] question-header">هل في دفع أو طلب أونلاين جوه المنصة؟</span>
                    </div>
                    <span class="material-symbols-outlined chevron">expand_more</span>
                </button>
                <div class="accordion-content">
                    <p class="font-body-md text-on-surface-variant leading-relaxed">
                        حالياً لأ. المنصة للعرض والاكتشاف فقط. بتشوف العربية والأطباق والتقييمات، وبعدين بتتواصل مع صاحب العربية مباشرة عشان الاتفاق والدفع. لو اتضاف نظام طلبات في المستقبل هنعلن عنه.
                    </p>
                </div>
            </div>

            <!-- FAQ 4: ما هي طرق الدفع المتاحة؟ -->
            <div class="accordion-item border-none">
                <button class="w-full flex items-center justify-between py-md text-right focus:outline-none transition-colors duration-300 group" onclick="toggleAccordion(this)">
                    <div class="flex items-center gap-md">
                        <span class="material-symbols-outlined text-secondary-container">payments</span>
                        <span class="font-headline-md text-[20px] question-header">هل أقدر أقيّم أي طبق؟</span>
                    </div>
                    <span class="material-symbols-outlined chevron">expand_more</span>
                </button>
                <div class="accordion-content">
                    <p class="font-body-md text-on-surface-variant leading-relaxed">
                        أيوه، بشرط تكون مسجل كـ عميل. كل عميل يقدر يقيّم الطبق مرة واحدة فقط. التقييم بيساعد باقي الناس ويحسّن ترتيب العربيات بنظام Fair Score العادل.
                    </p>
                </div>
            </div>

        </div>
    </div>

    <!-- Chef Section (Hidden by default) -->
    <div id="section-chefs" class="hidden space-y-sm">
        <div class="bg-white rounded-2xl p-md shadow-[0px_4px_20px_rgba(192,57,43,0.06)] border border-outline-variant/20">
            
            <!-- FAQ 5: كيف يمكنني الانضمام كشيف؟ -->
            <div class="accordion-item">
                <button class="w-full flex items-center justify-between py-md text-right focus:outline-none transition-colors duration-300 group" onclick="toggleAccordion(this)">
                    <div class="flex items-center gap-md">
                        <span class="material-symbols-outlined text-secondary-container">skillet</span>
                        <span class="font-headline-md text-[20px] question-header">إزاي أنضم كصاحب عربية على دوق؟</span>
                    </div>
                    <span class="material-symbols-outlined chevron">expand_more</span>
                </button>
                <div class="accordion-content">
                    <p class="font-body-md text-on-surface-variant leading-relaxed">
                        سهل جداً:
                        <br>- سجّل حساب جديد واختار دور "شيف".
                        <br>- بعد التسجيل تقدر تنشئ عربة واحدة فقط وتعبّي بياناتها (الاسم، المدينة، الصور، الأطباق...).
                        <br>- ضيف أطباقك وأسعارها وصورها.
                        <br>- العربيات الجديدة بتظهر للناس وبتستفيد من نظام Fair Score عشان متتظلمش في الترتيب.
                    </p>
                </div>
            </div>

            <!-- FAQ 6: ما هو الرمز التعريفي / Code الخاص بالشيف؟ -->
            <div class="accordion-item">
                <button class="w-full flex items-center justify-between py-md text-right focus:outline-none transition-colors duration-300 group" onclick="toggleAccordion(this)">
                    <div class="flex items-center gap-md">
                        <span class="material-symbols-outlined text-secondary-container">key</span>
                        <span class="font-headline-md text-[20px] question-header">هل أقدر أعمل أكتر من عربية؟</span>
                    </div>
                    <span class="material-symbols-outlined chevron">expand_more</span>
                </button>
                <div class="accordion-content">
                    <div class="bg-surface-container-low p-sm rounded-xl border-r-4 border-primary mb-sm">
                        <p class="font-body-md text-on-surface-variant leading-relaxed">
                            لأ. كل صاحب عربية (شيف) يقدر ينشئ عربة واحدة فقط على المنصة. ده عشان نحافظ على جودة المحتوى ونخلي كل عربية تمثل صاحبها بشكل واضح.
                        </p>
                        <p class="font-body-md text-primary font-bold mt-sm">
                            لو عندك أكتر من عربية، تواصل مع الدعم عشان نشوف أنسب حل لحالتك.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 7: هل توجد شروط صحية معينة لقبول المطابخ المنزلية؟ -->
            <div class="accordion-item border-none">
                <button class="w-full flex items-center justify-between py-md text-right focus:outline-none transition-colors duration-300 group" onclick="toggleAccordion(this)">
                    <div class="flex items-center gap-md">
                        <span class="material-symbols-outlined text-secondary-container">health_and_safety</span>
                        <span class="font-headline-md text-[20px] question-header">إيه المسؤوليات بتاعتي كصاحب عربية؟</span>
                    </div>
                    <span class="material-symbols-outlined chevron">expand_more</span>
                </button>
                <div class="accordion-content">
                    <p class="font-body-md text-on-surface-variant leading-relaxed">
                        أنت مسؤول عن:
                        <br>- صحة ودقة بيانات العربيته وصور الأطباق والأسعار.
                        <br>- إن الأكل والمحتوى اللي بتعرضه متوافق مع القوانين المصرية.
                        <br>- التعامل المحترم مع الزبائن اللي بيتواصلوا معاك.
                        <br>- تحديث بياناتك لو حصل أي تغيير (مكان، أسعار، صور...).
                    </p>
                </div>
            </div>

        </div>
    </div>

</main>

<!-- Support Banner -->
<section class="max-w-container-max mx-auto px-md mb-xl">
    <div class="bg-primary-container rounded-[2rem] p-lg md:p-xl flex flex-col md:flex-row items-center justify-between gap-lg relative overflow-hidden">
        <div class="relative z-10 text-center md:text-right">
            <h2 class="font-display-lg text-display-lg-mobile text-white mb-sm">مالقِيتش إجابتك؟</h2>
            <p class="font-body-lg text-on-primary-container mb-lg">فريق دعم دوق موجود دايماً عشان يساعدك في أي استفسار عن العربيات أو الحساب.</p>
            <a href="/contect-us" class="inline-block bg-secondary-container text-white px-xl py-md rounded-full font-headline-md text-[18px] hover:scale-105 transition-all shadow-lg active:scale-95">
                تواصل معنا الآن
            </a>
        </div>
        <div class="w-full md:w-1/3 aspect-square rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20 flex items-center justify-center relative z-10 group overflow-hidden">
            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" 
                 style="background-image: url('/assests/doq_logo.png');">
            </div>
            <div class="absolute inset-0 bg-primary/20"></div>
            <!-- <span class="material-symbols-outlined text-white text-[64px] relative z-20">support_agent</span> -->
        </div>
        <div class="absolute -top-10 -left-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
    </div>
</section>

<%- include('./partials/footer') %>


<script>
    // ============================================
    // Toggle Accordion
    // ============================================
    function toggleAccordion(button) {
        const item = button.parentElement;
        const isActive = item.classList.contains('active');
        
        // Close all other items in the same section
        const section = item.closest('[id^="section-"]');
        section.querySelectorAll('.accordion-item').forEach(otherItem => {
            if (otherItem !== item) {
                otherItem.classList.remove('active');
            }
        });

        // Toggle current item
        item.classList.toggle('active');
    }

    // ============================================
    // Switch Tab
    // ============================================
    function switchTab(tab) {
        const customerBtn = document.getElementById('tab-customers');
        const chefBtn = document.getElementById('tab-chefs');
        const customerSection = document.getElementById('section-customers');
        const chefSection = document.getElementById('section-chefs');

        if (tab === 'customers') {
            customerBtn.classList.add('bg-primary', 'text-white', 'shadow-xl');
            customerBtn.classList.remove('bg-white', 'text-on-surface-variant', 'border');
            chefBtn.classList.remove('bg-primary', 'text-white', 'shadow-xl');
            chefBtn.classList.add('bg-white', 'text-on-surface-variant', 'border');
            
            customerSection.classList.remove('hidden');
            chefSection.classList.add('hidden');
        } else {
            chefBtn.classList.add('bg-primary', 'text-white', 'shadow-xl');
            chefBtn.classList.remove('bg-white', 'text-on-surface-variant', 'border');
            customerBtn.classList.remove('bg-primary', 'text-white', 'shadow-xl');
            customerBtn.classList.add('bg-white', 'text-on-surface-variant', 'border');
            
            chefSection.classList.remove('hidden');
            customerSection.classList.add('hidden');
        }

        // Close all accordions when switching tabs
        document.querySelectorAll('.accordion-item').forEach(item => item.classList.remove('active'));
    }

    // ============================================
    // Initialize: open the first accordion of the active tab
    // ============================================
    window.onload = () => {
        const firstItem = document.querySelector('#section-customers .accordion-item');
        if (firstItem) firstItem.classList.add('active');
    }
</script>

</body>
</html>