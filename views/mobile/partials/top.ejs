<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#9e2016">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <title><%= pageTitle %></title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/assests/doq_logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/m-assets/app.css">
  <script src="/app-client.js"></script>
  <script src="/m-assets/app.js" defer></script>
</head>
<%
  const appbarMode = typeof appbar !== 'undefined' ? appbar : 'brand';
  const showTabbar = typeof tabbar === 'undefined' ? true : tabbar;
  const frameClass = [showTabbar ? '' : 'no-tabbar', typeof frame !== 'undefined' ? frame : ''].join(' ').trim();
%>
<body data-page="<%= page %>" data-params="<%= JSON.stringify(params || {}) %>" data-logged="<%= user ? '1' : '0' %>"<%= page === 'auth' ? ' data-no-notifications' : '' %>>
  <header class="appbar<%= appbarMode === 'transparent' ? ' transparent' : '' %>" id="appbar">
    <% if (appbarMode === 'brand') { %>
      <a class="brand" href="/m" aria-label="دوق - الرئيسية">
        <img src="/assests/doq_logo.png" alt="" width="34" height="34">
        <span>دوق</span>
      </a>
      <span class="spacer"></span>
    <% } else { %>
      <button class="icon-btn" type="button" data-back aria-label="رجوع"><i data-icon="arrow-right"></i></button>
      <h1 id="appbar-title"><%= typeof heading !== 'undefined' ? heading : '' %></h1>
    <% } %>
    <% if (user) { %>
      <a class="icon-btn" href="/m/notifications" aria-label="الإشعارات" id="notification-bell">
        <i data-icon="bell"></i>
        <span class="badge hidden" id="notification-badge">0</span>
      </a>
    <% } else if (page !== 'auth') { %>
      <a class="btn sm" href="/m/auth?next=<%= encodeURIComponent('/m') %>">دخول</a>
    <% } %>
  </header>
  <main class="app <%= frameClass %>" id="app">
