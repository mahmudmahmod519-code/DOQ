<%- include('partials/top', { appbar: 'transparent', heading: '', tabbar: false, frame: 'has-cta' }) %>
  <div class="dish-hero"><img id="dish-image" src="/assests/dish_avatar.jpeg" alt=""></div>
  <div class="sheet-top" id="dish-info">
    <div class="skeleton" style="height:26px;width:60%"></div>
    <div class="skeleton" style="height:16px;width:40%;margin-top:10px"></div>
  </div>
  <section class="section" id="dish-details" hidden></section>
  <section class="section">
    <div class="section-head"><h2>التقييمات</h2><span class="muted small" id="reviews-summary"></span></div>
    <div id="review-form-slot"></div>
    <div class="card pad"><div id="reviews"></div><div data-feed-status="reviews"></div></div>
  </section>

  <div class="cta-bar" id="cta" hidden>
    <div class="total grow"><small>السعر</small><b id="cta-price">—</b></div>
    <button class="btn" type="button" id="open-order"><i data-icon="bag"></i> اطلب دلوقتي</button>
  </div>

  <div class="sheet-backdrop" id="order-backdrop" hidden></div>
  <section class="sheet" id="order-sheet" role="dialog" aria-modal="true" aria-labelledby="order-title" hidden>
    <div class="grabber"></div>
    <h3 id="order-title">تأكيد الطلب</h3>
    <form id="order-form" class="stack" novalidate>
      <div class="field">
        <label for="order-name">اسم الطلب</label>
        <input class="input" id="order-name" name="order_name" maxlength="60" placeholder="مثلاً: غدا البيت" required>
      </div>
      <div class="row between">
        <span style="font-weight:700">الكمية</span>
        <div class="stepper">
          <button type="button" data-qty="1" aria-label="زود">+</button>
          <output id="qty" aria-live="polite">1</output>
          <button type="button" data-qty="-1" aria-label="قلل">−</button>
        </div>
      </div>
      <div class="field">
        <label for="coupon">كود خصم (اختياري)</label>
        <div class="row">
          <input class="input grow" id="coupon" name="coupon" placeholder="DOQ-XXXXXXXX" autocapitalize="characters" dir="ltr">
          <button class="btn sm ghost" type="button" id="apply-coupon">تطبيق</button>
        </div>
        <span class="small" id="coupon-msg"></span>
      </div>
      <div class="card pad" id="order-summary"></div>
      <p class="muted small" style="margin:0">العنوان: <span id="order-address"></span> — <a href="/m/account" style="color:var(--primary);font-weight:700">تعديل</a></p>
      <div class="form-error" id="order-error" role="alert"></div>
      <button class="btn block" type="submit" id="confirm-order">تأكيد الطلب</button>
    </form>
  </section>
<%- include('partials/bottom', { tabbar: false }) %>
