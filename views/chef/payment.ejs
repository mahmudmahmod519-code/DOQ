<!DOCTYPE html>
<html class="scroll-smooth" dir="rtl" lang="ar">
<head>
<script src="/app-client.js"></script>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport">
<title>اشتراك المطبخ | دوق DOQ</title>

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

<script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        "primary": "#9e2016",
        "primary-container": "#c0392b",
        "on-primary": "#ffffff",
        "secondary": "#a23f00",
        "secondary-container": "#fc7127",
        "on-secondary": "#ffffff",
        "surface": "#fff8f6",
        "surface-container-low": "#fff0ee",
        "surface-container": "#ffe9e6",
        "on-surface": "#261816",
        "on-surface-variant": "#59413d",
        "outline-variant": "#e1bfb9",
        "background": "#fff8f6",
        "on-background": "#261816",
        "error": "#ba1a1a",
        "tertiary": "#005875"
      },
      fontFamily: {
        sans: ["Tajawal", "sans-serif"],
        cairo: ["Cairo", "sans-serif"]
      }
    }
  }
}
</script>

<style>
  
  body {
    font-family: 'Tajawal', sans-serif;
    background-color: #fff8f6;
    color: #261816;
  }
  .cairo-font { font-family: 'Cairo', sans-serif; }
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    vertical-align: middle;
  }
  
</style>
</head>

<body class="bg-background text-on-background min-h-screen flex flex-col antialiased">

  <!-- استدعاء الشريط الجانبي للشيف -->
  <%- include('../partials/chef_sidebar', { activePage: 'payment' }) %>

  <!-- Main Content Wrapper -->
  <div class="transition-all duration-300">

    <!-- Top AppBar Header -->
    <header class="fixed top-0 right-0 lg:right-72 left-0 h-16 bg-surface/80 backdrop-blur-xl shadow-sm z-40 flex items-center justify-between px-4 md:px-8 border-b border-outline-variant/20">
      <div class="flex items-center gap-3 flex-1">
        <!-- زر القائمة للموبايل -->
        <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-surface-container transition-colors">
          <span class="material-symbols-outlined text-on-surface text-[24px]">menu</span>
        </button>
        
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 text-sm text-on-surface-variant">
          <a href="/chef/dashboard" class="hover:text-primary transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-[18px]">dashboard</span>
            <span class="hidden sm:inline">لوحة التحكم</span>
          </a>
          <span class="hidden sm:inline">/</span>
          <span class="text-on-surface font-semibold flex items-center gap-1">
            <span class="material-symbols-outlined text-[18px]">account_balance_wallet</span>
            الاشتراكات
          </span>
        </div>
      </div>
      
      <div class="flex items-center gap-3 md:gap-4">
        <!-- صورة المستخدم -->
        <div class="w-9 h-9 rounded-full bg-primary flex items-center justify-center text-white font-bold text-sm shadow-sm">
          <%= (currentUser?.first_name || 'ش').charAt(0).toUpperCase() %>
        </div>
      </div>
    </header>

    <main class="w-full pt-20 px-4 md:px-8 lg:pr-72 pb-16 bg-surface min-h-screen">
      <div class="max-w-3xl mx-auto space-y-8">

        <!-- Header -->
        <div class="mb-6">
          <h1 class="text-3xl md:text-4xl font-cairo font-bold text-on-background mb-2">اشتراك المطبخ</h1>
          <p class="text-on-surface-variant text-lg">تابع حالة اشتراكك وقم بالتجديد بسهولة لتستمر في استقبال الطلبات</p>
        </div>

        <!-- حالة الاشتراك -->
        <div class="relative overflow-hidden bg-surface-container-lowest rounded-2xl border border-outline-variant/30 shadow-sm">
          <div class="absolute top-0 right-0 w-2 h-full bg-gradient-to-b from-primary to-secondary-container"></div>
          
          <div class="p-6 md:p-8 flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="flex items-center gap-5">
              <div class="w-16 h-16 rounded-full <%= paymentsEnabled ? 'bg-amber-100 text-amber-700' : 'bg-green-100 text-green-600' %> flex items-center justify-center shadow-sm">
                <span class="material-symbols-outlined text-4xl">verified</span>
              </div>
              <div>
                <div class="flex items-center gap-3 mb-1">
                  <h3 class="text-xl font-cairo font-bold">حالة الحساب</h3>
                  <span class="<%= paymentsEnabled ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-700' %> px-3 py-1 rounded-full text-sm font-medium flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full <%= paymentsEnabled ? 'bg-amber-600' : 'bg-green-600' %>"></span>
                    <%= paymentsEnabled ? '?حالة الحساب???? ????' : '?حالة الحساب???? ?????' %>
                  </span>
                </div>
                <p class="text-on-surface-variant">
                  <%= paymentsEnabled ? 'التجديد من بوابة الدفع بعد تفعيلها' : '???حالة الحساب ??? ???????? ??? ??????? ?? ???????' %>
                </p>
              </div>
            </div>
            
            <button type="button" disabled class="w-full md:w-auto flex items-center justify-center gap-2 bg-surface-container text-on-surface-variant px-8 py-3 rounded-xl font-bold cursor-not-allowed">
              <span class="material-symbols-outlined">payments</span>
              ???حالة الحساب ??? ????????
            </button>
          </div>
        </div>

        <!-- تعليمات الدفع عبر InstaPay -->
        <div class="bg-surface-container-low rounded-2xl border border-outline-variant/30 overflow-hidden">
          <div class="p-5 bg-surface-container flex items-center gap-3 border-b border-outline-variant/30">
            <span class="material-symbols-outlined text-primary">info</span>
            <h3 class="text-xl font-cairo font-bold">تعليمات التجديد عبر InstaPay</h3>
          </div>
          
          <div class="p-6 md:p-8 space-y-6">
            <!-- Step 1 -->
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-lg">١</div>
              <div>
                <p class="font-bold text-on-surface mb-1">افتح تطبيق إنستا باي</p>
                <p class="text-on-surface-variant text-sm">قم بفتح التطبيق على هاتفك المحمول المسجل</p>
              </div>
            </div>
            
            <!-- Step 2 -->
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-lg">٢</div>
              <div>
                <p class="font-bold text-on-surface mb-1">اختر عنوان الدفع</p>
                <p class="text-on-surface-variant text-sm">اختر "إرسال نقود" ثم حدد خيار "عنوان الدفع"</p>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-lg">٣</div>
              <div>
                <p class="font-bold text-on-surface mb-1">أدخل بيانات الإدارة</p>
                <div class="flex items-center gap-3 mt-2">
                  <code class="bg-white border border-outline-variant/50 px-4 py-2 rounded-lg text-primary font-bold select-all text-lg" id="instapay-address">
                    <%= payoutLink %>
                  </code>
                  <button onclick="copyInstapay()" class="text-sm text-primary hover:underline flex items-center gap-1 font-medium">
                    <span class="material-symbols-outlined text-base">content_copy</span>
                    نسخ
                  </button>
                </div>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-lg">٤</div>
              <div>
                <p class="font-bold text-on-surface mb-1">تأكيد التحويل</p>
                <p class="text-on-surface-variant text-sm">
                  حول مبلغ <span class="text-primary font-bold text-base">500 ج.م</span> وسيتم التفعيل خلال 24 ساعة
                </p>
              </div>
            </div>
          </div>
          
          <div class="px-6 py-4 bg-primary/5 border-t border-outline-variant/30">
            <p class="text-xs text-on-surface-variant text-center">
              في حال واجهت أي مشكلة، يرجى التواصل مع الدعم الفني عبر قسم "اتصل بنا"
            </p>
          </div>
        </div>

      </div>
    </main>
  </div>

  <script>
    function copyInstapay() {
      const text = document.getElementById('instapay-address').innerText;
      navigator.clipboard.writeText(text).then(() => {
        // يمكن استبدال alert بـ toast notification إذا كان متاحاً في المشروع
        alert('تم نسخ عنوان InstaPay بنجاح!');
      }).catch(err => {
        console.error('فشل النسخ: ', err);
      });
    }
  </script>

</body>
</html>