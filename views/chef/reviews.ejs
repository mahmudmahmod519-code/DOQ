<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<script src="/app-client.js"></script>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
  <title>تقييمات مطبخي | دوق DOQ</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            "surface-dim": "#eed4d1",
            "inverse-surface": "#3c2d2a",
            "on-background": "#261816",
            "secondary": "#a23f00",
            "surface-container-highest": "#f7ddd9",
            "on-error": "#ffffff",
            "surface-container": "#ffe9e6",
            "inverse-on-surface": "#ffedea",
            "surface-container-high": "#fce2de",
            "on-primary-fixed-variant": "#8e130c",
            "on-primary": "#ffffff",
            "primary-container": "#c0392b",
            "surface-tint": "#b02d21",
            "secondary-fixed": "#ffdbcd",
            "on-tertiary-fixed-variant": "#004d66",
            "tertiary": "#005875",
            "primary-fixed": "#ffdad5",
            "primary": "#9e2016",
            "primary-fixed-dim": "#ffb4a9",
            "on-primary-fixed": "#410000",
            "surface": "#fff8f6",
            "surface-container-low": "#fff0ee",
            "tertiary-fixed-dim": "#80d0f8",
            "tertiary-container": "#007296",
            "tertiary-fixed": "#c0e8ff",
            "error-container": "#ffdad6",
            "on-error-container": "#93000a",
            "secondary-fixed-dim": "#ffb595",
            "surface-container-lowest": "#ffffff",
            "surface-bright": "#fff8f6",
            "on-surface-variant": "#59413d",
            "on-secondary-container": "#5c2000",
            "outline-variant": "#e1bfb9",
            "on-secondary": "#ffffff",
            "background": "#fff8f6",
            "on-primary-container": "#ffe5e1",
            "on-tertiary-container": "#d3eeff",
            "secondary-container": "#fc7127",
            "inverse-primary": "#ffb4a9",
            "on-surface": "#261816",
            "on-secondary-fixed-variant": "#7c2e00",
            "on-tertiary": "#ffffff",
            "on-secondary-fixed": "#351000",
            "outline": "#8d706c",
            "surface-variant": "#f7ddd9",
            "error": "#ba1a1a"
          },
          borderRadius: {
            DEFAULT: "0.25rem",
            lg: "0.5rem",
            xl: "0.75rem",
            "2xl": "1rem",
            full: "9999px"
          },
          spacing: {
            "container-max": "1280px",
            gutter: "16px",
            md: "16px",
            xl: "24px",
            base: "8px",
            sm: "12px"
          },
          fontFamily: {
            "body-lg": ["Tajawal", "sans-serif"],
            "headline-md": ["Cairo", "sans-serif"],
            "display-lg-mobile": ["Cairo", "sans-serif"],
            "label-sm": ["Tajawal", "sans-serif"],
            "body-md": ["Tajawal", "sans-serif"],
            "display-lg": ["Cairo", "sans-serif"]
          },
          fontSize: {
            "body-lg": ["16px", { lineHeight: "24px", fontWeight: "400" }],
            "headline-md": ["20px", { lineHeight: "28px", fontWeight: "600" }],
            "display-lg-mobile": ["28px", { lineHeight: "36px", fontWeight: "700" }],
            "label-sm": ["13px", { lineHeight: "18px", letterSpacing: "0.01em", fontWeight: "500" }],
            "body-md": ["14px", { lineHeight: "20px", fontWeight: "400" }],
