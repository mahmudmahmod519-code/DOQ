<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= pageTitle %></title>
<script src="/app-client.js"></script><script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#fff8f6] text-[#261816]">
<%- include('../partials/role_bar', { links: [{ href: '/users/dashboard', label: 'المطبخ' }, { href: '/users/orders', label: 'الطلبات', active: true }] }) %>
<main class="mx-auto max-w-6xl p-4 md:p-8">
  <section class="rounded-3xl bg-[#261816] p-6 text-white shadow-xl">
    <h1 class="text-2xl font-bold md:text-3xl">طلبات المطبخ</h1>
    <p class="mt-2 text-white/75">جهز الطلب وسلمه للمندوب<br>لما يقولك كود الطلب</p>
    <div class="mt-4 flex flex-wrap gap-2 text-sm">
      <span class="rounded-full bg-white/10 px-3 py-1">محتاجة تتجهز: <b id="count-open">0</b></span>
      <span class="rounded-full bg-white/10 px-3 py-1">اتسلمت: <b id="count-done">0</b></span>
    </div>
  </section>
  <div id="notice" class="mt-5 hidden rounded-xl p-4" role="status"></div>
  <section id="orders" class="mt-6 grid gap-4 md:grid-cols-2"></section>
</main>
<script>
const esc = v => DOQ.escape(v);
function notice(t, ok = true) { const e = document.getElementById('notice'); e.textContent = t; e.className = 'mt-5 rounded-xl p-4 ' + (ok ? 'bg-green-100 text-green-900' : 'bg-red-100 text-red-900'); }
function card(o) {
  const courier = o.status === 'pending' ? '<span class="text-amber-800">مستني أول شركة دليفري تقبل الطلب</span>' : o.status === 'accepted' ? '<span class="text-green-800">شركة الدليفري قبلت الطلب</span>' : '';
  return '<article class="rounded-2xl border border-[#e1bfb9] bg-white p-5 shadow-sm">'
    + '<div class="flex items-start justify-between gap-3"><div><p class="text-sm text-[#59413d]">كود الطلب</p><p dir="ltr" class="text-right text-xl font-extrabold tracking-wider">' + esc(o.order_code) + '</p></div>' + statusChip(o.status) + '</div>'
    + '<p class="mt-3 text-lg font-bold">' + esc(o.dish_name) + ' × ' + o.quantity + '</p>'
    + '<p class="mt-1 text-sm text-[#59413d]">' + money(o.unit_price) + ' للطبق · الإجمالي ' + money(o.total_price) + '</p>'
    + '<p class="mt-3 text-sm">' + courier + '</p>'
    + '<p class="mt-1 text-xs text-[#59413d]">' + when(o.created_at) + '</p>'
    + (o.status === 'pending' ? '<button class="mt-4 w-full rounded-xl bg-red-100 px-4 py-3 text-red-800" data-id="' + esc(o.public_id) + '">اعتذار عن الطلب</button>' : '')
    + '</article>';
}
async function load() {
  try {
    const rows = (await DOQ.api('/users/orders/api')).data || [];
    document.getElementById('count-open').textContent = rows.filter(o => o.status === 'pending' || o.status === 'accepted').length;
    document.getElementById('count-done').textContent = rows.filter(o => o.status === 'completed').length;
    document.getElementById('orders').innerHTML = rows.length ? rows.map(card).join('') : '<div class="rounded-2xl border border-dashed border-[#e1bfb9] bg-white p-8 text-center md:col-span-2">مفيش طلبات لسه. أول ما حد يطلب من أطباقك هيوصلك إشعار</div>';
  } catch (e) { notice(e.message, false); }
}
document.getElementById('orders').addEventListener('click', async e => {
  const b = e.target.closest('button[data-id]'); if (!b) return;
  if (!confirm('متأكد إنك مش هتقدر تجهز الطلب ده؟ العميل هيوصله إشعار بالإلغاء')) return;
  b.disabled = true;
  try { const j = await DOQ.api('/orders/api/v1/' + encodeURIComponent(b.dataset.id) + '/status', 'PATCH', { status: 'cancelled' }); notice(j.message); load(); }
  catch (err) { notice(err.message, false); b.disabled = false; }
});
load();
</script>
</body>
</html>
