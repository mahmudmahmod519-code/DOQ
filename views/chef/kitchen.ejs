<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<script src="/app-client.js"></script>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport">
    <title>مطبخي | دوق DOQ</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <style>
        
        body { font-family: 'Tajawal', sans-serif; scroll-behavior: smooth; background-color: #fff8f6; }
        .cairo-font { font-family: 'Cairo', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        .material-symbols-filled { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        
        
        .culinary-gradient { background: linear-gradient(135deg, #9e2016 0%, #c0392b 100%); }
        .animate-spin { animation: spin 1s linear infinite; }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        
        .slide-in-from-right { animation: slideInRight 0.3s ease-out forwards; }
        @keyframes slideInRight { from { opacity: 0; transform: translateX(50px); } to { opacity: 1; transform: translateX(0); } }
        
        .fade-in { animation: fadeIn 0.4s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        
        .modal-overlay { background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(8px); }
        .modal-content { animation: modalZoom 0.3s ease-out forwards; }
        @keyframes modalZoom { from { opacity: 0; transform: scale(0.8); } to { opacity: 1; transform: scale(1); } }
        
        .avatar-hover { transition: all 0.3s ease; }
        .avatar-hover:hover { transform: scale(1.02); box-shadow: 0 8px 30px rgba(158, 32, 22, 0.3); }
        .hidden-input { display: none; }

        /* Skeleton Loading */
        .skeleton { 
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); 
            background-size: 200% 100%; 
            animation: shimmer 1.5s infinite; 
            border-radius: 0.5rem; 
        }
        @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

        @media (max-width: 1024px) {
            html, body { overflow-x: hidden !important; max-width: 100vw !important; }
            * { max-width: 100vw !important; box-sizing: border-box !important; }
        }
    </style>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#9e2016", "primary-container": "#c0392b", "on-primary": "#ffffff",
                        "secondary": "#a23f00", "secondary-container": "#fc7127", "on-secondary-container": "#5c2000",
                        "background": "#fff8f6", "surface": "#fff8f6", "surface-container": "#ffe9e6",
                        "surface-container-low": "#fff0ee", "on-surface": "#261816", "on-surface-variant": "#59413d",
                        "outline": "#8d706c", "outline-variant": "#e1bfb9", "tertiary": "#005875", "tertiary-container": "#007296", "on-tertiary": "#ffffff",
                        "error": "#ba1a1a", "error-container": "#ffdad6"
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "2xl": "1rem", "full": "9999px" },
                    fontFamily: { "cairo": ["Cairo", "sans-serif"], "tajawal": ["Tajawal", "sans-serif"] }
                }
            }
        }
    </script>
</head>
<body class="bg-background text-on-surface min-h-screen flex flex-col antialiased">

    <!-- استدعاء الشريط الجانبي للشيف -->
    <%- include('../partials/chef_sidebar', { activePage: 'my-kitchen' }) %>

    <!-- Main Content Wrapper -->
    <div class="transition-all duration-300">

        <!-- Top AppBar Header -->
        <header class="fixed top-0 right-0 lg:right-72 left-0 h-16 bg-surface/80 backdrop-blur-xl shadow-sm z-40 flex items-center justify-between px-4 md:px-8 border-b border-outline-variant/20">
            <div class="flex items-center gap-3 flex-1">
                <!-- زر القائمة للموبايل -->
                <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-surface-container transition-colors">
                    <span class="material-symbols-outlined text-on-surface text-[24px]">menu</span>
                </button>
                
                <!-- Breadcrumb -->
                <div class="flex items-center gap-2 text-sm text-on-surface-variant">
                    <a href="/chef/dashboard" class="hover:text-primary transition-colors flex items-center gap-1">
                        <span class="material-symbols-outlined text-[18px]">dashboard</span>
                        <span class="hidden sm:inline">لوحة التحكم</span>
                    </a>
                    <span class="hidden sm:inline">/</span>
                    <span class="text-on-surface font-semibold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[18px]">storefront</span>
                        مطبخي
                    </span>
                </div>
            </div>
            
            <div class="flex items-center gap-3 md:gap-4">
                <!-- صورة المستخدم -->
                <div class="w-9 h-9 rounded-full bg-primary flex items-center justify-center text-white font-bold text-sm shadow-sm">
                    <%= (currentUser?.first_name || 'ش').charAt(0).toUpperCase() %>
                </div>
            </div>
        </header>

        <main class="w-full pt-20 px-4 md:px-8 lg:pr-72 pb-16 bg-surface min-h-screen">

            <% 
                var currentKitchen = Array.isArray(kitchen) ? kitchen[0] : kitchen;
                if (!currentKitchen) { 
            %>
                <!-- EMPTY STATE -->
                <div class="flex items-center justify-center min-h-[60vh]">
                    <div class="flex flex-col items-center justify-center text-center px-6 fade-in">
                        <div class="w-32 h-32 bg-surface-container rounded-full flex items-center justify-center mb-6 shadow-lg">
                            <span class="material-symbols-outlined text-[72px] text-primary" style="font-variation-settings: 'FILL' 1;">restaurant</span>
                        </div>
                        <h2 class="font-cairo text-3xl md:text-4xl font-bold mb-4 text-primary">🍳 ليس لديك مطبخ بعد!</h2>
                        <p class="text-lg text-on-surface-variant mb-8 max-w-lg">ابدأ رحلتك الطهوية الآن وشارك أطباقك اللذيذة مع المجتمع. أنشئ مطبخك في دقائق!</p>
                        <div class="flex flex-col sm:flex-row gap-4">
                            <button id="createKitchenBtn" class="bg-secondary-container text-white px-8 py-3 rounded-xl font-bold hover:scale-[1.05] active:scale-95 transition-all shadow-lg flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined">add_circle</span>
                                إنشاء مطبخ الآن
                            </button>
                            <a href="/" class="bg-surface-container-lowest text-on-surface-variant border border-outline-variant px-8 py-3 rounded-xl font-bold hover:bg-surface-container-low transition-all flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined">arrow_forward</span>
                                رجوع
                            </a>
                        </div>
                    </div>
                </div>

            <% } else { 
                var kitchenData = currentKitchen;
                var safeKitchenId = kitchenData.id || '';
                var safeImageUrl = function(value) {
                    try {
                        var parsed = new URL(String(value || ''), 'http://doq.local');
                        if (parsed.origin !== 'http://doq.local' || !/^\/uploads\//.test(parsed.pathname)) return '';
                        return (parsed.pathname + parsed.search).replace(/[&<>"']/g, function(char) {
                            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
                        });
                    } catch (e) { return ''; }
                };
            %>

                <div id="dashboard-content" class="w-full">
                    <div id="toastContainer" class="fixed top-24 right-6 z-[100] flex flex-col gap-2"></div>

                    <!-- 1. HERO SECTION -->
                    <section class="relative w-full min-h-[280px] md:min-h-[320px] flex items-end">
                        <div class="absolute inset-0 w-full h-full">
                            <% if (kitchenData.image_url && kitchenData.image_url !== null) { %>
                                <div class="w-full h-full bg-cover bg-center bg-no-repeat" style="background-image: url('<%= safeImageUrl(kitchenData.image_url) %>');">
                                    <div class="w-full h-full bg-gradient-to-t from-black/70 via-black/30 to-black/10"></div>
                                </div>
                            <% } else { %>
                                <div class="w-full h-full bg-gradient-to-b from-surface-container-low to-surface">
                                    <div class="w-full h-full opacity-5" style="background-image: radial-gradient(circle at 20% 50%, #9e2016 1px, transparent 1px); background-size: 40px 40px;"></div>
                                </div>
                            <% } %>
                        </div>
                        
                        <div class="relative z-10 w-full max-w-[1280px] mx-auto px-4 md:px-6 pb-6">
                            <div class="bg-surface/90 backdrop-blur-sm rounded-3xl p-4 md:p-6 shadow-lg flex flex-col md:flex-row gap-4 md:gap-6 items-start md:items-end border border-surface/20">
                                
                                <div class="relative group">
                                    <div id="avatarContainer" class="w-28 h-28 md:w-36 md:h-36 rounded-full border-4 border-surface overflow-hidden bg-primary-container flex items-center justify-center text-on-primary-container text-[48px] font-bold shadow-lg avatar-hover cursor-pointer">
                                        <% if (kitchenData.portfolio_url && kitchenData.portfolio_url !== null) { %>
                                            <img src="<%= safeImageUrl(kitchenData.portfolio_url) %>" alt="صورة المطبخ" class="w-full h-full object-cover">
                                        <% } else { %>
                                            <%= kitchenData.title ? kitchenData.title.charAt(0).toUpperCase() : 'م' %>
                                        <% } %>
                                    </div>
                                    <button id="uploadProfileBtn" class="absolute bottom-2 left-2 bg-secondary text-white p-2 rounded-full shadow-md hover:scale-110 transition-transform z-10">
                                        <span class="material-symbols-outlined text-sm">photo_camera</span>
                                    </button>
                                    <input type="file" id="profileImageInput" class="hidden-input" accept="image/*">
                                </div>

                                <div class="flex-1 space-y-2 w-full">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h1 class="font-cairo text-2xl md:text-3xl font-bold text-primary">
                                            <%= kitchenData.title || 'مطبخي' %>
                                        </h1>
                                        <span class="bg-surface-container-high text-secondary px-3 py-1 rounded-full text-xs font-bold">شيف معتمد</span>
                                    </div>
                                    <p class="text-base text-on-surface-variant flex items-center gap-2">
                                        <span class="material-symbols-outlined text-primary text-lg">person</span>
                                        الشيف <%= currentUser ? currentUser.first_name + ' ' + currentUser.last_name : '' %>
                                    </p>
                                    <div class="flex flex-wrap gap-4 text-on-surface-variant text-sm pt-1">
                                        <% if (kitchenData.city) { %>
                                            <div class="flex items-center gap-1">
                                                <span class="material-symbols-outlined text-secondary text-lg">location_on</span>
                                                <%= kitchenData.city %>
                                            </div>
                                        <% } %>
                                        <div class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-secondary text-lg">call</span>
                                            <%= kitchenData.phone_number || 'غير محدد' %>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-secondary text-lg">calendar_today</span>
                                            انضم في <%= new Date(kitchenData.created_at).toLocaleDateString('ar-EG') %>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex flex-col gap-2 w-full md:w-auto">
                                    <button class="w-full bg-tertiary text-on-tertiary px-6 py-2.5 rounded-xl flex items-center justify-center gap-2 font-bold hover:bg-tertiary-container transition-colors" 
                                            onclick="document.getElementById('edit-section').scrollIntoView({behavior: 'smooth'})">
                                        <span class="material-symbols-outlined">edit</span>
                                        تعديل بيانات المطبخ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 2. ADVANCED STATS CARDS (من الـ Dashboard) -->
                    <section class="max-w-[1280px] mx-auto px-4 md:px-6 py-8">
                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" id="stats-container">
                            <!-- Skeleton Loading -->
                            <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30"><div class="skeleton h-8 w-24 mb-2"></div><div class="skeleton h-10 w-16"></div></div>
                            <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30"><div class="skeleton h-8 w-24 mb-2"></div><div class="skeleton h-10 w-16"></div></div>
                            <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30"><div class="skeleton h-8 w-24 mb-2"></div><div class="skeleton h-10 w-16"></div></div>
                            <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30"><div class="skeleton h-8 w-24 mb-2"></div><div class="skeleton h-10 w-16"></div></div>
                        </div>
                    </section>

                    <!-- 3. DASHBOARD GRID (Reviews & Top Dishes) -->
                    <section class="max-w-[1280px] mx-auto px-4 md:px-6 pb-8">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <!-- Recent Reviews -->
                            <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30 flex flex-col h-full">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="font-cairo font-bold text-lg text-on-surface flex items-center gap-2">
                                        <span class="material-symbols-outlined text-primary">reviews</span> آخر التقييمات
                                    </h3>
                                    <a href="/reviews" class="text-primary text-sm font-medium hover:bg-primary/10 px-3 py-1 rounded-full transition-colors">عرض الكل</a>
                                </div>
                                <div id="recent-reviews-container" class="flex-grow">
                                    <div class="space-y-3">
                                        <div class="skeleton h-20 w-full"></div>
                                        <div class="skeleton h-20 w-full"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Top Dishes -->
                            <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30 flex flex-col h-full">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="font-cairo font-bold text-lg text-on-surface flex items-center gap-2">
                                        <span class="material-symbols-outlined text-primary">trending_up</span> أفضل الأطباق
                                    </h3>
                                    <a href="/dishes" class="text-primary text-sm font-medium hover:bg-primary/10 px-3 py-1 rounded-full transition-colors">إدارة الأطباق</a>
                                </div>
                                <div id="top-dishes-container" class="flex-grow">
                                    <div class="space-y-3">
                                        <div class="skeleton h-16 w-full"></div>
                                        <div class="skeleton h-16 w-full"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- 4. RECENT DISHES -->
                    <section class="max-w-[1280px] mx-auto px-4 md:px-6 pb-8">
                        <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="font-cairo font-bold text-lg text-on-surface flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary">new_releases</span> آخر الأطباق المضافة
                                </h3>
                                <a href="/dishes" class="text-primary text-sm font-medium hover:bg-primary/10 px-3 py-1 rounded-full transition-colors">إدارة الأطباق</a>
                            </div>
                            <div id="recent-dishes-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                <div class="skeleton h-24 w-full"></div>
                                <div class="skeleton h-24 w-full"></div>
                                <div class="skeleton h-24 w-full"></div>
                            </div>
                        </div>
                    </section>

                    <!-- 5. EDIT FORM SECTION -->
                    <section class="max-w-[1280px] mx-auto px-4 md:px-6 py-8" id="edit-section">
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                            <div class="lg:col-span-2 bg-surface rounded-3xl p-6 md:p-8 shadow-sm border border-outline-variant/30">
                                <h2 class="font-cairo font-bold text-xl text-primary mb-6 flex items-center gap-2">
                                    <span class="material-symbols-outlined">settings</span>
                                    تعديل بيانات المطبخ
                                </h2>

                                <form class="space-y-6" id="kitchen-form">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="space-y-1">
                                            <label class="text-sm text-on-surface-variant mr-1 font-medium">اسم المطبخ</label>
                                            <input id="kitchenTitle" class="w-full bg-surface-container-low border border-outline-variant/30 focus:border-primary focus:ring-1 focus:ring-primary rounded-xl py-2.5 px-4 outline-none transition-all" 
                                                   type="text" value="<%= kitchenData.title || '' %>">
                                        </div>
                                        <div class="space-y-1">
                                            <label class="text-sm text-on-surface-variant mr-1 font-medium">رقم الهاتف</label>
                                            <input id="kitchenPhone" class="w-full bg-surface-container-low border border-outline-variant/30 focus:border-primary focus:ring-1 focus:ring-primary rounded-xl py-2.5 px-4 outline-none transition-all" 
                                                   dir="ltr" type="tel" value="<%= kitchenData.phone_number || '' %>">
                                        </div>
                                    </div>

                                    <div class="space-y-1">
                                        <label class="text-sm text-on-surface-variant mr-1 font-medium">وصف المطبخ</label>
                                        <textarea id="kitchenDescription" class="w-full bg-surface-container-low border border-outline-variant/30 focus:border-primary focus:ring-1 focus:ring-primary rounded-xl py-2.5 px-4 outline-none transition-all" 
                                                  rows="4"><%= kitchenData.description || '' %></textarea>
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="space-y-1">
                                            <label class="text-sm text-on-surface-variant mr-1 font-medium">المدينة</label>
                                            <input id="kitchenCity" class="w-full bg-surface-container-low border border-outline-variant/30 focus:border-primary focus:ring-1 focus:ring-primary rounded-xl py-2.5 px-4 outline-none transition-all" 
                                                   type="text" value="<%= kitchenData.city || '' %>" placeholder="مثال: القاهرة">
                                        </div>
                                        <div class="space-y-1">
                                            <label class="text-sm text-on-surface-variant mr-1 font-medium">العنوان بالتفصيل</label>
                                            <input id="kitchenAddress" class="w-full bg-surface-container-low border border-outline-variant/30 focus:border-primary focus:ring-1 focus:ring-primary rounded-xl py-2.5 px-4 outline-none transition-all" 
                                                   type="text" value="<%= kitchenData.address || '' %>" placeholder="شارع 9، مدينة نصر">
                                        </div>
                                    </div>

                                    <div class="flex justify-end gap-4 pt-4">
                                        <button class="bg-primary text-white px-8 py-2.5 rounded-xl font-bold shadow-md hover:shadow-lg transition-all flex items-center gap-2" type="submit" id="saveKitchenBtn">
                                            <span class="material-symbols-outlined text-lg">save</span> حفظ التغييرات
                                        </button>
                                    </div>
                                </form>
                            </div>

                            <div class="space-y-6">
                                <div class="bg-surface rounded-3xl p-6 shadow-sm border border-outline-variant/30">
                                    <h3 class="text-sm text-on-surface-variant mb-4 font-medium">صورة غلاف المطبخ</h3>
                                    <div class="relative group cursor-pointer overflow-hidden rounded-2xl h-48 mb-4">
                                        <div id="kitchenImagePreview" class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-110" 
                                             style="background-image: url('<%= safeImageUrl(kitchenData.image_url) || '/assests/background_kitchen.jpeg' %>');">
                                        </div>
                                        <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                            <span class="material-symbols-outlined text-white text-4xl">cloud_upload</span>
                                        </div>
                                    </div>
                                    <input class="hidden" id="cover-upload" type="file" accept="image/*">
                                    <button class="w-full border-2 border-dashed border-outline-variant text-on-surface-variant py-3 rounded-xl flex items-center justify-center gap-2 hover:border-primary hover:text-primary transition-all font-medium" 
                                            onclick="document.getElementById('cover-upload').click()">
                                        <span class="material-symbols-outlined">image</span>
                                        رفع صورة جديدة
                                    </button>
                                </div>

                                <div class="bg-primary-container/10 p-5 rounded-3xl border border-primary/10">
                                    <div class="flex gap-3 items-start">
                                        <span class="material-symbols-outlined text-primary text-2xl">info</span>
                                        <div>
                                            <p class="text-sm text-primary font-bold mb-1">نصيحة للشيف</p>
                                            <p class="text-sm text-on-surface-variant leading-relaxed">الصور الواضحة والمضاءة جيداً تزيد من نسبة الطلبات بمعدل ٣ أضعاف! حاول تحديث صورة الغلاف بانتظام.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            <% } %>

        </main>
    </div>

    <div id="imageModal" class="fixed inset-0 z-[200] hidden modal-overlay flex items-center justify-center p-4">
        <div class="modal-content max-w-2xl w-full relative">
            <button id="closeModalBtn" class="absolute -top-12 left-0 text-white hover:text-secondary transition-colors p-2">
                <span class="material-symbols-outlined text-3xl">close</span>
            </button>
            <img id="modalImage" src="" alt="صورة المطبخ" class="w-full h-auto rounded-2xl shadow-2xl object-contain max-h-[80vh]">
        </div>
    </div>

    <script>
        // ==========================================
        // 1. دوال المساعدة (Helpers)
        // ==========================================
        function showToast(message, type) {
            type = type || 'success';
            var container = document.getElementById('toastContainer');
            if (!container) return;
            var toast = document.createElement('div');
            var bgColor = type === 'success' ? 'bg-[#059669]' : type === 'error' ? 'bg-[#dc2626]' : 'bg-[#0d6efd]';
            var icon = type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info';
            toast.className = bgColor + ' text-white px-4 py-3 rounded-xl shadow-xl flex items-center gap-3 slide-in-from-right';
            toast.innerHTML = '<span class="material-symbols-outlined">' + DOQ.escape(icon) + '</span><span class="font-bold">' + DOQ.escape(message) + '</span>';
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(50px)';
                toast.style.transition = 'all 0.5s ease';
                setTimeout(function() { toast.remove(); }, 500);
            }, 4000);
        }

        function timeAgo(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            const now = new Date();
            const diffInSeconds = Math.floor((now - date) / 1000);
            if (diffInSeconds < 60) return 'الآن';
            const diffInMinutes = Math.floor(diffInSeconds / 60);
            if (diffInMinutes < 60) return `منذ ${diffInMinutes} دقيقة`;
            const diffInHours = Math.floor(diffInMinutes / 60);
            if (diffInHours < 24) return `منذ ${diffInHours} ساعة`;
            const diffInDays = Math.floor(diffInHours / 24);
            if (diffInDays < 7) return `منذ ${diffInDays} يوم`;
            return date.toLocaleDateString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        // ==========================================
        // 2. دوال عرض البيانات (Render Functions)
        // ==========================================
        function renderStats(stats) {
            const totalReviews = stats.total_reviews || 0;
            const avgRating = stats.average_rating || '0.0';
            const fairScore = stats.fair_score || stats.average_rating || '0.0'; 

            const container = document.getElementById('stats-container');
            container.innerHTML = `
                <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30 hover:shadow-md transition-shadow fade-in">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-on-surface-variant text-sm mb-1 font-medium">إجمالي التقييمات</p>
                            <p class="text-3xl font-cairo font-bold text-secondary">${totalReviews}</p>
                        </div>
                        <span class="material-symbols-outlined text-4xl text-secondary bg-secondary/10 p-2 rounded-xl">reviews</span>
                    </div>
                </div>
                <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30 hover:shadow-md transition-shadow fade-in" style="animation-delay: 0.1s">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-on-surface-variant text-sm mb-1 font-medium">متوسط التقييم</p>
                            <div class="flex items-center gap-1">
                                <p class="text-3xl font-cairo font-bold text-tertiary">${avgRating}</p>
                                <span class="material-symbols-filled text-tertiary text-2xl">star</span>
                            </div>
                        </div>
                        <span class="material-symbols-outlined text-4xl text-tertiary bg-tertiary/10 p-2 rounded-xl">star_rate</span>
                    </div>
                </div>
                <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30 hover:shadow-md transition-shadow fade-in" style="animation-delay: 0.2s">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-on-surface-variant text-sm mb-1 font-medium">مؤشر الجودة</p>
                            <div class="flex items-center gap-1">
                                <p class="text-3xl font-cairo font-bold text-primary">${fairScore}</p>
                                <span class="material-symbols-outlined text-primary text-2xl">verified</span>
                            </div>
                        </div>
                        <span class="material-symbols-outlined text-4xl text-primary bg-primary/10 p-2 rounded-xl">analytics</span>
                    </div>
                </div>
                <a href="/payment" class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30 hover:bg-surface-container hover:border-primary/30 transition-all cursor-pointer group fade-in" style="animation-delay: 0.3s">
                    <div class="flex items-center justify-between h-full">
                        <div class="text-right">
                            <p class="text-on-surface-variant text-sm mb-1 font-medium group-hover:text-primary transition-colors">إدارة الاشتراك</p>
                            <p class="text-lg font-cairo font-bold text-on-surface">تجديد أو ترقية</p>
                        </div>
                        <span class="material-symbols-outlined text-4xl text-tertiary group-hover:scale-110 transition-transform bg-tertiary/10 p-2 rounded-xl">account_balance_wallet</span>
                    </div>
                </a>
            `;
        }

        function renderRecentReviews(reviews) {
            const container = document.getElementById('recent-reviews-container');
            if (!reviews || reviews.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-on-surface-variant fade-in"><span class="material-symbols-outlined text-4xl mb-2 text-outline-variant">rate_review</span><p class="text-sm">لا توجد تقييمات جديدة حتى الآن</p></div>`;
                return;
            }
            container.innerHTML = '<div class="space-y-3">' + reviews.map(review => `
                <div class="bg-surface p-4 rounded-xl border border-outline-variant/30 hover:border-primary/30 transition-colors fade-in">
                    <div class="flex items-start justify-between mb-2">
                        <div class="flex items-center gap-2">
                            <div class="flex">
                                ${Array(5).fill(0).map((_, i) => `<span class="material-symbols-filled text-base ${i < review.rating ? 'text-secondary' : 'text-outline-variant'}">star</span>`).join('')}
                            </div>
                            <span class="text-xs text-on-surface-variant font-medium">${DOQ.escape(review.first_name || 'عميل')} ${DOQ.escape(review.last_name || '')}</span>
                        </div>
                        <span class="text-[10px] text-outline bg-surface-container px-2 py-0.5 rounded-full">${timeAgo(review.created_at)}</span>
                    </div>
                    <p class="text-sm text-on-surface font-bold mb-1">${DOQ.escape(review.dish_name || 'طبق')}</p>
                    <p class="text-sm text-on-surface-variant leading-relaxed">${DOQ.escape(review.comment || 'لم يترك العميل تعليقاً')}</p>
                </div>
            `).join('') + '</div>';
        }

        function renderTopDishes(dishes) {
            const container = document.getElementById('top-dishes-container');
            if (!dishes || dishes.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-on-surface-variant fade-in"><span class="material-symbols-outlined text-4xl mb-2 text-outline-variant">restaurant_menu</span><p class="text-sm">لا توجد أطباق مصنفة بعد</p></div>`;
                return;
            }
            container.innerHTML = '<div class="space-y-3">' + dishes.slice(0, 5).map((dish, index) => `
                <div class="bg-surface p-3 rounded-xl border border-outline-variant/30 flex items-center gap-3 hover:border-primary/30 transition-colors fade-in">
                    <div class="w-14 h-14 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container-low border border-outline-variant/20">
                        ${dish.image_url ? `<img src="${DOQ.safeImage(dish.image_url)}" alt="${DOQ.escape(dish.name || '')}" class="w-full h-full object-cover" loading="lazy">` : '<div class="w-full h-full flex items-center justify-center text-outline-variant"><span class="material-symbols-outlined">restaurant</span></div>'}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm text-on-surface font-bold truncate">${DOQ.escape(dish.name || 'طبق غير مسمى')}</p>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="text-xs text-primary font-bold bg-primary/10 px-1.5 py-0.5 rounded">مؤشر: ${dish.fair_score || dish.avg_rating || '0.0'}</span>
                            <span class="text-xs text-on-surface-variant">${dish.reviews_count || 0} تقييم</span>
                        </div>
                    </div>
                    <span class="text-xl text-outline-variant font-cairo font-bold w-6 text-center">#${index + 1}</span>
                </div>
            `).join('') + '</div>';
        }

        function renderRecentDishes(dishes) {
            const container = document.getElementById('recent-dishes-container');
            if (!dishes || dishes.length === 0) {
                container.innerHTML = `<div class="col-span-full text-center py-8 text-on-surface-variant fade-in"><span class="material-symbols-outlined text-4xl mb-2 text-outline-variant">add_circle</span><p class="text-sm mb-3">لم تقم بإضافة أي أطباق بعد</p><a href="/dishes" class="inline-flex items-center gap-1 bg-primary text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-primary-container transition-colors"><span class="material-symbols-outlined text-[18px]">add</span> إضافة طبق جديد</a></div>`;
                return;
            }
            container.innerHTML = dishes.map(dish => `
                <div class="bg-surface p-3 rounded-xl border border-outline-variant/30 flex items-center gap-3 hover:border-primary/30 transition-colors fade-in group">
                    <div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container-low border border-outline-variant/20">
                        ${dish.image_url ? `<img src="${DOQ.safeImage(dish.image_url)}" alt="${DOQ.escape(dish.name || '')}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">` : '<div class="w-full h-full flex items-center justify-center text-outline-variant"><span class="material-symbols-outlined">restaurant</span></div>'}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm text-on-surface font-bold truncate">${DOQ.escape(dish.name || 'طبق غير مسمى')}</p>
                        <p class="text-xs text-secondary font-bold mt-0.5">${dish.price || 0} ج.م</p>
                    </div>
                    <a href="/dishes" class="text-on-surface-variant hover:text-primary hover:bg-primary/10 p-2 rounded-full transition-colors" title="تعديل">
                        <span class="material-symbols-outlined text-base">edit</span>
                    </a>
                </div>
            `).join('');
        }

        // ==========================================
        // 3. جلب البيانات الموحدة (Unified Fetch)
        // ==========================================
        async function fetchKitchenDashboardData() {
            var kId = '<%= safeKitchenId %>';
            if (!kId) return;

            // إعادة رسم الـ Skeletons
            document.getElementById('stats-container').innerHTML = `
                <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30"><div class="skeleton h-8 w-24 mb-2"></div><div class="skeleton h-10 w-16"></div></div>
                <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30"><div class="skeleton h-8 w-24 mb-2"></div><div class="skeleton h-10 w-16"></div></div>
                <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30"><div class="skeleton h-8 w-24 mb-2"></div><div class="skeleton h-10 w-16"></div></div>
                <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/30"><div class="skeleton h-8 w-24 mb-2"></div><div class="skeleton h-10 w-16"></div></div>
            `;
            document.getElementById('recent-reviews-container').innerHTML = `<div class="space-y-3"><div class="skeleton h-20 w-full"></div><div class="skeleton h-20 w-full"></div></div>`;
            document.getElementById('top-dishes-container').innerHTML = `<div class="space-y-3"><div class="skeleton h-16 w-full"></div><div class="skeleton h-16 w-full"></div></div>`;
            document.getElementById('recent-dishes-container').innerHTML = `<div class="skeleton h-24 w-full"></div><div class="skeleton h-24 w-full"></div><div class="skeleton h-24 w-full"></div>`;

            try {
                // نمرر kitchen_id لضمان جلب بيانات هذا المطبخ فقط
                const [reviewsRes, dishesRes] = await Promise.all([
                    fetch('/reviews/v1/api/chef?include_stats=true&limit=5&kitchen_id=' + kId),
                    fetch('/dishes/v1/api/my?limit=5&kitchen_id=' + kId)
                ]);

                const reviewsData = await reviewsRes.json();
                const dishesData = await dishesRes.json();

                if (reviewsData.status === 'success' && reviewsData.data.stats) {
                    renderStats(reviewsData.data.stats);
                    renderRecentReviews(reviewsData.data.reviews || []);
                    renderTopDishes(reviewsData.data.top_dishes || []);
                } else {
                    throw new Error(reviewsData.message || 'فشل في جلب بيانات التقييمات');
                }

                if (dishesData.status === 'success') {
                    renderRecentDishes(dishesData.data || []);
                } else {
                    throw new Error(dishesData.message || 'فشل في جلب بيانات الأطباق');
                }
            } catch (error) {
                console.error('Error fetching dashboard data:', error);
                const errorMsg = `<div class="col-span-full text-center py-8 text-error bg-error-container/20 rounded-xl border border-error/20">
                    <span class="material-symbols-outlined text-3xl mb-2 block">error</span>
                    <p class="font-bold">${DOQ.escape(error.message || 'حدث خطأ غير متوقع')}</p>
                    <button onclick="fetchKitchenDashboardData()" class="mt-3 text-sm bg-error text-white px-4 py-2 rounded-lg hover:bg-error/90 transition">إعادة المحاولة</button>
                </div>`;
                document.getElementById('stats-container').innerHTML = errorMsg;
                document.getElementById('recent-reviews-container').innerHTML = '';
                document.getElementById('top-dishes-container').innerHTML = '';
                document.getElementById('recent-dishes-container').innerHTML = '';
            }
        }

        // ==========================================
        // 4. أحداث الصفحة (Event Listeners)
        // ==========================================
        document.addEventListener('DOMContentLoaded', function() {
            var kitchenExists = '<%= currentKitchen ? true : false %>';
            if (kitchenExists) {
                fetchKitchenDashboardData();
            }

            // إنشاء مطبخ جديد
            var createBtn = document.getElementById('createKitchenBtn');
            if (createBtn) {
                createBtn.addEventListener('click', function() {
                    var btn = this;
                    var originalText = btn.innerHTML;
                    btn.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> جاري الإنشاء...';
                    btn.disabled = true;
                    fetch('/kitchens/api/v1/', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            title: 'مطبخي الجديد',
                            phone_number: '<%= currentUser ? currentUser.phone_number : "" %>',
                            city: 'غير محدد'
                        })
                    })
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        if (data.status === 'success') {
                            showToast('✅ ' + data.message, 'success');
                            if (data.redirect) {
                                setTimeout(function() { window.location.href = data.redirect; }, 1000);
                            } else {
                                location.reload();
                            }
                        } else {
                            showToast('❌ ' + (data.message || 'حدث خطأ'), 'error');
                            btn.innerHTML = originalText;
                            btn.disabled = false;
                        }
                    })
                    .catch(function(error) {
                        console.error('Create Kitchen Error:', error);
                        showToast('❌ حدث خطأ في الاتصال بالخادم', 'error');
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    });
                });
            }

            // حفظ تعديل بيانات المطبخ
            var kitchenForm = document.getElementById('kitchen-form');
            if (kitchenForm) {
                kitchenForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    var btn = document.getElementById('saveKitchenBtn');
                    var originalText = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> جاري الحفظ...';

                    var data = {
                        title: document.getElementById('kitchenTitle').value.trim(),
                        description: document.getElementById('kitchenDescription').value.trim(),
                        city: document.getElementById('kitchenCity').value.trim(),
                        address: document.getElementById('kitchenAddress').value.trim(),
                        phone_number: document.getElementById('kitchenPhone').value.trim(),
                        kitchen_id: '<%= safeKitchenId %>'
                    };
                    
                    var url = '/kitchens/api/v1/my';

                    fetch(url, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    })
                    .then(function(response) { return response.json(); })
                    .then(function(result) {
                        if (result.status === 'success') {
                            showToast('✅ ' + (result.message || 'تم تحديث المطبخ بنجاح'), 'success');
                            btn.innerHTML = '<span class="material-symbols-outlined text-lg">check</span> تم الحفظ';
                            btn.classList.remove('bg-primary');
                            btn.classList.add('bg-green-600');
                            
                            // تحديث الاسم في الواجهة فوراً
                            var titleEl = document.querySelector('.font-cairo.text-2xl.md\\:text-3xl.text-primary');
                            if (titleEl && data.title) titleEl.textContent = data.title;
                            
                            setTimeout(function() {
                                btn.innerHTML = originalText;
                                btn.classList.remove('bg-green-600');
                                btn.classList.add('bg-primary');
                                btn.disabled = false;
                            }, 2000);
                        } else {
                            showToast('❌ ' + (result.message || 'حدث خطأ'), 'error');
                            btn.innerHTML = originalText;
                            btn.disabled = false;
                        }
                    })
                    .catch(function(error) {
                        console.error('Update Error:', error);
                        showToast('❌ حدث خطأ في الاتصال بالخادم', 'error');
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    });
                });
            }

            // رفع صورة الغلاف
            var coverUpload = document.getElementById('cover-upload');
            if (coverUpload) {
                coverUpload.addEventListener('change', function() {
                    if (this.files.length === 0) return;
                    var formData = new FormData();
                    formData.append('background', this.files[0]);
                    var btn = this.parentElement.querySelector('button');
                    var originalText = btn.textContent;
                    btn.textContent = 'جاري الرفع...';
                    btn.disabled = true;
                    
                    var url = '/kitchens/api/v1/my/background?kitchen_id=<%= safeKitchenId %>';

                    fetch(url, { method: 'POST', body: formData })
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        if (data.status === 'success') {
                            showToast('✅ ' + (data.message || 'تم رفع الصورة بنجاح'), 'success');
                            var imgDiv = document.getElementById('kitchenImagePreview');
                            if (imgDiv && data.data && data.data.image_url) {
                                imgDiv.style.backgroundImage = 'url(' + DOQ.safeImage(data.data.image_url) + ')';
                            }
                            btn.textContent = '✅ تم الرفع';
                            setTimeout(function() { btn.textContent = originalText; btn.disabled = false; }, 2000);
                        } else {
                            showToast('❌ ' + (data.message || 'حدث خطأ'), 'error');
                            btn.textContent = originalText;
                            btn.disabled = false;
                        }
                    })
                    .catch(function(error) {
                        console.error('Upload Error:', error);
                        showToast('❌ حدث خطأ في الاتصال بالخادم', 'error');
                        btn.textContent = originalText;
                        btn.disabled = false;
                    });
                });
            }

            // رفع الصورة الشخصية
            var profileBtn = document.getElementById('uploadProfileBtn');
            var profileInput = document.getElementById('profileImageInput');
            var avatarContainer = document.getElementById('avatarContainer');

            if (profileBtn && profileInput) {
                profileBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    profileInput.click();
                });

                profileInput.addEventListener('change', function() {
                    if (this.files.length === 0) return;
                    var formData = new FormData();
                    formData.append('profile', this.files[0]);
                    profileBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">sync</span>';
                    profileBtn.disabled = true;
                    
                    var url = '/kitchens/api/v1/my/profile?kitchen_id=<%= safeKitchenId %>';

                    fetch(url, { method: 'POST', body: formData })
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        if (data.status === 'success') {
                            showToast('✅ ' + (data.message || 'تم تحديث الصورة الشخصية'), 'success');
                            if (data.data && data.data.image_url) {
                                avatarContainer.innerHTML = `<img src="${DOQ.safeImage(data.data.image_url)}" alt="صورة المطبخ" class="w-full h-full object-cover">`;
                            }
                            profileBtn.innerHTML = '<span class="material-symbols-outlined text-sm">photo_camera</span>';
                            profileBtn.disabled = false;
                        } else {
                            showToast('❌ ' + (data.message || 'حدث خطأ'), 'error');
                            profileBtn.innerHTML = '<span class="material-symbols-outlined text-sm">photo_camera</span>';
                            profileBtn.disabled = false;
                        }
                    })
                    .catch(function(error) {
                        console.error('Upload Profile Error:', error);
                        showToast('❌ حدث خطأ في الاتصال بالخادم', 'error');
                        profileBtn.innerHTML = '<span class="material-symbols-outlined text-sm">photo_camera</span>';
                        profileBtn.disabled = false;
                    });
                });
            }

            // Modal Logic
            var imageModal = document.getElementById('imageModal');
            var modalImage = document.getElementById('modalImage');
            var closeModalBtn = document.getElementById('closeModalBtn');

            if (avatarContainer) {
                avatarContainer.addEventListener('click', function(e) {
                    if (e.target.closest('#uploadProfileBtn')) return;
                    var img = this.querySelector('img');
                    if (img && img.src) {
                        modalImage.src = img.src;
                        imageModal.classList.remove('hidden');
                        document.body.style.overflow = 'hidden';
                    }
                });
            }

            function closeModal() {
                imageModal.classList.add('hidden');
                document.body.style.overflow = '';
            }

            if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
            if (imageModal) {
                imageModal.addEventListener('click', function(e) { if (e.target === this) closeModal(); });
            }
            document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });
        });
    </script>
</body>
</html>
