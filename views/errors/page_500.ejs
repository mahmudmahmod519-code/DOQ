<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<script src="/app-client.js"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%=  '500 - عطل تقني مؤقت' %> | دوق - فن التذوق</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              burgundy: '#4D0F0F',
              'burgundy-dark': '#380909',
              'burgundy-light': '#661616',
              orange: '#F26B1D',
              'orange-hover': '#d95a12',
              'orange-soft': '#fff2eb',
              bg: '#f9f9f9',
              surface: '#ffffff',
              muted: '#6b5e5c',
              border: '#f0e6e4'
            }
          },
          fontFamily: {
            cairo: ['Cairo', 'sans-serif'],
            tajawal: ['Tajawal', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: 'Tajawal', sans-serif;
      background-color: #f9f9f9;
      color: #333333;
    }
    h1, h2, h3, .font-heading {
      font-family: 'Cairo', sans-serif;
    }
    .subtle-shadow {
      box-shadow: 0 10px 30px -5px rgba(77, 15, 15, 0.05), 0 4px 12px -2px rgba(242, 107, 29, 0.04);
    }
    @keyframes gentle-pulse {
      0%, 100% { transform: scale(1); opacity: 0.95; }
      50% { transform: scale(1.03); opacity: 1; }
    }
    .animate-gentle {
      animation: gentle-pulse 3.5s ease-in-out infinite;
    }
    @keyframes steam {
      0% { transform: translateY(0) scaleX(1); opacity: 0; }
      50% { opacity: 0.6; }
      100% { transform: translateY(-16px) scaleX(1.15); opacity: 0; }
    }
    .steam-line-1 { animation: steam 2.4s ease-out infinite; }
    .steam-line-2 { animation: steam 2.8s ease-out infinite 0.7s; }
    .steam-line-3 { animation: steam 2.2s ease-out infinite 1.3s; }
  </style>
</head>
<body class="min-h-screen bg-brand-bg flex flex-col justify-between selection:bg-brand-orange selection:text-white antialiased">

  <!-- Header / Navigation Bar (لو عندك partials هتستخدم include هنا) -->
  <%- include('../partials/header') %> 

  <!-- Main Content Container -->
  <main class="flex-1 flex items-center justify-center px-4 sm:px-6 py-12 sm:py-16">
    <div class="w-full max-w-xl mx-auto">

      <!-- Card Box -->
      <div class="bg-brand-surface rounded-2xl border border-brand-border subtle-shadow p-8 sm:p-12 text-center relative overflow-hidden">
        
        <!-- Decorative subtle background glow -->
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-brand-orange/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-brand-burgundy/5 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Custom Illustration: Closed Kitchen Door & Steaming Pot resting peacefully -->
        <div class="relative w-40 h-40 sm:w-48 sm:h-48 mx-auto mb-8 flex items-center justify-center">
          <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-3xl bg-gradient-to-b from-brand-orange-soft to-amber-50/60 border border-brand-orange/15 flex items-center justify-center relative subtle-shadow">
            
            <!-- SVG Illustration of Closed Kitchen & Chef Hat resting -->
            <svg class="w-24 h-24 sm:w-28 sm:h-28 text-brand-burgundy" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Kitchen Door Frame -->
              <rect x="22" y="20" width="76" height="84" rx="10" stroke="#4D0F0F" stroke-width="3.5" fill="#ffffff" />
              <!-- Arch in Door -->
              <path d="M34 94V44C34 33 44 26 60 26C76 26 86 33 86 44V94" stroke="#4D0F0F" stroke-width="2.5" stroke-dasharray="3 3" />
              <!-- Door Sign Board Hanging -->
              <rect x="42" y="46" width="36" height="18" rx="4" fill="#F26B1D" />
              <text x="60" y="58.5" fill="#ffffff" font-family="'Cairo', sans-serif" font-size="8.5" font-weight="bold" text-anchor="middle">مغلق مؤقتاً</text>
              <!-- Strings hanging sign -->
              <line x1="50" y1="40" x2="46" y2="46" stroke="#4D0F0F" stroke-width="1.8" />
              <line x1="70" y1="40" x2="74" y2="46" stroke="#4D0F0F" stroke-width="1.8" />
              <circle cx="60" cy="38" r="2" fill="#4D0F0F" />
              
              <!-- Sleeping Chef / Resting Pan Element -->
              <path d="M44 86C44 80 50 75 60 75C70 75 76 80 76 86" stroke="#4D0F0F" stroke-width="3" stroke-linecap="round" fill="#fff8f6" />
              <!-- Whimsical ZZZ (Resting) -->
              <path d="M78 30H84L78 36H84" stroke="#F26B1D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="steam-line-1" />
              <path d="M84 22H88L84 26H88" stroke="#F26B1D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="steam-line-2" />
              <!-- Small Pot base -->
              <rect x="48" y="86" width="24" height="8" rx="2" fill="#4D0F0F" />
            </svg>

            <!-- Status Indicator Tooltip Badge -->
            <div class="absolute -bottom-2.5 bg-brand-burgundy text-white px-3 py-1 rounded-full text-[11px] font-heading font-bold tracking-wide shadow-sm flex items-center gap-1.5 border border-white">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-orange animate-ping"></span>
              <span>استراحة فنية سريعة</span>
            </div>
          </div>
        </div>

        <!-- Big Clean 500 Number -->
        <div class="mb-3">
          <span class="font-heading font-black text-6xl sm:text-7xl tracking-tight text-brand-burgundy inline-block">
            500
          </span>
        </div>

        <!-- Headline -->
        <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-brand-burgundy mb-3 leading-snug">
          المطبخ بياخد هدنة ثواني!
        </h1>

        <!-- Supportive Reassuring Message -->
        <p class="text-base sm:text-lg text-[#4a3f3d] font-normal leading-relaxed mb-8 max-w-md mx-auto">
          حصلت مشكلة تقنية من طرفنا. إحنا بنحاول نصلحها بسرعة عشان ترجع تدوق أحلى أكل.
        </p>

        <!-- Technical Note (Light & Clean) -->
        <div class="mb-8 p-3 rounded-xl bg-brand-bg border border-brand-border/80 inline-flex items-center gap-2 text-xs text-brand-muted">
          <span class="material-symbols-outlined text-base text-brand-orange">info</span>
          <span>رمز الخطأ: <strong class="text-brand-burgundy font-mono">500 - Internal Server Error</strong></span>
          <span class="text-gray-300">|</span>
          <span>طلبك مسجل وجاري معالجته تلقائياً</span>
        </div>

        <!-- Call To Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
          <!-- Primary Retry Button (Orange) -->
          <button 
            id="retry-btn"
            onclick="handleRetry()"
            class="w-full sm:w-auto px-7 py-3.5 bg-brand-orange hover:bg-brand-orange-hover text-white font-heading font-bold text-base rounded-xl transition-all duration-200 shadow-sm hover:shadow-md active:scale-98 flex items-center justify-center gap-2 group cursor-pointer focus:outline-none focus:ring-4 focus:ring-brand-orange/30">
            <span class="material-symbols-outlined text-xl transition-transform group-hover:rotate-180 duration-500" id="retry-icon">sync</span>
            <span id="retry-text">إعادة المحاولة</span>
          </button>

          <!-- Secondary Back to Home Button (Burgundy outline / soft) -->
          <a 
            href="/" 
            class="w-full sm:w-auto px-7 py-3.5 bg-white hover:bg-brand-bg text-brand-burgundy border-2 border-brand-burgundy/20 hover:border-brand-burgundy font-heading font-bold text-base rounded-xl transition-all duration-200 flex items-center justify-center gap-2 focus:outline-none focus:ring-4 focus:ring-brand-burgundy/10">
            <span class="material-symbols-outlined text-xl">home</span>
            <span>العودة للرئيسية</span>
          </a>
        </div>

        <!-- Friendly Tips / Help -->
        <div class="mt-8 pt-6 border-t border-brand-border/60 flex flex-wrap items-center justify-center gap-4 text-xs text-brand-muted">
          <span>محتاج طلب عاجل؟</span>
          <a href="https://wa.me/+201211260324" target="_blank" class="text-brand-orange hover:underline font-bold inline-flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">chat</span>
            <span>كلمنا واتساب مباشرة</span>
          </a>
          <span class="text-gray-300">•</span>
          <a href="/faqs" class="hover:text-brand-burgundy transition-colors">الأسئلة الشائعة</a>
          <span class="text-gray-300">•</span>
          <a href="/contect-us" class="hover:text-brand-burgundy transition-colors">اتصل بنا</a>
        </div>

      </div>

      <!-- Footer Micro Copy -->
      <p class="text-center text-xs text-brand-muted/80 mt-6">
        © <%= new Date().getFullYear() %> منصة دوق (DOQ) - المتخصصة في ربط عشاق الأكل البيتي بأمهر الطهاة في مصر.
      </p>

    </div>
  </main>

  <!-- Interactive JavaScript -->
  <script>
    function handleRetry() {
      const btn = document.getElementById('retry-btn');
      const icon = document.getElementById('retry-icon');
      const text = document.getElementById('retry-text');
      
      // Visual feedback on retry
      icon.classList.add('animate-spin');
      text.innerText = 'جاري التحقق من السيرفر...';
      btn.disabled = true;
      btn.classList.add('opacity-80', 'cursor-not-allowed');

      setTimeout(() => {
        window.location.reload();
      }, 1200);
    }
  </script>

</body>
</html>