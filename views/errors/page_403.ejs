<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<script src="/app-client.js"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>403 - غير مصرح بالدخول | دوق DOQ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              burgundy: '#4D0F0F',
              burgundyDark: '#350909',
              burgundyDeep: '#260606',
              orange: '#F26B1D',
              orangeHover: '#d95a12',
              gold: '#FFB800',
              cardBg: '#5A1515'
            }
          },
          fontFamily: {
            cairo: ['Cairo', 'sans-serif'],
            tajawal: ['Tajawal', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: 'Tajawal', sans-serif;
      background: radial-gradient(circle at 50% 30%, #5e1313 0%, #4D0F0F 45%, #290606 100%);
      overflow-x: hidden;
      width: 100%;
      max-width: 100vw;
    }
    h1, h2, h3, .font-heading {
      font-family: 'Cairo', sans-serif;
    }
    .glow-orange {
      text-shadow: 0 0 35px rgba(242, 107, 29, 0.45);
    }
    .rope-pattern {
      background-image: repeating-linear-gradient(45deg, #c53030, #c53030 10px, #9b1c1c 10px, #9b1c1c 20px);
    }
    .stanchion-glow {
      filter: drop-shadow(0 8px 24px rgba(255, 184, 0, 0.25));
    }
    /* Prevent horizontal scroll */
    .container-safe {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
    }
    @media (max-width: 640px) {
      .text-8xl { font-size: 4rem; }
      .text-9xl { font-size: 5rem; }
      .text-6xl { font-size: 3.5rem; }
      .text-7xl { font-size: 4rem; }
    }
  </style>
</head>
<body class="min-h-screen text-stone-100 flex flex-col justify-between antialiased selection:bg-brand-orange selection:text-white relative container-safe">

  <!-- Ambient Glow Background Effects - Responsive -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[500px] h-[250px] bg-brand-orange/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 right-4 sm:right-10 w-40 sm:w-60 md:w-80 h-40 sm:h-60 md:h-80 bg-brand-burgundyDark rounded-full blur-2xl pointer-events-none -z-10"></div>

  <!-- Top Minimal Navigation - Responsive -->
  <header class="w-full max-w-6xl mx-auto px-3 sm:px-4 md:px-6 py-4 sm:py-6 flex items-center justify-between">
    <div class="flex items-center gap-2 sm:gap-3">
      <a href="/" class="flex items-center gap-2 sm:gap-3 group">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-brand-orange text-white flex items-center justify-center font-cairo font-black text-lg sm:text-xl shadow-lg shadow-brand-orange/30 transition-transform group-hover:scale-105">
          د
        </div>
        <div class="flex flex-col">
          <span class="font-cairo font-black text-xl sm:text-2xl tracking-tight text-white flex items-center gap-1 sm:gap-1.5">
            دوق <span class="text-[10px] sm:text-xs bg-brand-orange/20 text-brand-orange border border-brand-orange/30 font-semibold px-1.5 sm:px-2 py-0.5 rounded-full">DOQ</span>
          </span>
          <span class="text-[9px] sm:text-[11px] text-stone-400 -mt-0.5 sm:-mt-1 font-medium hidden xs:block">منصة الأكل البيتي والشعبي المصري</span>
        </div>
      </a>
    </div>

    <!-- Security Status Badge - Responsive -->
    <div class="flex items-center gap-1.5 sm:gap-2 bg-stone-900/60 border border-stone-700/60 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full backdrop-blur-md">
      <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-red-500 animate-pulse"></span>
      <span class="text-[10px] sm:text-xs text-stone-300 font-medium flex items-center gap-0.5 sm:gap-1 font-tajawal">
        <span class="material-symbols-outlined text-[13px] sm:text-[15px] text-brand-orange">lock</span>
        <span class="hidden sm:inline">منطقة محظورة (403)</span>
        <span class="sm:hidden">403</span>
      </span>
    </div>
  </header>

  <!-- Main Content Container - Responsive -->
  <main class="flex-1 max-w-4xl w-full mx-auto px-3 sm:px-4 md:px-6 py-6 sm:py-8 md:py-12 flex flex-col items-center justify-center text-center relative z-10">

    <!-- Visual Backdrop: Behind The Scenes / Velvet Ropes & Kitchen Cart -->
    <div class="relative w-full max-w-sm sm:max-w-lg mb-4 sm:mb-6 flex flex-col items-center">
      
      <!-- Big Stylized 403 Typography - Responsive -->
      <div class="relative select-none">
        <span class="font-cairo font-black text-7xl sm:text-8xl md:text-9xl text-stone-800/40 tracking-widest block transform -translate-y-1 sm:-translate-y-2">
          403
        </span>
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="font-cairo font-extrabold text-5xl sm:text-6xl md:text-7xl text-brand-orange glow-orange tracking-wider">
            ٤٠٣
          </span>
        </div>
      </div>

      <!-- Velvet Rope & Stanchion Setup - Responsive -->
      <div class="w-full relative mt-[-15px] sm:mt-[-20px] flex items-end justify-center pt-2 sm:pt-4">
        
        <!-- Left Stanchion (Gold Pole) - Responsive -->
        <div class="relative flex flex-col items-center z-20">
          <div class="w-4 h-4 sm:w-6 sm:h-6 rounded-full bg-gradient-to-br from-amber-300 to-amber-600 shadow-md"></div>
          <div class="w-1.5 sm:w-2 h-12 sm:h-20 bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 rounded-sm"></div>
          <div class="w-6 sm:w-10 h-2 sm:h-3 bg-gradient-to-t from-amber-700 to-amber-400 rounded-full shadow-lg"></div>
        </div>

        <!-- Hanging Red Velvet Rope - Responsive SVG -->
        <div class="flex-1 mx-[-4px] sm:mx-[-6px] mb-8 sm:mb-12 relative h-8 sm:h-10 z-10 flex items-center justify-center">
          <svg class="w-full h-10 sm:h-12 overflow-visible" viewBox="0 0 200 40" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
            <path d="M 0,5 Q 100,45 200,5" stroke="#b91c1c" stroke-width="6" stroke-linecap="round" filter="drop-shadow(0 4px 10px rgba(0,0,0,0.6))"/>
            <path d="M 0,5 Q 100,45 200,5" stroke="#e11d48" stroke-width="3" stroke-dasharray="8 6" stroke-linecap="round" opacity="0.6"/>
            <!-- Hanging Sign on the rope - Responsive -->
            <g transform="translate(70, 18)">
              <rect x="0" y="0" width="60" height="22" rx="5" fill="#1c1917" stroke="#F26B1D" stroke-width="1.5" />
              <text x="30" y="15" fill="#ffffff" font-size="8" font-weight="bold" font-family="Cairo" text-anchor="middle">ممنوع الدخول</text>
            </g>
          </svg>
        </div>

        <!-- Center: Food Cart Silhouette - Responsive -->
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 z-0 opacity-90 scale-75 sm:scale-90 md:scale-100 flex flex-col items-center">
          <div class="relative bg-stone-900/90 border border-stone-700/80 rounded-xl sm:rounded-2xl p-3 sm:p-5 shadow-2xl backdrop-blur-sm flex flex-col items-center">
            
            <!-- Chef Hat with Lock Badge - Responsive -->
            <div class="relative mb-1.5 sm:mb-2">
              <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl bg-brand-burgundyDark border border-brand-orange/40 flex items-center justify-center text-brand-orange shadow-inner">
                <span class="material-symbols-outlined text-3xl sm:text-4xl text-brand-orange">chef_hat</span>
              </div>
              <div class="absolute -bottom-0.5 sm:-bottom-1 -left-0.5 sm:-left-1 w-5 h-5 sm:w-7 sm:h-7 bg-brand-orange text-white rounded-full flex items-center justify-center shadow-lg border-2 border-brand-burgundy">
                <span class="material-symbols-outlined text-[12px] sm:text-[16px]">lock</span>
              </div>
            </div>

            <!-- Mini Tag - Responsive -->
            <span class="text-[10px] sm:text-[12px] font-cairo font-bold text-stone-300 bg-stone-800/80 px-2 sm:px-3 py-0.5 rounded-full border border-stone-700 whitespace-nowrap">
              مطبخ الإدارة 👨‍🍳
            </span>
          </div>
        </div>

        <!-- Right Stanchion (Gold Pole) - Responsive -->
        <div class="relative flex flex-col items-center z-20">
          <div class="w-4 h-4 sm:w-6 sm:h-6 rounded-full bg-gradient-to-br from-amber-300 to-amber-600 shadow-md"></div>
          <div class="w-1.5 sm:w-2 h-12 sm:h-20 bg-gradient-to-r from-amber-300 via-amber-400 to-amber-600 rounded-sm"></div>
          <div class="w-6 sm:w-10 h-2 sm:h-3 bg-gradient-to-t from-amber-700 to-amber-400 rounded-full shadow-lg"></div>
        </div>

      </div>
    </div>

    <!-- Speech / Egyptian Message Section - Responsive -->
    <div class="max-w-xs sm:max-w-xl mx-auto space-y-2 sm:space-y-3">
      
      <!-- Badges - Responsive -->
      <div class="inline-flex items-center gap-1.5 sm:gap-2 px-2 sm:px-3 py-1 rounded-full bg-brand-orange/15 border border-brand-orange/30 text-brand-orange text-[11px] sm:text-sm font-semibold mb-0.5 sm:mb-1">
        <span class="material-symbols-outlined text-sm">shield_person</span>
        <span>كواليس المطبخ مقفولة</span>
      </div>

      <!-- Main Headline - Responsive -->
      <h1 class="font-cairo font-extrabold text-2xl sm:text-3xl md:text-4xl text-white tracking-tight leading-snug sm:leading-tight">
        الأمانة! المنطقة دي مخصوصة بس لأصحاب العربيات أو الإدارة
      </h1>

      <!-- Description / Explanation - Responsive -->
      <p class="text-stone-300 text-sm sm:text-base md:text-lg leading-relaxed font-normal pt-0.5 sm:pt-1">
        يبدو إنك وصلت لحرم المطبخ السري بدون تصريح رسمي! الصفحات دي مخصصة فقط للشيفات المسجلين وإدارة منصة <strong class="text-white font-semibold">دوق</strong> لمتابعة الطلبات والأرباح.
      </p>

      <!-- Tip Box - Responsive -->
      <div class="bg-stone-900/60 border border-stone-800 rounded-lg sm:rounded-xl p-2.5 sm:p-3.5 mt-3 sm:mt-4 text-[11px] sm:text-xs md:text-sm text-stone-400 flex items-center justify-center gap-1.5 sm:gap-2">
        <span class="material-symbols-outlined text-brand-orange text-base sm:text-lg flex-shrink-0">info</span>
        <span>إذا كنت شيف أو أدمن، يرجى تسجيل الدخول بحسابك لتفعيل الصلاحيات.</span>
      </div>
    </div>

    <!-- Action Buttons Group - Responsive -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mt-6 sm:mt-8 w-full max-w-sm sm:max-w-md px-1">
      <!-- Primary Solid Orange Button: Login -->
      <a href="/auth" class="w-full flex-1 inline-flex items-center justify-center gap-2 sm:gap-2.5 bg-brand-orange hover:bg-brand-orangeHover active:scale-[0.98] text-white font-cairo font-bold text-sm sm:text-base px-5 sm:px-6 py-3 sm:py-3.5 rounded-xl shadow-lg shadow-brand-orange/30 transition-all duration-200">
        <span class="material-symbols-outlined text-lg sm:text-xl">login</span>
        <span>تسجيل الدخول</span>
      </a>

      <!-- Ghost / Outline Button: Back to Homepage -->
      <a href="/" class="w-full flex-1 inline-flex items-center justify-center gap-2 sm:gap-2.5 bg-white/5 hover:bg-white/10 active:scale-[0.98] text-stone-200 hover:text-white border border-stone-600/70 hover:border-stone-400 font-cairo font-semibold text-sm sm:text-base px-5 sm:px-6 py-3 sm:py-3.5 rounded-xl transition-all duration-200 backdrop-blur-sm">
        <span class="material-symbols-outlined text-lg sm:text-xl">home</span>
        <span>العودة للرئيسية</span>
      </a>
    </div>

    <!-- Quick Links / Support Footer Help - Responsive -->
    <div class="mt-6 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 text-[10px] sm:text-xs text-stone-400 px-2">
      <a href="/contect-us" class="hover:text-brand-orange transition-colors flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">support_agent</span>
        تواصل مع الدعم الفني
      </a>
      <span class="w-1 h-1 rounded-full bg-stone-600 hidden sm:block"></span>
      <a href="/auth" class="hover:text-brand-orange transition-colors flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">restaurant</span>
        انضم كطاهٍ لمنصة دوق
      </a>
    </div>

  </main>

  <!-- Bottom Legal & Brand Note - Responsive -->
  <footer class="w-full border-t border-stone-800/80 bg-stone-950/40 py-3 sm:py-4 px-3 sm:px-6 text-center text-[10px] sm:text-xs text-stone-500 font-tajawal">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-1.5 sm:gap-2">
      <p>© <%= new Date().getFullYear() %> دوق (DOQ) - جميع الحقوق محفوظة.</p>
      <div class="flex items-center gap-2 sm:gap-4 text-stone-400 flex-wrap justify-center">
        <a href="/police/terms-of-service" class="hover:underline hover:text-stone-300">الشروط</a>
        <span class="hidden sm:inline">•</span>
        <a href="/police/privacy-policy" class="hover:underline hover:text-stone-300">الخصوصية</a>
      </div>
    </div>
  </footer>

</body>
</html>