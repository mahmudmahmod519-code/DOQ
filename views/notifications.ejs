<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>الإشعارات | دوق</title><script src="/app-client.js"></script><script src="https://cdn.tailwindcss.com"></script></head><body class="min-h-screen bg-[#fff8f6] text-[#261816]"><main class="mx-auto max-w-3xl p-4 md:p-8"><h1 class="text-3xl font-bold">الإشعارات</h1><p class="mt-2 text-[#59413d]">آخر التنبيهات الخاصة بحسابك</p><section id="items" class="mt-6 grid gap-3"></section></main><script>const esc=v=>DOQ.escape(v);async function load(){try{const j=await DOQ.api('/notifications/api');const rows=j.data||[];document.getElementById('items').innerHTML=rows.map(n=>'<article class="rounded-2xl border border-[#e1bfb9] bg-white p-4 '+(n.read_at?'opacity-60':'')+'"><div class="flex justify-between gap-3"><h2 class="font-bold">'+esc(n.title)+'</h2><time class="text-xs text-gray-500">'+new Date(n.created_at).toLocaleString('ar-EG')+'</time></div><p class="mt-2">'+esc(n.body)+'</p>'+(n.read_at?'':'<button class="mt-3 rounded-lg bg-[#fce2de] px-3 py-2 text-sm" data-id="'+n.id+'">تحديد كمقروء</button>')+'</article>').join('')||'<p>لا توجد إشعارات جديدة</p>'}catch(e){document.getElementById('items').textContent=e.message}}document.addEventListener('click',async e=>{const b=e.target.closest('[data-id]');if(!b)return;await DOQ.api('/notifications/api/'+encodeURIComponent(b.dataset.id)+'/read','PATCH',{});load()});load();</script></body></html>