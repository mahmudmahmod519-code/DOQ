<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>الإشعارات | دوق</title>
  <script src="/app-client.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Cairo', sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
  </style>
</head>
<body class="min-h-screen bg-surface text-on-surface">
  <main class="mx-auto max-w-3xl p-4 md:p-8 pt-20 sm:pt-16">
    <!-- Header with back arrow (RTL: right side) -->
    <div class="relative flex items-center justify-center mb-6 sm:mb-8">
      <a href="javascript:history.back()" class="absolute right-0 flex items-center justify-center w-10 h-10 rounded-full bg-surface-container-low hover:bg-primary hover:text-white transition-all duration-200 shadow-md">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
      </a>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-2xl text-primary">notifications</span>
        <h1 class="text-2xl md:text-3xl font-bold">الإشعارات</h1>
      </div>
    </div>
    <p class="text-sm sm:text-base text-on-surface-variant mt-1 mb-6">آخر التنبيهات الخاصة بحسابك</p>

    <section id="items" class="grid gap-3"></section>
  </main>
  <script>
    const esc = v => DOQ.escape(v);
    async function load() {
      try {
        const j = await DOQ.api('/notifications/api');
        const rows = j.data || [];
        document.getElementById('items').innerHTML = rows.map(n =>
          '<article class="rounded-2xl border border-[#e1bfb9] bg-white p-4 ' + (n.read_at ? 'opacity-60' : '') + '">'
          + '<div class="flex justify-between gap-3"><h2 class="font-bold">' + esc(n.title) + '</h2><time class="text-xs text-gray-500">' + new Date(n.created_at).toLocaleString('ar-EG') + '</time></div>'
          + '<p class="mt-2">' + esc(n.body) + '</p>'
          + (n.read_at ? '' : '<button class="mt-3 rounded-lg bg-[#fce2de] px-3 py-2 text-sm" data-id="' + n.id + '">تحديد كمقروء</button>')
          + '</article>'
        ).join('') || '<p class="text-center py-8 text-on-surface-variant">لا توجد إشعارات جديدة</p>';
      } catch (e) {
        document.getElementById('items').textContent = e.message;
      }
    }
    document.addEventListener('click', async e => {
      const b = e.target.closest('[data-id]');
      if (!b) return;
      await DOQ.api('/notifications/api/' + encodeURIComponent(b.dataset.id) + '/read', 'PATCH', {});
      load();
    });
    load();
  </script>
</body>
</html>