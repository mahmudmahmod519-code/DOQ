    <style>
        .hero-gradient {
            background: linear-gradient(135deg, #9e2016 0%, #c0392b 50%, #fc7127 100%);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(225, 191, 185, 0.3);
        }
        .form-input-focus {
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }
        .form-input-focus:focus {
            border-color: #9e2016;
            box-shadow: 0 0 0 4px rgba(158, 32, 22, 0.1);
            outline: none;
            background: white;
        }
        .form-input-focus::placeholder {
            color: #8d706c;
            opacity: 0.7;
        }
        .animate-spin {
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="text-on-surface bg-background">

    <%- include('./partials/header.ejs') %>


<main class="pt-24 pb-xl">

    <!-- Hero Section -->
    <section class="relative w-full overflow-hidden mb-lg">
        <div class="hero-gradient px-md py-xl md:py-24 text-center text-on-primary">
            <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg mb-sm">تواصل مع دوق</h1>
            <p class="font-body-lg text-body-lg max-w-2xl mx-auto opacity-90">
                إحنا هنا عشان نساعدك. سواء عندك استفسار عن عربية، أو عايز تنضم كصاحب عربية، فريق دوق مستني رسالتك.
            </p>
        </div>
        <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-background to-transparent"></div>
    </section>

    <div class="max-w-container-max mx-auto px-md md:px-xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-lg">

            <!-- Right Side: Sidebar & Contact Info -->
            <aside class="lg:col-span-4 space-y-md">
                
                <!-- Welcome Message -->
                <div class="bg-surface-container-low p-lg rounded-xl border border-outline-variant/30">
                    <h2 class="text-headline-md font-headline-md text-primary mb-sm">يسعدنا سماع صوتك!</h2>
                    <p class="font-body-md text-on-surface-variant leading-relaxed">
                        في دوق، بنؤمن إن التواصل الجيد جزء من التجربة. سواء بتدور على عربية أكل شارع مميزة، أو صاحب عربية عايز تعرض شغلك، إحنا هنا ندعمك.
                    </p>
                </div>

                <!-- Contact Cards -->
                <div class="grid grid-cols-1 gap-sm">
                    <!-- WhatsApp -->
                    <div class="glass-card p-md rounded-xl flex items-start gap-md hover:shadow-lg transition-shadow duration-300">
                        <div class="bg-secondary-container/10 p-sm rounded-lg text-secondary">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">chat</span>
                        </div>
                        <div>
                            <h3 class="font-headline-md text-body-md font-bold mb-xs">الدعم عبر واتساب</h3>
                            <p class="text-on-surface-variant font-body-md" dir="ltr">0100 123 4567</p>
                        </div>
                    </div>

                    <!-- Email Support -->
                    <div class="glass-card p-md rounded-xl flex items-start gap-md hover:shadow-lg transition-shadow duration-300">
                        <div class="bg-primary-container/10 p-sm rounded-lg text-primary">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">mail</span>
                        </div>
                        <div>
                            <h3 class="font-headline-md text-body-md font-bold mb-xs">البريد الإلكتروني العام</h3>
                            <p class="text-on-surface-variant font-body-md">support@doq.com</p>
                        </div>
                    </div>

                    <!-- Commercial -->
                    <div class="glass-card p-md rounded-xl flex items-start gap-md hover:shadow-lg transition-shadow duration-300">
                        <div class="bg-tertiary-container/10 p-sm rounded-lg text-tertiary">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">handshake</span>
                        </div>
                        <div>
                            <h3 class="font-headline-md text-body-md font-bold mb-xs">شراكات أصحاب العربيات</h3>
                            <p class="text-on-surface-variant font-body-md">commercial@doq.com</p>
                        </div>
                    </div>

                    <!-- Working Hours -->
                    <div class="glass-card p-md rounded-xl flex items-start gap-md">
                        <div class="bg-outline-variant/20 p-sm rounded-lg text-on-surface-variant">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">schedule</span>
                        </div>
                        <div>
                            <h3 class="font-headline-md text-body-md font-bold mb-xs">أوقات العمل</h3>
                            <p class="text-on-surface-variant font-body-md">السبت - الخميس، 10 صباحاً - 10 مساءً</p>
                        </div>
                    </div>
                </div>

                <!-- Social Links -->
                <div class="pt-md">
                    <h4 class="font-label-sm text-on-surface-variant mb-sm uppercase tracking-wider">تابعنا على</h4>
                    <div class="flex gap-sm flex-wrap">
                        <a href="https://wa.me/201001234567" target="_blank" class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-secondary hover:bg-secondary hover:text-on-secondary transition-all duration-300 shadow-sm">
                            <span class="material-symbols-outlined">chat</span>
                        </a>
                        <a href="https://t.me/dhouq" target="_blank" class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-secondary hover:bg-secondary hover:text-on-secondary transition-all duration-300 shadow-sm">
                            <span class="material-symbols-outlined">send</span>
                        </a>
                        <a href="https://facebook.com/dhouq" target="_blank" class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-secondary hover:bg-secondary hover:text-on-secondary transition-all duration-300 shadow-sm">
                            <span class="material-symbols-outlined">public</span>
                        </a>
                        <a href="https://instagram.com/dhouq" target="_blank" class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-secondary hover:bg-secondary hover:text-on-secondary transition-all duration-300 shadow-sm">
                            <span class="material-symbols-outlined">photo_camera</span>
                        </a>
                        <a href="https://youtube.com/dhouq" target="_blank" class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-secondary hover:bg-secondary hover:text-on-secondary transition-all duration-300 shadow-sm">
                            <span class="material-symbols-outlined">video_library</span>
                        </a>
                    </div>
                </div>
            </aside>

            <!-- Left Side: Contact Form -->
            <section class="lg:col-span-8">
                <div class="bg-white p-lg md:p-xl rounded-2xl shadow-[0px_4px_20px_rgba(192,57,43,0.06)] border border-outline-variant/20">
                    
                    <!-- Form Header -->
                    <div class="mb-md text-right">
                        <h3 class="text-headline-md font-headline-md text-on-surface mb-xs">نحب أن نسمع منك!</h3>
                        <p class="text-on-surface-variant font-body-md">املأ النموذج التالي وسنرد عليك في أقرب وقت ممكن.</p>
                    </div>

                    <form id="contactForm" class="space-y-md">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                            <div class="space-y-xs">
                                <label for="name" class="font-label-sm text-on-surface-variant mr-xs">الاسم بالكامل</label>
                                <input type="text" id="name" required class="w-full bg-surface-bright border-outline-variant/30 rounded-xl px-md py-sm form-input-focus transition-all text-body-md" placeholder="أدخل اسمك الكريم">
