<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>مطبخي | DOQ</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Tajawal', sans-serif;
            scroll-behavior: smooth;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .glass-effect {
            backdrop-filter: blur(10px);
            background: rgba(255, 248, 246, 0.8);
        }
        .culinary-gradient {
            background: linear-gradient(135deg, #9e2016 0%, #c0392b 100%);
        }
        .animate-spin {
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .slide-in-from-right {
            animation: slideInRight 0.3s ease-out forwards;
        }
        @keyframes slideInRight {
            from { opacity: 0; transform: translateX(50px); }
            to { opacity: 1; transform: translateX(0); }
        }
    </style>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-primary-fixed-variant": "#8e130c",
                        "surface-container-high": "#fce2de",
                        "surface-container-lowest": "#ffffff",
                        "inverse-primary": "#ffb4a9",
                        "on-secondary": "#ffffff",
                        "primary-fixed-dim": "#ffb4a9",
                        "tertiary-fixed": "#c0e8ff",
                        "surface-container-highest": "#f7ddd9",
                        "on-secondary-fixed": "#351000",
                        "tertiary-fixed-dim": "#80d0f8",
                        "on-surface-variant": "#59413d",
                        "tertiary-container": "#007296",
                        "outline": "#8d706c",
                        "error-container": "#ffdad6",
                        "secondary": "#a23f00",
                        "surface-dim": "#eed4d1",
                        "surface": "#fff8f6",
                        "on-tertiary-fixed": "#001e2b",
                        "tertiary": "#005875",
                        "surface-bright": "#fff8f6",
                        "on-secondary-fixed-variant": "#7c2e00",
                        "on-error-container": "#93000a",
                        "on-primary-fixed": "#410000",
                        "primary-fixed": "#ffdad5",
                        "on-background": "#261816",
                        "on-tertiary-fixed-variant": "#004d66",
                        "on-error": "#ffffff",
                        "on-secondary-container": "#5c2000",
                        "surface-container-low": "#fff0ee",
                        "surface-variant": "#f7ddd9",
                        "on-surface": "#261816",
                        "outline-variant": "#e1bfb9",
                        "on-tertiary-container": "#d3eeff",
                        "surface-tint": "#b02d21",
                        "on-tertiary": "#ffffff",
                        "on-primary": "#ffffff",
                        "error": "#ba1a1a",
                        "surface-container": "#ffe9e6",
                        "background": "#fff8f6",
                        "secondary-fixed-dim": "#ffb595",
                        "secondary-container": "#fc7127",
                        "primary": "#9e2016",
                        "inverse-on-surface": "#ffedea",
                        "secondary-fixed": "#ffdbcd",
                        "primary-container": "#c0392b",
                        "inverse-surface": "#3c2d2a",
                        "on-primary-container": "#ffe5e1"
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    spacing: {
                        "xl": "80px",
                        "container-max": "1280px",
                        "md": "24px",
                        "lg": "48px",
                        "base": "8px",
                        "sm": "12px",
                        "xs": "4px",
                        "gutter": "24px"
                    },
                    fontFamily: {
                        "body-md": ["Tajawal"],
                        "body-lg": ["Tajawal"],
                        "label-sm": ["Tajawal"],
                        "headline-md": ["Tajawal"],
                        "display-lg-mobile": ["Tajawal"],
                        "display-lg": ["Tajawal"]
                    },
                    fontSize: {
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                        "label-sm": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "display-lg-mobile": ["32px", {"lineHeight": "40px", "fontWeight": "700"}],
                        "display-lg": ["48px", {"lineHeight": "60px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-background text-on-surface min-h-screen">

    <!-- Top Navigation Bar -->
    <header class="fixed top-0 w-full z-50 bg-surface/80 dark:bg-surface-dim/80 backdrop-blur-md shadow-[0px_4px_20px_rgba(192,57,43,0.06)]">
        <div class="flex flex-row-reverse justify-between items-center w-full px-md md:px-xl py-sm max-w-container-max mx-auto">
            <div class="text-headline-md font-headline-md text-secondary">دوق</div>
            <nav class="hidden md:flex flex-row-reverse gap-lg items-center">
                <a class="text-on-surface-variant hover:text-secondary transition-colors font-body-md text-body-md" href="/">الرئيسية</a>
                <a class="text-on-surface-variant hover:text-secondary transition-colors font-body-md text-body-md" href="/kitchens">تصفح المطابخ</a>
                <a class="text-on-surface-variant hover:text-secondary transition-colors font-body-md text-body-md" href="/auth">انضم كطباخ</a>
                <a class="text-on-surface-variant hover:text-secondary transition-colors font-body-md text-body-md" href="/about">من نحن</a>
            </nav>
            <div class="flex items-center gap-sm">
                <a href="/auth/logout" class="bg-error/10 text-error px-md py-xs rounded-full font-label-sm text-label-sm hover:bg-error/20 transition-all">
                    تسجيل خروج
                </a>
            </div>
        </div>
    </header>

    <main class="pt-[72px] pb-xl">

        <!-- ============================================ -->
        <!-- EMPTY STATE - إذا لم يكن لدى الشيف مطبخ -->
        <!-- ============================================ -->
        <% if (!kitchen) { %>
            <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-md" id="empty-state">
                <div class="w-32 h-32 bg-surface-container rounded-full flex items-center justify-center mb-md">
                    <span class="material-symbols-outlined text-[64px] text-primary" style="font-variation-settings: 'FILL' 1;">restaurant</span>
                </div>
                <h2 class="font-display-lg text-display-lg-mobile md:text-display-lg mb-sm text-primary">🍳 ليس لديك مطبخ بعد!</h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant mb-lg max-w-lg">
                    ابدأ رحلتك الطهوية الآن وشارك أطباقك اللذيذة مع المجتمع. أنشئ مطبخك في دقائق!
                </p>
                <button id="createKitchenBtn" class="bg-secondary-container text-white px-lg py-md rounded-xl font-headline-md text-headline-md hover:scale-[1.05] transition-all shadow-lg">
                    ➕ إنشاء مطبخ الآن
                </button>
            </div>
        <% } else { %>

            <!-- ============================================ -->
            <!-- DASHBOARD CONTENT - إذا كان المطبخ موجود -->
            <!-- ============================================ -->
            <div id="dashboard-content">

                <!-- Toast Container -->
                <div id="toastContainer" class="fixed top-24 right-6 z-[100] flex flex-col gap-2"></div>

                <!-- Page Header -->
                <section class="relative">
                    <div class="max-w-container-max mx-auto px-md md:px-xl relative z-10 pt-lg">
                        <div class="bg-surface rounded-3xl p-md md:p-lg shadow-[0px_12px_40px_rgba(44,62,80,0.12)] flex flex-col md:flex-row gap-md items-start md:items-end border border-outline-variant/30">
                            
                            <!-- Avatar -->
                            <div class="relative">
                                <div class="w-32 h-32 md:w-40 md:h-40 rounded-full border-8 border-surface overflow-hidden bg-primary-container flex items-center justify-center text-on-primary-container text-[48px] font-bold shadow-lg">
                                    <%= kitchen.title ? kitchen.title.charAt(0).toUpperCase() : 'م' %>
                                </div>
                                <button id="uploadAvatarBtn" class="absolute bottom-2 left-2 bg-secondary text-white p-2 rounded-full shadow-md hover:scale-110 transition-transform">
                                    <span class="material-symbols-outlined">photo_camera</span>
                                </button>
                            </div>

                            <!-- Info -->
                            <div class="flex-1 space-y-2">
                                <div class="flex items-center gap-sm flex-wrap">
                                    <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary">
                                        <%= kitchen.title || 'مطبخي' %>
                                    </h1>
                                    <span class="bg-surface-container-high text-secondary px-sm py-1 rounded-full text-label-sm font-label-sm">
                                        شيف معتمد
                                    </span>
                                </div>
                                <p class="font-body-lg text-body-lg text-on-surface-variant flex items-center gap-xs">
                                    <span class="material-symbols-outlined text-primary">person</span>
                                    الشيف <%= currentUser ? currentUser.first_name + ' ' + currentUser.last_name : '' %>
                                </p>
                                <div class="flex flex-wrap gap-md text-on-surface-variant font-label-sm pt-sm">
                                    <% if (kitchen.city) { %>
                                        <div class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-secondary">location_on</span>
                                            <%= kitchen.city %>
                                        </div>
                                    <% } %>
                                    <div class="flex items-center gap-1">
                                        <span class="material-symbols-outlined text-secondary">call</span>
                                        <%= kitchen.phone_number || 'غير محدد' %>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <span class="material-symbols-outlined text-secondary">calendar_today</span>
                                        انضم في <%= new Date(kitchen.created_at).toLocaleDateString('ar-EG') %>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Button -->
                            <div class="flex flex-col gap-sm w-full md:w-auto">
                                <button class="w-full bg-tertiary text-on-tertiary px-md py-sm rounded-xl flex items-center justify-center gap-2 font-label-sm hover:bg-tertiary-container transition-colors" 
                                        onclick="document.getElementById('edit-section').scrollIntoView({behavior: 'smooth'})">
                                    <span class="material-symbols-outlined">edit</span>
                                    تعديل بيانات المطبخ
                                </button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Stats Bar -->
                <section class="max-w-container-max mx-auto px-md md:px-xl py-lg">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
                        <div class="bg-surface-container-low p-md rounded-2xl flex items-center gap-md border border-outline-variant/30 hover:shadow-md transition-all">
                            <div class="w-14 h-14 rounded-full culinary-gradient flex items-center justify-center text-white">
                                <span class="material-symbols-outlined text-3xl">restaurant_menu</span>
                            </div>
                            <div>
                                <p class="text-on-surface-variant font-label-sm">عدد الأطباق</p>
                                <p class="text-headline-md font-headline-md text-primary" id="dishesCount">0 طبق</p>
                            </div>
                        </div>
                        <div class="bg-surface-container-low p-md rounded-2xl flex items-center gap-md border border-outline-variant/30 hover:shadow-md transition-all">
                            <div class="w-14 h-14 rounded-full bg-secondary-container flex items-center justify-center text-white">
                                <span class="material-symbols-outlined text-3xl">reviews</span>
                            </div>
                            <div>
                                <p class="text-on-surface-variant font-label-sm">إجمالي التقييمات</p>
                                <p class="text-headline-md font-headline-md text-secondary" id="reviewsCount">0 تقييم</p>
                            </div>
                        </div>
                        <div class="bg-surface-container-low p-md rounded-2xl flex items-center gap-md border border-outline-variant/30 hover:shadow-md transition-all">
                            <div class="w-14 h-14 rounded-full bg-tertiary flex items-center justify-center text-white">
                                <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">star</span>
                            </div>
                            <div>
                                <p class="text-on-surface-variant font-label-sm">متوسط التقييم</p>
                                <div class="flex items-center gap-1 text-headline-md font-headline-md text-tertiary" id="avgRatingDisplay">
                                    جديد
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Main Actions -->
                <section class="max-w-container-max mx-auto px-md md:px-xl pb-lg">
                    <div class="flex flex-wrap gap-md">
                        <button id="addDishBtn" class="bg-primary text-white px-lg py-md rounded-xl flex items-center gap-2 font-headline-md shadow-lg hover:scale-[1.02] active:scale-95 transition-all">
                            <span class="material-symbols-outlined">add_circle</span>
                            إضافة أكلة جديدة
                        </button>
                        <a href="/dishes?kitchen_id=<%= kitchen.id %>" class="bg-secondary-fixed text-on-secondary-fixed-variant px-lg py-md rounded-xl flex items-center gap-2 font-headline-md border border-secondary/20 hover:bg-secondary-fixed-dim transition-all">
                            <span class="material-symbols-outlined">format_list_bulleted</span>
                            عرض جميع الأطباق
                        </a>
                    </div>
                </section>

                <!-- Edit Form Section & Image Upload -->
                <section class="max-w-container-max mx-auto px-md md:px-xl py-lg" id="edit-section">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-lg">
                        
                        <!-- Edit Form -->
                        <div class="lg:col-span-2 bg-surface rounded-3xl p-md md:p-xl shadow-[0px_4px_20px_rgba(192,57,43,0.06)] border border-outline-variant/30">
                            <h2 class="font-headline-md text-headline-md text-primary mb-lg flex items-center gap-2">
                                <span class="material-symbols-outlined">settings</span>
                                تعديل بيانات المطبخ
                            </h2>

                            <form class="space-y-md" id="kitchen-form">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                                    <div class="space-y-xs">
                                        <label class="font-label-sm text-on-surface-variant mr-1">اسم المطبخ</label>
                                        <input id="kitchenTitle" class="w-full bg-surface-container-low border-outline-variant/30 focus:border-primary focus:ring-primary rounded-xl py-sm px-md outline-none transition-all" 
                                               type="text" value="<%= kitchen.title || '' %>">
                                    </div>
                                    <div class="space-y-xs">
                                        <label class="font-label-sm text-on-surface-variant mr-1">رقم الهاتف</label>
                                        <input id="kitchenPhone" class="w-full bg-surface-container-low border-outline-variant/30 focus:border-primary focus:ring-primary rounded-xl py-sm px-md outline-none transition-all" 
                                               dir="ltr" type="tel" value="<%= kitchen.phone_number || '' %>">
                                    </div>
                                </div>

                                <div class="space-y-xs">
                                    <label class="font-label-sm text-on-surface-variant mr-1">وصف المطبخ</label>
                                    <textarea id="kitchenDescription" class="w-full bg-surface-container-low border-outline-variant/30 focus:border-primary focus:ring-primary rounded-xl py-sm px-md outline-none transition-all" 
                                              rows="4"><%= kitchen.description || '' %></textarea>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                                    <div class="space-y-xs">
                                        <label class="font-label-sm text-on-surface-variant mr-1">المدينة</label>
                                        <input id="kitchenCity" class="w-full bg-surface-container-low border-outline-variant/30 focus:border-primary focus:ring-primary rounded-xl py-sm px-md outline-none transition-all" 
                                               type="text" value="<%= kitchen.city || '' %>" placeholder="مثال: القاهرة">
                                    </div>
                                    <div class="space-y-xs">
                                        <label class="font-label-sm text-on-surface-variant mr-1">العنوان بالتفصيل</label>
                                        <input id="kitchenAddress" class="w-full bg-surface-container-low border-outline-variant/30 focus:border-primary focus:ring-primary rounded-xl py-sm px-md outline-none transition-all" 
                                               type="text" value="<%= kitchen.address || '' %>" placeholder="شارع 9، مدينة نصر">
                                    </div>
                                </div>

                                <div class="flex justify-end gap-md pt-lg">
                                    <button class="text-on-surface-variant font-label-sm px-lg py-sm hover:bg-surface-container-high rounded-xl transition-all" type="button" id="resetFormBtn">
                                        إلغاء
                                    </button>
                                    <button class="bg-primary text-white px-xl py-sm rounded-xl font-label-sm shadow-md hover:shadow-lg transition-all" type="submit" id="saveKitchenBtn">
                                        💾 حفظ التغييرات
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Image Upload -->
                        <div class="space-y-lg">
                            <div class="bg-surface rounded-3xl p-md shadow-[0px_4px_20px_rgba(192,57,43,0.06)] border border-outline-variant/30">
                                <h3 class="font-label-sm text-on-surface-variant mb-md">صورة غلاف المطبخ</h3>
                                <div class="relative group cursor-pointer overflow-hidden rounded-2xl h-48 mb-md">
                                    <div id="kitchenImagePreview" class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-110" 
                                         style="background-image: url('<%= kitchen.image_url || 'https://images.unsplash.com/photo-1547928576-a4a33237eceb?auto=format&fit=crop&w=600&q=80' %>');">
                                    </div>
                                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                        <span class="material-symbols-outlined text-white text-4xl">cloud_upload</span>
                                    </div>
                                </div>
                                <input class="hidden" id="cover-upload" type="file" accept="image/*">
                                <button class="w-full border-2 border-dashed border-outline-variant text-on-surface-variant py-md rounded-xl flex items-center justify-center gap-2 hover:border-primary hover:text-primary transition-all" 
                                        onclick="document.getElementById('cover-upload').click()">
                                    <span class="material-symbols-outlined">image</span>
                                    رفع صورة جديدة
                                </button>
                            </div>

                            <div class="bg-primary-container/10 p-md rounded-3xl border border-primary/10">
                                <div class="flex gap-sm items-start">
                                    <span class="material-symbols-outlined text-primary">info</span>
                                    <div>
                                        <p class="font-label-sm text-primary font-bold">نصيحة للشيف</p>
                                        <p class="font-body-md text-on-surface-variant text-sm">
                                            الصور الواضحة والمضاءة جيداً تزيد من نسبة الطلبات بمعدل ٣ أضعاف!
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        <% } %>

    </main>

    <!-- Footer -->
    <footer class="bg-surface-container-lowest dark:bg-surface-dim w-full py-lg mt-xl border-t border-outline-variant/30">
        <div class="flex flex-col md:flex-row-reverse justify-between items-center px-md md:px-xl max-w-container-max mx-auto gap-sm">
            <div class="text-headline-md font-headline-md text-secondary">دوق</div>
            <div class="flex flex-row-reverse gap-md">
                <a class="text-on-surface-variant hover:text-secondary transition-colors font-label-sm text-label-sm" href="#">سياسة الخصوصية</a>
                <a class="text-on-surface-variant hover:text-secondary transition-colors font-label-sm text-label-sm" href="#">شروط الاستخدام</a>
                <a class="text-on-surface-variant hover:text-secondary transition-colors font-label-sm text-label-sm" href="/contact">اتصل بنا</a>
            </div>
            <div class="text-on-surface-variant font-label-sm text-label-sm">© 2026 دوق. جميع الحقوق محفوظة.</div>
        </div>
    </footer>

    <script>
        // ============================================
        // Toast Notifications
        // ============================================
        function showToast(message, type) {
            type = type || 'success';
            var container = document.getElementById('toastContainer');
            if (!container) return;
            
            var toast = document.createElement('div');
            var bgColor = type === 'success' ? 'bg-[#059669]' : type === 'error' ? 'bg-[#dc2626]' : 'bg-[#0d6efd]';
            var icon = type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info';
            
            toast.className = bgColor + ' text-white px-md py-sm rounded-xl shadow-xl flex items-center gap-3 slide-in-from-right';
            toast.innerHTML = '<span class="material-symbols-outlined">' + icon + '</span><span class="font-bold">' + message + '</span>';
            container.appendChild(toast);
            
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(50px)';
                toast.style.transition = 'all 0.5s ease';
                setTimeout(function() { toast.remove(); }, 500);
            }, 4000);
        }

        // ============================================
        // Fetch Kitchen Stats (dishes, reviews)
        // ============================================
        async function fetchKitchenStats() {
            var kitchenId = '<%= kitchen ? kitchen.id : "" %>';
            if (!kitchenId) return;

            try {
                // 1. جلب الأطباق
                var dishesRes = await fetch('/dishes/kitchen/' + kitchenId);
                var dishesData = await dishesRes.json();

                if (dishesData.status === 'success') {
                    var dishes = dishesData.data || [];
                    document.getElementById('dishesCount').textContent = dishes.length + ' طبق';
                }

                // 2. جلب التقييمات
                var reviewsRes = await fetch('/reviews/kitchen/' + kitchenId);
                var reviewsData = await reviewsRes.json();

                if (reviewsData.status === 'success') {
                    var reviews = reviewsData.data || [];
                    document.getElementById('reviewsCount').textContent = reviews.length + ' تقييم';

                    // حساب متوسط التقييم
                    if (reviews.length > 0) {
                        var total = 0;
                        for (var i = 0; i < reviews.length; i++) {
                            total += reviews[i].rating;
                        }
                        var avg = (total / reviews.length).toFixed(1);
                        document.getElementById('avgRatingDisplay').innerHTML = avg + ' <span class="material-symbols-outlined text-lg">star</span>';
                    }
                }

            } catch (error) {
                console.error('Error fetching stats:', error);
            }
        }

        // ============================================
        // Create Kitchen (from Empty State)
        // ============================================
        var createBtn = document.getElementById('createKitchenBtn');
        if (createBtn) {
            createBtn.addEventListener('click', function() {
                var btn = this;
                var originalText = btn.textContent;
                btn.textContent = 'جاري الإنشاء...';
                btn.disabled = true;

                fetch('/kitchens/api/v1', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        title: 'مطبخي الجديد',
                        phone_number: '<%= currentUser ? currentUser.phone_number : "" %>'
                    })
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data.status === 'success') {
                        showToast('✅ ' + data.message, 'success');
                        if (data.redirect) {
                            setTimeout(function() { window.location.href = data.redirect; }, 1000);
                        } else {
                            location.reload();
                        }
                    } else {
                        showToast('❌ ' + data.message, 'error');
                        btn.textContent = originalText;
                        btn.disabled = false;
                    }
                })
                .catch(function(error) {
                    console.error('Create Kitchen Error:', error);
                    showToast('❌ حدث خطأ في الاتصال بالخادم', 'error');
                    btn.textContent = originalText;
                    btn.disabled = false;
                });
            });
        }

        // ============================================
        // Update Kitchen - PUT /kitchens/:id
        // ============================================
        var kitchenForm = document.getElementById('kitchen-form');
        if (kitchenForm) {
            kitchenForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                var btn = document.getElementById('saveKitchenBtn');
                var originalText = btn.textContent;
                btn.disabled = true;
                btn.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> جاري الحفظ...';

                var kitchenId = '<%= kitchen ? kitchen.id : "" %>';
                var data = {
                    title: document.getElementById('kitchenTitle').value.trim(),
                    description: document.getElementById('kitchenDescription').value.trim(),
                    city: document.getElementById('kitchenCity').value.trim(),
                    address: document.getElementById('kitchenAddress').value.trim(),
                    phone_number: document.getElementById('kitchenPhone').value.trim()
                };

                fetch('/kitchens/api/v1/my', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                })
                .then(function(response) { return response.json(); })
                .then(function(result) {
                    if (result.status === 'success') {
                        showToast('✅ ' + (result.message || 'تم تحديث المطبخ بنجاح'), 'success');
                        btn.innerHTML = '✅ تم الحفظ';
                        btn.classList.remove('bg-primary');
                        btn.classList.add('bg-green-600');
                        
                        // تحديث الـ Header
                        var titleEl = document.querySelector('.font-display-lg.text-primary');
                        if (titleEl && data.title) titleEl.textContent = data.title;
                        
                        setTimeout(function() {
                            btn.innerHTML = originalText;
                            btn.classList.remove('bg-green-600');
                            btn.classList.add('bg-primary');
                            btn.disabled = false;
                        }, 2000);
                    } else {
                        showToast('❌ ' + (result.message || 'حدث خطأ'), 'error');
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }
                })
                .catch(function(error) {
                    console.error('Update Error:', error);
                    showToast('❌ حدث خطأ في الاتصال بالخادم', 'error');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                });
            });
        }

        // ============================================
        // Reset Form
        // ============================================
        var resetBtn = document.getElementById('resetFormBtn');
        if (resetBtn) {
            resetBtn.addEventListener('click', function() {
                document.getElementById('kitchenTitle').value = '<%= kitchen ? kitchen.title : "" %>';
                document.getElementById('kitchenDescription').value = '<%= kitchen ? kitchen.description : "" %>';
                document.getElementById('kitchenCity').value = '<%= kitchen ? kitchen.city : "" %>';
                document.getElementById('kitchenAddress').value = '<%= kitchen ? kitchen.address : "" %>';
                document.getElementById('kitchenPhone').value = '<%= kitchen ? kitchen.phone_number : "" %>';
                showToast('🔄 تم إعادة تعيين النموذج', 'info');
            });
        }

        // ============================================
        // Upload Image - POST /kitchens/:id/image
        // ============================================
        var fileInput = document.getElementById('cover-upload');
        if (fileInput) {
            fileInput.addEventListener('change', function() {
                if (this.files.length === 0) return;
                
                var formData = new FormData();
                formData.append('image', this.files[0]);
                
                var kitchenId = '<%= kitchen ? kitchen.id : "" %>';
                var btn = this.parentElement.querySelector('button');
                var originalText = btn.textContent;
                btn.textContent = 'جاري الرفع...';
                btn.disabled = true;
                
                fetch('/kitchens/api/v1/my/upload', {
                    method: 'POST',
                    body: formData
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data.status === 'success') {
                        showToast('✅ ' + (data.message || 'تم رفع الصورة بنجاح'), 'success');
                        var imgDiv = document.getElementById('kitchenImagePreview');
                        if (imgDiv && data.data && data.data.image_url) {
                            imgDiv.style.backgroundImage = 'url(' + data.data.image_url + ')';
                        }
                        btn.textContent = '✅ تم الرفع';
                        setTimeout(function() {
                            btn.textContent = originalText;
                            btn.disabled = false;
                        }, 2000);
                    } else {
                        showToast('❌ ' + (data.message || 'حدث خطأ'), 'error');
                        btn.textContent = originalText;
                        btn.disabled = false;
                    }
                })
                .catch(function(error) {
                    console.error('Upload Error:', error);
                    showToast('❌ حدث خطأ في الاتصال بالخادم', 'error');
                    btn.textContent = originalText;
                    btn.disabled = false;
                });
            });
        }

        // ============================================
        // Add Dish Button
        // ============================================
        var addDishBtn = document.getElementById('addDishBtn');
        if (addDishBtn) {
            addDishBtn.addEventListener('click', function() {
                window.location.href = '/dishes/create?kitchen_id=<%= kitchen ? kitchen.id : "" %>';
            });
        }

        // ============================================
        // Stats Cards Hover Effect
        // ============================================
        document.querySelectorAll('.bg-surface-container-low').forEach(function(card) {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px)';
                this.style.transition = 'all 0.3s ease';
            });
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });

        // ============================================
        // Initialize - Fetch Stats on Load
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            // إذا كان هناك مطبخ، جلب الإحصائيات
            var kitchenExists = '<%= kitchen ? true : false %>';
            if (kitchenExists) {
                fetchKitchenStats();
            }
        });
    </script>

</body>
</html>