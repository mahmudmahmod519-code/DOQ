<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Dhouq | تغيير كلمة المرور</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#9e2016",
                        "primary-container": "#c0392b",
                        "on-primary-container": "#ffe5e1",
                        "secondary": "#a23f00",
                        "on-surface": "#261816",
                        "on-surface-variant": "#59413d",
                        "surface-container-low": "#fff0ee",
                        "surface-container-lowest": "#ffffff",
                        "outline-variant": "#e1bfb9"
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap');
        body { font-family: 'Tajawal', sans-serif; background-color: #fff8f6; }
        .hidden-form { display: none; opacity: 0; transform: translateY(10px); }
        .visible-form { display: block; opacity: 1; transform: translateY(0); transition: opacity 0.4s ease, transform 0.4s ease; }
        .animate-fadeIn {
            animation: fadeIn 0.3s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        input[type="text"]:focus, input[type="email"]:focus, input[type="password"]:focus {
            outline: none;
        }
        .alert {
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 16px;
            font-weight: 600;
            text-align: right;
            animation: fadeIn 0.3s ease-out;
        }
        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }
        .alert-error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }
        .btn-loading {
            opacity: 0.7;
            pointer-events: none;
            cursor: not-allowed;
        }
    </style>
</head>
<body class="antialiased overflow-x-hidden">
<main class="min-h-screen flex flex-col md:flex-row">
    
    <!-- Left Panel - Visual Marketing (hidden on mobile) -->
    <section class="hidden md:flex md:w-1/2 relative bg-[#2C3E50] overflow-hidden items-center justify-center p-12">
        <div class="absolute inset-0 z-0 bg-cover bg-center opacity-40 mix-blend-overlay" style="background-image: url('https://images.unsplash.com/photo-1547928576-a4a33237eceb?auto=format&fit=crop&w=1000&q=80');"></div>
        <div class="absolute inset-0 z-10 bg-gradient-to-br from-[#2C3E50] via-[#2C3E50]/80 to-secondary/30"></div>
        <div class="relative z-20 text-center flex flex-col items-center max-w-lg">
            <div class="mb-6">
                <span class="text-5xl">🛡️</span>
                <h2 class="text-2xl font-bold text-white mt-2">دوق</h2>
            </div>
            <h1 class="text-3xl font-bold text-white mb-4 leading-tight">تغيير كلمة المرور</h1>
            <div class="w-24 h-1 bg-secondary rounded-full mb-6"></div>
            <p class="text-lg text-white/80">تأمين حسابك بكلمة مرور قوية وجديدة</p>
            <div class="mt-8 flex gap-4 text-white/60 text-sm">
                <span>🔐 آمن</span>
                <span>•</span>
                <span>🔄 تحديث فوري</span>
            </div>
        </div>
    </section>

    <!-- Right Panel - Form -->
    <section class="w-full md:w-1/2 flex flex-col items-center justify-center p-6 md:p-12 bg-surface relative">
        <div class="w-full max-w-md">

            <!-- Alert Container -->
            <div id="alert-container"></div>

            <div class="bg-white rounded-2xl shadow-xl p-6 border border-slate-100 overflow-hidden">
                
                <!-- Header -->
                <div class="text-right mb-6">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="text-3xl">🔄</span>
                        <div>
                            <h2 class="text-xl font-bold text-on-surface">تغيير كلمة المرور</h2>
                            <p class="text-sm text-on-surface-variant">أدخل رمز التحقق وكلمة المرور الحالية ثم الجديدة</p>
                        </div>
                    </div>
                </div>

                <!-- User Info -->
                <div class="bg-surface-container-low rounded-xl p-3 mb-5 flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary">person</span>
                    <div>
                        <p class="font-semibold text-sm text-on-surface"><%= currentUser ? currentUser.first_name + ' ' + currentUser.last_name : 'المستخدم' %></p>
                        <p class="text-xs text-on-surface-variant"><%= currentUser ? currentUser.email : '' %></p>
                    </div>
                </div>

                <!-- Form -->
                <form class="space-y-4" id="reset-password-form">

                    <!-- Code Field -->
                    <div>
                        <label class="block text-xs font-semibold text-on-surface mb-1.5 pr-1">
                            <span class="material-symbols-outlined text-[16px] align-middle ml-1">shield</span>
                            رمز التحقق
                        </label>
                        <input 
                            type="text" 
                            name="code" 
                            id="code"
                            class="w-full px-4 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-center tracking-[8px] text-2xl font-bold"
                            placeholder="• • • • • •"
                            maxlength="6"
                            required
                            dir="ltr"
                            autocomplete="one-time-code"
                        >
                        <div class="text-[10px] text-on-surface-variant mt-1 pr-1">أدخل الرمز المكون من 6 أرقام</div>
                    </div>

                    <!-- Current Password -->
                    <div>
                        <label class="block text-xs font-semibold text-on-surface mb-1.5 pr-1">
                            <span class="material-symbols-outlined text-[16px] align-middle ml-1">lock</span>
                            كلمة المرور الحالية
                        </label>
                        <div class="relative group">
                            <input 
                                type="password" 
                                name="current_password" 
                                id="current_password"
                                class="w-full pr-10 pl-10 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-right"
                                placeholder="••••••••"
                                required
                            >
                            <button 
                                type="button" 
                                class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition"
                                onclick="togglePassword(this)"
                            >
                                <span class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- New Password -->
                    <div>
                        <label class="block text-xs font-semibold text-on-surface mb-1.5 pr-1">
                            <span class="material-symbols-outlined text-[16px] align-middle ml-1">key</span>
                            كلمة المرور الجديدة
                        </label>
                        <div class="relative group">
                            <input 
                                type="password" 
                                name="new_password" 
                                id="new_password"
                                class="w-full pr-10 pl-10 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-right"
                                placeholder="••••••••"
                                required
                                minlength="8"
                            >
                            <button 
                                type="button" 
                                class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition"
                                onclick="togglePassword(this)"
                            >
                                <span class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                        </div>
                        <div class="text-[10px] text-on-surface-variant mt-1 pr-1">يجب أن تحتوي على 8 أحرف على الأقل، حرف كبير، حرف صغير، رقم، ورمز خاص</div>
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label class="block text-xs font-semibold text-on-surface mb-1.5 pr-1">
                            <span class="material-symbols-outlined text-[16px] align-middle ml-1">check_circle</span>
                            تأكيد كلمة المرور الجديدة
                        </label>
                        <div class="relative group">
                            <input 
                                type="password" 
                                name="confirm_password" 
                                id="confirm_password"
                                class="w-full pr-10 pl-10 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-right"
                                placeholder="••••••••"
                                required
                            >
                            <button 
                                type="button" 
                                class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition"
                                onclick="togglePassword(this)"
                            >
                                <span class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- Password Strength Indicator -->
                    <div id="password-strength" class="hidden">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-semibold text-on-surface">قوة كلمة المرور:</span>
                            <div class="flex-1 h-1.5 bg-gray-200 rounded-full overflow-hidden">
                                <div id="strength-bar" class="h-full w-0 transition-all duration-300 rounded-full"></div>
                            </div>
                            <span id="strength-text" class="text-xs font-semibold"></span>
                        </div>
                    </div>

                    <!-- Password Requirements -->
                    <div class="p-3 bg-surface-container-low rounded-xl text-right">
                        <p class="text-xs font-semibold text-on-surface mb-1.5">متطلبات كلمة المرور:</p>
                        <div class="grid grid-cols-2 gap-1 text-[11px]">
                            <div class="flex items-center gap-1.5 text-on-surface-variant" id="req-length">
                                <span class="material-symbols-outlined text-[14px]">circle</span>
                                <span>8 أحرف على الأقل</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-on-surface-variant" id="req-uppercase">
                                <span class="material-symbols-outlined text-[14px]">circle</span>
                                <span>حرف كبير (A-Z)</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-on-surface-variant" id="req-lowercase">
                                <span class="material-symbols-outlined text-[14px]">circle</span>
                                <span>حرف صغير (a-z)</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-on-surface-variant" id="req-number">
                                <span class="material-symbols-outlined text-[14px]">circle</span>
                                <span>رقم (0-9)</span>
                            </div>
                            <div class="flex items-center gap-1.5 text-on-surface-variant col-span-2" id="req-special">
                                <span class="material-symbols-outlined text-[14px]">circle</span>
                                <span>رمز خاص (@$!%*?&)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button 
                        type="submit" 
                        id="reset-btn"
                        class="w-full py-3 bg-primary-container text-on-primary-container rounded-xl font-bold hover:opacity-90 transition-all shadow-md mt-1 text-base"
                    >
                        <span class="material-symbols-outlined text-[20px] align-middle ml-1">save</span>
                        تحديث كلمة المرور
                    </button>

                    <!-- Back to Dashboard -->
                    <div class="text-center pt-1">
                        <a href="/user/profile" class="text-primary hover:underline text-sm flex items-center justify-center gap-1">
                            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                           العودة الى صفحتي
                        </a>
                    </div>
                </form>
            </div>

            <footer class="mt-6 text-center space-y-2">
                <p class="text-xs text-on-surface-variant">© 2026 دوق. جميع الحقوق محفوظة</p>
            </footer>
        </div>
    </section>
</main>

<script>
// ============================================
// Toggle Password Visibility
// ============================================
function togglePassword(btn) {
    const input = btn.parentElement.querySelector('input');
    const icon = btn.querySelector('.material-symbols-outlined');
    if (input.type === 'password') {
        input.type = 'text';
        icon.innerText = 'visibility_off';
    } else {
        input.type = 'password';
        icon.innerText = 'visibility';
    }
}

// ============================================
// Auto-format Code Input
// ============================================
document.getElementById('code').addEventListener('input', function() {
    this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
});

// ============================================
// Show Alert Function
// ============================================
function showAlert(message, type) {
    const container = document.getElementById('alert-container');
    const cls = type === 'success' ? 'alert-success' : 'alert-error';
    container.innerHTML = `<div class="alert ${cls}">${message}</div>`;
    setTimeout(() => {
        const alert = container.querySelector('.alert');
        if (alert) {
            alert.style.opacity = '0';
            alert.style.transition = 'opacity 0.5s';
            setTimeout(() => {
                if (alert.parentNode) alert.remove();
            }, 500);
        }
    }, 5000);
}

// ============================================
// Password Strength & Requirements
// ============================================
const newPassword = document.getElementById('new_password');
const strengthBar = document.getElementById('strength-bar');
const strengthText = document.getElementById('strength-text');
const strengthContainer = document.getElementById('password-strength');

const reqLength = document.getElementById('req-length');
const reqUppercase = document.getElementById('req-uppercase');
const reqLowercase = document.getElementById('req-lowercase');
const reqNumber = document.getElementById('req-number');
const reqSpecial = document.getElementById('req-special');

function checkRequirements(password) {
    const checks = {
        length: password.length >= 8,
        uppercase: /[A-Z]/.test(password),
        lowercase: /[a-z]/.test(password),
        number: /[0-9]/.test(password),
        special: /[@$!%*?&]/.test(password)
    };
    
    const elements = {
        length: reqLength,
        uppercase: reqUppercase,
        lowercase: reqLowercase,
        number: reqNumber,
        special: reqSpecial
    };
    
    Object.keys(checks).forEach(key => {
        const el = elements[key];
        const icon = el.querySelector('.material-symbols-outlined');
        if (checks[key]) {
            el.className = 'flex items-center gap-1.5 text-green-600';
            icon.innerText = 'check_circle';
        } else {
            el.className = 'flex items-center gap-1.5 text-on-surface-variant';
            icon.innerText = 'circle';
        }
    });
    
    return checks;
}

newPassword.addEventListener('input', function() {
    const password = this.value;
    const checks = checkRequirements(password);
    
    if (password.length === 0) {
        strengthContainer.classList.add('hidden');
        return;
    }
    
    strengthContainer.classList.remove('hidden');
    
    let message = '';
    let color = '';
    
    const fulfilled = Object.values(checks).filter(v => v).length;
    
    if (fulfilled <= 2) { message = 'ضعيفة'; color = 'bg-red-500 text-red-500'; }
    else if (fulfilled <= 3) { message = 'متوسطة'; color = 'bg-yellow-500 text-yellow-500'; }
    else if (fulfilled <= 4) { message = 'قوية'; color = 'bg-green-500 text-green-500'; }
    else { message = 'قوية جداً'; color = 'bg-emerald-500 text-emerald-500'; }
    
    const percentage = (fulfilled / 5) * 100;
    strengthBar.className = `h-full transition-all duration-300 rounded-full ${color.split(' ')[0]}`;
    strengthBar.style.width = `${percentage}%`;
    strengthText.textContent = message;
    strengthText.className = `text-xs font-semibold ${color.split(' ')[1]}`;
});

// ============================================
// RESET PASSWORD - Submit with Fetch
// ============================================
document.getElementById('reset-password-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const btn = document.getElementById('reset-btn');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined text-[20px] align-middle ml-1">hourglass_top</span> جاري...';
    btn.disabled = true;
    btn.classList.add('btn-loading');

    const code = document.getElementById('code').value.trim();
    const current_password = document.getElementById('current_password').value;
    const new_password = document.getElementById('new_password').value;
    const confirm_password = document.getElementById('confirm_password').value;

    // Validation
    if (code.length !== 6) {
        showAlert('رمز التحقق يجب أن يكون 6 أرقام', 'error');
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        return;
    }
    
    if (!current_password) {
        showAlert('يرجى إدخال كلمة المرور الحالية', 'error');
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        return;
    }
    
    if (new_password !== confirm_password) {
        showAlert('كلمة المرور الجديدة وتأكيدها غير متطابقين', 'error');
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        return;
    }
    
    if (new_password.length < 8) {
        showAlert('كلمة المرور الجديدة يجب أن تكون 8 أحرف على الأقل', 'error');
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        return;
    }

    try {
        const response = await fetch('/auth/resetpassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                code, 
                current_password, 
                new_password, 
                confirm_password 
            })
        });

        // ✅ التحقق من نوع الـ response
        const contentType = response.headers.get('content-type');

        if (contentType && contentType.includes('application/json')) {
            // لو كان JSON
            const data = await response.json();
            if (response.ok) {
                showAlert('✅ ' + data.message, 'success');
                if (data.redirect) {
                    setTimeout(() => window.location.href = data.redirect, 1500);
                }
            } else {
                showAlert('❌ ' + data.message, 'error');
            }
        } else {
            // ✅ لو كان redirect (HTML)
            if (response.redirected) {
                window.location.href = response.url;
            } else {
                // لو كان HTML عادي
                const text = await response.text();
                document.documentElement.innerHTML = text;
            }
        }
    } catch (error) {
        console.error('Reset Password Error:', error);
        showAlert('❌ حدث خطأ أثناء تغيير كلمة المرور', 'error');
    } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-loading');
    }
});

// ============================================
// Enter key to submit
// ============================================
document.querySelectorAll('input').forEach(input => {
    input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            document.getElementById('reset-password-form').dispatchEvent(new Event('submit'));
        }
    });
});
</script>
</body>
</html>