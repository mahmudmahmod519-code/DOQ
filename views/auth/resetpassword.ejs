<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<script src="/app-client.js"></script>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>دوق | تغيير كلمة المرور</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#9e2016",
                        "primary-container": "#c0392b",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#ffe5e1",
                        "secondary": "#a23f00",
                        "secondary-container": "#fc7127",
                        "on-secondary": "#ffffff",
                        "surface": "#fff8f6",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#fff0ee",
                        "surface-container": "#ffe9e6",
                        "on-surface": "#261816",
                        "on-surface-variant": "#59413d",
                        "outline": "#8d706c",
                        "outline-variant": "#e1bfb9",
                        "error": "#ba1a1a",
                        "success": "#15803d",
                    },
                    fontFamily: {
                        "cairo": ["Cairo", "sans-serif"],
                    },
                    boxShadow: {
                        "soft": "0 10px 40px rgba(38, 24, 22, 0.08)",
                        "glow": "0px 8px 32px rgba(158, 32, 22, 0.2)",
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; background-color: #fff8f6; color: #261816; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        
        @keyframes floatUp { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
        .float-anim { animation: floatUp 6s ease-in-out infinite; }
        
        .input-field { transition: all 0.25s ease; }
        .input-field:focus { box-shadow: 0 0 0 4px rgba(158, 32, 22, 0.08); }
        
        .toast { animation: slideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
        @keyframes slideIn { from { opacity: 0; transform: translateX(100%); } to { opacity: 1; transform: translateX(0); } }
        
        .strength-bar { transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s ease; }
    </style>
</head>
<body class="antialiased overflow-x-hidden">

<main class="min-h-screen flex flex-col lg:flex-row">
    
    <!-- ========================================== -->
    <!-- اللوحة اليسرى: هوية دوق الدافئة -->
    <!-- ========================================== -->
    <section class="hidden lg:flex lg:w-[55%] relative overflow-hidden items-center justify-center p-12">
        <div class="absolute inset-0 bg-gradient-to-br from-primary via-primary-container to-secondary"></div>
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>
        
        <div class="absolute top-20 right-20 w-32 h-32 rounded-full bg-white/10 blur-2xl float-anim"></div>
        <div class="absolute bottom-32 left-16 w-48 h-48 rounded-full bg-secondary-container/20 blur-3xl float-anim" style="animation-delay: 1s;"></div>
        
        <div class="relative z-20 text-center max-w-xl px-6">
            <div class="inline-flex items-center gap-3 mb-8 bg-white/10 backdrop-blur-md px-6 py-3 rounded-full border border-white/20">
                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary text-2xl" style="font-variation-settings: 'FILL' 1;">lock_reset</span>
                </div>
                <span class="text-white font-extrabold text-2xl">أمان حسابك</span>
            </div>
            
            <h1 class="text-5xl font-black text-white mb-6 leading-[1.1]">
                حماية بياناتك<br>
                <span class="text-on-primary-container">أولويتنا القصوى</span>
            </h1>
            
            <div class="w-20 h-1.5 bg-white/40 rounded-full mb-6 mx-auto"></div>
            
            <p class="text-xl text-white/90 mb-10 leading-relaxed font-light">
                نستخدم أحدث معايير التشفير لحماية حسابك. يرجى إدخال رمز التحقق وكلمة المرور الحالية لتعيين كلمة مرور جديدة بأمان تام.
            </p>
            
            <div class="flex items-center justify-center gap-6 text-white/80 text-sm font-medium">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-xl">shield</span>
                    <span>تشفير متقدم</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-xl">verified_user</span>
                    <span>تحقق مزدوج</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- اللوحة اليمنى: نموذج التغيير -->
    <!-- ========================================== -->
    <section class="w-full lg:w-[45%] flex flex-col items-center justify-center p-6 lg:p-12 bg-surface relative min-h-screen">
        
        <!-- شعار للموبايل -->
        <div class="lg:hidden flex items-center gap-2 mb-8">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center shadow-glow">
                <span class="material-symbols-outlined text-white text-2xl" style="font-variation-settings: 'FILL' 1;">local_dining</span>
            </div>
            <span class="text-primary font-extrabold text-2xl">دوق</span>
        </div>
        
        <div class="w-full max-w-md">
            <!-- حاوية التنبيهات (واضحة ومقروءة 100%) -->
            <div id="alert-container" class="fixed top-6 right-6 left-6 lg:left-auto lg:w-[450px] z-50 space-y-2"></div>

            <!-- البطاقة الرئيسية -->
            <div class="bg-surface-container-lowest rounded-3xl shadow-soft p-6 md:p-8 border border-outline-variant/30">
                
                <div class="text-right mb-6">
                    <h2 class="text-2xl font-extrabold text-on-surface mb-2 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-2xl">key</span>
                        تغيير كلمة المرور
                    </h2>
                    <p class="text-sm text-on-surface-variant">اكتب الباسورد الحالي وبعدين الجديد</p>
                </div>

                <!-- معلومات المستخدم -->
                <div class="bg-surface-container-low rounded-xl p-4 mb-6 flex items-center gap-3 border border-outline-variant/30">
                    <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                    <div>
                        <p class="font-bold text-sm text-on-surface"><%= currentUser ? currentUser.first_name + ' ' + currentUser.last_name : 'المستخدم' %></p>
                        <p class="text-xs text-on-surface-variant"><%= currentUser ? currentUser.email : 'email@example.com' %></p>
                    </div>
                </div>

                <form class="space-y-5" id="reset-password-form">
                    
                    <% const needsOtp = Boolean(currentUser && Number(currentUser.two_factor_enabled)); %>
                    <% if (needsOtp) { %>
                    <!-- رمز التحقق -->
                    <div>
                        <label class="block text-xs font-bold text-on-surface mb-2 mr-1 flex items-center gap-1">
                            <span class="material-symbols-outlined text-base text-primary" style="font-variation-settings: 'FILL' 1;">pin</span>
                            رمز التحقق
                        </label>
                        <div class="relative">
                            <input type="text" name="otp" id="otp" dir="ltr" autocomplete="one-time-code"
                                class="input-field w-full px-4 py-3.5 rounded-xl border border-outline-variant bg-surface-container-low text-xl font-bold font-mono focus:outline-none focus:border-primary text-center tracking-[0.5em] text-primary"
                                placeholder="0 0 0 0 0 0" maxlength="6" required>
                        </div>
                        <p class="text-[11px] text-on-surface-variant mt-1.5 mr-1">اكتب الكود اللي ظاهر في تطبيق المصادقة</p>
                    </div>
                    <% } %>

                    <!-- كلمة المرور الحالية -->
                    <div>
                        <label class="block text-xs font-bold text-on-surface mb-2 mr-1">كلمة المرور الحالية</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline text-xl">lock</span>
                            <input type="password" name="current_password" id="current_password"
                                class="input-field w-full pr-12 pl-12 py-3.5 rounded-xl border border-outline-variant bg-surface-container-low text-sm font-medium focus:outline-none focus:border-primary text-right"
                                placeholder="أدخل كلمة المرور الحالية" required>
                            <button type="button" class="absolute left-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" onclick="togglePassword('current_password', this)">
                                <span class="material-symbols-outlined text-xl">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- كلمة المرور الجديدة -->
                    <div>
                        <label class="block text-xs font-bold text-on-surface mb-2 mr-1">كلمة المرور الجديدة</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline text-xl">key</span>
                            <input type="password" name="new_password" id="new_password"
                                class="input-field w-full pr-12 pl-12 py-3.5 rounded-xl border border-outline-variant bg-surface-container-low text-sm font-medium focus:outline-none focus:border-primary text-right"
                                placeholder="8 أحرف على الأقل" minlength="8" required>
                            <button type="button" class="absolute left-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" onclick="togglePassword('new_password', this)">
                                <span class="material-symbols-outlined text-xl">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- تأكيد كلمة المرور -->
                    <div>
                        <label class="block text-xs font-bold text-on-surface mb-2 mr-1">تأكيد كلمة المرور الجديدة</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline text-xl">check_circle</span>
                            <input type="password" name="confirm_password" id="confirm_password"
                                class="input-field w-full pr-12 pl-12 py-3.5 rounded-xl border border-outline-variant bg-surface-container-low text-sm font-medium focus:outline-none focus:border-primary text-right"
                                placeholder="أعد كتابة كلمة المرور" required>
                            <button type="button" class="absolute left-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" onclick="togglePassword('confirm_password', this)">
                                <span class="material-symbols-outlined text-xl">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- مؤشر قوة كلمة المرور -->
                    <div id="password-strength" class="hidden pt-2">
                        <div class="flex items-center gap-3 mb-2">
                            <span class="text-xs font-bold text-on-surface-variant">قوة كلمة المرور:</span>
                            <div class="flex-1 h-2 bg-surface-container rounded-full overflow-hidden">
                                <div id="strength-bar" class="strength-bar h-full w-0 rounded-full"></div>
                            </div>
                            <span id="strength-text" class="text-xs font-bold"></span>
                        </div>
                        
                        <!-- متطلبات كلمة المرور -->
                        <div class="bg-surface-container-low/50 rounded-xl p-3 border border-outline-variant/30">
                            <p class="text-[11px] font-bold text-on-surface-variant mb-2">متطلبات الأمان:</p>
                            <div class="grid grid-cols-1 gap-1.5 text-[11px]">
                                <div id="req-length" class="flex items-center gap-2 text-on-surface-variant transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">circle</span>
                                    <span>8 أحرف على الأقل</span>
                                </div>
                                <div id="req-uppercase" class="flex items-center gap-2 text-on-surface-variant transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">circle</span>
                                    <span>حرف كبير واحد على الأقل (A-Z)</span>
                                </div>
                                <div id="req-lowercase" class="flex items-center gap-2 text-on-surface-variant transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">circle</span>
                                    <span>حرف صغير واحد على الأقل (a-z)</span>
                                </div>
                                <div id="req-number" class="flex items-center gap-2 text-on-surface-variant transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">circle</span>
                                    <span>رقم واحد على الأقل (0-9)</span>
                                </div>
                                <div id="req-special" class="flex items-center gap-2 text-on-surface-variant transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">circle</span>
                                    <span>رمز خاص واحد على الأقل (@$!%*?&)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- زر الحفظ -->
                    <button type="submit" id="reset-btn"
                        class="btn-primary-glow w-full py-3.5 bg-gradient-to-l from-primary to-primary-container text-white rounded-xl font-extrabold text-base shadow-glow hover:shadow-lg transition-all active:scale-[0.98] flex items-center justify-center gap-2 mt-4">
                        <span class="material-symbols-outlined">save</span>
                        تحديث كلمة المرور
                    </button>

                    <!-- العودة -->
                    <div class="text-center pt-4 border-t border-outline-variant/30 mt-2">
                        <a href="/users/settings" class="text-primary font-bold hover:text-primary-container transition-colors text-sm flex items-center justify-center gap-1">
                            <span class="material-symbols-outlined text-lg">arrow_forward</span>
                            العودة إلى ملفي الشخصي
                        </a>
                    </div>
                </form>
            </div>

            <footer class="mt-8 text-center">
                <p class="text-xs text-on-surface-variant">© 2026 <span class="font-bold text-primary">دوق</span> — فن التذوق يبدأ من هنا</p>
            </footer>
        </div>
    </section>
</main>

<script>
// ============================================
// إظهار/إخفاء كلمة المرور
// ============================================
function togglePassword(id, btn) {
    const input = document.getElementById(id);
    const icon = btn.querySelector('.material-symbols-outlined');
    if (input.type === 'password') {
        input.type = 'text';
        icon.innerText = 'visibility_off';
    } else {
        input.type = 'password';
        icon.innerText = 'visibility';
    }
}

// ============================================
// تنسيق حقل الرمز (6 أرقام فقط)
// ============================================
document.getElementById('otp')?.addEventListener('input', function() {
    this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
});

// ============================================
// نظام التنبيهات المحسّن (واضح، مقروء، وأنيق)
// ============================================
function showAlert(message, type) {
    const container = document.getElementById('alert-container');
    const theme = type === 'success' 
        ? 'bg-surface-container-lowest border-r-4 border-success text-on-surface' 
        : 'bg-surface-container-lowest border-r-4 border-error text-on-surface';
    const iconColor = type === 'success' ? 'text-success' : 'text-error';
    const icon = type === 'success' ? 'check_circle' : 'error';
    
    const toast = document.createElement('div');
    toast.className = `toast flex items-center gap-3 p-4 rounded-xl border border-outline-variant/30 ${theme} shadow-soft`;
    toast.innerHTML = `
        <span class="material-symbols-outlined text-2xl ${iconColor}" style="font-variation-settings: 'FILL' 1;">${icon}</span>
        <p class="font-bold text-sm flex-1 leading-snug">${message}</p>
        <button onclick="this.parentElement.remove()" class="text-on-surface-variant hover:text-error transition-colors p-1 rounded-full hover:bg-surface-container">
            <span class="material-symbols-outlined text-lg">close</span>
        </button>
    `;
    container.appendChild(toast);
    
    setTimeout(() => {
        toast.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(100%)';
        setTimeout(() => { if (toast.parentElement) toast.remove(); }, 400);
    }, 5000);
}

// ============================================
// مؤشر قوة كلمة المرور والمتطلبات
// ============================================
const newPassword = document.getElementById('new_password');
const strengthContainer = document.getElementById('password-strength');
const strengthBar = document.getElementById('strength-bar');
const strengthText = document.getElementById('strength-text');

const reqLength = document.getElementById('req-length');
const reqUppercase = document.getElementById('req-uppercase');
const reqLowercase = document.getElementById('req-lowercase');
const reqNumber = document.getElementById('req-number');
const reqSpecial = document.getElementById('req-special');

function checkRequirements(password) {
    const checks = {
        length: password.length >= 8,
        uppercase: /[A-Z]/.test(password),
        lowercase: /[a-z]/.test(password),
        number: /[0-9]/.test(password),
        special: /[@$!%*?&]/.test(password)
    };
    
    const elements = {
        length: reqLength,
        uppercase: reqUppercase,
        lowercase: reqLowercase,
        number: reqNumber,
        special: reqSpecial
    };
    
    let fulfilledCount = 0;
    Object.keys(checks).forEach(key => {
        const el = elements[key];
        const icon = el.querySelector('.material-symbols-outlined');
        if (checks[key]) {
            fulfilledCount++;
            el.className = 'flex items-center gap-2 text-success transition-colors';
            icon.innerText = 'check_circle';
            icon.style.fontVariationSettings = "'FILL' 1";
        } else {
            el.className = 'flex items-center gap-2 text-on-surface-variant transition-colors';
            icon.innerText = 'circle';
            icon.style.fontVariationSettings = "'FILL' 0";
        }
    });
    
    return { checks, fulfilledCount };
}

newPassword.addEventListener('input', function() {
    const password = this.value;
    
    if (password.length === 0) {
        strengthContainer.classList.add('hidden');
        return;
    }
    
    strengthContainer.classList.remove('hidden');
    const { checks, fulfilledCount } = checkRequirements(password);
    
    let message = '';
    let colorClass = '';
    let textColorClass = '';
    
    if (fulfilledCount <= 2) { 
        message = 'ضعيفة'; 
        colorClass = 'bg-error'; 
        textColorClass = 'text-error'; 
    } else if (fulfilledCount === 3) { 
        message = 'متوسطة'; 
        colorClass = 'bg-orange-500'; 
        textColorClass = 'text-orange-600'; 
    } else if (fulfilledCount === 4) { 
        message = 'قوية'; 
        colorClass = 'bg-yellow-500'; 
        textColorClass = 'text-yellow-600'; 
    } else { 
        message = 'قوية جداً'; 
        colorClass = 'bg-success'; 
        textColorClass = 'text-success'; 
    }
    
    const percentage = (fulfilledCount / 5) * 100;
    strengthBar.className = `strength-bar h-full rounded-full ${colorClass}`;
    strengthBar.style.width = `${percentage}%`;
    strengthText.textContent = message;
    strengthText.className = `text-xs font-bold ${textColorClass}`;
});

// ============================================
// تقديم النموذج
// ============================================
document.getElementById('reset-password-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const btn = document.getElementById('reset-btn');
    const originalHTML = btn.innerHTML;
    
    const otpInput = document.getElementById('otp');
    const otp = otpInput ? otpInput.value.trim() : '';
    const current_password = document.getElementById('current_password').value;
    const new_password = document.getElementById('new_password').value;
    const confirm_password = document.getElementById('confirm_password').value;

    if (otpInput && otp.length !== 6) { showAlert('رمز التحقق يجب أن يكون 6 أرقام', 'error'); return; }
    if (!current_password) { showAlert('يرجى إدخال كلمة المرور الحالية', 'error'); return; }
    if (new_password !== confirm_password) { showAlert('كلمة المرور الجديدة وتأكيدها غير متطابقين', 'error'); return; }
    if (new_password.length < 8) { showAlert('كلمة المرور الجديدة يجب أن تكون 8 أحرف على الأقل', 'error'); return; }

    btn.innerHTML = '<div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div> جاري التحديث...';
    btn.disabled = true;

    try {
        const response = await fetch('/auth/resetpassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ otp, current_password, new_password, confirm_password })
        });

        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
            const data = await response.json();
            if (response.ok) {
                showAlert('✅ ' + data.message, 'success');
                if (data.redirect) setTimeout(() => window.location.href = data.redirect, 1500);
            } else {
                showAlert('❌ ' + data.message, 'error');
            }
        } else {
            if (response.redirected) window.location.href = response.url;
            else document.documentElement.innerHTML = await response.text();
        }
    } catch (error) {
        console.error('Reset Password Error:', error);
        showAlert('❌ حدث خطأ أثناء تغيير كلمة المرور', 'error');
    } finally {
        btn.innerHTML = originalHTML;
        btn.disabled = false;
    }
});

// دعم مفتاح Enter للإرسال
document.querySelectorAll('input').forEach(input => {
    input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('reset-password-form').dispatchEvent(new Event('submit'));
        }
    });
});
</script>
</body>
</html>