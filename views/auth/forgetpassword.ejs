<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<script src="/app-client.js"></script>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>دوق | استعادة كلمة المرور</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#9e2016",
                        "primary-container": "#c0392b",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#ffe5e1",
                        "secondary": "#a23f00",
                        "secondary-container": "#fc7127",
                        "on-secondary": "#ffffff",
                        "surface": "#fff8f6",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#fff0ee",
                        "surface-container": "#ffe9e6",
                        "on-surface": "#261816",
                        "on-surface-variant": "#59413d",
                        "outline": "#8d706c",
                        "outline-variant": "#e1bfb9",
                        "error": "#ba1a1a",
                        "success": "#15803d",
                    },
                    fontFamily: {
                        "cairo": ["Cairo", "sans-serif"],
                    },
                    boxShadow: {
                        "soft": "0 10px 40px rgba(38, 24, 22, 0.08)",
                        "glow": "0px 8px 32px rgba(158, 32, 22, 0.2)",
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; background-color: #fff8f6; color: #261816; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        
        @keyframes floatUp { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
        .float-anim { animation: floatUp 6s ease-in-out infinite; }
        
        .input-field { transition: all 0.25s ease; }
        .input-field:focus { box-shadow: 0 0 0 4px rgba(158, 32, 22, 0.08); }
        
        .toast { animation: slideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
        @keyframes slideIn { from { opacity: 0; transform: translateX(100%); } to { opacity: 1; transform: translateX(0); } }
        
        .strength-bar { transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s ease; }
    </style>
</head>
<body class="antialiased overflow-x-hidden">

<main class="min-h-screen flex flex-col lg:flex-row">
    
    <!-- اللوحة اليسرى: هوية دوق الدافئة -->
    <section class="hidden lg:flex lg:w-[55%] relative overflow-hidden items-center justify-center p-12">
        <div class="absolute inset-0 bg-gradient-to-br from-primary via-primary-container to-secondary"></div>
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>
        
        <div class="absolute top-20 right-20 w-32 h-32 rounded-full bg-white/10 blur-2xl float-anim"></div>
        <div class="absolute bottom-32 left-16 w-48 h-48 rounded-full bg-secondary-container/20 blur-3xl float-anim" style="animation-delay: 1s;"></div>
        
        <div class="relative z-20 text-center max-w-xl px-6">
            <div class="inline-flex items-center gap-3 mb-8 bg-white/10 backdrop-blur-md px-6 py-3 rounded-full border border-white/20">
                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary text-2xl" style="font-variation-settings: 'FILL' 1;">shield</span>
                </div>
                <span class="text-white font-extrabold text-2xl">حساب آمن</span>
            </div>
            
            <h1 class="text-5xl font-black text-white mb-6 leading-[1.1]">
                استعادة الحساب<br>
                <span class="text-on-primary-container">بأمان وسرية تامة</span>
            </h1>
            
            <div class="w-20 h-1.5 bg-white/40 rounded-full mb-6 mx-auto"></div>
            
            <p class="text-xl text-white/90 mb-10 leading-relaxed font-light">
                لضمان أمان حسابك، نستخدم المصادقة الثنائية. يرجى إدخال بريدك الإلكتروني والرمز المكون من 6 أرقام الظاهر في تطبيق المصادقة (Authenticator) الخاص بك.
            </p>
            
            <div class="flex items-center justify-center gap-6 text-white/80 text-sm font-medium">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-xl">smartphone</span>
                    <span>تطبيق المصادقة</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-xl">lock_clock</span>
                    <span>رمز متجدد</span>
                </div>
            </div>
        </div>
    </section>

    <!-- اللوحة اليمنى: نموذج الاستعادة -->
    <section class="w-full lg:w-[45%] flex flex-col items-center justify-center p-6 lg:p-12 bg-surface relative min-h-screen">
        
        <div class="lg:hidden flex items-center gap-2 mb-8">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center shadow-glow">
                <span class="material-symbols-outlined text-white text-2xl" style="font-variation-settings: 'FILL' 1;">local_dining</span>
            </div>
            <span class="text-primary font-extrabold text-2xl">دوق</span>
        </div>
        
        <div class="w-full max-w-md">
            <div id="alert-container" class="fixed top-6 right-6 left-6 lg:left-auto lg:w-[450px] z-50 space-y-2"></div>

            <div class="bg-surface-container-lowest rounded-3xl shadow-soft p-6 md:p-8 border border-outline-variant/30">
                
                <div class="text-right mb-8">
                    <h2 class="text-2xl font-extrabold text-on-surface mb-2">نسيت الباسورد؟</h2>
                    <p class="text-sm text-on-surface-variant">اكتب إيميلك وهنبعتلك لينك تغير بيه الباسورد</p>
                </div>

                <form class="space-y-5" id="forget-password-form">
                    
                    <!-- البريد الإلكتروني وزر التحقق -->
                    <div>
                        <label class="block text-xs font-bold text-on-surface mb-2 mr-1">البريد الإلكتروني</label>
                        <div class="flex gap-2">
                            <div class="relative flex-grow">
                                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline text-xl">mail</span>
                                <input type="email" name="email" id="email" dir="ltr"
                                    class="input-field w-full pr-12 pl-4 py-3.5 rounded-xl border border-outline-variant bg-surface-container-low text-sm font-medium focus:outline-none focus:border-primary text-right"
                                    placeholder="example@dhouq.com" required>
                            </div>
                            <!-- <button type="button" id="verify-email-btn"
                                class="btn-primary-glow whitespace-nowrap px-4 py-3.5 bg-primary text-white rounded-xl font-bold text-sm shadow-glow hover:shadow-lg transition-all active:scale-95 flex items-center gap-1">
                                <span class="material-symbols-outlined text-lg">verified</span>
                                <span>تحقق</span>
                            </button> -->
                        </div>
                        <div id="verify-timer" class="text-xs text-secondary font-bold mt-2 mr-1 hidden flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">hourglass_top</span>
                            <span></span>
                        </div>
                    </div>

                    <!-- زر الحفظ -->
                    <button type="submit" id="forget-btn"
                        class="btn-primary-glow w-full py-3.5 bg-gradient-to-l from-primary to-primary-container text-white rounded-xl font-extrabold text-base shadow-glow hover:shadow-lg transition-all active:scale-[0.98] flex items-center justify-center gap-2 mt-6">
                        <span class="material-symbols-outlined">send</span>
                        ابعت اللينك
                    </button>

                    <!-- العودة -->
                    <div class="text-center pt-4 border-t border-outline-variant/30 mt-6">
                        <a href="/auth" class="text-primary font-bold hover:text-primary-container transition-colors text-sm flex items-center justify-center gap-1">
                            <span class="material-symbols-outlined text-lg">arrow_forward</span>
                            العودة إلى تسجيل الدخول
                        </a>
                    </div>
                </form>
            </div>

            <footer class="mt-8 text-center">
                <p class="text-xs text-on-surface-variant">© 2026 <span class="font-bold text-primary">دوق</span> — فن التذوق يبدأ من هنا</p>
            </footer>
        </div>
    </section>
</main>

<script>
// ============================================
// إظهار/إخفاء كلمة المرور
// ============================================
function togglePassword(id, btn) {
    const input = document.getElementById(id);
    const icon = btn.querySelector('.material-symbols-outlined');
    if (input.type === 'password') {
        input.type = 'text';
        icon.innerText = 'visibility_off';
    } else {
        input.type = 'password';
        icon.innerText = 'visibility';
    }
}

// ============================================
// ============================================
// نظام التنبيهات المحسّن
// ============================================
function showAlert(message, type) {
    const container = document.getElementById('alert-container');
    const theme = type === 'success' 
        ? 'bg-surface-container-lowest border-r-4 border-success text-on-surface' 
        : 'bg-surface-container-lowest border-r-4 border-error text-on-surface';
    const iconColor = type === 'success' ? 'text-success' : 'text-error';
    const icon = type === 'success' ? 'check_circle' : 'error';
    
    const toast = document.createElement('div');
    toast.className = `toast flex items-center gap-3 p-4 rounded-xl border border-outline-variant/30 ${theme} shadow-soft`;
    toast.innerHTML = `
        <span class="material-symbols-outlined text-2xl ${iconColor}" style="font-variation-settings: 'FILL' 1;">${icon}</span>
        <p class="font-bold text-sm flex-1 leading-snug">${message}</p>
        <button onclick="this.parentElement.remove()" class="text-on-surface-variant hover:text-error transition-colors p-1 rounded-full hover:bg-surface-container">
            <span class="material-symbols-outlined text-lg">close</span>
        </button>
    `;
    container.appendChild(toast);
    
    setTimeout(() => {
        toast.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(100%)';
        setTimeout(() => { if (toast.parentElement) toast.remove(); }, 400);
    }, 5000);
}

// ============================================
// تقديم نموذج تغيير كلمة المرور
// ============================================
document.getElementById('forget-password-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('forget-btn');
    const originalHTML = btn.innerHTML;
    
    const email = document.getElementById('email').value.trim();
    if (!email.includes('@')) { showAlert('اكتب إيميل صحيح', 'error'); return; }

    btn.innerHTML = '<div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div> بنبعت اللينك...';
    btn.disabled = true;

    try {
        const response = await fetch('/auth/forgetpassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
        });

        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
            const data = await response.json();
            if (response.ok) {
                showAlert(data.message, 'success');
                if (data.redirect) setTimeout(() => window.location.href = data.redirect, 1500);
            } else {
                showAlert(data.message, 'error');
            }
        } else {
            if (response.redirected) window.location.href = response.url;
            else document.documentElement.innerHTML = await response.text();
        }
    } catch (error) {
        console.error('Forget Password Error:', error);
        showAlert('❌ مقدرناش نوصل للسيرفر. اتأكد من النت وجرب تاني', 'error');
    } finally {
        btn.innerHTML = originalHTML;
        btn.disabled = false;
    }
});
</script>
</body>
</html>