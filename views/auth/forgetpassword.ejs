<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Dhouq | استعادة كلمة المرور</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#9e2016",
                        "primary-container": "#c0392b",
                        "on-primary-container": "#ffe5e1",
                        "secondary": "#a23f00",
                        "on-surface": "#261816",
                        "on-surface-variant": "#59413d",
                        "surface-container-low": "#fff0ee",
                        "surface-container-lowest": "#ffffff",
                        "outline-variant": "#e1bfb9"
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap');
        body { font-family: 'Tajawal', sans-serif; background-color: #fff8f6; }
        .hidden-form { display: none; opacity: 0; transform: translateY(10px); }
        .visible-form { display: block; opacity: 1; transform: translateY(0); transition: opacity 0.4s ease, transform 0.4s ease; }
        .animate-fadeIn {
            animation: fadeIn 0.3s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        .animate-pulse-slow {
            animation: pulse 2s ease-in-out infinite;
        }
        input[type="text"]:focus, input[type="email"]:focus, input[type="password"]:focus, input[type="tel"]:focus {
            outline: none;
        }
        .alert {
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 16px;
            font-weight: 600;
            text-align: right;
            animation: fadeIn 0.3s ease-out;
        }
        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }
        .alert-error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }
        .btn-loading {
            opacity: 0.7;
            pointer-events: none;
            cursor: not-allowed;
        }
    </style>
</head>
<body class="antialiased overflow-x-hidden">
<main class="min-h-screen flex flex-col md:flex-row">
    
    <!-- Left Panel - Visual Marketing (hidden on mobile) -->
    <section class="hidden md:flex md:w-1/2 relative bg-[#2C3E50] overflow-hidden items-center justify-center p-12">
        <div class="absolute inset-0 z-0 bg-cover bg-center opacity-40 mix-blend-overlay" style="background-image: url('https://images.unsplash.com/photo-1547928576-a4a33237eceb?auto=format&fit=crop&w=1000&q=80');"></div>
        <div class="absolute inset-0 z-10 bg-gradient-to-br from-[#2C3E50] via-[#2C3E50]/80 to-secondary/30"></div>
        <div class="relative z-20 text-center flex flex-col items-center max-w-lg">
            <!-- Logo -->
            <div class="mb-6">
                <span class="text-5xl">🔐</span>
                <h2 class="text-2xl font-bold text-white mt-2">دوق</h2>
            </div>
            <h1 class="text-3xl font-bold text-white mb-4 leading-tight">استعادة كلمة المرور</h1>
            <div class="w-24 h-1 bg-secondary rounded-full mb-6"></div>
            <p class="text-lg text-white/80">لا تقلق، سنساعدك على استعادة حسابك بكل سهولة وأمان</p>
            <div class="mt-8 flex gap-4 text-white/60 text-sm">
                <span>🔒 آمن ١٠٠٪</span>
                <span>•</span>
                <span>📧 إرسال رمز تحقق</span>
            </div>
        </div>
    </section>

    <!-- Right Panel - Form -->
    <section class="w-full md:w-1/2 flex flex-col items-center justify-center p-6 md:p-12 bg-surface relative">
        <div class="w-full max-w-md">

            <!-- Alert Container -->
            <div id="alert-container"></div>

            <div class="bg-white rounded-2xl shadow-xl p-6 border border-slate-100 overflow-hidden">
                
                <!-- Header -->
                <div class="text-right mb-6">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="text-3xl">🔑</span>
                        <div>
                            <h2 class="text-xl font-bold text-on-surface">نسيت كلمة المرور؟</h2>
                            <p class="text-sm text-on-surface-variant">أدخل بريدك الإلكتروني وسنرسل لك رمز تحقق</p>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <form class="space-y-5" id="forget-password-form">

                    <!-- Email Field -->
                    <div class="relative group">
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant">mail</span>
                        <input 
                            type="email" 
                            name="email" 
                            id="email"
                            class="w-full pr-10 pl-3 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-right"
                            placeholder="example@doq.com"
                            required
                            dir="ltr"
                        >
                        <div class="text-[10px] text-on-surface-variant mt-1 pr-1">سيتم إرسال رمز التحقق إلى هذا البريد</div>
                    </div>

                    <!-- Code Field with Send Button -->
                    <div>
                        <label class="block text-xs font-semibold text-on-surface mb-1.5 pr-1">
                            <span class="material-symbols-outlined text-[16px] align-middle ml-1">shield</span>
                            رمز التحقق
                        </label>
                        <div class="relative group">
                            <input 
                                type="text" 
                                name="code" 
                                id="code"
                                class="w-full px-4 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-center tracking-[8px] text-2xl font-bold"
                                placeholder="• • • • • •"
                                maxlength="6"
                                required
                                dir="ltr"
                                autocomplete="one-time-code"
                            >
                            <button 
                                type="button" 
                                id="send-code-btn"
                                class="absolute left-2 top-1/2 -translate-y-1/2 text-sm bg-primary-container text-on-primary-container px-4 py-1.5 rounded-lg hover:opacity-90 transition font-semibold shadow-sm"
                            >
                                إرسال
                            </button>
                        </div>
                        <div id="code-timer" class="text-xs text-secondary font-semibold mt-1 hidden text-center"></div>
                        <div class="text-[10px] text-on-surface-variant mt-1 pr-1">أدخل الرمز المكون من 6 أرقام المرسل إلى بريدك</div>
                    </div>

                    <!-- New Password -->
                    <div>
                        <label class="block text-xs font-semibold text-on-surface mb-1.5 pr-1">
                            <span class="material-symbols-outlined text-[16px] align-middle ml-1">lock</span>
                            كلمة المرور الجديدة
                        </label>
                        <div class="relative group">
                            <input 
                                type="password" 
                                name="new_password" 
                                id="new_password"
                                class="w-full pr-10 pl-10 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-right"
                                placeholder="••••••••"
                                required
                                minlength="8"
                            >
                            <button 
                                type="button" 
                                class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition"
                                onclick="togglePassword(this)"
                            >
                                <span class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                        </div>
                        <div class="text-[10px] text-on-surface-variant mt-1 pr-1">يجب أن تحتوي على 8 أحرف على الأقل، حرف كبير، حرف صغير، رقم، ورمز خاص</div>
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label class="block text-xs font-semibold text-on-surface mb-1.5 pr-1">
                            <span class="material-symbols-outlined text-[16px] align-middle ml-1">check_circle</span>
                            تأكيد كلمة المرور
                        </label>
                        <div class="relative group">
                            <input 
                                type="password" 
                                name="confirm_password" 
                                id="confirm_password"
                                class="w-full pr-10 pl-10 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-right"
                                placeholder="••••••••"
                                required
                            >
                            <button 
                                type="button" 
                                class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition"
                                onclick="togglePassword(this)"
                            >
                                <span class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- Password Strength Indicator -->
                    <div id="password-strength" class="hidden">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-semibold text-on-surface">قوة كلمة المرور:</span>
                            <div class="flex-1 h-1.5 bg-gray-200 rounded-full overflow-hidden">
                                <div id="strength-bar" class="h-full w-0 transition-all duration-300 rounded-full"></div>
                            </div>
                            <span id="strength-text" class="text-xs font-semibold"></span>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button 
                        type="submit" 
                        id="forget-btn"
                        class="w-full py-3 bg-primary-container text-on-primary-container rounded-xl font-bold hover:opacity-90 transition-all shadow-md mt-2 text-base"
                    >
                        <span class="material-symbols-outlined text-[20px] align-middle ml-1">sync</span>
                        تغيير كلمة المرور
                    </button>

                    <!-- Back to Login -->
                    <div class="text-center pt-2">
                        <a href="/auth" class="text-primary hover:underline text-sm flex items-center justify-center gap-1">
                            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                            العودة إلى تسجيل الدخول
                        </a>
                    </div>
                </form>
            </div>

            <footer class="mt-6 text-center space-y-2">
                <p class="text-xs text-on-surface-variant">© 2026 دوق. جميع الحقوق محفوظة</p>
            </footer>
        </div>
    </section>
</main>

<script>
// ============================================
// Toggle Password Visibility
// ============================================
function togglePassword(btn) {
    const input = btn.parentElement.querySelector('input');
    const icon = btn.querySelector('.material-symbols-outlined');
    if (input.type === 'password') {
        input.type = 'text';
        icon.innerText = 'visibility_off';
    } else {
        input.type = 'password';
        icon.innerText = 'visibility';
    }
}

// ============================================
// Auto-format Code Input (6 digits)
// ============================================
document.getElementById('code').addEventListener('input', function() {
    this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
});

// ============================================
// Show Alert Function
// ============================================
function showAlert(message, type) {
    const container = document.getElementById('alert-container');
    const cls = type === 'success' ? 'alert-success' : 'alert-error';
    container.innerHTML = `<div class="alert ${cls}">${message}</div>`;
    setTimeout(() => {
        const alert = container.querySelector('.alert');
        if (alert) {
            alert.style.opacity = '0';
            alert.style.transition = 'opacity 0.5s';
            setTimeout(() => {
                if (alert.parentNode) alert.remove();
            }, 500);
        }
    }, 5000);
}

// ============================================
// Password Strength Indicator
// ============================================
document.getElementById('new_password').addEventListener('input', function() {
    const password = this.value;
    const strengthBar = document.getElementById('strength-bar');
    const strengthText = document.getElementById('strength-text');
    const strengthContainer = document.getElementById('password-strength');
    
    if (password.length === 0) {
        strengthContainer.classList.add('hidden');
        return;
    }
    
    strengthContainer.classList.remove('hidden');
    
    let score = 0;
    let message = '';
    let color = '';
    
    if (password.length >= 8) score++;
    if (/[a-z]/.test(password)) score++;
    if (/[A-Z]/.test(password)) score++;
    if (/[0-9]/.test(password)) score++;
    if (/[@$!%*?&]/.test(password)) score++;
    
    if (score <= 2) { message = 'ضعيفة'; color = 'bg-red-500'; }
    else if (score <= 3) { message = 'متوسطة'; color = 'bg-yellow-500'; }
    else if (score <= 4) { message = 'قوية'; color = 'bg-green-500'; }
    else { message = 'قوية جداً'; color = 'bg-emerald-500'; }
    
    const percentage = Math.min((score / 5) * 100, 100);
    strengthBar.className = `h-full transition-all duration-300 rounded-full ${color}`;
    strengthBar.style.width = `${percentage}%`;
    strengthText.textContent = message;
    strengthText.className = `text-xs font-semibold ${color.replace('bg-', 'text-')}`;
});

// ============================================
// Send Code Button (AJAX)
// ============================================
document.getElementById('send-code-btn').addEventListener('click', async function() {
    const email = document.getElementById('email').value;
    const btn = this;
    const timerDiv = document.getElementById('code-timer');
    
    if (!email) {
        showAlert('يرجى إدخال البريد الإلكتروني أولاً', 'error');
        return;
    }
    
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showAlert('البريد الإلكتروني غير صحيح', 'error');
        return;
    }
    
    btn.disabled = true;
    btn.textContent = 'جاري الإرسال...';
    btn.classList.add('opacity-50');
    
    try {
        const response = await fetch('/auth/send-reset-code', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ email })
        });
        
        const data = await response.json();
        
        if (data.status === 'success') {
            showAlert('✅ ' + data.message, 'success');
            
            let seconds = 60;
            timerDiv.classList.remove('hidden');
            timerDiv.textContent = `⏱ يمكنك طلب رمز جديد بعد ${seconds} ثانية`;
            
            const interval = setInterval(() => {
                seconds--;
                if (seconds <= 0) {
                    clearInterval(interval);
                    timerDiv.classList.add('hidden');
                    btn.disabled = false;
                    btn.textContent = 'إرسال';
                    btn.classList.remove('opacity-50');
                } else {
                    timerDiv.textContent = `⏱ يمكنك طلب رمز جديد بعد ${seconds} ثانية`;
                }
            }, 1000);
            
            if (data.data && data.data.reset_code) {
                document.getElementById('code').value = data.data.reset_code;
                showAlert('✅ تم تعبئة الرمز تلقائياً (بيئة التطوير)', 'success');
            }
        } else {
            showAlert('❌ ' + (data.message || 'حدث خطأ أثناء إرسال الرمز'), 'error');
            btn.disabled = false;
            btn.textContent = 'إرسال';
            btn.classList.remove('opacity-50');
        }
    } catch (error) {
        console.error('Send Code Error:', error);
        showAlert('❌ حدث خطأ أثناء الاتصال بالخادم', 'error');
        btn.disabled = false;
        btn.textContent = 'إرسال';
        btn.classList.remove('opacity-50');
    }
});

// ============================================
// FORGET PASSWORD - Submit with Fetch
// ============================================
document.getElementById('forget-password-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const btn = document.getElementById('forget-btn');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined text-[20px] align-middle ml-1">hourglass_top</span> جاري...';
    btn.disabled = true;
    btn.classList.add('btn-loading');

    const email = document.getElementById('email').value.trim();
    const code = document.getElementById('code').value.trim();
    const new_password = document.getElementById('new_password').value;
    const confirm_password = document.getElementById('confirm_password').value;

    // Validation
    if (!email) {
        showAlert('يرجى إدخال البريد الإلكتروني', 'error');
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        return;
    }
    
    if (code.length !== 6) {
        showAlert('رمز التحقق يجب أن يكون 6 أرقام', 'error');
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        return;
    }
    
    if (new_password !== confirm_password) {
        showAlert('كلمة المرور وتأكيدها غير متطابقين', 'error');
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        return;
    }
    
    if (new_password.length < 8) {
        showAlert('كلمة المرور الجديدة يجب أن تكون 8 أحرف على الأقل', 'error');
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-loading');
        return;
    }

    try {
        const response = await fetch('/auth/forgetpassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                email, 
                code, 
                new_password, 
                confirm_password 
            })
        });

        // ✅ التحقق من نوع الـ response
        const contentType = response.headers.get('content-type');

        if (contentType && contentType.includes('application/json')) {
            // لو كان JSON
            const data = await response.json();
            if (response.ok) {
                showAlert('✅ ' + data.message, 'success');
                if (data.redirect) {
                    setTimeout(() => window.location.href = data.redirect, 1500);
                }
            } else {
                showAlert('❌ ' + data.message, 'error');
            }
        } else {
            // ✅ لو كان redirect (HTML)
            if (response.redirected) {
                window.location.href = response.url;
            } else {
                // لو كان HTML عادي
                const text = await response.text();
                document.documentElement.innerHTML = text;
            }
        }
    } catch (error) {
        console.error('Forget Password Error:', error);
        showAlert('❌ حدث خطأ أثناء تغيير كلمة المرور', 'error');
    } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('btn-loading');
    }
});
</script>
</body>
</html>