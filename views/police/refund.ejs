<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<script src="/app-client.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سياسة الإلغاء والاسترداد - دوق | DOQ</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            bg: '#f9f9f9',
                            text: '#333333',
                            headings: '#4D0F0F',
                            accent: '#F26B1D',
                            accentHover: '#d95a12',
                            burgundyLight: '#5e1313',
                            cardBorder: '#eeeeee',
                        }
                    },
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                        tajawal: ['Tajawal', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #f9f9f9; color: #333333; font-family: 'Tajawal', sans-serif; -webkit-font-smoothing: antialiased; }
        h1, h2, h3, .heading-font { font-family: 'Cairo', sans-serif; color: #4D0F0F; }
        .custom-bullet { position: relative; padding-right: 1.75rem; }
        .custom-bullet::before { content: ''; position: absolute; right: 0; top: 0.65rem; width: 8px; height: 8px; border-radius: 50%; background-color: #F26B1D; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #d8c3be; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #b89b94; }
    </style>
</head>
<body class="min-h-screen py-8 md:py-16 px-4 sm:px-6 flex flex-col justify-between items-center selection:bg-[#F26B1D] selection:text-white">

    <!-- Minimal Top Brand Bar -->
    <header class="w-full max-w-[800px] flex items-center justify-between mb-8 px-2">
        <a href="/" class="inline-flex items-center gap-2 group transition-transform hover:scale-105">
            <img class="w-10 h-10 rounded-full bg-[#4D0F0F] flex items-center justify-center text-white font-bold text-xl font-cairo shadow-sm" src="/assests/doq_logo.png" alt="">
            <div class="flex flex-col">
                <span class="font-cairo font-black text-2xl tracking-tight text-[#4D0F0F] leading-none">دوق <span class="text-[#F26B1D] text-base font-bold">DOQ</span></span>
                <span class="text-xs text-gray-500 font-medium">منصة عربيات أكل الشارع المصرية</span>
            </div>
        </a>
        <div class="flex items-center gap-3">
            <span class="hidden sm:inline-flex items-center gap-1 text-xs text-gray-600 bg-white px-3 py-1.5 rounded-full border border-gray-200 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                وثيقة قانونية معتمدة
            </span>
            <button onclick="window.print()" class="text-xs font-semibold text-gray-600 hover:text-[#4D0F0F] bg-white hover:bg-gray-50 p-2 rounded-lg border border-gray-200 shadow-sm flex items-center gap-1 transition-all" title="طباعة الوثيقة">
                <span class="material-symbols-outlined text-base">print</span>
                <span class="hidden md:inline">طباعة</span>
            </button>
        </div>
    </header>

    <!-- Main Container Card -->
    <main class="w-full max-w-[800px] bg-white rounded-[10px] shadow-[0_4px_24px_rgba(0,0,0,0.06)] border border-[#eeeeee] p-6 sm:p-10 md:p-12 mb-8">
        <div class="mb-10 text-right">
            <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#F26B1D] bg-[#F26B1D]/10 px-3 py-1 rounded-full mb-3">
                <span class="material-symbols-outlined text-sm">currency_exchange</span>
                <span>سياسة الإلغاء والاسترداد</span>
            </div>
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#4D0F0F] leading-tight mb-2 tracking-tight">سياسة الإلغاء والاسترداد</h1>
            <div class="flex items-center gap-2 text-xs sm:text-sm text-gray-500 mb-5">
                <span class="material-symbols-outlined text-base text-gray-400">schedule</span>
                <span>آخر تحديث: <time datetime="2026-09-03" class="font-medium text-gray-700">٣ سبتمبر ٢٠٢٦</time></span>
                <span class="text-gray-300">•</span>
                <span class="text-gray-500">الإصدار 1.0</span>
            </div>
            <div class="w-full h-[2px] bg-[#F26B1D] rounded-full"></div>
        </div>

        <article class="space-y-8 text-base sm:text-[17px] leading-relaxed text-[#333333]">
            <section class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-bold text-[#4D0F0F] flex items-center gap-2">
                    <span class="w-1.5 h-5 bg-[#F26B1D] rounded-full inline-block"></span>١. النظام الحالي (عرض فقط)
                </h2>
                <p class="leading-loose text-justify text-gray-700">
                    حالياً منصة <strong>«دوق» (DOQ)</strong> بتشتغل كنظام عرض واكتشاف فقط. مفيش دفع أونلاين داخل المنصة، والاتفاق والدفع بيتم مباشرة بينك وبين صاحب العربية. عشان كده أي موضوع استرداد بيتعامل معاه مباشرة مع صاحب العربية.
                </p>
            </section>

            <section class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-bold text-[#4D0F0F] flex items-center gap-2">
                    <span class="w-1.5 h-5 bg-[#F26B1D] rounded-full inline-block"></span>٢. لو اتضاف نظام طلبات مستقبلاً
                </h2>
                <ul class="space-y-2.5 pr-1 text-gray-700">
                    <li class="custom-bullet">لو الطلب جه ناقص أو فيه مشكلة واضحة، تقدر تفتح «بلاغ» من خلال المنصة خلال <strong>٢٤ ساعة</strong> من استلام الطلب.</li>
                    <li class="custom-bullet">لو صاحب العربية لغى الطلب قبل ما يبدأ تجهيزه، بتحصل على استرداد كامل للمبلغ.</li>
                    <li class="custom-bullet">لو حصل تأخير كبير أو مشكلة من طرف صاحب العربية، فريق دوق هيتدخل للوساطة العادلة.</li>
                </ul>
            </section>

            <section class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-bold text-[#4D0F0F] flex items-center gap-2">
                    <span class="w-1.5 h-5 bg-[#F26B1D] rounded-full inline-block"></span>٣. نصائح مهمة
                </h2>
                <ul class="space-y-2.5 pr-1 text-gray-700">
                    <li class="custom-bullet">اتفق مع صاحب العربية على السعر وموعد التسليم والمكونات قبل ما تدفع أي فلوس.</li>
                    <li class="custom-bullet">خليك واضح في الطلب عشان تقلل فرص حدوث مشاكل.</li>
                    <li class="custom-bullet">في حالة وجود نزاع، فريق «دوق» جاهز يتدخل كوسيط محايد عشان نوصل لحل عادل للطرفين.</li>
                </ul>
            </section>

            <section class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-bold text-[#4D0F0F] flex items-center gap-2">
                    <span class="w-1.5 h-5 bg-[#F26B1D] rounded-full inline-block"></span>٤. حدود المسؤولية
                </h2>
                <p class="text-gray-700 leading-loose">
                    المنصة مش طرف مباشر في الاتفاق المالي بين العميل وصاحب العربية حالياً. دورنا الأساسي تسهيل الاكتشاف والتقييم العادل، والمساعدة في حل النزاعات لما يُطلب منا.
                </p>
            </section>

            <!-- Contact Callout -->
            <div class="bg-[#f9f9f9] border-r-4 border-[#F26B1D] rounded-lg p-4 sm:p-5 mt-6">
                <h3 class="font-bold text-[#4D0F0F] text-base mb-1 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[#F26B1D] text-lg">mail</span>
                    لديك استفسار أو بلاغ؟
                </h3>
                <p class="text-sm text-gray-600 leading-relaxed">
                    راسلنا على: <a href="mailto:support@doq.com" class="text-[#F26B1D] font-semibold underline underline-offset-4 hover:text-[#d95a12] transition-colors">support@doq.com</a>
                </p>
            </div>
        </article>

        <hr class="my-10 border-t border-[#eeeeee]">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
            <div class="text-xs text-gray-500 text-center sm:text-right">بالاستمرار في استخدام منصة دوق، فإنك توافق على سياسة الإلغاء والاسترداد.</div>
            <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-[#4D0F0F] text-white font-cairo font-bold rounded-[8px] hover:bg-[#5e1313] active:scale-98 shadow-sm hover:shadow-md transition-all duration-200 group text-center">
                <span>العودة للرئيسية</span>
                <span class="material-symbols-outlined text-lg transition-transform group-hover:-translate-x-1">arrow_back</span>
            </a>
        </div>
    </main>

    <footer class="text-center text-xs text-gray-500 py-2">
        <p>© 2026 دوق (DOQ) - اكتشف أحلى عربيات أكل الشارع بسهولة. جميع الحقوق محفوظة.</p>
    </footer>
</body>
</html>