<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>دعوة لتجربة طبق شهي | دوق DOQ</title>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet"/>
    
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-container-low": "#fff0ee",
                        "primary-fixed-dim": "#ffb4a9",
                        "error-container": "#ffdad6",
                        "surface-dim": "#eed4d1",
                        "surface": "#fff8f6",
                        "outline": "#8d706c",
                        "on-surface": "#261816",
                        "on-primary-container": "#ffe5e1",
                        "on-tertiary": "#ffffff",
                        "surface-variant": "#f7ddd9",
                        "inverse-on-surface": "#ffedea",
                        "on-tertiary-fixed-variant": "#004d66",
                        "surface-container-lowest": "#ffffff",
                        "primary": "#9e2016",
                        "primary-container": "#c0392b",
                        "primary-fixed": "#ffdad5",
                        "inverse-primary": "#ffb4a9",
                        "on-secondary": "#ffffff",
                        "on-tertiary-container": "#d3eeff",
                        "on-primary-fixed": "#410000",
                        "tertiary-fixed": "#c0e8ff",
                        "surface-container": "#ffe9e6",
                        "on-surface-variant": "#59413d",
                        "error": "#ba1a1a",
                        "on-secondary-fixed": "#351000",
                        "on-background": "#261816",
                        "on-secondary-fixed-variant": "#7c2e00",
                        "on-error": "#ffffff",
                        "surface-container-high": "#fce2de",
                        "tertiary": "#005875",
                        "secondary": "#a23f00",
                        "outline-variant": "#e1bfb9",
                        "on-primary": "#ffffff",
                        "surface-container-highest": "#f7ddd9",
                        "tertiary-container": "#007296",
                        "secondary-container": "#fc7127",
                        "on-tertiary-fixed": "#001e2b",
                        "surface-bright": "#fff8f6",
                        "on-secondary-container": "#5c2000",
                        "on-error-container": "#93000a",
                        "background": "#fff8f6",
                        "inverse-surface": "#3c2d2a"
                    },
                    spacing: {
                        "sm": "12px",
                        "container-max": "1280px",
                        "xs": "4px",
                        "xl": "80px",
                        "xs": "4px",
                        "md": "24px",
                        "lg": "48px",
                        "base": "8px"
                    },
                    fontFamily: {
                        "sans": ["Tajawal", "sans-serif"],
                        "label-sm": ["Tajawal"],
                        "body-lg": ["Tajawal"],
                        "headline-md": ["Cairo"],
                        "display-lg": ["Cairo"],
                        "body-md": ["Tajawal"],
                        "display-lg-mobile": ["Cairo"]
                    },
                    fontSize: {
                        "label-sm": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "headline-lg": ["28px", {"lineHeight": "36px", "fontWeight": "700"}],
                        "display-md": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.01em", "fontWeight": "800"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    },
                    boxShadow: {
                        'culinary': '0px 4px 20px rgba(192, 57, 43, 0.06)',
                        'soft': '0px 2px 8px rgba(38, 24, 22, 0.04)'
                    }
                }
            }
        }
    </script>
    
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .hero-image {
            transition: transform 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .hero-wrapper:hover .hero-image {
            transform: scale(1.05);
        }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #e1bfb9; border-radius: 10px; }
    </style>
</head>
<body class="bg-background text-on-surface selection:bg-primary-container selection:text-on-primary-container min-h-screen flex flex-col">

    <header class="fixed top-0 right-0 left-0 h-16 bg-surface/80 backdrop-blur-xl shadow-sm z-40 flex items-center justify-between px-4 md:px-8 border-b border-outline-variant/20">
        <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings: 'FILL' 1;">restaurant</span>
                <span class="font-bold text-xl text-primary">دوق</span>
            </a>
        </div>
        <a href="/auth" class="px-4 py-2 bg-primary text-white rounded-xl font-bold hover:bg-primary-container transition-colors text-sm">
            تسجيل الدخول
        </a>
    </header>

    <main class="flex-grow pt-20 pb-16 flex flex-col">
        <section class="relative w-full h-[60vh] md:h-[70vh] overflow-hidden hero-wrapper bg-surface-dim flex-grow">
            <div class="absolute inset-0 w-full h-full hero-image bg-cover bg-center" id="heroImage" style="background-image: url('/assests/hero.jpeg');"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-background via-background/20 to-transparent z-10"></div>
        </section>

        <div class="container-max mx-auto px-4 md:px-6 -mt-20 relative z-20 flex-grow">
            <div class="bg-surface-container-lowest rounded-2xl md:rounded-3xl p-6 md:p-8 shadow-ambient border border-outline-variant/20 animate-elegant max-w-3xl mx-auto">
                <div class="text-center mb-8">
                    <div class="inline-flex items-center gap-2 bg-secondary-fixed/50 px-4 py-2 rounded-full mx-auto mb-6">
                        <span class="material-symbols-outlined text-secondary-container text-xl" style="font-variation-settings: 'FILL' 1;">card_giftcard</span>
                        <span class="font-bold text-on-surface text-body-md">هدية خاصة لك</span>
                    </div>
                    <h1 class="font-cairo font-bold text-display-lg-mobile md:text-display-lg text-on-surface mb-3 leading-tight" id="dishName">
                        طبق شهي بانتظارك
                    </h1>
                    <p class="text-on-surface-variant text-body-lg max-w-xl mx-auto leading-relaxed" id="dishDescription">
                        أحد أصدقائك دعاك لتجربة هذا الطبق الرائع على منصة دوق
                    </p>
                </div>

                <div class="bg-surface-container-low p-6 rounded-2xl border border-outline-variant/20 mb-6">
                    <div class="flex items-center justify-center gap-4 mb-4">
                        <img id="dishImage" src="/assests/dish_avatar.jpeg" alt="صورة الطبق" class="w-24 h-24 rounded-xl object-cover shadow-lg">
                        <div class="text-center">
                            <p class="font-bold text-xl text-primary" id="dishPrice">— ج.م</p>
                            <p class="text-sm text-on-surface-variant" id="dishKitchen">مطبخ دوق</p>
                        </div>
                    </div>
                    
                    <div class="flex items-center justify-center gap-6 text-sm">
                        <div class="flex items-center gap-1.5 bg-primary-fixed text-on-primary-fixed-variant px-4 py-2 rounded-full">
                            <span class="material-symbols-outlined text-primary text-lg" style="font-variation-settings: 'FILL' 1;">local_fire_department</span>
                            <span id="discountPercent">خصم —%</span>
                        </div>
                        <div class="flex items-center gap-1.5 bg-tertiary-fixed text-on-tertiary-fixed-variant px-4 py-2 rounded-full">
                            <span class="material-symbols-outlined text-tertiary text-lg" style="font-variation-settings: 'FILL' 1;">verified</span>
                            <span>عرض حصري للإحالة</span>
                        </div>
                    </div>
                </div>

                <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 mb-6">
                    <div class="flex items-center gap-3 text-amber-900 mb-3">
                        <span class="material-symbols-outlined text-2xl">schedule</span>
                        <span class="font-bold text-lg">العرض صالح لفترة محدودة</span>
                    </div>
                    <p class="text-amber-900/80" id="expiresText">ينتهي العرض في: —</p>
                </div>

                <div class="space-y-4">
                    <button id="signupBtn" class="w-full bg-primary text-on-primary py-4 px-6 rounded-xl font-cairo font-bold text-body-lg shadow-glow hover:scale-[1.02] active:scale-95 transition-all duration-300 flex items-center justify-center gap-2.5">
                        <span class="material-symbols-outlined">person_add</span>
                        سجل الآن واحصل على الخصم
                    </button>
                    
                    <button id="loginBtn" class="w-full bg-surface text-primary border border-primary/20 py-4 px-6 rounded-xl font-cairo font-bold text-body-lg hover:bg-primary hover:text-white transition-all flex items-center justify-center gap-2.5">
                        <span class="material-symbols-outlined">login</span>
                        لدي حساب بالفعل - تسجيل دخول
                    </button>
                </div>

                <p class="mt-4 text-center text-sm text-on-surface-variant/70">
                    بالتسجيل، أنت توافق على <a href="/police/terms-of-service" class="underline hover:text-primary">شروط الخدمة</a> و <a href="/police/privacy-policy" class="underline hover:text-primary">سياسة الخصوصية</a>
                </p>
            </div>

            <div class="mt-8 text-center">
                <p class="text-on-surface-variant text-sm">أو</p>
                <a href="/dishes" class="inline-flex items-center gap-2 text-primary font-bold hover:underline">
                    <span class="material-symbols-outlined">arrow_forward</span>
                    تصفح جميع الأطباق بدون تسجيل
                </a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <script>
        // قراءة التوكن من الرابط
        const urlParams = new URLSearchParams(window.location.search);
        const token = urlParams.get('token');
        const referralToken = new URLSearchParams(window.location.search).get('ref') || token;

        // حفظ التوكن في الكوكيز للتسجيل لاحقاً
        if (referralToken) {
            document.cookie = `doq_referral=${referralToken}; path=/; max-age=2592000; SameSite=Lax`; // 30 يوم
        }

        async function fetchReferralDetails() {
            if (!referralToken) return;
            
            try {
                const response = await fetch(`/platform/referrals/validate?token=${referralToken}`);
                const data = await response.json();
                
                if (data.status === 'success' && data.data) {
                    renderReferral(data.data);
                } else {
                    // توكن غير صالح - إظهار صفحة افتراضية
                    showDefaultState();
                }
            } catch (err) {
                console.error('Error fetching referral:', err);
                showDefaultState();
            }
        }

        function renderReferral(data) {
            document.getElementById('dishName').textContent = data.dish_name || 'طبق شهي';
            document.getElementById('dishDescription').textContent = data.description || 'أحد أصدقائك دعاك لتجربة هذا الطبق الرائع على منصة دوق';
            document.getElementById('dishPrice').textContent = data.price ? `${Number(data.price).toLocaleString('ar-EG')} ج.م` : '— ج.م';
            document.getElementById('dishKitchen').textContent = data.kitchen_name || 'مطبخ دوق';
            document.getElementById('discountPercent').textContent = data.discount_percent ? `خصم ${data.discount_percent}%` : 'خصم خاص';
            document.getElementById('expiresText').textContent = data.expires_at ? `ينتهي العرض في: ${formatDate(data.expires_at)}` : 'عرض لفترة محدودة';
            
            if (data.image_url) {
                document.getElementById('dishImage').src = data.image_url;
                document.getElementById('heroImage').style.backgroundImage = `url('${data.image_url}')`;
            }

            // تحديث أزرار التسجيل لتحويل لصفحة التسجيل مع التوكن
            const signupBtn = document.getElementById('signupBtn');
            const loginBtn = document.getElementById('loginBtn');
            
            signupBtn.onclick = () => {
                window.location.href = `/auth?ref=${referralToken}`;
            };
            
            loginBtn.onclick = () => {
                window.location.href = `/auth?ref=${referralToken}`;
            };
        }

        function showDefaultState() {
            // الصفحة تظهر الحالة الافتراضية الموجودة في HTML
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            const d = new Date(dateStr);
            return d.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
        }

        // تأثيرات التمرير
        window.addEventListener('scroll', () => {
            const header = document.querySelector('header');
            if (header) {
                if (window.scrollY > 20) {
                    header.classList.add('shadow-ambient', 'bg-surface/90', 'backdrop-blur-md');
                } else {
                    header.classList.remove('shadow-ambient', 'bg-surface/90', 'backdrop-blur-md');
                }
            }
        });

        document.addEventListener('DOMContentLoaded', fetchReferralDetails);
    </script>
</body>
</html>